#usda 1.0
(
    defaultPrim = "Dex3"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [ @./physics.usda@ ]
)

over "Dex3"
{
    over "Physics"
    {
        over "hand_index_0_joint" ( prepend apiSchemas = ["PhysxJointAPI"] ) {
            float drive:angular:physics:damping = 0.06
            float drive:angular:physics:stiffness = 0.1
            float drive:angular:physics:maxForce = 1.4
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
        }
        over "hand_index_1_joint" ( prepend apiSchemas = ["PhysxJointAPI"] ) {
            float drive:angular:physics:damping = 0.06
            float drive:angular:physics:stiffness = 0.1
            float drive:angular:physics:maxForce = 1.4
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }
        over "hand_middle_0_joint" ( prepend apiSchemas = ["PhysxJointAPI"] ) {
            float drive:angular:physics:damping = 0.06
            float drive:angular:physics:stiffness = 0.1
            float drive:angular:physics:maxForce = 1.4
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }
        over "hand_middle_1_joint" ( prepend apiSchemas = ["PhysxJointAPI"] ) {
            float drive:angular:physics:damping = 0.06
            float drive:angular:physics:stiffness = 0.1
            float drive:angular:physics:maxForce = 1.4
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }
        over "hand_thumb_0_joint" ( prepend apiSchemas = ["PhysxJointAPI"] ) {
            float drive:angular:physics:damping = 0.08
            float drive:angular:physics:stiffness = 0.12
            float drive:angular:physics:maxForce = 2.45
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
        }
        over "hand_thumb_1_joint" ( prepend apiSchemas = ["PhysxJointAPI"] ) {
            float drive:angular:physics:damping = 0.06
            float drive:angular:physics:stiffness = 0.1
            float drive:angular:physics:maxForce = 1.4
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }
        over "hand_thumb_2_joint" ( prepend apiSchemas = ["PhysxJointAPI"] ) {
            float drive:angular:physics:damping = 0.06
            float drive:angular:physics:stiffness = 0.1
            float drive:angular:physics:maxForce = 1.4
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }
    }
}
