#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "left_hand_palm_link" (
        prepend references = @./geometries.usd@</Geometries/left_hand_palm_link>
    )
    {
        over "left_hand_palm_link" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/left_hand_palm_link/VisualMaterials/black_metal>
        }

        def Scope "VisualMaterials"
        {
            def Material "black_metal" (
                instanceable = false
                prepend references = @./materials.usda@</Materials/black_metal>
            )
            {
            }
        }
    }

    def Xform "left_hand_palm_link_1" (
        prepend references = @./geometries.usd@</Geometries/left_hand_palm_link>
    )
    {
        over "left_hand_palm_link" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"
        }
    }

