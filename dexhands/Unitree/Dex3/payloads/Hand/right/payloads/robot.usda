#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Dex3"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "Dex3" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Dex3/Physics/root_joint>,
        </Dex3/Physics/hand_index_0_joint>,
        </Dex3/Physics/hand_middle_0_joint>,
        </Dex3/Physics/hand_thumb_0_joint>,
        </Dex3/Physics/hand_index_1_joint>,
        </Dex3/Physics/hand_middle_1_joint>,
        </Dex3/Physics/hand_thumb_1_joint>,
        </Dex3/Physics/hand_thumb_2_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Dex3/Geometry/hand_palm_link>,
        </Dex3/Geometry/hand_palm_link/hand_index_0_link>,
        </Dex3/Geometry/hand_palm_link/hand_index_0_link/hand_index_1_link>,
        </Dex3/Geometry/hand_palm_link/hand_middle_0_link>,
        </Dex3/Geometry/hand_palm_link/hand_middle_0_link/hand_middle_1_link>,
        </Dex3/Geometry/hand_palm_link/hand_thumb_0_link>,
        </Dex3/Geometry/hand_palm_link/hand_thumb_0_link/hand_thumb_1_link>,
        </Dex3/Geometry/hand_palm_link/hand_thumb_0_link/hand_thumb_1_link/hand_thumb_2_link>,
    ]
    token isaac:robotType = "Manipulator"

    over "Geometry"
    {
        over "hand_palm_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "hand_index_0_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hand_index_1_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "hand_middle_0_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hand_middle_1_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "hand_thumb_0_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "hand_thumb_1_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "hand_thumb_2_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "hand_index_0_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "hand_index_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "hand_middle_0_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "hand_middle_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "hand_thumb_0_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "hand_thumb_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "hand_thumb_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

