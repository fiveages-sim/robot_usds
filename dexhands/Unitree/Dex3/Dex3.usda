#usda 1.0
(
    defaultPrim = "Dex3"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Unitree Dex3. Side=left|right renames finger DOFs to left_hand_* /
right_hand_* (matches unitree_dex_description / ros2_control). Side=right also
switches Hand/right morphology (Y-mirror placement + mesh Rx180). Joint limits
and angle semantics are identical L/R — same home/command vector (no limit
mirror). Dual mounts require Side prefixes or HW interfaces collide
(hand_index_0_joint ×2)."""
)

def Xform "Dex3" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string Robot = "none"
        string Side = "default"
    }
    prepend variantSets = ["Physics", "Side"]
    append variantSets = ["Robot"]
)
{
    variantSet "Physics" = {
        "mujoco" ( prepend payload = @./payloads/Physics/mujoco.usda@ ) {}
        "none" ( prepend payload = @./payloads/Physics/none.usda@ ) {}
        "physics" ( prepend payload = @./payloads/Physics/physics.usda@ ) {}
        "physx" ( prepend payload = @./payloads/Physics/physx.usda@ ) {}
    }
    variantSet "Side" = {
        "default" ( prepend payload = @./payloads/Side/default.usda@ ) {}
        "left" ( prepend payload = @./payloads/Side/left.usda@ ) {}
        # Match Revo2: swap Hand/right base + Side rename only.
        # Do NOT also payload Hand/right Physics — Physics=physx already owns
        # joints/ArtRoot; a second physx payload re-applies nested ArtRoot and
        # duplicate hand_* defs → tensors invalidate → parent arms scatter.
        "right" (
            prepend payload = @./payloads/Side/right.usda@
            delete references = @./payloads/base.usda@
            prepend references = @./payloads/Hand/right/payloads/base.usda@
        ) {}
    }
    variantSet "Robot" = {
        "none" ( prepend payload = @./payloads/Robot/none.usda@ ) {}
    }
}
