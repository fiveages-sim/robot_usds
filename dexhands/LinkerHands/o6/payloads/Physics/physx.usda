#usda 1.0
(
    defaultPrim = "LinkerHand_o6"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "LinkerHand_o6"
{
    over "joints"
    {
        over "index_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "index_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.89
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o6/joints/index_joint>
        }

        over "middle_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "middle_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.89
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o6/joints/middle_joint>
        }

        over "pinky_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "pinky_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.89
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o6/joints/pinky_joint>
        }

        over "ring_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "ring_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.89
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o6/joints/ring_joint>
        }

        over "thumb_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "thumb_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 57.295776
        }

        over "thumb_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.86
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o6/joints/thumb_joint1>
        }
    }

    # Cap contact correction impulse (Isaac Lab / PhysX common fix for flyaway).
    # Does not change joint drive strength used for open/close.
    over "flange" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "index_proximal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "index_distal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "middle_proximal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "middle_distal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "pinky_proximal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "pinky_distal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "ring_proximal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "ring_distal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "thumb_metacarpals_base2" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "thumb_metacarpals" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }
    over "thumb_distal" ( prepend apiSchemas = ["PhysxRigidBodyAPI"] )
    {
        float physxRigidBody:maxDepenetrationVelocity = 1
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 96
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:sleepThreshold = 0.00005
        float physxArticulation:stabilizationThreshold = 0.00001
    }
}

