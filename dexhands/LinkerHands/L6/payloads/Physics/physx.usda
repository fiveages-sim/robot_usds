#usda 1.0
(
    defaultPrim = "L6"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "L6"
{
    over "joints"
    {
        over "index_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }
        over "index_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.9047
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </L6/joints/index_joint>
        }
