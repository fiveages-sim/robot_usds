#usda 1.0
(
    defaultPrim = "L6"
    metersPerUnit = 1
    upAxis = "Z"
)

over "L6"
{
    over "joints"
    {
        over "index_joint" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

        over "index_dip" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "middle_joint" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

        over "middle_dip" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "pinky_joint" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

        over "pinky_dip" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "ring_joint" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

        over "ring_dip" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "thumb_joint2" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

        over "thumb_joint1" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

        over "thumb_dip" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
        }
    }
}

