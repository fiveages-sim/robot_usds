            rel physxMimicJoint:rotX:referenceJoint = </L6/joints/thumb_joint1>
        }
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </L6/flange>
    }
}
