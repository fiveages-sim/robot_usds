#usda 1.0
(
    defaultPrim = "L6"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Look=dark_gray — original white shell/finger become dark-gray glossy plastic.
Uninstance visual prototypes so local shader opinions beat materials.usda.
Rubber / LED / black_metal unchanged.
"""
