        def PhysicsRevoluteJoint "left_hand_index_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 0.18
            float drive:angular:physics:maxForce = 80
            float drive:angular:physics:stiffness = 1.2
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </L6/flange>
            custom rel physics:body1
            prepend rel physics:body1 = </L6/index_proximal>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 4.34395249e-05
            point3f physics:localPos0 = (-0.00066821, -0.028834, 0.12104)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.99965733, 0.026177008, 0, 0)
            quatf physics:localRot1 = (1.0, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 72.19268
            float physxJoint:maxJointVelocity = 500000
        }
