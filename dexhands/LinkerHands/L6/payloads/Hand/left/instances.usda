                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/rubber>
            }

            over "finger" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/finger>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "shell" (
                instanceable = false
                prepend references = @../materials.usda@</Materials/shell>
            )
            {
            }

            def Material "light" (
                instanceable = true
                prepend references = @../materials.usda@</Materials/light>
            )
            {
            }

            def Material "rubber" (
                instanceable = true
                prepend references = @../materials.usda@</Materials/rubber>
            )
            {
            }

            def Material "finger" (
                instanceable = false
                prepend references = @../materials.usda@</Materials/finger>
            )
            {
            }
        }
    }

