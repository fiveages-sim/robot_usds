#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "shell" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/shell>
            }

            over "light" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/light>
            }

            over "rubber" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/rubber>
            }

            over "finger" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/finger>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "shell" (
                instanceable = false
                prepend references = @../materials.usda@</Materials/shell>
            )
            {
            }

            def Material "light" (
                instanceable = true
                prepend references = @../materials.usda@</Materials/light>
            )
            {
            }

            def Material "rubber" (
                instanceable = true
                prepend references = @../materials.usda@</Materials/rubber>
            )
            {
            }

            def Material "finger" (
                instanceable = false
                prepend references = @../materials.usda@</Materials/finger>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysicsMaterialAPI", "PhysxMaterialAPI", "PhysxCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"
            float physics:staticFriction = 2
            float physics:dynamicFriction = 1.6
            float physics:restitution = 0
            token physxMaterial:frictionCombineMode = "max"
            bool physxMaterial:improvePatchFriction = 1
            float physxCollision:contactOffset = 0.002

            over "shell" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/shell>
            }

            over "light" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/light>
            }

            over "rubber" (
                apiSchemas = ["MaterialBindingAPI"]
            )
