#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Right instances: shared left + right-only palm/thumb Y-flipped geometries."
)

def Scope "Instances" (
    prepend references = @../left/instances.usda@</Instances>
)
{
    over "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
    }
    over "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
    }
    over "mesh_3" (
        prepend references = @./geometries.usd@</Geometries/mesh_3>
    )
    {
    }
    over "mesh_3_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_3>
    )
    {
    }
    over "mesh_4" (
        prepend references = @./geometries.usd@</Geometries/mesh_4>
    )
    {
    }
    over "mesh_4_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_4>
    )
    {
    }
    over "mesh_5" (
        prepend references = @./geometries.usd@</Geometries/mesh_5>
    )
    {
    }
    over "mesh_5_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_5>
    )
    {
    }
}
