#usda 1.0
(
    defaultPrim = "L6"
    doc = """L6 — unified left/right via Side variant (default|left|right).
default: left morphology, unprefixed joints.
left: left morphology, left_hand_* joints.
right: right morphology, right_hand_* joints (Y-mirror poses; four-finger meshes unflipped).
PhysX Drive (Xhand1 close speed, F lowered for L6): fingers D=0.18 K=1.2 F=80; thumb D=0.24 K=1.44 F=130;
jointFriction=0.5 armature=0.001; maxJointVelocity=500000; K raised for snappy tracking (stay below o7 explode ~1.5).
self-col On + FilteredPairs; collider μs=2.0 μd=1.6 contactOffset=0.002.
Mimic gearing kept (finger dip -0.9047, thumb dip -1.23); dampingRatio=0 naturalFrequency=0.
Physics: root has no authored default. Each Side payload weakly selects Physics=physx.
Look: default = original white shell/finger; dark_gray = satin chrome (rubber/LED/black_metal unchanged).
Flange: default none; default option = AG2F90 metal + o6 black print (M6 EE selects this).
Sensor=d405 + Flange=default: hide AG2F90, keep print, CAD flange+brace + D405 (Side sticky-mirrors brace).
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "L6" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Flange = "none"
        string Look = "default"
        string Robot = "none"
        string Sensor = "none"
        string Side = "default"
    }
    prepend variantSets = ["Physics", "Flange", "Look", "Side"]
    append variantSets = ["Robot", "Sensor"]
)
{
    over "joints"
    {
        over "index_joint"
        {
            float drive:angular:physics:damping = 0.18
            float drive:angular:physics:maxForce = 80
            float drive:angular:physics:stiffness = 1.2
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float physxJoint:maxJointVelocity = 500000
        }
        over "index_dip"
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:naturalFrequency = 0
        }
        over "middle_joint"
        {
            float drive:angular:physics:damping = 0.18
            float drive:angular:physics:maxForce = 80
            float drive:angular:physics:stiffness = 1.2
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float physxJoint:maxJointVelocity = 500000
        }
        over "middle_dip"
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:naturalFrequency = 0
        }
        over "pinky_joint"
        {
            float drive:angular:physics:damping = 0.18
            float drive:angular:physics:maxForce = 80
            float drive:angular:physics:stiffness = 1.2
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float physxJoint:maxJointVelocity = 500000
        }
        over "pinky_dip"
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:naturalFrequency = 0
        }
        over "ring_joint"
        {
            float drive:angular:physics:damping = 0.18
            float drive:angular:physics:maxForce = 80
            float drive:angular:physics:stiffness = 1.2
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float physxJoint:maxJointVelocity = 500000
        }
        over "ring_dip"
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:naturalFrequency = 0
        }
        over "thumb_joint2"
        {
            float drive:angular:physics:damping = 0.24
            float drive:angular:physics:maxForce = 130
            float drive:angular:physics:stiffness = 1.44
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float physxJoint:maxJointVelocity = 500000
        }
        over "thumb_joint1"
        {
            float drive:angular:physics:damping = 0.24
            float drive:angular:physics:maxForce = 130
            float drive:angular:physics:stiffness = 1.44
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float physxJoint:maxJointVelocity = 500000
        }
        over "thumb_dip"
        {
            float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:naturalFrequency = 0
        }
    }
    variantSet "Side" = {
        "default" (
            prepend payload = @./payloads/Side/default.usda@
        ) {

        }
        "left" (
            prepend payload = @./payloads/Side/left.usda@
        ) {
            rel isaac:physics:robotJoints = [
        </L6/root_joint>,
        </L6/joints/left_hand_index_joint>,
        </L6/joints/left_hand_index_dip>,
        </L6/joints/left_hand_middle_joint>,
        </L6/joints/left_hand_middle_dip>,
        </L6/joints/left_hand_pinky_joint>,
        </L6/joints/left_hand_pinky_dip>,
        </L6/joints/left_hand_ring_joint>,
        </L6/joints/left_hand_ring_dip>,
        </L6/joints/left_hand_thumb_joint2>,
        </L6/joints/left_hand_thumb_joint1>,
        </L6/joints/left_hand_thumb_dip>
            ]
        }
        "right" (
            prepend payload = @./payloads/Side/right.usda@
            delete references = @./payloads/base.usda@
            prepend references = @./payloads/Hand/right/base.usda@
        ) {
            rel isaac:physics:robotJoints = [
        </L6/root_joint>,
        </L6/joints/right_hand_index_joint>,
        </L6/joints/right_hand_index_dip>,
        </L6/joints/right_hand_middle_joint>,
        </L6/joints/right_hand_middle_dip>,
        </L6/joints/right_hand_pinky_joint>,
        </L6/joints/right_hand_pinky_dip>,
        </L6/joints/right_hand_ring_joint>,
        </L6/joints/right_hand_ring_dip>,
        </L6/joints/right_hand_thumb_joint2>,
        </L6/joints/right_hand_thumb_joint1>,
        </L6/joints/right_hand_thumb_dip>
            ]
        }
    }
    variantSet "Flange" = {
        "default" (
            prepend payload = @./payloads/Flange/default.usda@
        ) {

        }
        "none" {

        }
    }
    variantSet "Physics" = {
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
    }
    variantSet "Look" = {
        "default" (
            prepend payload = @./payloads/Look/default.usda@
        ) {

        }
        "dark_gray" (
            prepend payload = @./payloads/Look/dark_gray.usda@
        ) {

        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {

        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {

        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {

        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {

        }
        "d405" (
            prepend payload = @./payloads/Sensor/d405.usda@
        ) {

        }
    }
}
