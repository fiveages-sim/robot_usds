        over "right_hand_pinky_dip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 0.4615
            rel newton:mimicJoint = </LinkerHand_o7/joints/right_hand_pinky_joint>
        }

        over "right_hand_ring_pip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.3462
            rel newton:mimicJoint = </LinkerHand_o7/joints/right_hand_ring_joint>
        }

        over "right_hand_ring_dip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 0.4615
            rel newton:mimicJoint = </LinkerHand_o7/joints/right_hand_ring_joint>
        }

        over "right_hand_thumb_mcp" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.1
            bool newton:mimicEnabled = 0
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.3898
            rel newton:mimicJoint = </LinkerHand_o7/joints/right_hand_thumb_joint1>
        }

        over "right_hand_thumb_ip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.1
            bool newton:mimicEnabled = 0
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.5085
            rel newton:mimicJoint = </LinkerHand_o7/joints/right_hand_thumb_joint1>
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 1
    }

    # Newton-only: mute non-tip thumb collision GEOMS (not the instance root).
    # CollisionAPI lives on nested mesh_* inside instanceable prototypes;
    # setting collisionEnabled on the instance Xform does nothing for Newton.
    # Break instanceable so we can author the real mesh opinion. PhysX rail
    # does not load this layer → PhysX FilteredPairs / meshes unchanged.
    # Keep thumb_distal/mesh_9 enabled for tip↔finger-tip pinch.
    over "thumb_metacarpals_base1"
    {
        over "collisions"
        {
            over "thumb_metacarpals_base1" (
                instanceable = false
            )
            {
                over "mesh_5"
                {
                    bool physics:collisionEnabled = 0
                }
            }
        }
    }

    over "thumb_metacarpals_base2"
    {
        over "collisions"
        {
            over "thumb_metacarpals_base2" (
                instanceable = false
            )
            {
                over "mesh_6"
                {
                    bool physics:collisionEnabled = 0
                }
            }
        }
    }

    over "thumb_metacarpals"
    {
        over "collisions"
        {
            over "thumb_metacarpals" (
                instanceable = false
            )
            {
                over "mesh_7"
                {
                    bool physics:collisionEnabled = 0
                }
            }
        }
    }

    over "thumb_proximal"
    {
        over "collisions"
        {
            over "thumb_proximal" (
                instanceable = false
            )
            {
                over "mesh_8"
                {
                    bool physics:collisionEnabled = 0
                }
            }
        }
    }

    # Default-Side position actuators only (left/right actuators in Side payloads).
    def Scope "actuators"
    {
        def MjcActuator "index_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5, -1.5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -30
            uniform double mjc:forceRange:max = 30
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0.0
            uniform double mjc:ctrlRange:max = 1.36069994
            rel mjc:target = </LinkerHand_o7/joints/index_joint>
        }

        def MjcActuator "middle_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
