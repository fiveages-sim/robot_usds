#usda 1.0
(
    defaultPrim = "LinkerHand_o7"
    doc = """MuJoCo/Newton physics rail for LinkerHand o7.
subLayers physics.usda (mass/joints/filteredPairs). Strips PhysX Drive;
adds MjcJointAPI + MjcActuator + NewtonMimicAPI. Does not edit physx.usda.
Mimic coef1 starts as PhysX gearing (negative); flip sign if open/close inverted.
Actuator kp/kd are MJWarp starting values (not PhysX K=0.1).
Side left/right actuators live in payloads/Side/{left,right}.usda.
"""
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
    customLayerData = {
        dictionary omni_layer = {
            string authoring_layer = "./mujoco.usda"
        }
    }
)

over "LinkerHand_o7"
{
    over "joints"
    {
        # --- default Side driven joints ---
        over "index_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -30
            uniform double mjc:actuatorfrcrange:max = 30
        }

        over "middle_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -30
            uniform double mjc:actuatorfrcrange:max = 30
        }

        over "pinky_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -30
            uniform double mjc:actuatorfrcrange:max = 30
        }

        over "ring_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -30
            uniform double mjc:actuatorfrcrange:max = 30
        }

        over "thumb_joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.08
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }

        over "thumb_joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.08
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }

        over "thumb_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.08
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }

        # --- mimic: coef1 = +abs(PhysX gearing); negative PhysX gearing fights under Newton ---
        over "index_pip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.3462
            rel newton:mimicJoint = </LinkerHand_o7/joints/index_joint>
        }

        over "index_dip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 0.4615
            rel newton:mimicJoint = </LinkerHand_o7/joints/index_joint>
        }

        over "middle_pip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.3462
            rel newton:mimicJoint = </LinkerHand_o7/joints/middle_joint>
        }

        over "middle_dip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 0.4615
            rel newton:mimicJoint = </LinkerHand_o7/joints/middle_joint>
        }

        over "pinky_pip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.3462
            rel newton:mimicJoint = </LinkerHand_o7/joints/pinky_joint>
