            uniform double[] mjc:biasPrm = [0, -5, -1.5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -30
            uniform double mjc:forceRange:max = 30
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0.0
            uniform double mjc:ctrlRange:max = 1.36069994
            rel mjc:target = </LinkerHand_o7/joints/middle_joint>
        }

        def MjcActuator "pinky_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5, -1.5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -30
            uniform double mjc:forceRange:max = 30
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0.0
            uniform double mjc:ctrlRange:max = 1.36069994
            rel mjc:target = </LinkerHand_o7/joints/pinky_joint>
        }

        def MjcActuator "ring_joint"
