            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 0.4615
            rel newton:mimicJoint = </LinkerHand_o7/joints/ring_joint>
        }

        over "thumb_mcp" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.1
            bool newton:mimicEnabled = 0
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.3898
            rel newton:mimicJoint = </LinkerHand_o7/joints/thumb_joint1>
            # DIAG: mimicEnabled=0 — thumb_joint1 localRot is non-identity; Newton scalar mimic may fight
        }

        over "thumb_ip" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.1
            bool newton:mimicEnabled = 0
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1.5085
            rel newton:mimicJoint = </LinkerHand_o7/joints/thumb_joint1>
        }

        # --- Side=left driven (Drive strip when Physics=mujoco; prims exist only if Side=left) ---
        over "left_hand_index_joint" (
