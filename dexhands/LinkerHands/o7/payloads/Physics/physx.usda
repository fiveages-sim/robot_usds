#usda 1.0
(
    defaultPrim = "LinkerHand_o7"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "LinkerHand_o7"
{
    over "joints"
    {
        over "index_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
        }

        over "index_pip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.3462
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/index_joint>
        }

        over "index_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.4615
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/index_joint>
        }

        over "middle_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
        }

        over "middle_pip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.3462
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/middle_joint>
        }

        over "middle_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.4615
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/middle_joint>
        }

        over "pinky_pip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.3462
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/pinky_joint>
        }

        over "pinky_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
        }

        over "pinky_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.4615
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/pinky_joint>
        }

        over "ring_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
        }

        over "ring_pip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.3462
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/ring_joint>
        }

        over "ring_dip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -0.4615
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/ring_joint>
        }

        over "thumb_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
        }

        over "thumb_joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
        }

        over "thumb_mcp" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.3898
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/thumb_joint1>
        }

        over "thumb_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
        }

        over "thumb_ip" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.5085
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </LinkerHand_o7/joints/thumb_joint1>
        }
    
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 1
        float physxArticulation:stabilizationThreshold = 0.00001
    }
}
