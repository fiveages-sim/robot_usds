#usda 1.0
(
    defaultPrim = "LinkerHand_o7"
    metersPerUnit = 1
    upAxis = "Z"
)

over "LinkerHand_o7" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace (
        displayName = "Namespace"
        doc = "Namespace of the prim in Isaac Sim"
    )
    prepend rel isaac:physics:robotJoints = [
        </LinkerHand_o7/root_joint>,
        </LinkerHand_o7/joints/index_joint>,
        </LinkerHand_o7/joints/middle_joint>,
        </LinkerHand_o7/joints/pinky_joint>,
        </LinkerHand_o7/joints/ring_joint>,
        </LinkerHand_o7/joints/thumb_joint3>,
        </LinkerHand_o7/joints/index_pip>,
        </LinkerHand_o7/joints/index_dip>,
        </LinkerHand_o7/joints/middle_pip>,
        </LinkerHand_o7/joints/middle_dip>,
        </LinkerHand_o7/joints/pinky_pip>,
        </LinkerHand_o7/joints/pinky_dip>,
        </LinkerHand_o7/joints/ring_pip>,
        </LinkerHand_o7/joints/ring_dip>,
        </LinkerHand_o7/joints/thumb_joint2>,
        </LinkerHand_o7/joints/thumb_joint1>,
        </LinkerHand_o7/joints/thumb_mcp>,
        </LinkerHand_o7/joints/thumb_ip>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </LinkerHand_o7/flange>,
        </LinkerHand_o7/index_proximal>,
        </LinkerHand_o7/index_middle>,
        </LinkerHand_o7/index_distal>,
        </LinkerHand_o7/middle_proximal>,
        </LinkerHand_o7/middle_middle>,
        </LinkerHand_o7/middle_distal>,
        </LinkerHand_o7/pinky_proximal>,
        </LinkerHand_o7/pinky_middle>,
        </LinkerHand_o7/pinky_distal>,
        </LinkerHand_o7/ring_proximal>,
        </LinkerHand_o7/ring_middle>,
        </LinkerHand_o7/ring_distal>,
        </LinkerHand_o7/thumb_metacarpals_base1>,
        </LinkerHand_o7/thumb_metacarpals_base2>,
        </LinkerHand_o7/thumb_metacarpals>,
        </LinkerHand_o7/thumb_proximal>,
        </LinkerHand_o7/thumb_distal>,
        </LinkerHand_o7/flange/hand_base>,
    ]

    over "flange" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "hand_base" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "index_proximal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "index_middle" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "index_distal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "middle_proximal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "middle_middle" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "middle_distal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "pinky_proximal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "pinky_middle" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "pinky_distal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "ring_proximal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "ring_middle" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "ring_distal" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "thumb_metacarpals_base1" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "thumb_metacarpals_base2" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "thumb_metacarpals" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

