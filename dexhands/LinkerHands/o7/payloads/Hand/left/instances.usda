    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh/VisualMaterials/DEFAULT_MTL>
        }

        def Scope "VisualMaterials"
        {
            def Material "DEFAULT_MTL" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/DEFAULT_MTL>
            )
            {
            }
        }
    }

