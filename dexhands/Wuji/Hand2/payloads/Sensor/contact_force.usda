#usda 1.0
(
    defaultPrim = "Wuji_hand2"
    doc = """Sensor=contact_force — PhysX ContactSensor on palm+phalanges + TipPad on tips,
OmniGraph ROS_Contact_Force (ScriptNode → rclpy MarkerArray/Wrench/Bool).
Hand-local only (handRoot auto-discovered). Side payloads set tfPrefix/topicPrefix
(right→wuji_rh/right_hand, left→wuji_lh/left_hand). Works on any arm/stage that mounts this hand.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Wuji_hand2"
{
    # --- Contact Report + IsaacContactSensor (relative to this hand) ---

        over "world" (
            prepend apiSchemas = ["PhysxContactReportAPI"]
        )
        {
            float physxContactReport:threshold = 0
            def IsaacContactSensor "Contact_Sensor"
            {
                bool enabled = 1
                float2 threshold = (0.0001, 100000)
                float radius = -1
                float4 color = (0.15, 0.35, 0.85, 0.15)
            }
        }

        over "thumb_proximal" (
