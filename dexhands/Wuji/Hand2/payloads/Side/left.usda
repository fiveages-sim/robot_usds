        def MjcActuator "left_hand_index_finger_mcp_flex"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [4, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -4, -3.0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -10
            uniform double mjc:forceRange:max = 10
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -1.04699998
            uniform double mjc:ctrlRange:max = 1.56999993
