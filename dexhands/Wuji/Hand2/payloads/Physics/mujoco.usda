#usda 1.0
(
    defaultPrim = "Wuji_hand2"
    doc = """MuJoCo/Newton physics rail for Wuji Hand2.
subLayers physics.usda (mass/joints). Strips PhysX Drive; adds MjcJointAPI +
MjcActuator. No mimic joints on this hand (20 independent DOFs).
Actuator kp/kd are MJWarp starting values (PhysX baseline was K=0.05 D=0.0005 F=2;
forceRange raised to ±10/±15 for usable Newton tracking — retune after smoke).
Default-Side actuators only here; left/right actuators in Side payloads.
Self-collision: newton:selfCollisionEnabled=1; FilteredPairs policy lives in physics.usda (subLayer) — tip↔palm + inter-finger KEEP; non-tip↔palm + intra-finger FILTER. Do not reintroduce o7-style neighbor tip filters.
"""
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
    customLayerData = {
        dictionary omni_layer = {
            string authoring_layer = "./mujoco.usda"
        }
    }
)

over "Wuji_hand2"
{
    over "joints"
    {
        # --- default Side (unprefixed) ---
        over "index_finger_mcp_flex" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -10
            uniform double mjc:actuatorfrcrange:max = 10
        }

        over "index_finger_mcp_abd" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
