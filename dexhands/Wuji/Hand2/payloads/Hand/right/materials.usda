                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Opacity"
            )
            int inputs:alpha_mode = 0 (
                customData = {
                    int default = 0
                    dictionary range = {
                        int max = 2
                        int min = 0
                    }
                }
                displayGroup = "Opacity"
                renderType = "gltf_alpha_mode"
                sdrMetadata = {
                    string __SDR__enum_value = "opaque"
                    string options = "opaque:0|mask:1|blend:2"
                }
            )
            float inputs:base_alpha = 1 (
                customData = {
                    double default = 1
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Base Alpha"
            )
            color3f inputs:base_color_factor = (0, 0, 0) (
                customData = {
                    float3 default = (1, 1, 1)
                    dictionary range = {
                        float3 max = (1, 1, 1)
                        float3 min = (0, 0, 0)
                    }
                }
                displayGroup = "PBR Metallic Roughness"
            )
            float inputs:emissive_strength = 10000 (
                customData = {
                    double default = 1
                }
                displayGroup = "Emission"
            )
            float inputs:metallic_factor = 0.9 (
                customData = {
                    double default = 0
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
