#usda 1.0
(
    defaultPrim = "Wuji_hand2"
    doc = """Wuji Hand2 — unified left/right via Side variant (default|left|right).
default: left morphology, unprefixed joints.
left: left morphology, left_hand_* joints (default joints deactivated).
right: right morphology, right_hand_* joints (X-mirror of Hand/left).
Drive baseline (user-tuned): D=0.0005 K=0.05 F=2 force; maxJointVelocity=500000.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Wuji_hand2" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string Robot = "none"
        string Sensor = "none"
        string Side = "default"
    }
    prepend variantSets = ["Side", "Physics"]
    append variantSets = ["Robot", "Sensor"]
)
{
    over "joints"
    {
        over "index_finger_mcp_flex"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "index_finger_mcp_abd"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "index_finger_pip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "index_finger_dip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "middle_finger_mcp_flex"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "middle_finger_mcp_abd"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "middle_finger_pip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "middle_finger_dip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "pinky_mcp_flex"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "pinky_mcp_abd"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "pinky_pip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "pinky_dip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "ring_mcp_flex"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "ring_mcp_abd"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "ring_pip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "ring_dip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "thumb_cmc_flex"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "thumb_cmc_abd"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "thumb_mcp"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }

        over "thumb_ip"
        {
            float drive:angular:physics:damping = 0.0005
            float drive:angular:physics:maxForce = 2
            float drive:angular:physics:stiffness = 0.05
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 500000
        }
    }

    variantSet "Side" = {
        "default" (
            prepend payload = @./payloads/Side/default.usda@
        ) {
        }
        "left" (
            prepend payload = @./payloads/Side/left.usda@
        ) {
        }
        "right" (
            prepend payload = @./payloads/Side/right.usda@
            delete references = @./payloads/base.usda@
            prepend references = @./payloads/Hand/right/base.usda@
        ) {
        }
    }
    variantSet "Physics" = {
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {
        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {
        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {
        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {
        }
    }
}
