#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Right instances: shared left instances + right-only palm/thumb/hand_back geometries."
)

def Scope "Instances" (
    prepend references = @../left/instances.usda@</Instances>
)
{
    over "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
    }
    over "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
    }
    over "mesh_1_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
    }
    over "mesh_1_2" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
    }
    over "mesh_8" (
        prepend references = @./geometries.usd@</Geometries/mesh_8>
    )
    {
    }
    over "mesh_8_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_8>
    )
    {
    }
    over "mesh_9" (
        prepend references = @./geometries.usd@</Geometries/mesh_9>
    )
    {
    }
    over "mesh_9_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_9>
    )
    {
    }
    over "mesh_10" (
        prepend references = @./geometries.usd@</Geometries/mesh_10>
    )
    {
    }
    over "mesh_10_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_10>
    )
    {
    }
    over "mesh_11" (
        prepend references = @./geometries.usd@</Geometries/mesh_11>
    )
    {
    }
    over "mesh_11_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_11>
    )
    {
    }
    over "mesh_12" (
        prepend references = @./geometries.usd@</Geometries/mesh_12>
    )
    {
    }
    over "mesh_12_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_12>
    )
    {
    }
}
