#usda 1.0
(
    defaultPrim = "Xhand1"
    doc = """MuJoCo/Newton physics rail for Xhand1.
subLayers physics.usda (mass/joints). Strips PhysX Drive; adds MjcJointAPI +
MjcActuator. No mimic joints (12 independent DOFs).
Default-Side actuators only here; left/right actuators in Side payloads.
Self-collision: newton:selfCollisionEnabled=1; FilteredPairs in physics.usda.
"""
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Xhand1"
{
    over "joints"
    {
        over "index_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.002
            uniform double mjc:damping = 0.02
            uniform double mjc:frictionloss = 0.0
            uniform token mjc:actuatorfrclimited = "true"
            uniform double mjc:actuatorfrcrange:min = -10
            uniform double mjc:actuatorfrcrange:max = 10
        }
        over "index_joint2" (
