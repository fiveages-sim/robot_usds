        def MjcActuator "index_joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [5, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -5, -1.5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -10
            uniform double mjc:forceRange:max = 10
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -0.1739999889
            uniform double mjc:ctrlRange:max = 0.1739999889
            rel mjc:target = </Xhand1/joints/index_joint1>
