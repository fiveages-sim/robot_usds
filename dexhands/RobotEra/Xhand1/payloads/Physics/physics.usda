#usda 1.0
(
    defaultPrim = "Xhand1"
    doc = """Xhand1 physics layer.

Self-collision FilteredPairs policy:
- KEEP tip↔palm and all inter-finger contacts (pinch / finger-finger).
- FILTER non-tip↔palm and all intra-finger link pairs.
Shared by PhysX and Newton (UsdPhysics filteredPairs).
Drive baseline (G1 hold · fasim-dexhand-asset §0.1): fingers D=0.06 K=0.1 F=30;
thumb D=0.08 K=0.12 F=50; jointFriction=0.5 armature=0.001.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Xhand1"
{
    over "hand_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physxRigidBody:maxDepenetrationVelocity = 2.0
        rel physics:filteredPairs = [
