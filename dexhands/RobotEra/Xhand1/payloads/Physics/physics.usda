            float drive:angular:physics:damping = 0.18
            float drive:angular:physics:maxForce = 120
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
            float drive:angular:physics:stiffness = 1.2
            float drive:angular:physics:targetPosition = 0
