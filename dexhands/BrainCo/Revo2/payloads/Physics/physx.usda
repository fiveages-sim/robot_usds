#usda 1.0
(
    defaultPrim = "Revo2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Revo2"
{
    over "joints"
    {
        over "index_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }

        over "index_distal_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.155
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Revo2/joints/index_joint>
        }

        over "middle_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }

        over "middle_distal_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.155
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Revo2/joints/middle_joint>
        }

        over "pinky_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }

        over "pinky_distal_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.155
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Revo2/joints/pinky_joint>
        }

        over "ring_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }

        over "ring_distal_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1.155
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Revo2/joints/ring_joint>
        }

        over "thumb_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }

        over "thumb_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }

        over "thumb_distal_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:gearing = -1.0
            float physxMimicJoint:rotX:naturalFrequency = 0
            float physxMimicJoint:rotX:offset = 0
            rel physxMimicJoint:rotX:referenceJoint = </Revo2/joints/thumb_joint1>
        }

    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 1
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:stabilizationThreshold = 0.00001
    }
}
