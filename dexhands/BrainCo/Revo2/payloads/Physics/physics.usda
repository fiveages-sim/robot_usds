#usda 1.0
(
    defaultPrim = "Revo2"
    doc = """Revo2 physics layer.

Self-collision FilteredPairs policy:
- FILTER palm↔non-tip and intra-finger pairs.
- KEEP thumb_distal ↔ other finger distals (pinch).
Shared by PhysX and Newton (UsdPhysics filteredPairs).
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Revo2"
{
    over "hand_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physxRigidBody:maxDepenetrationVelocity = 2.0
        rel physics:filteredPairs = [
            </Revo2/index_proximal_Link>,
            </Revo2/middle_proximal_Link>,
            </Revo2/pinky_proximal_Link>,
