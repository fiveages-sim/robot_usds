#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "silver" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/silver>
            }

            over "metal_grey" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/metal_grey>
            }

            over "green_light" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/green_light>
            }

            over "metal_black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/metal_black>
            }

            over "rubber_grey" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/rubber_grey>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }

            def Material "metal_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/metal_grey>
            )
            {
            }

            def Material "green_light" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/green_light>
            )
            {
            }

            def Material "metal_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/metal_black>
            )
            {
            }

            def Material "rubber_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/rubber_grey>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI", "PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:staticFriction = 2.0
            float physics:dynamicFriction = 1.6
            float physics:restitution = 0
            uniform token physxMaterial:frictionCombineMode = "max"
            uniform token physxMaterial:restitutionCombineMode = "min"
            bool physxMaterial:improvePatchFriction = 1
            float physxCollision:contactOffset = 0.002
            float physxCollision:restOffset = 0

            token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "silver" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/silver>
            }

            over "metal_grey" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/metal_grey>
            }

            over "green_light" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/green_light>
            }

            over "metal_black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/metal_black>
            }

            over "rubber_grey" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/rubber_grey>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }

            def Material "metal_grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/metal_grey>
            )
            {
            }

            def Material "green_light" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/green_light>
            )
            {
            }

            def Material "metal_black" (
