#usda 1.0
(
    defaultPrim = "Revo1"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Revo1" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </Revo1/root_joint>,
        </Revo1/joints/index_joint>,
        </Revo1/joints/index_pip_joint>,
        </Revo1/joints/middle_joint>,
        </Revo1/joints/middle_pip_joint>,
        </Revo1/joints/pinky_joint>,
        </Revo1/joints/pinky_pip_joint>,
        </Revo1/joints/ring_joint>,
        </Revo1/joints/ring_pip_joint>,
        </Revo1/joints/thumb_joint2>,
        </Revo1/joints/thumb_joint1>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Revo1/hand_base>,
        </Revo1/index_prox>,
        </Revo1/index_dist>,
        </Revo1/middle_prox>,
        </Revo1/middle_dist>,
        </Revo1/pinky_prox>,
        </Revo1/pinky_dist>,
        </Revo1/ring_prox>,
        </Revo1/ring_dist>,
        </Revo1/thumb_prox>,
        </Revo1/thumb_dist>,
        </Revo1/hand_base/base_offset>,
    ]

    over "hand_base" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "base_offset" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "index_prox" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "joints"
    {
        over "index_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "index_pip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "middle_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "middle_pip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "pinky_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "pinky_pip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "ring_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "ring_pip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "thumb_joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "thumb_joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }
    }

    over "index_dist" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "middle_prox" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "middle_dist" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "pinky_prox" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "pinky_dist" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "ring_prox" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "ring_dist" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "thumb_prox" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "thumb_dist" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "root_joint" (
        prepend apiSchemas = ["IsaacJointAPI"]
    )
    {
    }
}

