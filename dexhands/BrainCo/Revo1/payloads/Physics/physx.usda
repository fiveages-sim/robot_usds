#usda 1.0
(
    defaultPrim = "Revo1"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Revo1"
{
    over "joints"
    {
        over "index_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }
        over "index_pip_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:gearing = -1.2
            float physxMimicJoint:rotX:naturalFrequency = 0
            float physxMimicJoint:rotX:offset = 0.19373155
            rel physxMimicJoint:rotX:referenceJoint = </Revo1/joints/index_joint>
        }
        over "middle_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }
        over "middle_pip_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:gearing = -1.2
            float physxMimicJoint:rotX:naturalFrequency = 0
            float physxMimicJoint:rotX:offset = 0.18325958
            rel physxMimicJoint:rotX:referenceJoint = </Revo1/joints/middle_joint>
        }
        over "pinky_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }
        over "pinky_pip_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:gearing = -1.2
            float physxMimicJoint:rotX:naturalFrequency = 0
            float physxMimicJoint:rotX:offset = 0.20245819
            rel physxMimicJoint:rotX:referenceJoint = </Revo1/joints/pinky_joint>
        }
        over "ring_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }
        over "ring_pip_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxMimicJoint:rotX:dampingRatio = 0
            float physxMimicJoint:rotX:gearing = -1.2
            float physxMimicJoint:rotX:naturalFrequency = 0
            float physxMimicJoint:rotX:offset = 0.16580628
            rel physxMimicJoint:rotX:referenceJoint = </Revo1/joints/ring_joint>
        }
        over "thumb_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }
        over "thumb_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 500000
            float physxJoint:jointFriction = 0.5
            float physxJoint:armature = 0.001
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 1
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:stabilizationThreshold = 0.00001
    }
}
