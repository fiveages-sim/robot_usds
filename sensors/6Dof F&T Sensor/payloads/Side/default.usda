#usda 1.0
(
    defaultPrim = "KWR75B"
    doc = "KWR75B Side=default: topic/frame overlay."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "KWR75B"
{
    over "Graph"
    {
        over "ROS_FT_Sensor"
        {
            over "ReadFT"
            {
                custom string inputs:frameId = "tcp"
                custom string inputs:topicName = "/isaac/ft_wrench"
            }
        }
    }
}
