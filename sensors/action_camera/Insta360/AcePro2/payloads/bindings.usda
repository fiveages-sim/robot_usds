#usda 1.0
(
    defaultPrim = "AcePro2"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "AcePro2"
{
    over "lens_guard"
    {
        over "lens_guard_0" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_bezel>
        }

        over "lens_guard_1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_red>
        }

        over "lens_guard_2" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_edge>
        }

        over "lens_guard_3" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_black>
        }

        over "lens_guard_4" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_glass>
        }

        over "lens_guard_5" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_optical>
        }

    }

    over "body"
    {
        over "Ace_Pro_2_reconstructed_exterior_0" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_body>
        }

        over "Ace_Pro_2_reconstructed_exterior_1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_bezel>
        }

        over "Ace_Pro_2_reconstructed_exterior_2" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_edge>
        }

        over "Ace_Pro_2_reconstructed_exterior_3" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_black>
        }

        over "Ace_Pro_2_reconstructed_exterior_4" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_display>
        }

        over "Ace_Pro_2_reconstructed_exterior_5" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_red>
        }

        over "Ace_Pro_2_reconstructed_exterior_6" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_markings>
        }

        over "Ace_Pro_2_reconstructed_exterior_7" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_glass>
        }

    }

    over "utility_frame"
    {
        over "Ace_Pro_2_reconstructed_exterior_8" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </AcePro2/Looks/ace_cage>
        }

    }


    over "optical_frame"
    {
        over "wide_lens"
        {
            over "barrel" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </AcePro2/Looks/wide_lens_barrel>
            }

            over "rim" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </AcePro2/Looks/wide_lens_rim>
            }

            over "glass" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </AcePro2/Looks/wide_lens_glass>
            }
        }
    }
}
