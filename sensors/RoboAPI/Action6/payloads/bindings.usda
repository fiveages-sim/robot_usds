#usda 1.0
(
    defaultPrim = "Action6"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Action6"
{
    over "lens_guard"
    {
        over "lens_guard_0" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_glass>
        }

        over "lens_guard_1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_bezel>
        }

        over "lens_guard_2" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_lensplate>
        }

        over "lens_guard_3" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_rim>
        }

        over "lens_guard_4" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_optics>
        }

    }

    over "body"
    {
        over "Action_6_detailed_CAD_exterior_0" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_body>
        }

        over "Action_6_detailed_CAD_exterior_1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_black>
        }

        over "Action_6_detailed_CAD_exterior_2" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_button>
        }

        over "Action_6_detailed_CAD_exterior_3" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_adapter>
        }

        over "Action_6_detailed_CAD_exterior_4" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_bezel>
        }

        over "Action_6_detailed_CAD_exterior_5" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_display>
        }

        over "Action_6_detailed_CAD_exterior_6" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_markings>
        }

        over "Action_6_detailed_CAD_exterior_7" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_sensor>
        }

        over "Action_6_detailed_CAD_exterior_8" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_red>
        }

        over "Action_6_detailed_CAD_exterior_9" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Action6/Looks/action_rim>
        }

    }


    over "optical_frame"
    {
        over "wide_lens"
        {
            over "barrel" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Action6/Looks/wide_lens_barrel>
            }

            over "rim" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Action6/Looks/wide_lens_rim>
            }

            over "glass" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Action6/Looks/wide_lens_glass>
            }
        }
    }
}
