#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.3807094475474109, 0.7430621714318532, 0.6012040764597185)
                double3 target = (-0.6452468597183649, -0.46908173250095964, -0.04249074182984436)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./Agilex_Ranger_Mini.usd"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Agilex_Ranger_Mini"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Agilex_Ranger_Mini" (
    prepend apiSchemas = ["PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 0

    over "joints"
    {
        over "fl_steering_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 359.81747
        }

        over "fl_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = inf
        }

        over "fr_steering_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 359.81747
        }

        over "fr_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = inf
        }

        over "rl_steering_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 359.81747
        }

        over "rl_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = inf
        }

        over "rr_steering_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 359.81747
        }

        over "rr_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = inf
        }
    }

    over "base_link"
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}

