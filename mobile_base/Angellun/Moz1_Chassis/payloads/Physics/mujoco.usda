#usda 1.0
(
    defaultPrim = "OmniChassis"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "OmniChassis"
{
    over "base_link" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    over "joints"
    {
        over "wheel1_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }

        over "wheel2_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }

        over "wheel3_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }

        over "wheel4_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }
    }

    def Scope "actuators"
    {
        def MjcActuator "wheel1_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -20, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -50
            uniform double mjc:forceRange:max = 50
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </OmniChassis/joints/wheel1_joint>
        }

        def MjcActuator "wheel2_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -20, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -50
            uniform double mjc:forceRange:max = 50
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </OmniChassis/joints/wheel2_joint>
        }

        def MjcActuator "wheel3_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -20, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -50
            uniform double mjc:forceRange:max = 50
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </OmniChassis/joints/wheel3_joint>
        }

        def MjcActuator "wheel4_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -20, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -50
            uniform double mjc:forceRange:max = 50
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </OmniChassis/joints/wheel4_joint>
        }
    }
}
