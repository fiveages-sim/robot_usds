#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, -0.018108169296467712, 0.17746005910538143)
                double radius = 0.6355711460113526
            }
            dictionary Perspective = {
                double3 position = (1.2079228136378675, 1.4239328588322782, 0.9260825541372442)
                double3 target = (-1.1830391237017068, -2.1710383046762702, -0.4303201089154187)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 1.3599302291870117
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary metricsAssembler = {
            dictionary "/Ai2_Bot2_Chassis/base_footprint/base_link/chassis_panel/panel" = {
            }
            dictionary "/Ai2_Bot2_Chassis/base_footprint/base_link/dabai_dw/orbbec_dabai_dw" = {
            }
            dictionary "/Ai2_Bot2_Chassis/base_footprint/base_link/lidar_link/ms500" = {
            }
            int version = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./Ai2_Bot2_Chassis.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Ai2_Bot2_Chassis"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Ai2_Bot2_Chassis"
{
    over "base_footprint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }

    over "joints"
    {
        over "driven_fl_joint_v" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driven_fl_joint_h" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driven_fr_joint_v" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driven_fr_joint_h" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driven_rl_joint_v" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driven_rl_joint_h" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driven_rr_joint_v" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driven_rr_joint_h" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driving_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 1000000
            float drive:angular:physics:maxForce = 50
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 572.95776
        }

        over "driving_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 1000000
            float drive:angular:physics:maxForce = 50
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 572.95776
        }
    }
}

