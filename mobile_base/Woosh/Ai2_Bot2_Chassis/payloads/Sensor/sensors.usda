#usda 1.0
(
    defaultPrim = "Ai2_Bot2_Chassis"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Ai2_Bot2_Chassis"
{
    over "base_footprint"
    {
        over "base_link"
        {
            over "chassis_camera"
            {
                def "orbbec_dabai_dw" (
                    prepend payload = @../../../../../sensors/orbbec_dabai_dw.usd@
                )
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    double xformOp:rotateX:unitsResolve = 90
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                }

                def Camera "chassis_camera"
                {
                    float2 clippingRange = (0.01, 10000000)
                    float focalLength = 18.147562
                    float focusDistance = 400
                    quatd xformOp:orient = (0.5000000000000001, 0.5, -0.5, -0.49999999999999994)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }

            over "lidar_link"
            {
                def "oradar_ms500" (
                    prepend payload = @../../../../../sensors/oradar_ms500.usd@
                )
                {
                    quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
                    double xformOp:rotateX:unitsResolve = 90
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                }
            }

            over "chassis_panel"
            {
                def "panel" (
                    prepend payload = @../../../panel.usd@
                )
                {
                    quatf xformOp:orient = (0.70710677, 0, 0, -0.70710677)
                    double xformOp:rotateX:unitsResolve = 90
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                }
            }
        }
    }
}
