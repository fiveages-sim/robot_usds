        </Woosh_AGV/caster_2_link/collisions>,
        </Woosh_AGV/caster_3_link/collisions>,
        </Woosh_AGV/caster_4_link/collisions>,
    ]
    token isaac:robotType (
        displayName = "Robot Type"
    )
    string isaac:source (
        displayName = "Source"
    )
    string isaac:version (
        displayName = "Version"
    )

    over "base_footprint" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
