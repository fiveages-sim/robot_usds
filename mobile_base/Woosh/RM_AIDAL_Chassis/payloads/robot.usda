    defaultPrim = "Woosh_AGV"
    doc = """Generated from Composed Stage of root layer /home/fiveages/libraries/FaSim-Isaac/robots/humanoid/Realman_AIDAL/Woosh_AGV/RM_AIDAL_Chassis.usd
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Woosh_AGV" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string[] isaac:changelog (
        displayName = "Changelog"
    )
    string isaac:description (
        displayName = "Description"
    )
    token isaac:license (
        displayName = "License"
    )
    string isaac:namespace (
        displayName = "Namespace"
        doc = "Namespace of the prim in Isaac Sim"
    )
    rel isaac:physics:robotJoints (
        displayName = "Robot Joints"
    )
    prepend rel isaac:physics:robotJoints = [
        </Woosh_AGV/joints/caster_1_joint>,
        </Woosh_AGV/joints/caster_wheel_1_joint>,
        </Woosh_AGV/joints/caster_2_joint>,
        </Woosh_AGV/joints/caster_wheel_2_joint>,
        </Woosh_AGV/joints/caster_3_joint>,
        </Woosh_AGV/joints/caster_wheel_3_joint>,
        </Woosh_AGV/joints/caster_4_joint>,
        </Woosh_AGV/joints/caster_wheel_4_joint>,
        </Woosh_AGV/joints/left_wheel_joint>,
        </Woosh_AGV/joints/right_wheel_joint>,
    ]
    rel isaac:physics:robotLinks (
        displayName = "Robot Links"
    )
    prepend rel isaac:physics:robotLinks = [
        </Woosh_AGV/base_footprint>,
        </Woosh_AGV/caster_1_link>,
        </Woosh_AGV/caster_wheel_1_link>,
        </Woosh_AGV/caster_2_link>,
