            dictionary Perspective = {
                double3 position = (0.5979233620665069, 0.8761666046421297, 0.27834504477750877)
                double3 target = (0.024265257960828013, -0.7104306074861884, -0.0024753439593301896)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
