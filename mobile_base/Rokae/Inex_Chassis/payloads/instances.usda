#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "Shell_White" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/Shell_White>
            }

            over "white_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/white_metal>
            }

            over "green_light" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/green_light>
            }

            over "camera" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/camera>
            }

            over "face_black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/face_black>
            }

            over "metal_black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/metal_black>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "Shell_White" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Shell_White>
            )
            {
            }

            def Material "white_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white_metal>
            )
            {
            }

            def Material "green_light" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/green_light>
            )
            {
            }

            def Material "camera" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/camera>
            )
            {
            }

            def Material "face_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/face_black>
            )
            {
            }

            def Material "metal_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/metal_black>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh_1/VisualMaterials/silver>
        }

        def Scope "VisualMaterials"
        {
            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }
        }
    }

    def Xform "mesh_2" (
        prepend references = @./geometries.usd@</Geometries/mesh_2>
    )
    {
        over "mesh_2"
        {
            over "black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_2/VisualMaterials/black>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }
        }
    }
}

