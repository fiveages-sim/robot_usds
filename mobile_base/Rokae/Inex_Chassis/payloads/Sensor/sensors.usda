#usda 1.0
(
    defaultPrim = "Inex_Chassis"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Inex_Chassis"
{
    over "base_footprint"
    {
        over "base_link"
        {
            over "a_d_lidar_base"
            {
                over "a_d_lidar"
                {
                    def "mid360" (
                        prepend payload = @../../../../../sensors/mid360.usd@
                    )
                    {
                        quatf xformOp:orient = (1, 0, 0, 0)
                        double xformOp:rotateX:unitsResolve = 90
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                    }
                }
            }

            over "fr_lidar_link"
            {
                def "oradar_ms500" (
                    prepend payload = @../../../../../sensors/orbbec/oradar_ms500.usd@
                )
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    double xformOp:rotateX:unitsResolve = 90
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                }
            }

            over "rl_lidar_link"
            {
                def "oradar_ms500" (
                    prepend payload = @../../../../../sensors/orbbec/oradar_ms500.usd@
                )
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    double xformOp:rotateX:unitsResolve = 90
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                }
            }
        }
    }
}
