#usda 1.0
(
    defaultPrim = "S2_V2"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "S2_V2" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </S2_V2/joints/fl_steer_joint>,
        </S2_V2/joints/fl_wheel_joint>,
        </S2_V2/joints/fr_steer_joint>,
        </S2_V2/joints/fr_wheel_joint>,
        </S2_V2/joints/rl_steer_joint>,
        </S2_V2/joints/rl_wheel_joint>,
        </S2_V2/joints/rr_steer_joint>,
        </S2_V2/joints/rr_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </S2_V2/base_footprint>,
        </S2_V2/fl_steer>,
        </S2_V2/fl_wheel>,
        </S2_V2/fr_steer>,
        </S2_V2/fr_wheel>,
        </S2_V2/rl_steer>,
        </S2_V2/rl_wheel>,
        </S2_V2/rr_steer>,
        </S2_V2/rr_wheel>,
    ]

    over "base_footprint" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "fl_steer" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "joints"
    {
        over "fl_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "fl_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "fr_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "fr_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "rl_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "rl_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "rr_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "rr_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }
    }

    over "fl_wheel" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "fr_steer" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "fr_wheel" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "rl_steer" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "rl_wheel" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "rr_steer" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "rr_wheel" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }
}

