#usda 1.0
(
    defaultPrim = "S2_V2"
    metersPerUnit = 1
    upAxis = "Z"
)

def "S2_V2"
{
    over "base_footprint"
    {
        over "base_link"
        {
            def "shell_default" (
                prepend payload = @./shell_default.usd@
            )
            {
                quatf xformOp:orient = (6.123234e-17, 4.3297803e-17, -0.70710677, 0.70710677)
                double xformOp:rotateX:unitsResolve = 90
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]

                over "Looks"
                {
                    over "color"
                    {
                        over "color"
                        {
                            color3f inputs:base_color_factor = (0.007843138, 0.105882354, 0.6509804)
                        }
                    }

                    over "color_inner"
                    {
                        over "color_inner"
                        {
                            color3f inputs:base_color_factor = (0.007843138, 0.105882354, 0.6509804)
                        }
                    }
                }
            }

            over "chassis_base"
            {
                over "chassis_left_battery"
                {
                    over "battery"
                    {
                        over "Looks"
                        {
                            over "color_battery"
                            {
                                over "color_battery"
                                {
                                    color3f inputs:base_color_factor = (1, 0.9999926, 0.99999)
                                }
                            }
                        }
                    }
                }

                over "chassis_right_battery"
                {
                    over "battery"
                    {
                        over "Looks"
                        {
                            over "color_battery"
                            {
                                over "color_battery"
                                {
                                    color3f inputs:base_color_factor = (1, 0.99999255, 0.99999)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
