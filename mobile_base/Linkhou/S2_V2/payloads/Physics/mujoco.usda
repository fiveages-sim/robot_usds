#usda 1.0
(
    defaultPrim = "S2_V2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "S2_V2"
{
    over "joints"
    {
        over "fl_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -2000
            uniform double mjc:actuatorfrcrange:max = 2000
        }

        over "fl_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            # W2-scale wheel joint: damping+frictionloss hold when ctrl≈0
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 5
            uniform double mjc:frictionloss = 3
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -400
            uniform double mjc:actuatorfrcrange:max = 400
        }

        over "fr_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -2000
            uniform double mjc:actuatorfrcrange:max = 2000
        }

        over "fr_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            # W2-scale wheel joint: damping+frictionloss hold when ctrl≈0
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 5
            uniform double mjc:frictionloss = 3
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -400
            uniform double mjc:actuatorfrcrange:max = 400
        }

        over "rl_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -2000
            uniform double mjc:actuatorfrcrange:max = 2000
        }

        over "rl_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            # W2-scale wheel joint: damping+frictionloss hold when ctrl≈0
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 5
            uniform double mjc:frictionloss = 3
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -400
            uniform double mjc:actuatorfrcrange:max = 400
        }

        over "rr_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -2000
            uniform double mjc:actuatorfrcrange:max = 2000
        }

        over "rr_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            # W2-scale wheel joint: damping+frictionloss hold when ctrl≈0
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 5
            uniform double mjc:frictionloss = 3
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -400
            uniform double mjc:actuatorfrcrange:max = 400
        }
    }

    over "base_footprint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    def Scope "actuators"
    {
        def MjcActuator "fl_steer_joint"
        {
            # Position PD from PhysX kp=60000 kd=6000; force raised for W2+Newton
            # (PhysX maxForce=100 starved Ackermann steers → chassis spin).
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -2000
            uniform double mjc:forceRange:max = 2000
            uniform token mjc:ctrlLimited = "true"
            # Isaac ArticulationController uses radians (not USD degree limits)
            uniform double mjc:ctrlRange:min = -3.14159265
            uniform double mjc:ctrlRange:max = 3.14159265
            rel mjc:target = </S2_V2/joints/fl_steer_joint>
        }

        def MjcActuator "fl_wheel_joint"
        {
            # Velocity servo F=kd*(ctrl-qvel). kd=50/±400: track cmd_vel without overpowering grip.
                        uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [50, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -50, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -400
            uniform double mjc:forceRange:max = 400
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/fl_wheel_joint>
        }

        def MjcActuator "fr_steer_joint"
        {
            # Position PD from PhysX kp=60000 kd=6000; force raised for W2+Newton
            # (PhysX maxForce=100 starved Ackermann steers → chassis spin).
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -2000
            uniform double mjc:forceRange:max = 2000
            uniform token mjc:ctrlLimited = "true"
            # Isaac ArticulationController uses radians (not USD degree limits)
            uniform double mjc:ctrlRange:min = -3.14159265
            uniform double mjc:ctrlRange:max = 3.14159265
            rel mjc:target = </S2_V2/joints/fr_steer_joint>
        }

        def MjcActuator "fr_wheel_joint"
        {
            # Velocity servo F=kd*(ctrl-qvel). kd=50/±400: track cmd_vel without overpowering grip.
                        uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [50, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -50, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -400
            uniform double mjc:forceRange:max = 400
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/fr_wheel_joint>
        }

        def MjcActuator "rl_steer_joint"
        {
            # Position PD from PhysX kp=60000 kd=6000; force raised for W2+Newton
            # (PhysX maxForce=100 starved Ackermann steers → chassis spin).
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -2000
            uniform double mjc:forceRange:max = 2000
            uniform token mjc:ctrlLimited = "true"
            # Isaac ArticulationController uses radians (not USD degree limits)
            uniform double mjc:ctrlRange:min = -3.14159265
            uniform double mjc:ctrlRange:max = 3.14159265
            rel mjc:target = </S2_V2/joints/rl_steer_joint>
        }

        def MjcActuator "rl_wheel_joint"
        {
            # Velocity servo F=kd*(ctrl-qvel). kd=50/±400: track cmd_vel without overpowering grip.
                        uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [50, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -50, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -400
            uniform double mjc:forceRange:max = 400
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/rl_wheel_joint>
        }

        def MjcActuator "rr_steer_joint"
        {
            # Position PD from PhysX kp=60000 kd=6000; force raised for W2+Newton
            # (PhysX maxForce=100 starved Ackermann steers → chassis spin).
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -2000
            uniform double mjc:forceRange:max = 2000
            uniform token mjc:ctrlLimited = "true"
            # Isaac ArticulationController uses radians (not USD degree limits)
            uniform double mjc:ctrlRange:min = -3.14159265
            uniform double mjc:ctrlRange:max = 3.14159265
            rel mjc:target = </S2_V2/joints/rr_steer_joint>
        }

        def MjcActuator "rr_wheel_joint"
        {
            # Velocity servo F=kd*(ctrl-qvel). kd=50/±400: track cmd_vel without overpowering grip.
                        uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [50, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -50, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -400
            uniform double mjc:forceRange:max = 400
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/rr_wheel_joint>
        }
    }








    # Wheel–ground (Newton): W2~5x Lift2S mass — Lift2S has NO authored friction;
    # grip comes from defaults + light base. S2 needs high mu + stiff contact.
    over "fl_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.0
                    float physics:dynamicFriction = 2.7
                    float physics:restitution = 0
                    float newton:contactStiffness = 100000
                    float newton:contactDamping = 2000
                    float newton:contactFrictionGain = 10000
                }
            }
        }
    }

    # Wheel–ground (Newton): W2~5x Lift2S mass — Lift2S has NO authored friction;
    # grip comes from defaults + light base. S2 needs high mu + stiff contact.
    over "fr_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.0
                    float physics:dynamicFriction = 2.7
                    float physics:restitution = 0
                    float newton:contactStiffness = 100000
                    float newton:contactDamping = 2000
                    float newton:contactFrictionGain = 10000
                }
            }
        }
    }

    # Wheel–ground (Newton): W2~5x Lift2S mass — Lift2S has NO authored friction;
    # grip comes from defaults + light base. S2 needs high mu + stiff contact.
    over "rl_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.0
                    float physics:dynamicFriction = 2.7
                    float physics:restitution = 0
                    float newton:contactStiffness = 100000
                    float newton:contactDamping = 2000
                    float newton:contactFrictionGain = 10000
                }
            }
        }
    }

    # Wheel–ground (Newton): W2~5x Lift2S mass — Lift2S has NO authored friction;
    # grip comes from defaults + light base. S2 needs high mu + stiff contact.
    over "rr_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.0
                    float physics:dynamicFriction = 2.7
                    float physics:restitution = 0
                    float newton:contactStiffness = 100000
                    float newton:contactDamping = 2000
                    float newton:contactFrictionGain = 10000
                }
            }
        }
    }

}
