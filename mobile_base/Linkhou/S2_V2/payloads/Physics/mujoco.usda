#usda 1.0
(
    defaultPrim = "S2_V2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

# W2 Newton chassis (pass after R1_Lite success):
# Ice-skate + non-spinning wheels under whole-robot mass → raise grip + wheel torque.
# Steer stays R1-stable (625/80); do NOT use PhysX kp=60000.

def "S2_V2"
{
    over "joints"
    {
        over "fl_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 1.0
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -200
            uniform double mjc:actuatorfrcrange:max = 200
        }

        over "fl_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.03
            uniform double mjc:damping = 0.5
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -1000
            uniform double mjc:actuatorfrcrange:max = 1000
        }

        over "fr_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 1.0
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -200
            uniform double mjc:actuatorfrcrange:max = 200
        }

        over "fr_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.03
            uniform double mjc:damping = 0.5
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -1000
            uniform double mjc:actuatorfrcrange:max = 1000
        }

        over "rl_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 1.0
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -200
            uniform double mjc:actuatorfrcrange:max = 200
        }

        over "rl_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.03
            uniform double mjc:damping = 0.5
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -1000
            uniform double mjc:actuatorfrcrange:max = 1000
        }

        over "rr_steer_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 1.0
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -200
            uniform double mjc:actuatorfrcrange:max = 200
        }

        over "rr_wheel_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.03
            uniform double mjc:damping = 0.5
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -1000
            uniform double mjc:actuatorfrcrange:max = 1000
        }
    }

    over "base_footprint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    def Scope "actuators"
    {
        def MjcActuator "fl_steer_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [625, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -625, -80, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -200
            uniform double mjc:forceRange:max = 200
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -3.141592653589793
            uniform double mjc:ctrlRange:max = 3.141592653589793
            rel mjc:target = </S2_V2/joints/fl_steer_joint>
        }

        # W2 heavier than R1_Lite: kd=100 / ±1000 (was 50/500 → ice + no roll)
        def MjcActuator "fl_wheel_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -100, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -1000
            uniform double mjc:forceRange:max = 1000
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/fl_wheel_joint>
        }

        def MjcActuator "fr_steer_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [625, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -625, -80, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -200
            uniform double mjc:forceRange:max = 200
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -3.141592653589793
            uniform double mjc:ctrlRange:max = 3.141592653589793
            rel mjc:target = </S2_V2/joints/fr_steer_joint>
        }

        def MjcActuator "fr_wheel_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -100, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -1000
            uniform double mjc:forceRange:max = 1000
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/fr_wheel_joint>
        }

        def MjcActuator "rl_steer_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [625, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -625, -80, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -200
            uniform double mjc:forceRange:max = 200
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -3.141592653589793
            uniform double mjc:ctrlRange:max = 3.141592653589793
            rel mjc:target = </S2_V2/joints/rl_steer_joint>
        }

        def MjcActuator "rl_wheel_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -100, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -1000
            uniform double mjc:forceRange:max = 1000
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/rl_wheel_joint>
        }

        def MjcActuator "rr_steer_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [625, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -625, -80, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -200
            uniform double mjc:forceRange:max = 200
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -3.141592653589793
            uniform double mjc:ctrlRange:max = 3.141592653589793
            rel mjc:target = </S2_V2/joints/rr_steer_joint>
        }

        def MjcActuator "rr_wheel_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -100, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -1000
            uniform double mjc:forceRange:max = 1000
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </S2_V2/joints/rr_wheel_joint>
        }
    }

    # Grip for whole-robot mass: μ≈3.5 (1.2 iced W2; 5+ke8e4 jumped). Soft ke, no rolling lock.
    over "fl_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.5
                    float physics:dynamicFriction = 3.2
                    float physics:restitution = 0
                    float newton:rollingFriction = 0
                    float newton:torsionalFriction = 0.001
                    float newton:contactStiffness = 45000
                    float newton:contactDamping = 1500
                    float newton:contactFrictionGain = 15000
                }
            }
        }
    }

    over "fr_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.5
                    float physics:dynamicFriction = 3.2
                    float physics:restitution = 0
                    float newton:rollingFriction = 0
                    float newton:torsionalFriction = 0.001
                    float newton:contactStiffness = 45000
                    float newton:contactDamping = 1500
                    float newton:contactFrictionGain = 15000
                }
            }
        }
    }

    over "rl_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.5
                    float physics:dynamicFriction = 3.2
                    float physics:restitution = 0
                    float newton:rollingFriction = 0
                    float newton:torsionalFriction = 0.001
                    float newton:contactStiffness = 45000
                    float newton:contactDamping = 1500
                    float newton:contactFrictionGain = 15000
                }
            }
        }
    }

    over "rr_wheel"
    {
        over "collisions"
        {
            over "mesh_0"
            {
                over "cylinder" (
                    prepend apiSchemas = ["NewtonMaterialAPI", "NewtonCollisionAPI"]
                )
                {
                    uniform int mjc:condim = 3
                    float physics:staticFriction = 3.5
                    float physics:dynamicFriction = 3.2
                    float physics:restitution = 0
                    float newton:rollingFriction = 0
                    float newton:torsionalFriction = 0.001
                    float newton:contactStiffness = 45000
                    float newton:contactDamping = 1500
                    float newton:contactFrictionGain = 15000
                }
            }
        }
    }

}
