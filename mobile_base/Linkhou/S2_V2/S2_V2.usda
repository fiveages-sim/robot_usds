def Xform "S2_V2" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Battery = "default"
        string Physics = "physx"
        string ROS = "none"
        string Robot = "none"
        string Sensor = "sensors"
        string Visual = "default"
    }
    prepend variantSets = ["Physics", "Visual", "Battery", "ROS"]
    append variantSets = ["Robot", "Sensor"]
)
