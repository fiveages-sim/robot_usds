                }
            }

            over "ultrasonic_c5"
            {
                def "ultrasonic_02" (
                    prepend payload = @../../../../../sensors/ultrasonic_02.usd@
                )
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
