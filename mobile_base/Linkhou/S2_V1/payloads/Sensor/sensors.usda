def Xform "Linkhou_S2_V1" (
    variants = {
        string Sensor = "none"
    }
)
{
    over "base_footprint"
    {
        over "base_link"
        {
            over "chassis_base"
            {
                over "fl_lidar"
                {
                    def "robosense_airy" (
                        prepend payload = @../../../../../sensors/robosense_airy.usd@
                    )
                    {
                        quatf xformOp:orient = (0.5, -0.5, -0.5, -0.5)
                        double xformOp:rotateX:unitsResolve = 90
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                    }
                }

                over "rr_lidar"
                {
                    def "robosense_airy" (
                        prepend payload = @../../../../../sensors/robosense_airy.usd@
                    )
                    {
                        quatf xformOp:orient = (0.5, -0.5, -0.5, -0.5)
                        double xformOp:rotateX:unitsResolve = 90
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
