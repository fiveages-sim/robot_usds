                    }
                }

                over "chassis_camera"
                {
                    def "linkhou_ds51" (
                        prepend payload = @../../../../../sensors/linkhou_ds51.usd@
                    )
                    {
                        quatf xformOp:orient = (0.5, 0.5, -0.5, 0.5)
