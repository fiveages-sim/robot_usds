#usda 1.0
(
    defaultPrim = "Linkhou_S2_V1"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Linkhou_S2_V1"
{
    over "base_footprint"
    {
        over "base_link"
        {
            def "shell" (
                prepend payload = @./shell.usd@
            )
            {
                quatf xformOp:orient = (1, 0, 0, 0)
                double xformOp:rotateX:unitsResolve = 90
                float3 xformOp:scale = (1, 1, 1)
                double3 xformOp:scale:unitsResolve = (0.01, 0.01, 0.01)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]

                over "Looks"
                {
                    over "color"
                    {
                        over "color"
                        {
                            color3f inputs:base_color_factor = (0.8, 0.8, 0.8)
                        }
                    }

                    over "color_inner"
                    {
                        over "color_inner"
                        {
                            color3f inputs:base_color_factor = (0.8, 0.8, 0.8)
                        }
                    }
                }
            }

            over "chassis_base"
            {
                over "chassis_left_battery"
                {
                    def "battery" (
                        prepend payload = @../Battery/battery.usd@
                    )
                    {
                        quatf xformOp:orient = (1, 0, 0, 0)
                        double xformOp:rotateX:unitsResolve = 90
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]

                        over "Looks"
                        {
                            over "color_battery"
                            {
                                over "color_battery"
                                {
                                    color3f inputs:base_color_factor = (0.8, 0.8, 0.8)
                                }
                            }
                        }
                    }
                }

                over "chassis_right_battery"
                {
                    def "battery" (
                        prepend payload = @../Battery/battery.usd@
                    )
                    {
                        quatf xformOp:orient = (1, 0, 0, 0)
                        double xformOp:rotateX:unitsResolve = 90
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]

                        over "Looks"
                        {
                            over "color_battery"
                            {
                                over "color_battery"
                                {
                                    color3f inputs:base_color_factor = (0.8, 0.8, 0.8)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
