#usda 1.0
(
    defaultPrim = "Q1"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Q1"
{
    over "base_footprint"
    {
        over "visuals"
        {
            over "base" (
                instanceable = false
            )
            {
                over "VisualMaterials"
                {
                    over "silver" (
                        instanceable = false
                    )
                    {
                        over "silver"
                        {
                            color3f inputs:base_color_factor = (0.886275, 0.886275, 0.886275)
                            float inputs:metallic_factor = 0.33
                        }
                    }

                    over "logo" (
                        instanceable = false
                    )
                    {
                        over "logo"
                        {
                            color3f inputs:base_color_factor = (0.886275, 0.886275, 0.886275)
                            float inputs:metallic_factor = 0.33
                        }
                    }
                }
            }
        }
    }
}
