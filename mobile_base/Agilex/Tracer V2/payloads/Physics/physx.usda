#usda 1.0
(
    defaultPrim = "Tracer_V2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Tracer_V2" (
    prepend apiSchemas = ["PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 0
    int physxArticulation:solverPositionIterationCount = 32
    int physxArticulation:solverVelocityIterationCount = 1

    over "joints"
    {
        over "left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = inf
        }

        over "right_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = inf
        }

        over "left_front_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "left_front_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "left_rear_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "left_rear_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "right_front_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "right_front_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "right_rear_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "right_rear_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 100
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }
    }
}
