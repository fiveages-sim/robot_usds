def PhysicsScene "PhysicsScene" (
    delete apiSchemas = ["MjcSceneAPI", "NewtonXpbdSceneAPI", "PhysxSceneAPI"]
    prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI", "MjcSceneAPI", "MaterialBindingAPI"]
)
{
    rel material:binding:physics = </World/CR5/AG2F90/right_up_link/right_Pad_link/pad_link/Looks/PhysicsMaterial> (
        bindMaterialAs = "weakerThanDescendants"
    )
    uniform token mjc:option:cone = "elliptic"
    uniform token mjc:option:integrator = "implicit"
    uniform int newton:maxSolverIterations = 100
}

