        }
        dictionary omni_layer = {
            string authoring_layer = "./Elite_EC66.usd"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Elite_EC66"
    endTimeCode = 0
    metersPerUnit = 1
    startTimeCode = -1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
