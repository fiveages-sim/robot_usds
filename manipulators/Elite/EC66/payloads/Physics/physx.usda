#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (-0.39722329705977893, -0.3414313121664593, 1.3708757411489505)
                double3 target = (0.879688503585156, 0.8249715458927805, 0.2614092831085937)
