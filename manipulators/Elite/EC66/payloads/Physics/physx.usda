def "Elite_EC66"
{
    over "joints"
    {
        over "joint1" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxDrivePerformanceEnvelopeAPI:angular"]
        )
        {
            float physxDrivePerformanceEnvelope:angular:maxActuatorVelocity = 180
            float physxJoint:maxJointVelocity = 150.1092
        }

        over "joint2" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxDrivePerformanceEnvelopeAPI:angular"]
        )
        {
            float physxDrivePerformanceEnvelope:angular:maxActuatorVelocity = 180
            float physxJoint:maxJointVelocity = 150.1092
        }

        over "joint3" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxDrivePerformanceEnvelopeAPI:angular"]
        )
        {
            float physxDrivePerformanceEnvelope:angular:maxActuatorVelocity = 180
            float physxJoint:maxJointVelocity = 189.99852
        }

        over "joint4" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxDrivePerformanceEnvelopeAPI:angular"]
        )
        {
            float physxDrivePerformanceEnvelope:angular:maxActuatorVelocity = 180
            float physxJoint:maxJointVelocity = 260.0025
        }

        over "joint5" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxDrivePerformanceEnvelopeAPI:angular"]
        )
        {
            float physxDrivePerformanceEnvelope:angular:maxActuatorVelocity = 180
            float physxJoint:maxJointVelocity = 260.0025
        }

        over "joint6" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxDrivePerformanceEnvelopeAPI:angular"]
        )
        {
            float physxDrivePerformanceEnvelope:angular:maxActuatorVelocity = 180
            float physxJoint:maxJointVelocity = 260.0025
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}

