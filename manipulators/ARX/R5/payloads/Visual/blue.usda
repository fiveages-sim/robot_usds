#usda 1.0
(
    defaultPrim = "R5"
    metersPerUnit = 1
    upAxis = "Z"
)

def "R5"
{
    over "link3"
    {
        over "visuals"
        {
            over "link3" (
                delete references = @../instances.usda@</Instances/mesh_3>
                prepend references = @./instances/blue.usda@</Instances/mesh_3>
            )
            {
            }
        }
    }
}
