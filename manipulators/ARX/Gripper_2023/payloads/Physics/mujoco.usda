#usda 1.0
(
    defaultPrim = "Gripper_2023"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Gripper_2023"
{
    over "joints"
    {
        # PhysX DriveAPI (kp=100, kd=10, maxForce=10) -> MjcActuator position PD
        over "gripper_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.5
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -10
            uniform double mjc:actuatorfrcrange:max = 10
        }

        # PhysX mimic gearing=-1; Newton often needs coef1=+1 (same as Galaxea_G1).
        over "joint8" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysxMimicJointAPI:rotY"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.5
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1
            rel newton:mimicJoint = </Gripper_2023/joints/gripper_joint>
        }

        over "left_gripper_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.5
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -10
            uniform double mjc:actuatorfrcrange:max = 10
        }

        over "left_joint8" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysxMimicJointAPI:rotY", "PhysxJointAPI"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.5
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1
            rel newton:mimicJoint = </Gripper_2023/joints/left_gripper_joint>
        }

        over "right_gripper_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.5
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -10
            uniform double mjc:actuatorfrcrange:max = 10
        }

        over "right_joint8" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysxMimicJointAPI:rotY", "PhysxJointAPI"]
        )
        {
            uniform double mjc:armature = 0.005
            uniform double mjc:damping = 0.5
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1
            rel newton:mimicJoint = </Gripper_2023/joints/right_gripper_joint>
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    def Scope "actuators"
    {
        def MjcActuator "gripper_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -100, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -10
            uniform double mjc:forceRange:max = 10
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0
            uniform double mjc:ctrlRange:max = 0.044
            rel mjc:target = </Gripper_2023/joints/gripper_joint>
        }
    }
}
