#usda 1.0
(
    defaultPrim = "Gripper_2025"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

# PhysX gripper for OCS2 AdaptiveGripperController.
# Mimic/drive shape matches ARX_Lift2S left_physic.usd (gearing=-1, stiff PD,
# hard NF=0). Open has no force check so it already works; close enables
# adaptive force feedback (force_threshold=0.5 in ros2_controllers.yaml).
# PhysX publishes projected drive effort capped by maxForce — with maxForce=20
# close aborts on the first step. Cap maxForce below the threshold and allow
# the full gearing=-1 stroke on joint8 so free-space close can finish.
# Do not edit mujoco.usda.

def "Gripper_2025"
{
    prepend rel isaac:physics:robotJoints = [
        </Gripper_2025/joints/left_gripper_joint>,
        </Gripper_2025/joints/right_gripper_joint>,
        </Gripper_2025/joints/left_joint8>,
        </Gripper_2025/joints/right_joint8>,
    ]

    over "joints"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 6000
            float drive:linear:physics:maxForce = 0.4
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.044
            float physxJoint:maxJointVelocity = 5
        }

        over "joint8" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            # Full ±0.044 range so gearing=-1 is valid at open (leader=0.044 →
            # follower=-0.044) and does not pin on the old -0.0088 limit.
            float physics:lowerLimit = -0.044
            float physics:upperLimit = 0.044
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Gripper_2025/joints/gripper_joint>
        }

        over "left_gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 6000
            float drive:linear:physics:maxForce = 0.4
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.044
            float physxJoint:maxJointVelocity = 5
        }

        over "left_joint8" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physics:lowerLimit = -0.044
            float physics:upperLimit = 0.044
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Gripper_2025/joints/left_gripper_joint>
        }

        over "right_gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 6000
            float drive:linear:physics:maxForce = 0.4
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.044
            float physxJoint:maxJointVelocity = 5
        }

        over "right_joint8" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physics:lowerLimit = -0.044
            float physics:upperLimit = 0.044
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Gripper_2025/joints/right_gripper_joint>
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}
