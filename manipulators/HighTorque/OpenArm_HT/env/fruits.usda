#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (-0.2, 1.4, 1.4)
                double3 target = (-0.7, 0.0, 0.7)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./fruits.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "fruits" (
        prepend payload = @../../../../../environment/fiveages_env/tasks/table_optical/fruits.usda@
    )
    {
        # Optical table top is at z≈0.80 (AABB). Keep fruits near the -X edge
        # so the floor-standing dual-arm can reach them from beside the table.
        over "lime" (
            active = true
        )
        {
            double3 xformOp:translate = (-0.55, 0.08, 0.83)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        over "apple" (
            active = true
        )
        {
            double3 xformOp:translate = (-0.55, -0.08, 0.85)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "Geometry"
            {
                over "model_normalized_0_vis_obj" (
                    prepend apiSchemas = ["PhysxRigidBodyAPI"]
                )
                {
                    over "model_normalized_0_vis_mesh"
                    {
                        over "model_normalized_0_vis_mesh" (
                            prepend apiSchemas = ["PhysxSDFMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
                        )
                        {
                            uniform token physics:approximation = "sdf"
                        }
                    }
                }
            }
        }

        over "empty" (
            variants = {
                string ROS_Camera = "enable"
            }
        )
        {
        }

        over "shelf"
        {
            quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.25, -0.3514014829647969, 0.9316625759687558)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]

            over "shelf8" (
                delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
            )
            {
            }
        }
    }

    # Floor-standing dual-arm. Optical table spans X≈[-0.75, 0.75], Z top≈0.80.
    # Base must sit beside the table (not under the slab). Shoulders ≈0.7 m.
    def "OpenArm_HT" (
        prepend payload = @../OpenArm_HT.usda@
        variants = {
            string Physics = "physx"
            string ROS = "enable"
            string Robot = "none"
            string Sensor = "none"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-1.05, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        # Payload nests under /World/OpenArm_HT — retarget ROS graph prims.
        over "Graph"
        {
            over "ROS_JointStates"
            {
                over "isaac_read_joint_state_node"
                {
                    custom rel inputs:prim = </World/OpenArm_HT/world>
                }

                over "ArticulationController"
                {
                    custom rel inputs:targetPrim = </World/OpenArm_HT/world>
                }
            }
        }
    }
}

def Xform "Environment"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:angle = 1
        float inputs:exposure = 1.5
        float inputs:intensity = 3000
        bool inputs:normalize = 1
        float inputs:shaping:cone:angle = 180
        custom int omni:rtx:usdluxVersion = 2505
        quatd xformOp:orient = (0.6532814824381883, 0.2705980500730985, 0.27059805007309845, 0.6532814824381882)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

over "OmniverseKit_Persp" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    customData = {
        dictionary omni = {
            dictionary kit = {
                bool hide_in_stage_window = 1
                bool no_delete = 1
            }
        }
    }
    hide_in_stage_window = true
    kind = "component"
    no_delete = true
)
{
    float2 clippingRange = (0.01, 10000000)
    float exposure:fStop = 5
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
    float focalLength = 18.147562
    float focusDistance = 400
    custom uniform vector3d omni:kit:centerOfInterest = (-0.7, 0, -0.8)
    float3 xformOp:rotateXYZ = (55, 0, 160)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (-0.2, 1.4, 1.4)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI"]
)
{
}
