def Xform "World"
{
    def "fruits" (
        prepend payload = @../../../../../environment/fiveages_env/tasks/table_optical/fruits.usda@
    )
    {
        over "empty"
        {
            token visibility = "inherited"

            over "Graph"
            {
                over "ROS_Camera"
                {
                    over "RGBPublish"
                    {
                        custom token inputs:type (
                            allowedTokens = ["rgb", "rgb_h264", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "rgb_hevc"]
                        )
                    }

                    over "DepthPublish"
                    {
                        custom token inputs:type (
                            allowedTokens = ["rgb", "rgb_h264", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "rgb_hevc"]
                        )
                    }
                }
            }

            over "global_camera" (
                prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
            )
            {
                float exposure:fStop = 5
                float exposure:responsivity = 1.1026709
                float exposure:time = 0.02
            }
        }

        over "shelf"
        {
            quatf xformOp:orient = (0.5, 0.5, 0.5, 0.5)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.000053298975678600646, -0.04079685253920842, 0.9316625759687558)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]

            over "visual"
            {
                over "mesh"
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (-3.642919299551295e-15, 1.7763568394002505e-15, 0.03793202592057249)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }

        over "apple" (
            prepend payload = @../../../../../environment/fiveages_env/moveable/fruits/apple.usd@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.013986975408212254, -0.026617575229058485, 1.1000629434399471)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "apple" (
                active = false
            )
            {
                over "apple"
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0.21885446541189907, -0.65080866688125, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }

        over "lime" (
            active = false
        )
        {
            token visibility = "invisible"

            over "Grasp"
            {
                over "grasp_identifier"
                {
                    over "grasp_identifier_curve" (
                        delete apiSchemas = ["OmniSceneVisualizationAPI"]
                    )
                    {
                    }
                }
            }
        }

        def "banana" (
            prepend payload = @../../../../../environment/fiveages_env/moveable/fruits/banana.usd@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, -0.17357198835609558, 1.0879694715924613)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "banana"
            {
                over "banana"
                {
                    double3 xformOp:rotateZYX = (0, 0, 0)
                    double3 xformOp:scale = (0.3, 0.3, 0.3)
                    double3 xformOp:translate = (0.01852201883068254, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]
                }
            }
        }

        def "pear" (
            prepend payload = @../../../../../environment/fiveages_env/moveable/fruits/pear.usd@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.1, 0.1, 0.1)
            double3 xformOp:translate = (0.01399, 0.0887026501326698, 1.10006)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "pear"
            {
                over "pear"
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0.03401237171715621, 0.5488867524336268, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }
    }

    def "OpenArm_HT" (
        prepend payload = @../OpenArm_HT.usda@
        variants = {
            string ROS = "enable"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
