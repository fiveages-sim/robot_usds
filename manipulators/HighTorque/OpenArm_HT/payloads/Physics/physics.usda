{
    over "world" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        point3f physics:centerOfMass = (0.000011884581, 0, 0.15568368)
        float3 physics:diagonalInertia = (1.0515324, 1.0426145, 0.14538191)
