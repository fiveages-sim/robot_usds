#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh/VisualMaterials/jiegou>
        }

        def Scope "VisualMaterials"
        {
            def Material "jiegou" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/jiegou>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1"
        {
            over "jiegou_013" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/jiegou>
            }

            over "dianji_012" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/dianji_012>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "jiegou" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/jiegou>
            )
            {
            }

            def Material "dianji_012" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dianji_012>
            )
            {
            }
        }
    }

