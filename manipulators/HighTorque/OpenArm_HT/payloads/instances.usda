            token physics:approximation = "convexHull"
            uniform token purpose = "guide"
        }

        def Scope "VisualMaterials"
        {
            def Material "DefaultMaterial" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/DefaultMaterial>
            )
