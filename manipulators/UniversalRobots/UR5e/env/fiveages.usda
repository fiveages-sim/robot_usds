#usda 1.0
(
    defaultPrim = "World"
    doc = "Minimal UR5e scene for in-process ros2_control (ROS=fiveages, Physics=physx, EE=robotiq85)."
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.6, 0.6, 1.4)
                double3 target = (0.0, 0.0, 0.4)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./fiveages.usda"
        }
    }
)

def Xform "World"
{
    def "UR5e" (
        prepend references = @../UR5e.usda@
        variants = {
            string EE = "robotiq85"
            string Gripper = "none"
            string Physics = "physx"
            string ROS = "fiveages"
            string Robot = "none"
            string Sensor = "none"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Graph"
        {
            over "ROS_Control"
            {
                over "ROS2ControlLaunch"
                {
                    custom token inputs:mode (
                        allowedTokens = ["demo", "split_body", "full_body"]
                    )
                    custom rel inputs:targetPrim = </World/UR5e/root_joint>
                    custom bool state:configured
                }
            }
        }
    }

    def "default_environment" (
        prepend payload = @../../../../../environment/fiveages_env/background/Grid/default_environment.usd@
    )
    {
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI", "PhysxSceneAPI"]
)
{
}
