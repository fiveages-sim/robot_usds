#usda 1.0
(
    defaultPrim = "Gripper_2025"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

# PhysX gripper tuning matched to working ARX_Lift2S (ARX_Lift2S.usd /
# left_physic.usd): stiff force drive + PhysxMimic gearing=-1 on joint8.
# Do not use gearing=+1 here — joint8 localRot is already flipped; +1 leaves
# link8 unmoved / fights the leader. Newton/MJC keep their own coef in mujoco.

def "Gripper_2025"
{
    over "joints"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 6000
            float drive:linear:physics:maxForce = 20
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            float physxJoint:maxJointVelocity = 5
        }

        over "joint8" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physics:lowerLimit = -0.0088
            float physics:upperLimit = 0.0528
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Gripper_2025/joints/gripper_joint>
        }

        over "left_gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 6000
            float drive:linear:physics:maxForce = 20
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            float physxJoint:maxJointVelocity = 5
        }

        over "left_joint8" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physics:lowerLimit = -0.0088
            float physics:upperLimit = 0.0528
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Gripper_2025/joints/left_gripper_joint>
        }

        over "right_gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 6000
            float drive:linear:physics:maxForce = 20
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            float physxJoint:maxJointVelocity = 5
        }

        over "right_joint8" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotY"]
        )
        {
            float physics:lowerLimit = -0.0088
            float physics:upperLimit = 0.0528
            float physxMimicJoint:rotY:dampingRatio = 0
            float physxMimicJoint:rotY:gearing = -1
            float physxMimicJoint:rotY:naturalFrequency = 0
            float physxMimicJoint:rotY:offset = 0
            rel physxMimicJoint:rotY:referenceJoint = </Gripper_2025/joints/right_gripper_joint>
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}
