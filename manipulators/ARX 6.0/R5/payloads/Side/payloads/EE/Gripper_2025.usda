def Xform "R5"
{
    def "Gripper_2025" (
        prepend payload = @../../../../../Gripper_2025/Gripper_2025.usda@
        variants = {
            string Side = "left"
        }
    )
    {
        quatd xformOp:orient = (0.9999697482770888, -0.007772549307966229, -0.0003000128408086994, -4.5404574853402103e-7)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.09649718552827835, 6.657901394646615e-7, 0.16357509791851044)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "root_joint" (
            active = false
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
        }

        over "gripper_base"
        {
            vector3f physics:angularVelocity = (0, 0, 0)
            vector3f physics:velocity = (0, 0, 0)
            quatd xformOp:orient = (0.9999855025176336, 0.0053843191568792555, -0.00002716628555732547, 0.00005589065699807165)
            double3 xformOp:translate = (-8.08802224666616e-7, 0.000012556297534106666, 0.000005635274000742596)

            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </R5/ee>
                rel physics:body1 = </R5/Gripper_2025/gripper_base>
                point3f physics:localPos0 = (1.9428903e-16, -4.6642377e-15, -1.9428903e-16)
                point3f physics:localPos1 = (3.8857806e-16, -9.328909e-15, -3.8857806e-16)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "link7"
        {
            vector3f physics:angularVelocity = (0, 0, 0)
            vector3f physics:velocity = (0, 0, 0)
            quatd xformOp:orient = (0.999985502470943, 0.005384327823434455, -0.000027167294245079273, 0.000055890639730333325)
            double3 xformOp:translate = (0.08396649451361533, 0.027296714201034123, -0.00596658917715609)
        }

        over "link8"
        {
            vector3f physics:angularVelocity = (0, 0, 0)
            vector3f physics:velocity = (0, 0, 0)
            quatd xformOp:orient = (0.9999855024132058, 0.0053843383108667245, -0.000027144621691908958, 0.00005592434143761113)
            double3 xformOp:translate = (0.08397218615686135, -0.02354655937858882, -0.0065142438222364485)
        }

        over "joints"
        {
            over "left_gripper_joint"
            {
                float state:linear:physics:position = -0.0000011404235
                float state:linear:physics:velocity = 0
            }

            over "left_joint8"
            {
                float state:linear:physics:position = -6.274944e-7
                float state:linear:physics:velocity = 0
            }
        }
    }

    over "joints"
    {
        over "left_joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint5"
        {
