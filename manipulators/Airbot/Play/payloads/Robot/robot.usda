#usda 1.0
(
    defaultPrim = "Airbot_Play"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Airbot_Play" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    token isaac:robotType = "Manipulator"
    prepend rel isaac:physics:robotJoints = [
        </Airbot_Play/joints/root_joint>,
        </Airbot_Play/joints/joint1>,
        </Airbot_Play/joints/joint2>,
        </Airbot_Play/joints/joint3>,
        </Airbot_Play/joints/joint4>,
        </Airbot_Play/joints/joint5>,
        </Airbot_Play/joints/joint6>
    ]
    prepend rel isaac:physics:robotLinks = [
        </Airbot_Play/base_link>,
        </Airbot_Play/link1>,
        </Airbot_Play/link2>,
        </Airbot_Play/link3>,
        </Airbot_Play/link4>,
        </Airbot_Play/link5>,
        </Airbot_Play/link6>
    ]
}
