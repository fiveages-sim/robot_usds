#usda 1.0
(
    defaultPrim = "Materials"
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "black"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/black/black.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/black/black.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/black/black.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "black" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            color3f inputs:base_color_factor = (0.011764706, 0.011764706, 0.011764706)
            float inputs:base_alpha = 1
            float inputs:metallic_factor = 0.0
            float inputs:roughness_factor = 0.5
            float inputs:emissive_strength = 0
            color3f inputs:emissive_factor = (0, 0, 0)
            int inputs:alpha_mode = 0
            float inputs:alpha_cutoff = 0
            token outputs:out
        }
    }

    def Material "white"
