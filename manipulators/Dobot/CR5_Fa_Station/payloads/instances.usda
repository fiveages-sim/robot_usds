def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "tdrb0000000" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_metal>
            }

            over "tdrb00000001" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/white>
            }

            over "tdrb00000002" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_metal>
            }

            over "tdrb00000003" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/silver>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "black_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_metal>
            )
            {
            }

            def Material "white" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white>
            )
            {
            }

            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "tdrb0000000" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/black_metal>
            }

            over "tdrb00000001" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/white>
            }

            over "tdrb00000002" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/black_metal>
            }

            over "tdrb00000003" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/silver>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "black_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_metal>
            )
            {
            }

            def Material "white" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white>
            )
            {
            }

            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }
        }
    }
}

