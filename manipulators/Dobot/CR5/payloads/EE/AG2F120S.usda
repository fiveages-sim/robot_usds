#usda 1.0
(
    defaultPrim = "CR5"
    doc = """Seamless EE mount for ChangingTek AG2F120S under /CR5/Link6/tcp/EE.
CR5 tcp carries the flange +90deg Z; mount adds Z=-90deg plus flange→gripper_base
offset 0.0258 m along tcp Z (AG2F120S flange→gripper_base).
"""
)

def Xform "CR5"
{
    over "Link6"
    {
        over "tcp"
        {
            def "EE" (
                prepend payload = @../../../../../grippers/ChangingTek/AG2F120S/AG2F120S.usda@
                variants = {
                    string Flange = "default"
                    string Side = "default"
                }
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0, -0.7071067811865475)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.0258)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </CR5/Link6/tcp>
                        rel physics:body1 = </CR5/Link6/tcp/EE/gripper_base>
                        point3f physics:localPos0 = (0, 0, 0.0258)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "gripper_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_support_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_2_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_1_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_support_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_2_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }
                }
            }
        }
    }

    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}
