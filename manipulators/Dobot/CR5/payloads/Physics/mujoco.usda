#usda 1.0
(
    defaultPrim = "CR5"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "CR5"
{
    over "joints"
    {
        # PhysX DriveAPI (kp=60000, kd=6000, maxForce=100) -> MjcActuator position PD
        # F = kp*(ctrl - q) - kd*qdot
        over "joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint5" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint6" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    over "Link1"
    {
        uniform float mjc:gravcomp = 1
    }

    over "Link2"
    {
        uniform float mjc:gravcomp = 1
    }

    over "Link3"
    {
        uniform float mjc:gravcomp = 1
    }

    over "Link4"
    {
        uniform float mjc:gravcomp = 1
    }

    over "Link5"
    {
        uniform float mjc:gravcomp = 1
    }

    over "Link6"
    {
        uniform float mjc:gravcomp = 1
    }

    def Scope "actuators"
    {
        def MjcActuator "joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -360
            uniform double mjc:ctrlRange:max = 360
            rel mjc:target = </CR5/joints/joint1>
        }

        def MjcActuator "joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -360
            uniform double mjc:ctrlRange:max = 360
            rel mjc:target = </CR5/joints/joint2>
        }

        def MjcActuator "joint3"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -159.99846
            uniform double mjc:ctrlRange:max = 159.99846
            rel mjc:target = </CR5/joints/joint3>
        }

        def MjcActuator "joint4"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -360
            uniform double mjc:ctrlRange:max = 360
            rel mjc:target = </CR5/joints/joint4>
        }

        def MjcActuator "joint5"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -360
            uniform double mjc:ctrlRange:max = 360
            rel mjc:target = </CR5/joints/joint5>
        }

        def MjcActuator "joint6"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -360
            uniform double mjc:ctrlRange:max = 360
            rel mjc:target = </CR5/joints/joint6>
        }
    }
}
