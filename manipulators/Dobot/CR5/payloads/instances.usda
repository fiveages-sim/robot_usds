    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "base_link" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/baise_001>
            }

            over "base_link1" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_005>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "baise_001" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/baise_001>
            )
            {
            }

            def Material "black_005" (
