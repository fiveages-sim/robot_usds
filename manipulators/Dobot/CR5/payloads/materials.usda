            )
            float inputs:opacity_threshold = 0 (
                customData = {
                    double default = 0
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Opacity"
            )
            float inputs:texture_rotate = 0 (
                customData = {
                    double default = 0
                    dictionary range = {
                        double max = 360
                        double min = 0
                    }
                }
                displayGroup = "UV"
            )
            float2 inputs:texture_scale = (1, 1) (
                customData = {
                    float2 default = (1, 1)
                }
                displayGroup = "UV"
            )
            float2 inputs:texture_translate = (0, 0) (
                customData = {
                    float2 default = (0, 0)
                }
                displayGroup = "UV"
            )
            token outputs:out
        }
    }
}

