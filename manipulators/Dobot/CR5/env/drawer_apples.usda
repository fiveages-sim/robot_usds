#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.5876128495629869, 0.6964506974637203, 1.9075047529601818)
                double3 target = (-17.337320290162044, -7.557181893195787, -6.707139402748077)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary metricsAssembler = {
            dictionary "/World/optical_table_01" = {
            }
            dictionary "/World/shelf8" = {
            }
            dictionary "/World/shelf8_01" = {
            }
            dictionary "/World/table" = {
            }
            int version = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./drawer_apples.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "CR5" (
        prepend payload = @../CR5.usda@
    )
    {
        quatd xformOp:orient = (6.123233995736766e-17, 0, 0, 1)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.4, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Graph"
        {
            over "ROS_JointStates"
            {
                over "PublisherJointState"
                {
                    custom rel inputs:targetPrim = </World/CR5/root_joint>
                }

                over "ArticulationController"
                {
                    custom rel inputs:targetPrim = </World/CR5/root_joint>
                }
            }
        }
    }

    def "scene" (
        prepend payload = @../../../../../environment/fiveages_env/tasks/table_optical/drawer_apples.usda@
    )
    {
    }
}

