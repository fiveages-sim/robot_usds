def PhysicsScene "PhysicsScene" (
    delete apiSchemas = ["PhysxSceneAPI", "MjcSceneAPI", "NewtonXpbdSceneAPI"]
    prepend apiSchemas = ["NewtonSceneAPI", "MaterialBindingAPI", "MjcSceneAPI", "PhysxSceneAPI"]
)
{
    rel material:binding:physics = </World/CR5/AG2F90/left_up_link/left_Pad_link/pad_link/Looks/PhysicsMaterial> (
        bindMaterialAs = "weakerThanDescendants"
    )
    uniform bool mjc:compiler:alignFree = 1
    uniform bool mjc:flag:equality = 1
    uniform bool mjc:flag:spring = 1
    uniform token mjc:option:cone = "elliptic"
    uniform token mjc:option:integrator = "euler"
    uniform double mjc:option:tolerance = 1e-8
    uniform double mjc:option:viscosity = 0
