{
}

def PhysicsRevoluteJoint "right_joint1" (
    prepend apiSchemas = ["MjcJointAPI", "PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
)
{
    float drive:angular:physics:damping = 60000
    float drive:angular:physics:maxForce = 500
    float drive:angular:physics:stiffness = 600000
    float drive:angular:physics:targetPosition = 0
    uniform token drive:angular:physics:type = "force"
    uniform double mjc:armature = 0.01
    uniform bool mjc:actuatorgravcomp = 1
    uniform double mjc:damping = 0.1
    uniform token mjc:actuatorfrclimited = "auto"
    uniform double mjc:actuatorfrcrange:min = -500
    uniform double mjc:actuatorfrcrange:max = 500
    uniform token physics:axis = "Y"
    prepend rel physics:body0 = </ART7/base_link>
    prepend rel physics:body1 = </ART7/link1>
    float physics:breakForce = 3.4028235e38
    float physics:breakTorque = 3.4028235e38
    float physics:JointEquivalentInertia = 0.0621497
    point3f physics:localPos0 = (-0.00088174, 0.00033281, 0.187)
    point3f physics:localPos1 = (0, 0, 0)
    quatf physics:localRot0 = (0.7071081, 0.7071055, 0, 0)
    quatf physics:localRot1 = (0, 1, 0, 0)
    float physics:lowerLimit = -174.99849
    float physics:upperLimit = 174.99849
    float physxJoint:maxJointVelocity = 180
    float state:angular:physics:position = 0
    float state:angular:physics:velocity = 0
}

