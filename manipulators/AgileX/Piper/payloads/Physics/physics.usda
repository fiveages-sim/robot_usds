#usda 1.0
(
    defaultPrim = "Piper"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Piper"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.004736412, 0.000025682913, 0.041451517)
        float3 physics:diagonalInertia = (0.0026911718, 0.0028261244, 0.00087939383)
        float physics:mass = 1.02
        quatf physics:principalAxes = (0.99883044, 0.00022092495, 0.048269138, 0.0028276476)
    }

    over "link1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.00012150473, 0.00010463216, -0.0043859733)
        float3 physics:diagonalInertia = (0.0004892622, 0.0004045508, 0.0004398869)
        float physics:mass = 0.71
        quatf physics:principalAxes = (0.99914896, 0.034498405, 0.02249824, -0.002259325)
    }

    over "joints"
    {
        def PhysicsRevoluteJoint "joint1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 6000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 60000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </Piper/base_link>
            custom rel physics:body1
            append rel physics:body1 = </Piper/link1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.013006199
            point3f physics:localPos0 = (0, 0, 0.123)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -150.00035
            float physics:upperLimit = 150.00035
        }

        def PhysicsRevoluteJoint "joint2" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
