#usda 1.0
(
    defaultPrim = "Piper"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@,
        @./arm_self_collision_mute.usda@
    ]
    upAxis = "Z"
)

def "Piper"
{
    over "joints"
    {
        over "joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 286.47888
        }

        over "joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 286.47888
        }

        over "joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 286.47888
        }

        over "joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 286.47888
        }

        over "joint5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 286.47888
        }

        over "joint6" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 171.88733
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        # Mounted dexhand: self-col on; NonDexHand (arm_self_collision_mute.usda)
        # mutes arm↔arm. DexHand EE sublayers dexhand_self_collision.usda to
        # exclude fingers.
        bool physxArticulation:enabledSelfCollisions = 1
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
    }

    over "link6"
    {
        over "tcp"
        {
            over "Gripper" (
                variants = {
                    string Physics = "physx"
                }
            )
            {
            }

            over "Revo1" (
                variants = {
                    string Physics = "physx"
                }
            )
            {
            }

            over "Revo2" (
                variants = {
                    string Physics = "physx"
                }
            )
            {
            }
        }
    }
}
