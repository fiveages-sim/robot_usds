#usda 1.0
(
    defaultPrim = "Piper"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Piper" (
    prepend variantSets = ["EE"]
)
{
    delete rel isaac:physics:robotJoints
    prepend rel isaac:physics:robotJoints = [
        </Piper/root_joint>,
        </Piper/joints/right_joint1>,
        </Piper/joints/right_joint2>,
        </Piper/joints/right_joint3>,
        </Piper/joints/right_joint4>,
        </Piper/joints/right_joint5>,
        </Piper/joints/right_joint6>,
    ]

    over "joints"
    {
        over "joint1" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_joint1" (
            prepend apiSchemas = ["MjcJointAPI", "PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 6000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 60000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform double mjc:armature = 0.01
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
            uniform token physics:axis = "Z"
            prepend rel physics:body0 = </Piper/base_link>
            prepend rel physics:body1 = </Piper/link1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.013006199
            point3f physics:localPos0 = (0, 0, 0.123)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -150.00035
            float physics:upperLimit = 150.00035
            float physxJoint:maxJointVelocity = 286.47888
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2" (
            active = false
        )
