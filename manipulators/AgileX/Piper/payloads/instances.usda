#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "subset_" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/grey_metal_001>
            }

            over "black_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_metal>
            }

            over "a0000000_0000_0000_0000_000000000000_003" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/a0000000_0000_0000_0000_000000000000_003>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "grey_metal_001" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey_metal_001>
            )
            {
            }

            def Material "black_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_metal>
            )
            {
            }

            def Material "a0000000_0000_0000_0000_000000000000_003" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/a0000000_0000_0000_0000_000000000000_003>
            )
            {
            }
        }
    }

