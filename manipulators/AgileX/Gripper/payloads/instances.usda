                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/grey_metal>
            }

            over "grey_metal0" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/grey_metal>
