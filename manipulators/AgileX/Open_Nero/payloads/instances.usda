#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "subset_______008" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______008>
            }

            over "subset_______007" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______007>
            }

            over "subset_______004" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______008>
            }

            over "subset_______006" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______007>
            }

            over "subset_______005" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______008>
            }

            over "subset_______001" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______008>
            }

            over "subset_______003" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______008>
            }

            over "subset_______002" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/material_______008>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "material_______008" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/material_______008>
            )
            {
            }

            def Material "material_______007" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/material_______007>
            )
            {
            }
        }
    }
}

