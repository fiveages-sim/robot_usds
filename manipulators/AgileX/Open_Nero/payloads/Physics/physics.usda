#usda 1.0
(
    defaultPrim = "Open_Nero"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Open_Nero"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.059098944, -0.06856089, 0.056943513)
        float3 physics:diagonalInertia = (0.06250878, 0.023601944, 0.068196066)
        float physics:mass = 4.4705596
        quatf physics:principalAxes = (0.9994693, 0.010009945, -0.03098476, -0.0009877349)

        over "left_base_link"
        {
            over "Nero" (
                variants = {
                    string Physics = "physics"
                }
            )
            {
            }
        }

        over "right_base_link"
        {
            over "Nero" (
                variants = {
                    string Physics = "physics"
                }
            )
            {
            }
        }
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </Open_Nero/base_link>
    }
}

