#usda 1.0
(
    defaultPrim = "Open_Nero"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Open_Nero" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = </Open_Nero/root_joint>
    prepend rel isaac:physics:robotLinks = [
        </Open_Nero/base_link>,
        </Open_Nero/base_link/arm_base>,
        </Open_Nero/base_link/left_base_link>,
        </Open_Nero/base_link/right_base_link>,
        </Open_Nero/base_link/top_camera_stand_link>,
    ]

    over "base_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "arm_base" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "left_base_link" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "right_base_link" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "top_camera_stand_link" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["IsaacJointAPI"]
    )
    {
    }
}

