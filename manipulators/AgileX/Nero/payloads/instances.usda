            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/silver>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }

            def Material "Material________002" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Material________002>
            )
            {
            }

            def Material "black_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_metal>
            )
            {
            }

            def Material "a0000000_0000_0000_0000_000000000000_003" (
