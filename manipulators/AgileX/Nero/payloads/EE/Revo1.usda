#usda 1.0
(
    subLayers = [
        @../Side/payloads/EE/dexhand_self_collision.usda@
    ]
    defaultPrim = "Nero"
    doc = """EE=Revo1 mount (Side=default). Nero URDF flange + hand TF.
Flange sibling TF: T=(0.031, 0, -0.0235) quat=(0.5, -0.5, 0.5, -0.5).
Hand weld: T=(0.043, 0, -0.0235) quat=(0.5, -0.5, -0.5, -0.5). Aligned to Revo2 palm via Piper-relative Rx(+90) chain. FixedJoint = xform.
"""
)

def Xform "Nero"
{
    over "link7"
    {
        over "tcp"
        {
            def Xform "NeroFlangeRevo2" (
                prepend references = @../../flange_revo2.usd@
            )
            {
                quatd xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.031, 0, -0.0235)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def "Revo1" (
                prepend payload = @../../../../../dexhands/BrainCo/Revo1/Revo1.usda@
                variants = {
                    string Side = "default"
                }
            )
            {
                quatd xformOp:orient = (0.5, -0.5, -0.5, -0.5)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.043, 0, -0.0235)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "hand_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Nero/link7/tcp>
                        rel physics:body1 = </Nero/link7/tcp/Revo1/hand_base>
                        point3f physics:localPos0 = (0.043, 0, -0.0235)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.5, -0.5, -0.5, -0.5)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "index_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "index_distal_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "middle_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "middle_distal_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "pinky_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "pinky_distal_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "ring_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "ring_distal_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "thumb_joint2"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "thumb_joint1"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "thumb_distal_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                }
            }
        }
    }

    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint7"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

    }
}
