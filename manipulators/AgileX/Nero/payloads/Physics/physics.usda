        point3f physics:centerOfMass = (-0.0007681058, -0.00005718031, -0.0068637277)
        float3 physics:diagonalInertia = (0.000668361, 0.000545022, 0.000513619)
        float physics:mass = 0.76710504
        quatf physics:principalAxes = (0.99849576, 0.024328494, -0.047403403, 0.012930846)
    }

    over "joints"
    {
        def PhysicsRevoluteJoint "joint1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 6000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 60000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </Nero/base_link>
            custom rel physics:body1
            append rel physics:body1 = </Nero/link1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.014861508
            point3f physics:localPos0 = (0, 0, 0.138)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -154.99997
            float physics:upperLimit = 154.99997
        }

