#usda 1.0
(
    defaultPrim = "Nero"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Nero"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.00319466, -0.00005467608, 0.043217584)
        float3 physics:diagonalInertia = (0.0010266423, 0.0011440256, 0.000908653)
        float physics:mass = 1.0645844
        quatf physics:principalAxes = (0.9998889, -0.0016739783, 0.012477598, -0.007994486)
    }

    over "link1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
