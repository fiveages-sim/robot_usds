#usda 1.0
(
    defaultPrim = "Nero"
    doc = """EE=Gripper (Side=left). Nero flange sibling + weld Gripper/tcp.
TF: flange (0.031, 0, -0.0235); Gripper/tcp (0.0324, 0, -0.0235) relative to flange (+0.0014 along tcp X). Hide Gripper built-in flange.
"""
)

def Xform "Nero"
{
    over "link7"
    {
        over "tcp"
        {
            def Xform "NeroFlangeGripper" (
                prepend references = @../../../../flange_gripper.usd@
            )
            {
                quatd xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.031, 0, -0.0235)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def "Gripper" (
                prepend payload = @../../../../../Gripper/Gripper.usda@
                variants = {
                    string ROS = "none"
                    string Side = "left"
                }
            )
            {
                quatd xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.0324, 0, -0.0235)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "tcp"
                {
                    over "visuals"
                    {
                        over "flange"
                        {
                            token visibility = "invisible"
                        }
                    }

                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Nero/link7/tcp>
                        rel physics:body1 = </Nero/link7/tcp/Gripper/tcp>
                        point3f physics:localPos0 = (0.0324, 0, -0.0235)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.5, -0.5, 0.5, -0.5)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "left_gripper_joint"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }

                    over "left_joint8"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }
                }
            }
        }
    }

    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint7"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

    }
}
