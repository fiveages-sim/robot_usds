#usda 1.0
(
    defaultPrim = "Piper_X"
)

def Xform "Piper_X"
{
    over "link6"
    {
        over "tcp"
        {
            def "Gripper" (
                prepend payload = @../../../Gripper/Gripper.usda@
                variants = {
                    string ROS = "none"
                    string Side = "default"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "tcp"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Piper_X/link6/tcp>
                        rel physics:body1 = </Piper_X/link6/tcp/Gripper/tcp>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "gripper_joint"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }

                    over "joint8"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }
                }
            }
        }
    }

    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}
