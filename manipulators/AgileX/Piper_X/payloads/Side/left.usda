#usda 1.0
(
    defaultPrim = "Piper_X"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Piper_X" (
    prepend variantSets = ["EE"]
)
{
    delete rel isaac:physics:robotJoints
    prepend rel isaac:physics:robotJoints = [
        </Piper_X/root_joint>,
        </Piper_X/joints/left_joint1>,
        </Piper_X/joints/left_joint2>,
        </Piper_X/joints/left_joint3>,
        </Piper_X/joints/left_joint4>,
        </Piper_X/joints/left_joint5>,
        </Piper_X/joints/left_joint6>,
    ]

    over "joints"
    {
        over "joint1" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "left_joint1" (
            prepend apiSchemas = ["MjcJointAPI", "PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 6000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 60000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:max = 100
            uniform double mjc:actuatorfrcrange:min = -100
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token physics:axis = "Z"
            rel physics:body0 = </Piper_X/base_link>
            rel physics:body1 = </Piper_X/link1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.01302218
            point3f physics:localPos0 = (0, 0, 0.123)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (7.54979e-8, 0, 0, 1)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -149.99998
            float physics:upperLimit = 149.99998
            float physxJoint:maxJointVelocity = 286.47888
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

