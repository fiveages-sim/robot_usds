#usda 1.0
(
    defaultPrim = "Piper_X"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Piper_X"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.004736412, 0.000025682913, 0.041451517)
        float3 physics:diagonalInertia = (0.0026911718, 0.0028261244, 0.00087939383)
        float physics:mass = 1.02
        quatf physics:principalAxes = (0.99883044, 0.00022092495, 0.048269138, 0.0028276476)
    }

    over "link1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.00053, -0.00039, -0.00315)
        float3 physics:diagonalInertia = (0.0005012004, 0.0004083597, 0.00045751984)
        float physics:mass = 0.71
        quatf physics:principalAxes = (0.99625754, -0.046027765, -0.07302398, 0.0044575473)
    }

    over "joints"
    {
        def PhysicsRevoluteJoint "joint1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 6000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 60000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </Piper_X/base_link>
            custom rel physics:body1
            append rel physics:body1 = </Piper_X/link1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.01302218
            point3f physics:localPos0 = (0, 0, 0.123)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (7.54979e-8, 0, 0, 1)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -149.99998
            float physics:upperLimit = 149.99998
        }

        def PhysicsRevoluteJoint "joint2" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
