#usda 1.0
(
    doc = """Piper Newton arm mute.

WIRE: Piper Physics=mujoco → append references = @this@</Piper_L>
Collision meshes are instanceable under linkN/collisions/linkN.
PhysX: arm_self_collision_mute CollisionGroup. Hands not muted.
"""
    metersPerUnit = 1
    defaultPrim = "Piper_L"
    upAxis = "Z"
)

over "Piper_L"
{
    over "link1"
    {
        over "collisions"
        {
            over "link1"
            {
                bool physics:collisionEnabled = 0
            }
        }
    }

    over "link2"
