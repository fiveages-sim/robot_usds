    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 1
    }

    over "base_link"
    {
        uniform float mjc:gravcomp = 1
    }

    over "link1"
    {
        uniform float mjc:gravcomp = 1
    }

    over "link2"
    {
        uniform float mjc:gravcomp = 1
    }

    over "link3"
    {
        uniform float mjc:gravcomp = 1
    }

    over "link4"
    {
        uniform float mjc:gravcomp = 1
    }

    over "link5"
    {
        uniform float mjc:gravcomp = 1
    }

    over "link6"
    {
        uniform float mjc:gravcomp = 1

        over "tcp"
        {
            over "Gripper" (
                variants = {
                    string Physics = "mujoco"
                }
            )
            {
            }

            over "Revo1" (
                variants = {
                    string Physics = "mujoco"
                }
            )
            {
            }

            over "Revo2" (
                variants = {
                    string Physics = "mujoco"
                }
            )
            {
            }
        }
    }

    def Scope "actuators"
    {
        def MjcActuator "joint1"
        {
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 149.99998474121094
            uniform double mjc:ctrlRange:min = -149.99998474121094
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            rel mjc:target = </Piper_L/joints/joint1>
        }

        def MjcActuator "joint2"
        {
            uniform double[] mjc:biasPrm = [0, -60000, -6000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 179.99998474121094
            uniform double mjc:ctrlRange:min = 0
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            uniform double[] mjc:gainPrm = [60000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            rel mjc:target = </Piper_L/joints/joint2>
        }

        def MjcActuator "joint3"
