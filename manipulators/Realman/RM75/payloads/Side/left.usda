    uniform token mjc:forceLimited = "true"
    uniform double mjc:forceRange:min = -60
    uniform double mjc:forceRange:max = 60
    uniform token mjc:ctrlLimited = "true"
    uniform double mjc:ctrlRange:min = -177.6169
    uniform double mjc:ctrlRange:max = 177.6169
    rel mjc:target = </RM75/joints/left_joint1>
}

