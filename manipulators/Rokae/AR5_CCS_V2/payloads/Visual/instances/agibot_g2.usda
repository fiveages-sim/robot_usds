#usda 1.0
(
    defaultPrim = "Instances"
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @../../geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "Shell_White" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/mesh/VisualMaterials/agibot_silver>
            }

            over "rubber" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/rubber>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "agibot_silver" (
                instanceable = true
                prepend references = @../../materials.usda@</Materials/agibot_silver>
            )
            {
            }

            def Material "rubber" (
                instanceable = true
                prepend references = @../../materials.usda@</Materials/rubber>
            )
            {
            }

            over "Shell_White" (
                active = false
            )
            {
            }
        }
    }

    def Xform "mesh_1_1" (
        prepend references = @../../geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding = </Instances/mesh_1_1/VisualMaterials/black> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        def Scope "VisualMaterials"
        {
            def Material "black" (
                instanceable = true
                prepend references = @../../materials.usda@</Materials/black>
            )
            {
            }

            over "Shell_White_0" (
                active = false
            )
            {
            }
        }
    }

