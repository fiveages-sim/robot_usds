#usda 1.0
(
    subLayers = [
        @../Side/payloads/EE/dexhand_self_collision.usda@
    ]
    defaultPrim = "AR5_CCS_V2"
    doc = """EE=LinkerHand L6 mount.
Weld tcp -> flange; FixedJoint matches mount xform.
Same AG2F90 adapter as AR5 EE=AG2F90: metal plate at tcp (gripper weld z=0.0195 + flange vis z=-0.0195).
L6 palm is 0.024383 beyond the plate → T z=0.024383, Rz=+90 (default/left).
"""
)

def Xform "AR5_CCS_V2"
{
    over "link7"
    {
        over "tcp"
        {
            def "L6" (
                prepend payload = @../../../../../dexhands/LinkerHands/L6/L6.usda@
                variants = {
                    string Flange = "default"
                    string Side = "default"
                }
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0, 0.7071067811865475)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.024383)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "flange"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </AR5_CCS_V2/link7/tcp>
                        rel physics:body1 = </AR5_CCS_V2/link7/tcp/L6/flange>
                        point3f physics:localPos0 = (0, 0, 0.024383)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                over "index_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "index_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "middle_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "middle_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "pinky_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "pinky_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "ring_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "ring_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "thumb_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "thumb_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "thumb_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
                }
            }
        }
    }
}
