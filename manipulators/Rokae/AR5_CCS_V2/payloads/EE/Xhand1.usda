#usda 1.0
(
    subLayers = [
        @../Side/payloads/EE/dexhand_self_collision.usda@
    ]
    defaultPrim = "AR5_CCS_V2"
    doc = """EE=Xhand1 mount.
Weld tcp -> hand_base; FixedJoint matches mount xform.
Same AG2F90 adapter as AR5 EE=AG2F90: metal plate at tcp.
Xhand1 palm is 0.024144 beyond the plate → T z=0.024144, Rz=+90 (default/left).
"""
)

def Xform "AR5_CCS_V2"
{
    over "link7"
    {
        over "tcp"
        {
            def "Xhand1" (
                prepend payload = @../../../../../dexhands/RobotEra/Xhand1/Xhand1.usda@
                variants = {
                    string Flange = "default"
                    string Side = "default"
                }
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0, 0.7071067811865475)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.024144)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "hand_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </AR5_CCS_V2/link7/tcp>
                        rel physics:body1 = </AR5_CCS_V2/link7/tcp/Xhand1/hand_base>
                        point3f physics:localPos0 = (0, 0, 0.024144)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                over "index_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "index_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "index_joint3"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "middle_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "middle_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "pinky_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "pinky_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "ring_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "ring_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "thumb_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "thumb_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "thumb_joint3"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                }
            }
        }
    }
}
