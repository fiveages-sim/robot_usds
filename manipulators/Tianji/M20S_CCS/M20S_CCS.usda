        "RG75" (
            prepend payload = @./payloads/EE/RG75.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </M20S_CCS/link7/tcp/RG75>
            prepend rel isaac:physics:robotLinks = </M20S_CCS/link7/tcp/RG75>
        }
        "AG2F90" (
            prepend payload = @./payloads/EE/AG2F90.usda@
        ) {
