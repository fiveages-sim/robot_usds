    float drive:angular:physics:stiffness = 600000
    float drive:angular:physics:targetPosition = 0
    uniform token drive:angular:physics:type = "force"
    uniform double mjc:armature = 0.01
    uniform bool mjc:actuatorgravcomp = 1
    uniform double mjc:damping = 0.1
    uniform token mjc:actuatorfrclimited = "auto"
    uniform double mjc:actuatorfrcrange:min = -490
    uniform double mjc:actuatorfrcrange:max = 490
    uniform token physics:axis = "Z"
    prepend rel physics:body0 = </M20S_CCS/base_link>
    prepend rel physics:body1 = </M20S_CCS/link1>
    float physics:breakForce = 3.4028235e38
    float physics:breakTorque = 3.4028235e38
    float physics:JointEquivalentInertia = 0.461011
    point3f physics:localPos0 = (0, 0, 0.305)
    point3f physics:localPos1 = (0, 0, 0)
    quatf physics:localRot0 = (1, 0, 0, 0)
    quatf physics:localRot1 = (1, 0, 0, 0)
    float physics:lowerLimit = -170.00229
    float physics:upperLimit = 170.00229
    float physxJoint:maxJointVelocity = 120.00027
    float state:angular:physics:position = 0
    float state:angular:physics:velocity = 0
}

