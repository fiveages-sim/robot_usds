#usda 1.0
(
    defaultPrim = "M20S_CCS"
)

def Xform "M20S_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "AG2F120S" (
                prepend payload = @../../../../../../../grippers/ChangingTek/AG2F120S/AG2F120S.usda@
                variants = {
                    string Flange = "default"
                    string Side = "right"
                }
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0, 0.7071067811865475)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.030300061273575873)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </M20S_CCS/link7/tcp>
                        rel physics:body1 = </M20S_CCS/link7/tcp/AG2F120S/gripper_base>
                        point3f physics:localPos0 = (5.6179556e-16, -6.9169137e-09, 0.030300062)
                        point3f physics:localPos1 = (-3.304865e-09, -1.8152579e-16, 8.761871e-10)
                        quatf physics:localRot0 = (0.70710677, 1.2971286e-09, -1.2971284e-09, 0.70710677)
                        quatf physics:localRot1 = (1, 1.2391298e-16, -1.5881049e-09, 1.4816293e-08)
                    }
                }

            over "joints"
            {
                over "right_gripper_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_left_support_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_left_2_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_right_1_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_right_support_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_right_2_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

            }
            }
        }
    }

    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint4"
        {
