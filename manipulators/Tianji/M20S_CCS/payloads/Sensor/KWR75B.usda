#usda 1.0
(
    defaultPrim = "M20S_CCS"
    doc = """Thin arm mount for Sensor=KWR75B.

Only flange/tcp offset + payload of the reusable KWR75B sensor asset.
Side/topic/Graph live in sensors/6Dof F&T Sensor/KWR75B.usda.
Arm Side=left/right selects nested KWR75B Side (see payloads/Side/{left,right}.usda).
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "M20S_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            double3 xformOp:translate = (0, -0.157, 0)
        }

        def "KWR75B" (
            prepend payload = @../../../../../sensors/6Dof F&T Sensor/KWR75B.usda@
            variants = {
                string Side = "default"
            }
        )
        {
            quatd xformOp:orient = (6.123233995736766e-17, -0.7071067811865475, -4.329780281177466e-17, -0.7071067811865476)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, -0.1575, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
}
