#usda 1.0
(
    defaultPrim = "Marvin_Pro"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

# Body frame only: fixed root + Newton articulation root.
# Child arms keep their own Physics (do not bake here). Parent overs push Physics=mujoco.
over "Marvin_Pro"
{
    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    over "base_link"
    {
        over "arm_base"
        {
            over "left_mount"
            {
                over "M6_CCS" (
                    variants = {
                        string Physics = "mujoco"
                    }
                )
                {
                }

                over "M6S_Lite_CCS" (
                    variants = {
                        string Physics = "mujoco"
                    }
                )
                {
                }
            }

            over "right_mount"
            {
                over "M6_CCS" (
                    variants = {
                        string Physics = "mujoco"
                    }
                )
                {
                }

                over "M6S_Lite_CCS" (
                    variants = {
                        string Physics = "mujoco"
                    }
                )
                {
                }
            }
        }
    }
}
