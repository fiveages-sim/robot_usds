#usda 1.0
(
    defaultPrim = "Marvin_Pro"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Marvin_Pro"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.0081994, -0.0000051, 0.47835004)
        float3 physics:diagonalInertia = (0.463463, 0.46324942, 0.3776567)
        float physics:mass = 18.846
        quatf physics:principalAxes = (0.99999356, 0.000025686591, 0.0031360944, 0.0017322226)
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </Marvin_Pro/base_link>
    }
}

