#usda 1.0
(
    defaultPrim = "Marvin_Pro"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Marvin_Pro"
{
    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }

    over "base_link"
    {
        over "arm_base"
        {
            over "left_mount"
            {
                over "M6_CCS" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }

                over "M6S_Lite_CCS" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }
            }

            over "right_mount"
            {
                over "M6_CCS" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }

                over "M6S_Lite_CCS" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }
            }
        }
    }
}
