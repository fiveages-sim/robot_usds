#usda 1.0
(
    subLayers = [
        @./dexhand_self_collision.usda@
    ]
    defaultPrim = "M6S_Lite_CCS"
    doc = """EE=LinkerHand L6 mount.
Weld tcp -> flange; FixedJoint matches mount xform (T z=0.03616, Rz=+180). Disable hand root_joint.
Hand Side=left, Flange=default (AG2F90 metal + black print, shifted -0.024383 in flange Z).
Palm sits after the print stack; Rz=+180 vs tcp (not o6's Rz=+90).
"""
)

def Xform "M6S_Lite_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "L6" (
                prepend payload = @../../../../../../../dexhands/LinkerHands/L6/L6.usda@
                variants = {
                    string Flange = "default"
                    string Side = "left"
                }
            )
            {
                quatd xformOp:orient = (0, 0, 0, 1)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.03616)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "flange"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </M6S_Lite_CCS/link7/tcp>
                        rel physics:body1 = </M6S_Lite_CCS/link7/tcp/L6/flange>
                        point3f physics:localPos0 = (0, 0, 0.03616)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0, 0, 0, 1)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                over "left_hand_index_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_index_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_middle_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_middle_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_pinky_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_pinky_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_ring_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_ring_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_thumb_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_thumb_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_hand_thumb_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
                }
            }
        }
    }
}
