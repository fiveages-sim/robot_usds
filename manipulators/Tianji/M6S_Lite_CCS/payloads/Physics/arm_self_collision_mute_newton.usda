#usda 1.0
(
    doc = """M6S Lite Newton arm mute.

WIRE: M6S_Lite_CCS Physics=mujoco → append references = @this@</M6S_Lite_CCS>
Collision meshes are instanceable under linkN/collisions/linkN (not M6 cylinders).
PhysX: arm_self_collision_mute CollisionGroup. Hands not muted.
"""
    metersPerUnit = 1
    defaultPrim = "M6S_Lite_CCS"
    upAxis = "Z"
)

over "M6S_Lite_CCS"
{
    over "link1"
    {
        over "collisions"
        {
            over "link1"
            {
                bool physics:collisionEnabled = 0
            }
        }
    }

    over "link2"
