#usda 1.0
(
    defaultPrim = "M6S_Lite_CCS"
    doc = """EE=Marvin Gripper. Weld tcp -> flange.
link7 tcp is 0.08 along tool axis; T z=0.005 so link7→straight flange = 0.085.
Do not sticky Flange or Physics.
"""
)

def Xform "M6S_Lite_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "Marvin_Gripper" (
                prepend payload = @../../../../../manipulators/Tianji/Marvin gripper/Marvin_marvin_gripper_core.usda@
                variants = {
                    string Side = "default"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.005)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "flange"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </M6S_Lite_CCS/link7/tcp>
                        rel physics:body1 = </M6S_Lite_CCS/link7/tcp/Marvin_Gripper/flange>
                        point3f physics:localPos0 = (0, 0, 0.005)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "gripper_joint"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }

                    over "right_finger_joint"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }
                }
            }
        }
    }

    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint7"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}
