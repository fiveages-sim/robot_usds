#usda 1.0
(
    defaultPrim = "M6_CCS"
    doc = """EE=scoop_type1 left-arm mount. Jointless fixed scoop.

Play-safe TF: identity weld; flange Rx=-90 on gripper_base children.
"""
)

def Xform "M6_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "Scoop_type1" (
                prepend payload = @../../../../../../../components/fixed_ee/Scoop_type1/Scoop_type1.usda@
                variants = {
                    string side = "left"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    point3f physics:centerOfMass = (0.069, 0.009, 0.008)
                    float3 physics:diagonalInertia = (0.0012, 0.0022, 0.0014)

                    over "Spade_shaped_gripper_left"
                    {
                        double3 xformOp:rotateXYZ = (-90, 0, 0)
                    }

                    over "collision"
                    {
                        quatd xformOp:orient = (0.7071067811865476, -0.7071067811865476, 0, 0)
                    }

                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </M6_CCS/link7/tcp>
                        rel physics:body1 = </M6_CCS/link7/tcp/Scoop_type1/gripper_base>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }
            }
        }
    }
}
