#usda 1.0
(
    defaultPrim = "M6_CCS"
    doc = """EE=ysw_e70 left-arm mount (Hook pattern)."""
)

def Xform "M6_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "ysw_e70" (
                prepend payload = @../../../../../../../suction_cup/YSW/E70/e70.usda@
                variants = {
                    string Physics = "physx"
                    string type = "none"
                    string side = "left"
                }
            )
            {
                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </M6_CCS/link7/tcp>
                        rel physics:body1 = </M6_CCS/link7/tcp/ysw_e70/gripper_base>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }
            }
        }
    }
}
