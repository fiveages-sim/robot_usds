#usda 1.0
(
    defaultPrim = "M6_CCS"
    doc = """EE=LinkerHand_o6 mount — RG75 pattern.
Weld tcp -> flange; FixedJoint matches mount xform (T z=0.0045, Rz=+90). Disable hand root_joint.
Hand Side=right; mount TF translate z=0.0045, Rz=+90°.
"""
)

def Xform "M6_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "LinkerHand_o6" (
                prepend payload = @../../../../../../../dexhands/LinkerHands/o6/LinkerHand_o6.usda@
                variants = {
                    string Side = "right"
                }
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0, 0.7071067811865475)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.0045)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "flange"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </M6_CCS/link7/tcp>
                        rel physics:body1 = </M6_CCS/link7/tcp/LinkerHand_o6/flange>
                        point3f physics:localPos0 = (0, 0, 0.0045)
                        point3f physics:localPos1 = (0, 0, 0)
                        # Must match LinkerHand_o6 xform (T z=0.0045, Rz=+90) so PhysX does not snap on Play
                        quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {

                over "right_hand_index_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_index_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_middle_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_middle_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_pinky_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_pinky_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_ring_joint"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_ring_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_thumb_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_thumb_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_hand_thumb_dip"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                }
            }
        }
    }
}
