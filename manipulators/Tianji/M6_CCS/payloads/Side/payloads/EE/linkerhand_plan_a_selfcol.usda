#usda 1.0
(
    doc = """LinkerHand EE: carve hands out of NonDexHand.

M6/W2 physx enable articulation self-col and put arm(/body) links in
NonDexHand (filters itself). link7 include expands into EE children, so
without excludes fingers land in NonDexHand and lose self-collision.

This sublayer only adds collection:colliders:excludes for LinkerHand_*.
Hands stay ungrouped → articulation self-col + hand FilteredPairs apply.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "M6_CCS"
{
    over "CollisionGroups"
    {
        over "NonDexHand"
        {
            prepend rel collection:colliders:excludes = [
                </M6_CCS/link7/tcp/LinkerHand_o6>,
                </M6_CCS/link7/tcp/LinkerHand_o7>,
            ]
        }
    }
}
