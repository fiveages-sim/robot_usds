#usda 1.0
(
    defaultPrim = "M6_CCS"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@,
        @./arm_self_collision_mute.usda@
    ]
    upAxis = "Z"
)

def "M6_CCS"
{
    over "joints"
    {
        over "joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "joint5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "joint6" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }

        over "joint7" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 180
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        # Mounted dexhand: self-col on; NonDexHand (arm_self_collision_mute.usda)
        # mutes arm↔arm. DexHand EE sublayers dexhand_self_collision.usda to
        # exclude fingers.
        bool physxArticulation:enabledSelfCollisions = 1
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}
