#usda 1.0
(
    doc = """M6 Newton arm mute — VALIDATED 2026-09-10.

WIRE: M6_CCS Physics=mujoco → append references = @this@</M6_CCS>
Do not wire from W2 root. One over per link (no duplicate link3).
PhysX: arm_self_collision_mute CollisionGroup. Hands not muted.
"""
