#usda 1.0
(
    defaultPrim = "Marvin_M6_CCS"
    doc = """EE=suction_type1 right-arm mount. side=right; EE↔tcp pose from suction flange variant."""
)

def Xform "Marvin_M6_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "Suction_type1" (
                prepend payload = @../../../../../../../components/suction_ee/Suction_type1/Suction_type1.usda@
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                variants = {
                    string side = "right"
                }
            )
            {
                float physics:mass = 0.3

                def PhysicsFixedJoint "AssemblerFixedJoint"
                {
                    rel physics:body0 = </Marvin_M6_CCS/link7/tcp>
                    rel physics:body1 = </Marvin_M6_CCS/link7/tcp/Suction_type1>
                    point3f physics:localPos0 = (0, 0, 0)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }
    }
}
