#usda 1.0
(
    defaultPrim = "Marvin_M6_CCS"
    doc = """EE=Hook right-arm mount. side=right → right_gripper_joint virtual DOFs for ROS."""
)

def Xform "Marvin_M6_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "Hook" (
                prepend payload = @../../../../../../../grippers/Others/Hook/Hook.usda@
                variants = {
                    string side = "right"
                }
            )
            {
                double3 xformOp:translate = (0, 0, 0)
                double3 xformOp:rotateZYX = (0, 0, -180)
                double3 xformOp:scale = (1, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Marvin_M6_CCS/link7/tcp>
                        rel physics:body1 = </Marvin_M6_CCS/link7/tcp/Hook/gripper_base>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "right_gripper_joint"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }

                    over "right_right_finger_joint"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }
                }
            }
        }
    }
}
