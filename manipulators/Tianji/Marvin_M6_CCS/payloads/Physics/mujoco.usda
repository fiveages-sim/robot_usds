#usda 1.0
(
    defaultPrim = "Marvin_M6_CCS"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Marvin_M6_CCS"
{
    over "joints"
