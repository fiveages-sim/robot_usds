#usda 1.0
(
    defaultPrim = "Marvin_M6_CCS"
    doc = """EE=ysw_e70 mount — same pattern as hook_type1.

Physics=physx sticky. Weld tcp -> gripper_base (identity FixedJoint).
Disable EE root_joint. Flange TF stays on gripper_base/visual (non-RB).
"""
)

def Xform "Marvin_M6_CCS"
{
    over "link7"
    {
        over "tcp"
        {
            def "ysw_e70" (
                prepend payload = @../../../../../suction_cup/YSW/E70/e70.usda@
                variants = {
                    string Physics = "physx"
                    string type = "none"
                    string side = "default"
                }
            )
            {
                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Marvin_M6_CCS/link7/tcp>
                        rel physics:body1 = </Marvin_M6_CCS/link7/tcp/ysw_e70/gripper_base>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }
            }
        }
    }
}
