#usda 1.0
(
    defaultPrim = "Dual_Stand1"
)

# Mount M6_CCS as left arm (Side=left). No sticky Physics — VariantSwitcher.
def Xform "Dual_Stand1"
{
    over "base_link"
    {
        over "arm_base"
        {
            over "left_mount"
            {
                def "M6_CCS" (
                    prepend payload = @../../../M6_CCS/M6_CCS.usda@
                    variants = {
                        string EE = "None"
                        string Robot = "none"
                        string Sensor = "none"
                        string Side = "left"
                        string visual = "default"
                    }
                )
                {
                    quatd xformOp:orient = (1, 0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                    over "root_joint" (
                        active = false
                    )
                    {
                    }

                    over "base_link"
                    {
                        def PhysicsFixedJoint "AssemblerFixedJoint"
                        {
                            rel physics:body0 = </Dual_Stand1/base_link/arm_base>
                            rel physics:body1 = </Dual_Stand1/base_link/arm_base/left_mount/M6_CCS/base_link>
                            point3f physics:localPos0 = (0, 0.12, 0)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (0.70710677, -0.70710677, 0, 0)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                        }
                    }

                    over "joints"
                    {
                        over "left_joint1"
                        {
                            float state:angular:physics:position = 0
                            float state:angular:physics:velocity = 0
                        }

                        over "left_joint2"
                        {
                            float state:angular:physics:position = 0
                            float state:angular:physics:velocity = 0
                        }

                        over "left_joint3"
                        {
                            float state:angular:physics:position = 0
                            float state:angular:physics:velocity = 0
                        }

                        over "left_joint4"
                        {
                            float state:angular:physics:position = 0
                            float state:angular:physics:velocity = 0
                        }

                        over "left_joint5"
                        {
                            float state:angular:physics:position = 0
                            float state:angular:physics:velocity = 0
                        }

                        over "left_joint6"
                        {
                            float state:angular:physics:position = 0
                            float state:angular:physics:velocity = 0
                        }

                        over "left_joint7"
                        {
                            float state:angular:physics:position = 0
                            float state:angular:physics:velocity = 0
                        }
                    }
                }
            }
        }
    }
}
