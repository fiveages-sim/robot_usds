#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.3259952362801153, -0.4808147248563754, 1.9812345417063444)
                double3 target = (-2.02328302086841, 0.008790301906192788, 0.7717961813336702)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./M6CCS_Medicine.usd"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "medicine_handover" (
        prepend payload = @../../../../../environment/fiveages_env/tasks/table_dual/medicine_handover.usd@
    )
    {
        over "FinasterideTablets"
        {
            vector3f physics:angularVelocity = (0.011080184, -0.00004857809, -0.004851224)
            vector3f physics:velocity = (-0.0000043922078, 0.000057468278, -0.0000035443336)
            quatf xformOp:orient = (0.9999731, -0.0000019603742, -4.2648967e-8, -0.007331101)
            double3 xformOp:translate = (0.004097897093743086, -0.3845837414264679, 0.8107143044471741)

            over "tablets"
            {
                over "tablets"
                {
                    double3 xformOp:translate = (0, 0, 0)
                }
            }
        }

        over "white_table"
        {
            over "table"
            {
                vector3f physics:angularVelocity = (-0.037372876, -0.12894657, 0.22684729)
                vector3f physics:velocity = (-0.00022609645, -0.0010492491, -0.0011367502)
                quatd xformOp:orient = (0.7071082172017757, -0.00029862090013929967, -0.00029789083055229245, 0.7071052193643725)
                double3 xformOp:translate = (0.00032108073594853845, 0.00021052255917729864, -0.52289125138707)
            }
        }
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI", "MaterialBindingAPI", "NewtonSceneAPI"]
    )
    {
        rel material:binding:physics = </World/M6_CCS_Dual/Dual_Stand1/Looks/PhysicsMaterial> (
            bindMaterialAs = "strongerThanDescendants"
        )
        uint physxScene:timeStepsPerSecond = 100
    }

    def "station" (
        prepend payload = @../station.usda@
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.44, 0, 0.77)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "base_link"
        {
            over "arm_base"
            {
                over "left_mount"
                {
                    over "Marvin_M6_CCS" (
                        variants = {
                            string EE = "AG2F90"
                        }
                    )
                    {
                    }
                }

                over "right_mount"
                {
                    over "Marvin_M6_CCS" (
                        variants = {
                            string EE = "AG2F90"
                        }
                    )
                    {
                    }
                }
            }
        }
    }
}

def Xform "Environment"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:angle = 1
        float inputs:exposure = 1.5
        float inputs:intensity = 3000
        bool inputs:normalize = 1
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        custom int omni:rtx:usdluxVersion = 2505
        quatd xformOp:orient = (0.6532814824381883, 0.2705980500730985, 0.27059805007309845, 0.6532814824381882)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

