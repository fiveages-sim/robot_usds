#usda 1.0
(
    defaultPrim = "Marvin"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Straight adapter. URDF flange_joint: xyz=0 0 0.0184, rpy=0 0 0.
CAD is cm / XY plate at Z=0; scale 0.01 only so mesh matches URDF flange frame.
"""
)

def "Marvin"
{
    over "flange" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.12

        def Xform "cad" (
            prepend payload = @./flange_straight.usd@
        )
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            double3 xformOp:scale:unitsResolve = (0.01, 0.01, 0.01)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]

            over "base_link_004"
            {
                over "base_link_013" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                }
            }

            over "base_link_005"
            {
                over "base_link_014" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                }
            }

            over "base_link_006"
            {
                over "base_link_015" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                )
                {
                    token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                }
            }
        }

        def Xform "camera"
        {
            quatd xformOp:orient = (0.7032331762534042, -0.07391278520356671, -0.0739127852035667, 0.7032331762534041)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.05855, 0, 0.05715)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def "SHW5G" (
                prepend payload = @../../../../../sensors/sensing/SHW5G.usd@
            )
            {
                double xformOp:rotateX = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:orient", "xformOp:scale"]
            }

            def Camera "camera"
            {
                float2 clippingRange = (0.01, 10000000)
                float focalLength = 18.147562
                float focusDistance = 400
                token projection = "perspective"
                quatd xformOp:orient = (0, 1, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }

    over "gripper_base"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0.0184)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "left_finger"
    {
        quatd xformOp:orient = (-4.371138828673793e-8, 0, 0, 1)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, -0.018345000222325325, 0.07790000137090683)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "right_finger"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0.018345000222325325, 0.07790000137090683)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    over "joints"
    {
        over "flange_to_base"
        {
            point3f physics:localPos0 = (0, 0, 0.0184)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}
