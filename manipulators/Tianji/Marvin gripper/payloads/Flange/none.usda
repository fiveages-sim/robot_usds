#usda 1.0
(
    defaultPrim = "Marvin"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "No adapter. flange_to_base is identity; gripper_base origin coincides with flange/tcp."
)

def "Marvin"
{
    over "joints"
    {
        over "flange_to_base"
        {
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}
