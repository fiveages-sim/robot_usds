#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "subset_" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_light_metal>
            }

            over "black_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_metal>
            }

            over "black_light_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_light_metal>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "black_light_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_light_metal>
            )
            {
            }

            def Material "black_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_metal>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "subset_" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/black_light_metal>
            }

            over "black_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/black_metal>
            }

            over "black_light_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/black_light_metal>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "black_light_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_light_metal>
            )
            {
            }

            def Material "black_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_metal>
            )
            {
            }
        }
    }

    def Xform "mesh_1_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1"
        {
            over "grey_plastic" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/grey_plastic>
            }

            over "black_light_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/black_light_metal>
            }

            over "black_light_metal0" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/black_light_metal>
            }

            over "black_plastic" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/black_plastic>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "grey_plastic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey_plastic>
            )
            {
            }

            def Material "black_light_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_light_metal>
            )
            {
            }

            def Material "black_plastic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_plastic>
            )
            {
            }
        }
    }

    def Xform "mesh_1_2" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "grey_plastic" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_2/VisualMaterials/grey_plastic>
            }

            over "black_light_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_2/VisualMaterials/black_light_metal>
            }

            over "black_light_metal0" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_2/VisualMaterials/black_light_metal>
            }

            over "black_plastic" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_2/VisualMaterials/black_plastic>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "grey_plastic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey_plastic>
            )
            {
            }

            def Material "black_light_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_light_metal>
            )
            {
            }

            def Material "black_plastic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_plastic>
            )
            {
            }
        }
    }
}

