#usda 1.0
(
    customLayerData = {
        string creator = "FaSim TRON2B component assembly"
    }
    defaultPrim = "tron2b_dach"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "tron2b_dach" (
    variants = {
        string Physics = "physx"
        string ROS = "none"
        string Sensor = "sensors"
        string Base = "dach"
        string Torso = "v1"
        string Body = "upper"
        string Head = "v1"
        string Robot = "robot"
    }
    # Head before ROS so Head=v1 can over ROS2ControlLaunch inputs:mode → full_body.
    prepend variantSets = ["Physics", "Head", "ROS", "Sensor", "Base", "Torso", "Body"]
    append variantSets = ["Robot"]
)
{
    variantSet "Physics" = {
        "none" {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {
        }
    }

    variantSet "ROS" = {
        "none" {
        }
        "fiveages" (
            prepend payload = @./payloads/ROS/fiveages.usda@
        ) {
        }
        "ros2" (
            prepend payload = @./payloads/ROS/ros2.usda@
        ) {
        }
    }

    variantSet "Sensor" = {
        "none" {
        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {
        }
    }

    variantSet "Base" = {
        "none" {
        }
        "dach" (
            prepend payload = @./payloads/Base/dach.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </tron2b_dach/Base_Dach>
            prepend rel isaac:physics:robotLinks = </tron2b_dach/Base_Dach>
        }
    }

    variantSet "Torso" = {
        "none" {
        }
        "v1" (
            prepend payload = @./payloads/Torso/v1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </tron2b_dach/Torso>
            prepend rel isaac:physics:robotLinks = </tron2b_dach/Torso>
        }
    }

    variantSet "Body" = {
        "none" {
        }
        "upper" (
            prepend payload = @./payloads/Body/upper.usda@
        ) {
            # Dual arms + EE only (Torso is separate).
            prepend rel isaac:physics:robotJoints = </tron2b_dach/Body_Upper>
            prepend rel isaac:physics:robotLinks = </tron2b_dach/Body_Upper>
        }
        "lower" (
            prepend payload = @./payloads/Body/lower.usda@
        ) {
        }
    }

    variantSet "Head" = {
        "none" {
        }
        "v1" (
            prepend payload = @./payloads/Head/v1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </tron2b_dach/Head_V1>
            prepend rel isaac:physics:robotLinks = </tron2b_dach/Head_V1>
        }
    }

    variantSet "Robot" = {
        "none" {
        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {
        }
    }
}
