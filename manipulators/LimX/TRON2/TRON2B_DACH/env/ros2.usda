#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (2.7459496304046143, 2.183822905453792, 2.058993913789676)
                double3 target = (0.41636079316799446, -0.14576593178282682, -0.27059486784378084)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./ros2.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "tron2b_dach"
    doc = "TRON2B_DACH topic JointState bridge (ROS=ros2): /joint_states + /joint_command + /clock."
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    subLayers = [
        @../TRON2B_DACH.usda@
    ]
    upAxis = "Z"
)

over "tron2b_dach" (
    variants = {
        string Physics = "physx"
        string ROS = "ros2"
        string Sensor = "sensors"
        string Base = "dach"
        string Torso = "v1"
        string Body = "upper"
        string Head = "v1"
        string Robot = "robot"
    }
)
{
    def PhysicsScene "PhysicsScene" (
        delete apiSchemas = ["MjcSceneAPI", "NewtonSceneAPI"]
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        uniform token physxScene:broadphaseType = "SAP"
        bool physxScene:enableGPUDynamics = 0
        uint physxScene:timeStepsPerSecond = 200
    }

    def Mesh "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 6, 2, 3, 7, 4, 5, 1, 0, 4, 0, 2, 6, 5, 7, 3, 1]
        point3f[] points = [(-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5)]
        color3f[] primvars:displayColor = [(0.2, 0.2, 0.2)]
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (20, 20, 0.01)
        double3 xformOp:translate = (0, 0, -0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
