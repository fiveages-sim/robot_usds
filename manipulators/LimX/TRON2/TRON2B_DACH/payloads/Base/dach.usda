#usda 1.0
(
    defaultPrim = "tron2b_dach"
)

def Xform "tron2b_dach"
{
    def "Base_Dach" (
        prepend payload = @../../../components/TRON2B_Base/TRON2B_Base.usda@
        variants = {
            string Physics = "physics"
        }
    )
    {
        # Match xacro base_2_Joint origin in base_link — must equal Assembler
        # localPos0 or PhysX snaps ~7cm on Play (disjointed body transforms).
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.00056, -0.00009, -0.07285)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Physics"
        {
            over "root_joint" (
                active = false
            )
            {
            }
        }

        over "Geometry"
        {
            over "base_2_Link" (
                delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
            )
            {
                def PhysicsFixedJoint "AssemblerFixedJoint"
                {
                    rel physics:body0 = </tron2b_dach/Torso/Geometry/base_link>
                    rel physics:body1 = </tron2b_dach/Base_Dach/Geometry/base_2_Link>
                    bool physics:excludeFromArticulation = false
                    point3f physics:localPos0 = (0.00056, -0.00009, -0.07285)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }
    }
}
