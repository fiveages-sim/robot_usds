#usda 1.0
(
    defaultPrim = "tron2b_dach"
)

# Body=upper: dual arms as robot-root children (W2-style). EE lives on each
# arm component (TRON2B_Arm EE=tron2_gripper). Torso stays via Torso=v1.
def Xform "tron2b_dach"
{
    def "Arm_Left" (
        prepend payload = @../../../components/TRON2B_Arm/TRON2B_Arm.usda@
        variants = {
            string Physics = "physx"
            string EE = "tron2_gripper"
            string Side = "left"
            string Robot = "none"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        # xacro: proximal_pitch_Joint parent=base_link (revolute).
        over "Geometry"
        {
            over "arm_base"
            {
                over "proximal_pitch_Link" (
                    delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                )
                {
                }
            }
        }

        over "Physics"
        {
            over "left_proximal_pitch_Joint"
            {
                rel physics:body0 = </tron2b_dach/Torso/Geometry/base_link>
            }
        }
    }

    def "Arm_Right" (
        prepend payload = @../../../components/TRON2B_Arm/TRON2B_Arm.usda@
        variants = {
            string Physics = "physx"
            string EE = "tron2_gripper"
            string Side = "right"
            string Robot = "none"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Geometry"
        {
            over "arm_base"
            {
                over "proximal_pitch_Link" (
                    delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                )
                {
                }
            }
        }

        over "Physics"
        {
            over "right_proximal_pitch_Joint"
            {
                rel physics:body0 = </tron2b_dach/Torso/Geometry/base_link>
            }
        }
    }
}
