#usda 1.0
(
    defaultPrim = "tron2b_dach"
    doc = """Push Physics=physx onto nested components + M6/W2-style self-col.

ArtRoot self-col ON; NonDexHand mute (body_self_collision_mute.usda) filters
Base/Torso/Arms/Head/Gripper. Future DexHand EE sublayers
payloads/Body/dexhand_self_collision.usda to exclude finger roots.
"""
    metersPerUnit = 1
    subLayers = [
        @./body_self_collision_mute.usda@
    ]
    upAxis = "Z"
)

over "tron2b_dach"
{
    over "Base_Dach" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }

    over "Torso" (
        variants = {
            string Physics = "physics"
        }
    )
    {
        # Live ArtRoot after component merge — M6/W2: self-col ON + NonDexHand.
        over "Geometry"
        {
            over "base_link" (
                prepend apiSchemas = ["PhysxArticulationAPI"]
            )
            {
                bool physxArticulation:enabledSelfCollisions = 1
                int physxArticulation:solverPositionIterationCount = 32
                int physxArticulation:solverVelocityIterationCount = 1
            }
        }
    }

    over "Body_Upper"
    {
        over "Arm_Left" (
            variants = {
                string Physics = "physx"
            }
        )
        {
            over "Geometry"
            {
                over "arm_base"
                {
                    over "proximal_pitch_Link"
                    {
                        over "proximal_roll_Link"
                        {
                            over "proximal_yaw_Link"
                            {
                                over "elbow_Link"
                                {
                                    over "wrist_yaw_Link"
                                    {
                                        over "wrist_pitch_Link"
                                        {
                                            over "wrist_roll_Link"
                                            {
                                                over "tcp"
                                                {
                                                    over "Gripper" (
                                                        variants = {
                                                            string Physics = "physx"
                                                        }
                                                    )
                                                    {
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        over "Arm_Right" (
            variants = {
                string Physics = "physx"
            }
        )
        {
            over "Geometry"
            {
                over "arm_base"
                {
                    over "proximal_pitch_Link"
                    {
                        over "proximal_roll_Link"
                        {
                            over "proximal_yaw_Link"
                            {
                                over "elbow_Link"
                                {
                                    over "wrist_yaw_Link"
                                    {
                                        over "wrist_pitch_Link"
                                        {
                                            over "wrist_roll_Link"
                                            {
                                                over "tcp"
                                                {
                                                    over "Gripper" (
                                                        variants = {
                                                            string Physics = "physx"
                                                        }
                                                    )
                                                    {
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Head_V1" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }
}
