                                                    token physics:approximation = "convexHull"
                                                    float physxCollision:contactOffset = 0.006
                                                    float physxCollision:restOffset = 0.003
                                                    int physxConvexHullCollision:hullVertexLimit = 128
                                                    token purpose = "guide"
                                                    matrix4d xformOp:transform = ( (-1, -1.2246467991473532e-16, -1.004859228696955e-14, 0), (1.004859228696955e-14, -2.2204460492503008e-16, -1, 0), (1.2246467991473308e-16, -1, 2.220446049250313e-16, 0), (-3.71932977472067e-10, -1.1401176447378703e-8, 1.6250610412882338e-8, 1) )
                                                    token[] xformOpOrder = ["xformOp:transform"]
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
