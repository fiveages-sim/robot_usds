#usda 1.0

over "tron2b_dach"
{
    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 0

            over "proximal_pitch_R_Link"
            {
                over "proximal_roll_R_Link"
                {
                    over "proximal_yaw_R_Link"
                    {
                        over "elbow_R_Link"
                        {
                            over "wrist_yaw_R_Link"
                            {
                                over "wrist_pitch_R_Link"
                                {
                                    over "wrist_roll_R_Link"
                                    {
                                        over "grasper_R_crank_left_Link"
                                        {
                                            over "grasper_R_jaw_left_Link"
                                            {
                                                over "jaw_1" (
                                                    active = false
                                                )
                                                {
                                                }

                                                def Mesh "GraspCollision" (
                                                    prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI", "PhysxCollisionAPI"]
                                                    prepend references = @../geometries.usd@</Geometries/grasper_R_jaw_left_Link_0/gripper_jaw_001>
                                                )
                                                {
                                                    token physics:approximation = "convexHull"
                                                    float physxCollision:contactOffset = 0.006
                                                    float physxCollision:restOffset = 0.003
                                                    int physxConvexHullCollision:hullVertexLimit = 128
                                                    token purpose = "guide"
                                                    matrix4d xformOp:transform = ( (1, 0, 0, 0), (0, 2.220446049250313e-16, -1, 0), (0, 1, 2.220446049250313e-16, 0), (-3.71932977472067e-10, 1.1401176447378703e-8, 1.6250610412882338e-8, 1) )
                                                    token[] xformOpOrder = ["xformOp:transform"]
                                                }
                                            }
                                        }

                                        over "grasper_R_crank_right_Link"
                                        {
                                            over "grasper_R_jaw_right_Link"
                                            {
                                                over "jaw_1" (
                                                    active = false
                                                )
                                                {
                                                }

