    over "Physics"
    {
        over "wrist_roll_L_Joint"
        {
            float drive:angular:physics:damping = 1.3962634
            float drive:angular:physics:stiffness = 55.850536
        }

        over "grasper_L_drive_Joint"
        {
            float drive:angular:physics:maxForce = 3
        }

        over "grasper_L_tip_left_Joint" (
            delete apiSchemas = ["NewtonMimicAPI", "PhysicsDriveAPI:angular"]
            prepend apiSchemas = ["PhysxMimicJointAPI:rotX"]
        )
        {
            rel newton:mimicJoint
            float physxMimicJoint:rotX:gearing = 1
            rel physxMimicJoint:rotX:referenceJoint = </tron2b_dach/Physics/grasper_L_drive_Joint>
            token physxMimicJoint:rotX:referenceJointAxis = "rotX"
        }

        over "grasper_L_bar_left_Joint" (
            delete apiSchemas = ["NewtonMimicAPI", "PhysicsDriveAPI:angular"]
            prepend apiSchemas = ["PhysxMimicJointAPI:rotX"]
        )
