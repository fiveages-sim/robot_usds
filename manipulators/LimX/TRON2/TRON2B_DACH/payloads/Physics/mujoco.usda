#usda 1.0
(
    defaultPrim = "tron2b_dach"
    doc = "Push Physics=mujoco onto nested components (Torso/Base stay physics)."
)

over "tron2b_dach"
{
    over "Base_Dach" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }

    over "Torso" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }

    over "Body_Upper"
    {
        over "Arm_Left" (
            variants = {
                string Physics = "mujoco"
            }
        )
        {
            over "Geometry"
            {
                over "arm_base"
                {
                    over "proximal_pitch_Link"
                    {
                        over "proximal_roll_Link"
                        {
                            over "proximal_yaw_Link"
                            {
                                over "elbow_Link"
                                {
                                    over "wrist_yaw_Link"
                                    {
                                        over "wrist_pitch_Link"
                                        {
                                            over "wrist_roll_Link"
                                            {
                                                over "tcp"
                                                {
                                                    over "Gripper" (
                                                        variants = {
                                                            string Physics = "mujoco"
                                                        }
                                                    )
                                                    {
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        over "Arm_Right" (
            variants = {
                string Physics = "mujoco"
            }
        )
        {
            over "Geometry"
            {
                over "arm_base"
                {
                    over "proximal_pitch_Link"
                    {
                        over "proximal_roll_Link"
                        {
                            over "proximal_yaw_Link"
                            {
                                over "elbow_Link"
                                {
                                    over "wrist_yaw_Link"
                                    {
                                        over "wrist_pitch_Link"
                                        {
                                            over "wrist_roll_Link"
                                            {
                                                over "tcp"
                                                {
                                                    over "Gripper" (
                                                        variants = {
                                                            string Physics = "mujoco"
                                                        }
                                                    )
                                                    {
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Head_V1" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
    }
}
