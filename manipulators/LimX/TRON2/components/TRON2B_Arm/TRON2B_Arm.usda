#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tron2b_arm"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "tron2b_arm" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string EE = "none"
        string Side = "default"
        string Robot = "none"
    }
    # Side before EE (M6): Side=left|right redefines EE payloads so Gripper
    # Side is pinned in the payload def (stronger than asset default).
    prepend variantSets = ["Physics", "Side", "EE"]
    append variantSets = ["Robot"]
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {
        }
        "none" {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
    }
    variantSet "EE" = {
        "none" {
        }
        "tron2_gripper" (
            prepend payload = @./payloads/EE/tron2_gripper.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </tron2b_arm/Geometry/arm_base/proximal_pitch_Link/proximal_roll_Link/proximal_yaw_Link/elbow_Link/wrist_yaw_Link/wrist_pitch_Link/wrist_roll_Link/tcp/Gripper>
            prepend rel isaac:physics:robotLinks = </tron2b_arm/Geometry/arm_base/proximal_pitch_Link/proximal_roll_Link/proximal_yaw_Link/elbow_Link/wrist_yaw_Link/wrist_pitch_Link/wrist_roll_Link/tcp/Gripper>
        }
    }
    variantSet "Side" = {
        "default" {
        }
        "left" (
            prepend payload = @./payloads/Side/left.usda@
        ) {
        }
        "right" (
            prepend payload = @./payloads/Side/right.usda@
        ) {
        }
    }
    variantSet "Robot" = {
        "none" {
        }
        "robot" (
            prepend payload = @./payloads/robot.usda@
        ) {
        }
    }
}
