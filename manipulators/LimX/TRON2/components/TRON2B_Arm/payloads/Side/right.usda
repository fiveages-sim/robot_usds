def "tron2b_arm" (
)
{
    delete rel isaac:physics:robotJoints
    prepend rel isaac:physics:robotJoints = [
        </tron2b_arm/Physics/right_proximal_pitch_Joint>,
        </tron2b_arm/Physics/right_proximal_roll_Joint>,
        </tron2b_arm/Physics/right_proximal_yaw_Joint>,
        </tron2b_arm/Physics/right_elbow_Joint>,
        </tron2b_arm/Physics/right_wrist_yaw_Joint>,
