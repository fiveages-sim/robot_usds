                        float physics:mass = 1.21
                        quatf physics:principalAxes = (0.70820445, 0.016625175, -0.7057919, -0.0052798507)

                        over "elbow_Link" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                        )
