                                    over "wrist_roll_Link" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                    )
                                    {
                                        double[] newton:inertia = [0.00025857, 0.00036517, 0.00026664, 5e-7, -0.00000801, -4.6e-7]
