                            )
                            {
                                double[] newton:inertia = [0.00312783, 0.00297221, 0.00104146, -0.00000187, -0.00000507, 0.00006903]
                                point3f physics:centerOfMass = (-0.00013, 0.00206, -0.06635)
                                float3 physics:diagonalInertia = (0.0010389831, 0.0029746476, 0.0031278695)
