    over "Physics"
    {
        def PhysicsRevoluteJoint "proximal_pitch_Joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:maxForce = 200
            float drive:angular:physics:damping = 200.0
            float drive:angular:physics:stiffness = 2000.0
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float newton:velocityLimit = 977.99884
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </tron2b_arm>
            custom rel physics:body1
            append rel physics:body1 = </tron2b_arm/Geometry/arm_base/proximal_pitch_Link>
            point3f physics:localPos0 = (-0.00044, 0.09497, 0.05446)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0.061628185, 0.70441604)
            quatf physics:localRot1 = (0.70710677, 0, 0.061628185, 0.70441604)
            float physics:lowerLimit = -180
            float physics:upperLimit = 149
            custom float urdf:limit:effort = 200
        }

