#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tron2b_arm"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tron2b_arm"
{
    over "Physics"
    {
        over "proximal_pitch_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "proximal_roll_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "proximal_yaw_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "elbow_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_yaw_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_pitch_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_roll_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "proximal_pitch_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 200
            uniform double mjc:forceRange:min = -200
            custom rel mjc:target
            append rel mjc:target = </tron2b_arm/Physics/proximal_pitch_Joint>
        }

        def MjcActuator "proximal_roll_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 200
            uniform double mjc:forceRange:min = -200
            custom rel mjc:target
            append rel mjc:target = </tron2b_arm/Physics/proximal_roll_Joint>
        }

        def MjcActuator "proximal_yaw_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 70
            uniform double mjc:forceRange:min = -70
            custom rel mjc:target
            append rel mjc:target = </tron2b_arm/Physics/proximal_yaw_Joint>
        }

        def MjcActuator "elbow_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 70
            uniform double mjc:forceRange:min = -70
            custom rel mjc:target
            append rel mjc:target = </tron2b_arm/Physics/elbow_Joint>
        }

        def MjcActuator "wrist_yaw_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 15
            uniform double mjc:forceRange:min = -15
            custom rel mjc:target
            append rel mjc:target = </tron2b_arm/Physics/wrist_yaw_Joint>
        }

        def MjcActuator "wrist_pitch_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 15
            uniform double mjc:forceRange:min = -15
            custom rel mjc:target
            append rel mjc:target = </tron2b_arm/Physics/wrist_pitch_Joint>
        }

        def MjcActuator "wrist_roll_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 15
            uniform double mjc:forceRange:min = -15
            custom rel mjc:target
            append rel mjc:target = </tron2b_arm/Physics/wrist_roll_Joint>
        }
    }
}

