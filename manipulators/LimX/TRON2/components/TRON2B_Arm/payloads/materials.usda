#usda 1.0

def Scope "Materials"
{
    def Material "polymer_matte_black"
    {
        token outputs:mdl:surface.connect = </Materials/polymer_matte_black/PBR.outputs:out>
        token outputs:surface.connect = </Materials/polymer_matte_black/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1.0
            color3f inputs:base_color_factor = (0.009721218, 0.011612245, 0.014443844)
            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1.0
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.0
            float inputs:roughness_factor = 0.64
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.009721218, 0.011612245, 0.014443844)
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:ior = 1.5
            float inputs:metallic = 0.0
            float inputs:opacity = 1.0
            float inputs:roughness = 0.64
            token outputs:surface
        }
    }
    def Material "metal_light_gray"
    {
        token outputs:mdl:surface.connect = </Materials/metal_light_gray/PBR.outputs:out>
        token outputs:surface.connect = </Materials/metal_light_gray/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1.0
            # Match torso front cover (tn__base024_VB / metal_medium_gray).
            color3f inputs:base_color_factor = (0.123, 0.133, 0.144)
            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1.0
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.72
            float inputs:roughness_factor = 0.36
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.123, 0.133, 0.144)
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:ior = 1.5
            float inputs:metallic = 0.72
            float inputs:opacity = 1.0
            float inputs:roughness = 0.36
            token outputs:surface
        }
    }
