            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1.0
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.72
            float inputs:roughness_factor = 0.36
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.123, 0.133, 0.144)
