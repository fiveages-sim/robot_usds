        def PhysicsRevoluteJoint "grasper_tip_left_Joint" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsJointStateAPI:angular"]
        )
        {
            float newton:mimicCoef1 = -1
            rel newton:mimicJoint = </tron2b_gripper/Physics/gripper_joint>
            float newton:velocityLimit = 572.9578
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </tron2b_gripper/Geometry/wrist_roll_Link/grasper_base_Link/grasper_crank_left_Link>
