#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tron2b_gripper"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tron2b_gripper"
{
    over "Physics"
    {
        over "gripper_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_tip_left_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_bar_left_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_crank_right_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_tip_right_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_bar_right_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_nut_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_jaw_left_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "grasper_jaw_right_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "gripper_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/gripper_joint>
        }

        def MjcActuator "grasper_tip_left_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_tip_left_Joint>
        }

        def MjcActuator "grasper_bar_left_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_bar_left_Joint>
        }

        def MjcActuator "grasper_crank_right_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_crank_right_Joint>
        }

        def MjcActuator "grasper_tip_right_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_tip_right_Joint>
        }

        def MjcActuator "grasper_bar_right_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_bar_right_Joint>
        }

        def MjcActuator "grasper_nut_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_nut_Joint>
        }

        def MjcActuator "grasper_jaw_left_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_jaw_left_Joint>
        }

        def MjcActuator "grasper_jaw_right_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            custom rel mjc:target
            append rel mjc:target = </tron2b_gripper/Physics/grasper_jaw_right_Joint>
        }
    }
}

