            float inputs:base_alpha = 1.0
            color3f inputs:base_color_factor = (0.009721218, 0.011612245, 0.014443844)
            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1.0
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.0
            float inputs:roughness_factor = 0.64
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.009721218, 0.011612245, 0.014443844)
            color3f inputs:emissiveColor = (0, 0, 0)
