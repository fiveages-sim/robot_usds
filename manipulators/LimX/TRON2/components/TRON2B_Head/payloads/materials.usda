#usda 1.0

def Scope "Materials"
{
    def Material "metal_dark_gray"
    {
        token outputs:mdl:surface.connect = </Materials/metal_dark_gray/PBR.outputs:out>
        token outputs:surface.connect = </Materials/metal_dark_gray/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1.0
            color3f inputs:base_color_factor = (0.053, 0.061, 0.069)
            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1.0
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.65
            float inputs:roughness_factor = 0.39
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.053, 0.061, 0.069)
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:ior = 1.5
            float inputs:metallic = 0.65
            float inputs:opacity = 1.0
            float inputs:roughness = 0.39
            token outputs:surface
        }
    }
    def Material "metal_medium_gray"
