#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tron2b_head"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "tron2b_head" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </tron2b_head/Physics/head_base_Joint>,
        </tron2b_head/Physics/head_yaw_Joint>,
        </tron2b_head/Physics/head_pitch_Joint>,
        </tron2b_head/Physics/head_camera_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </tron2b_head/Geometry/base_link/head_base_Link>,
        </tron2b_head/Geometry/base_link/head_base_Link/head_yaw_Link>,
        </tron2b_head/Geometry/base_link/head_base_Link/head_yaw_Link/head_pitch_Link>,
        </tron2b_head/Geometry/base_link/head_base_Link/head_yaw_Link/head_pitch_Link/head_camera>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link"
        {
            over "head_base_Link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "head_yaw_Link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "head_pitch_Link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "head_camera" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "head_base_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "head_yaw_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "head_pitch_Joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "head_camera_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

