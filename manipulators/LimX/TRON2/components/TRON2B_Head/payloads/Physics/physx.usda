#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tron2b_head"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tron2b_head"
{
    over "Physics"
    {
        over "head_yaw_Joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "head_pitch_Joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

