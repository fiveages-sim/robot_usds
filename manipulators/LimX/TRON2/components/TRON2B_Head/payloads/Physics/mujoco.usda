#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "tron2b_head"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tron2b_head"
{
    over "Physics"
    {
        over "head_yaw_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "head_pitch_Joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "head_yaw_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 15
            uniform double mjc:forceRange:min = -15
            custom rel mjc:target
            append rel mjc:target = </tron2b_head/Physics/head_yaw_Joint>
        }

        def MjcActuator "head_pitch_Joint_actuator"
        {
            uniform double mjc:forceRange:max = 15
            uniform double mjc:forceRange:min = -15
            custom rel mjc:target
            append rel mjc:target = </tron2b_head/Physics/head_pitch_Joint>
        }
    }
}

