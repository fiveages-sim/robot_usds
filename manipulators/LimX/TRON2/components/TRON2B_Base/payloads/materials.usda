#usda 1.0

def Scope "Materials"
{
    def Material "silver"
    {
        token outputs:mdl:surface.connect = </Materials/silver/PBR.outputs:out>
        token outputs:surface.connect = </Materials/silver/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.55, 0.55, 0.55)
            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.85
            float inputs:roughness_factor = 0.28
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.55, 0.55, 0.55)
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:ior = 1.5
            float inputs:metallic = 0.85
            float inputs:opacity = 1
            float inputs:roughness = 0.28
            token outputs:surface
        }
    }
    def Material "black_metal"
    {
        token outputs:mdl:surface.connect = </Materials/black_metal/PBR.outputs:out>
        token outputs:surface.connect = </Materials/black_metal/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.03, 0.03, 0.03)
            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.8
            float inputs:roughness_factor = 0.35
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:ior = 1.5
            float inputs:metallic = 0.8
            float inputs:opacity = 1
            float inputs:roughness = 0.35
            token outputs:surface
        }
    }
    def Material "metal_dark_gray_003"
    {
        token outputs:mdl:surface.connect = </Materials/metal_dark_gray_003/PBR.outputs:out>
        token outputs:surface.connect = </Materials/metal_dark_gray_003/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1.0
            color3f inputs:base_color_factor = (0.053, 0.061, 0.069)
            color3f inputs:emissive_factor = (0, 0, 0)
            float inputs:emissive_strength = 1.0
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.65
            float inputs:roughness_factor = 0.39
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.053, 0.061, 0.069)
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:ior = 1.5
            float inputs:metallic = 0.65
            float inputs:opacity = 1.0
            float inputs:roughness = 0.39
            token outputs:surface
        }
    }
}
