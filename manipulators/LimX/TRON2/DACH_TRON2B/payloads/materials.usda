#usda 1.0

def Scope "Materials"
{
    def Material "accent_red"
    {
        token outputs:mdl:surface.connect = </Materials/accent_red/PBR.outputs:out>
        token outputs:surface.connect = </Materials/accent_red/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.5647115, 0.02518686, 0.01850022)
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0.25
            float inputs:roughness_factor = 0.33
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.5647115, 0.02518686, 0.01850022)
            float inputs:ior = 1.5
            float inputs:metallic = 0.25
            float inputs:opacity = 1
            float inputs:roughness = 0.33
            token outputs:surface
        }
    }

    def Material "light_blue"
    {
        token outputs:mdl:surface.connect = </Materials/light_blue/PBR.outputs:out>
        token outputs:surface.connect = </Materials/light_blue/Preview.outputs:surface>

        def Shader "PBR"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.009721218, 0.59061885, 1)
            color3f inputs:emissive_factor = (0.009721218, 0.59061885, 1)
            float inputs:emissive_strength = 2.2
            float inputs:ior = 1.5
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.26
            token outputs:out
        }

        def Shader "Preview"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.009721218, 0.59061885, 1)
            color3f inputs:emissiveColor = (0.02138668, 1.2993615, 2.2)
            float inputs:ior = 1.5
            float inputs:metallic = 0
            float inputs:opacity = 1
            float inputs:roughness = 0.26
            token outputs:surface
        }
    }

