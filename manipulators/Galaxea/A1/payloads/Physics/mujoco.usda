#usda 1.0
(
    defaultPrim = "Galaxea_A1"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Galaxea_A1"
{
    over "joints"
    {
        # PhysX DriveAPI (kp=200, kd=10) -> MjcActuator position PD
        # F = kp*(ctrl - q) - kd*qdot
        # forceRange / ctrlRange from physics.usda maxForce / limits
        over "joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint5" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "joint6" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "left_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "left_joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "left_joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "left_joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "left_joint5" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "left_joint6" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "right_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "right_joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "right_joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "right_joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "right_joint5" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        over "right_joint6" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
        }

        # Side-specific joints/actuators live in payloads/Side/{left,right}.usda
    }

    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    def Scope "actuators"
    {
        def MjcActuator "joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -165.00038
            uniform double mjc:ctrlRange:max = 165.00038
            rel mjc:target = </Galaxea_A1/joints/joint1>
        }

        def MjcActuator "joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0
            uniform double mjc:ctrlRange:max = 185.00233
            rel mjc:target = </Galaxea_A1/joints/joint2>
        }

        def MjcActuator "joint3"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -189.99852
            uniform double mjc:ctrlRange:max = 0
            rel mjc:target = </Galaxea_A1/joints/joint3>
        }

        def MjcActuator "joint4"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -165.00038
            uniform double mjc:ctrlRange:max = 165.00038
            rel mjc:target = </Galaxea_A1/joints/joint4>
        }

        def MjcActuator "joint5"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -95.00213
            uniform double mjc:ctrlRange:max = 95.00213
            rel mjc:target = </Galaxea_A1/joints/joint5>
        }

        def MjcActuator "joint6"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -165.00038
            uniform double mjc:ctrlRange:max = 165.00038
            rel mjc:target = </Galaxea_A1/joints/joint6>
        }
    }
}
