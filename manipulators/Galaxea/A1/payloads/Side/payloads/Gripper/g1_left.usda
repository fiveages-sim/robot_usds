#usda 1.0
(
    defaultPrim = "Galaxea_A1"
)

# Same prim path as g1.usda / g1_right.usda so Side switches stay on /Galaxea_A1/Galaxea_G1
# Mount orient/localRot restored from legacy g1_left.usd (left-arm mount flange).
def Xform "Galaxea_A1"
{
    def "Galaxea_G1" (
        prepend payload = @../../../../../G1/G1.usda@
        variants = {
            string Sensor = "d405"
            string Side = "left"
        }
    )
    {
        # +90 deg about X vs default flange
        quatd xformOp:orient = (0.7071067811865476, 0.7071067811865475, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.085404, -5.350488496702576e-9, 0.24046629667282104)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "root_joint" (
            active = false
        )
        {
        }

        over "gripper_base"
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </Galaxea_A1/link6>
                rel physics:body1 = </Galaxea_A1/Galaxea_G1/gripper_base>
                point3f physics:localPos0 = (0.103899695, 0, 0)
                point3f physics:localPos1 = (-2.548933e-9, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "finger1"
        {
        }

        over "finger2"
        {
        }

        over "joints"
        {
            over "left_gripper_joint"
            {
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
            }

            over "left_gripper_joint2"
            {
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
            }
        }
    }

    over "joints"
    {
        over "left_joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "left_joint6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}
