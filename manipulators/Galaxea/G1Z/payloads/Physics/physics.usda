over "Galaxea_G1Z"
{
    over "gripper_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.04156509, 0.000024750001, -0.000092170005)
        float3 physics:diagonalInertia = (0.000033821034, 0.000639181, 0.000414538)
        float physics:mass = 0.5566554
        quatf physics:principalAxes = (0.93486, -0.0030031258, -0.00059919956, -0.35500363)
    }

    over "finger1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.02727101, -0.02205781, 0.00984327)
        float3 physics:diagonalInertia = (0.000038577848, 0.00014401008, 0.00015614208)
        float physics:mass = 0.137868
        quatf physics:principalAxes = (0.93042344, -0.13673972, -0.10351319, -0.3238818)
    }

    over "joints"
    {
        def PhysicsPrismaticJoint "gripper_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 0.0002572312
            float drive:linear:physics:maxForce = 10
            float drive:linear:physics:stiffness = 0.643078
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </Galaxea_G1Z/gripper_base>
            custom rel physics:body1
            prepend rel physics:body1 = </Galaxea_G1Z/finger1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.0010289248
            point3f physics:localPos0 = (0.0727, 0.025, -0.018)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.05
        }

        def PhysicsPrismaticJoint "gripper_joint2" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </Galaxea_G1Z/gripper_base>
            custom rel physics:body1
            prepend rel physics:body1 = </Galaxea_G1Z/finger2>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.0010939087
            point3f physics:localPos0 = (0.0727, -0.025, 0.018)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.010000001
            float physics:upperLimit = 0.060000002
        }
    }

    over "finger2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.02727101, 0.02205781, -0.00976829)
        float3 physics:diagonalInertia = (0.00003855451, 0.00014386437, 0.00015597114)
        float physics:mass = 0.137868
        quatf physics:principalAxes = (0.9309794, -0.1340635, 0.103318326, 0.32346535)
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </Galaxea_G1Z/gripper_base>
