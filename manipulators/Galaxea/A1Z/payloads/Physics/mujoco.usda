#usda 1.0
(
    customLayerData = {
        dictionary omni_layer = {
            string authoring_layer = "./mujoco.usda"
        }
    }
    defaultPrim = "Galaxea_A1Z"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Galaxea_A1Z"
{
    over "joints"
    {
        # PhysX DriveAPI (kp=200, kd=10) -> MjcActuator position PD
        over "joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -20
            uniform double mjc:actuatorfrcrange:max = 20
        }
        over "joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -25
            uniform double mjc:actuatorfrcrange:max = 25
        }
        over "joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -20
            uniform double mjc:actuatorfrcrange:max = 20
        }
        over "joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -9
            uniform double mjc:actuatorfrcrange:max = 9
        }
        over "joint5" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3.5
            uniform double mjc:actuatorfrcrange:max = 3.5
        }
        over "joint6" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -3.5
            uniform double mjc:actuatorfrcrange:max = 3.5
        }
        over "left_joint1" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "right_joint1" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "left_joint2" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "right_joint2" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "left_joint3" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "right_joint3" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "left_joint4" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "right_joint4" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "left_joint5" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "right_joint5" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "left_joint6" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        over "right_joint6" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }
        # Side-specific MjcActuator live in payloads/Side/{left,right}.usda
    }

    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    def Scope "actuators"
    {
        def MjcActuator "joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -20
            uniform double mjc:forceRange:max = 20
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -119.97736
            uniform double mjc:ctrlRange:max = 119.97736
            rel mjc:target = </Galaxea_A1Z/joints/joint1>
        }
        def MjcActuator "joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -25
            uniform double mjc:forceRange:max = 25
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0
            uniform double mjc:ctrlRange:max = 180.02333
            rel mjc:target = </Galaxea_A1Z/joints/joint2>
        }
        def MjcActuator "joint3"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -20
            uniform double mjc:forceRange:max = 20
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -180.02333
            uniform double mjc:ctrlRange:max = 0
            rel mjc:target = </Galaxea_A1Z/joints/joint3>
        }
        def MjcActuator "joint4"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -9
            uniform double mjc:forceRange:max = 9
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -75.000175
            uniform double mjc:ctrlRange:max = 75.000175
            rel mjc:target = </Galaxea_A1Z/joints/joint4>
        }
        def MjcActuator "joint5"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3.5
            uniform double mjc:forceRange:max = 3.5
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -85.02693
            uniform double mjc:ctrlRange:max = 85.02693
            rel mjc:target = </Galaxea_A1Z/joints/joint5>
        }
        def MjcActuator "joint6"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -3.5
            uniform double mjc:forceRange:max = 3.5
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -114.99262
            uniform double mjc:ctrlRange:max = 114.99262
            rel mjc:target = </Galaxea_A1Z/joints/joint6>
        }
    }
}
