def Xform "Galaxea_G1" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string Robot = "robot"
        string Sensor = "none"
        string Side = "default"
    }
    prepend variantSets = "Side"
    append variantSets = ["Physics", "Robot", "Sensor"]
)
{
    string isaac:description = "Galaxea G1 Gripper"
    string isaac:namespace = ""
    token isaac:robotType = "End Effector"

    over "gripper_base"
    {
    }

    over "finger1"
    {
    }

    over "finger2"
    {
        string isaac:nameOverride (
            displayName = "Name Override"
        )
    }

    over "joints"
    {
        over "gripper_joint"
        {
            float drive:linear:physics:damping = 10
            float drive:linear:physics:stiffness = 100
            float drive:linear:physics:targetPosition = 0
