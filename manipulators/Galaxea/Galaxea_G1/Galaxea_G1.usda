            float physics:lowerLimit = 0
            float physics:upperLimit = 0.05
            float state:linear:physics:position = 2.6704035e-18
            float state:linear:physics:velocity = 0
        }

        over "left_gripper_joint2"
        {
            float state:linear:physics:position = 4.56879e-17
