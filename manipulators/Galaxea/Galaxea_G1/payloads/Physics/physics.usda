over "Galaxea_G1"
{
    over "gripper_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.031107232, 1.1797998e-8, 7.9339465e-8)
        float3 physics:diagonalInertia = (0.00017588155, 0.00009863783, 0.00016512137)
        float physics:mass = 0.604
        quatf physics:principalAxes = (0.9999998, 0.0006157069, -0.000024660943, -4.0323602e-7)
    }

    over "finger1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.01958959, -0.015113684, 0.0054225437)
        float3 physics:diagonalInertia = (0.0000023577518, 0.000005752051, 0.000006491506)
        float physics:mass = 0.027
        quatf physics:principalAxes = (0.9972001, -0.045531727, 0.007974592, -0.058781225)
    }

    over "joints"
    {
        def PhysicsPrismaticJoint "gripper_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 1
            float drive:linear:physics:maxForce = 10
            float drive:linear:physics:stiffness = 10
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </Galaxea_G1/gripper_base>
            custom rel physics:body1
            prepend rel physics:body1 = </Galaxea_G1/finger1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.000021223641
            point3f physics:localPos0 = (0.03689, 0.013453, 0.00012059)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.05
        }

        def PhysicsPrismaticJoint "gripper_joint2" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </Galaxea_G1/gripper_base>
            custom rel physics:body1
            prepend rel physics:body1 = </Galaxea_G1/finger2>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.000021223646
            point3f physics:localPos0 = (0.03689, -0.013453, -0.00012059)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = -0.010000001
            float physics:upperLimit = 0.060000002
        }
    }

    over "finger2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.019589586, 0.015113689, -0.0054225437)
        float3 physics:diagonalInertia = (0.0000023577516, 0.00000575205, 0.000006491506)
        float physics:mass = 0.027
        quatf physics:principalAxes = (0.9972001, -0.04553169, -0.007974583, 0.058781117)
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </Galaxea_G1/gripper_base>
    }
