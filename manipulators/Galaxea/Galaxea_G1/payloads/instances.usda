                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/gripper_metal>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "gripper_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/gripper_metal>
            )
            {
            }

            def Material "grey" (
                instanceable = true
