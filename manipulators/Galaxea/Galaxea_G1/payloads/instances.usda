def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh/VisualMaterials/motor>
        }

        def Scope "VisualMaterials"
        {
            def Material "motor" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/motor>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh_1/VisualMaterials/motor>
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"
        }

        def Scope "VisualMaterials"
        {
            def Material "motor" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/motor>
            )
            {
            }
        }
    }

