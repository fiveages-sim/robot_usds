#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (0.14868354978227344, 0.12028593473477017, 0.350627366072111)
                double3 target = (-0.03457060757373165, -0.007913817416699248, -0.037284507850202486)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./mujoco.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Galaxea_G1"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Galaxea_G1"
{
    over "joints"
    {
        # Drive joints: PhysX DriveAPI -> MjcActuator position PD
        # Galaxea_G1.usda interface uses kp=100, kd=10; physics maxForce=10
        over "gripper_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            uniform double mjc:armature = 0.001
            uniform double mjc:damping = 0.01
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -10
            uniform double mjc:actuatorfrcrange:max = 10
        }

        over "gripper_joint2" (
            prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear"]
        )
        {
            uniform double mjc:armature = 0.001
            uniform double mjc:damping = 0.01
            bool newton:mimicEnabled = 1
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1
            rel newton:mimicJoint = </Galaxea_G1/joints/gripper_joint>
        }

        # Side-specific gripper joints/actuators live in payloads/Side/mujoco_{left,right}.usda
    }

    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    # Position actuator for default-side driven finger only.
    def Scope "actuators"
    {
        def MjcActuator "gripper_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -100, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -10
            uniform double mjc:forceRange:max = 10
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0
            uniform double mjc:ctrlRange:max = 0.05
            rel mjc:target = </Galaxea_G1/joints/gripper_joint>
        }
    }
}
