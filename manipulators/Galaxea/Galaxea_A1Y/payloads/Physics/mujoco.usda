#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (0.23737665316431572, 0.3061981396261718, 0.4775422300753622)
                double3 target = (-0.10299568940766135, -0.03417420294580514, 0.13716989562747056)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./mujoco.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Galaxea_A1Y"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "Galaxea_A1Y"
{
    over "joints"
    {
        # PhysX DriveAPI -> MjcActuator position PD
        # F = kp*(ctrl - q) - kd*qdot  (kp=200, kd=10)
        # ctrlRange / forceRange match A1Y physics.usda limits / maxForce
        over "joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -27
            uniform double mjc:actuatorfrcrange:max = 27
        }

        over "joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -50
            uniform double mjc:actuatorfrcrange:max = 50
        }

        over "joint3" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -27
            uniform double mjc:actuatorfrcrange:max = 27
        }

        over "joint4" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -14
            uniform double mjc:actuatorfrcrange:max = 14
        }

        over "joint5" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -14
            uniform double mjc:actuatorfrcrange:max = 14
        }

        over "joint6" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -14
            uniform double mjc:actuatorfrcrange:max = 14
        }

        # Side-specific joints/actuators live in payloads/Side/{left,right}.usda
    }

    over "root_joint" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    def Scope "actuators"
    {
        def MjcActuator "joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -27
            uniform double mjc:forceRange:max = 27
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -165.00009
            uniform double mjc:ctrlRange:max = 165.00009
            rel mjc:target = </Galaxea_A1Y/joints/joint1>
        }

        def MjcActuator "joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -50
            uniform double mjc:forceRange:max = 50
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0
            uniform double mjc:ctrlRange:max = 180
            rel mjc:target = </Galaxea_A1Y/joints/joint2>
        }

        def MjcActuator "joint3"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -27
            uniform double mjc:forceRange:max = 27
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -190.00008
            uniform double mjc:ctrlRange:max = 0
            rel mjc:target = </Galaxea_A1Y/joints/joint3>
        }

        def MjcActuator "joint4"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -14
            uniform double mjc:forceRange:max = 14
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -165.00009
            uniform double mjc:ctrlRange:max = 165.00009
            rel mjc:target = </Galaxea_A1Y/joints/joint4>
        }

        def MjcActuator "joint5"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -14
            uniform double mjc:forceRange:max = 14
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -105.00007
            uniform double mjc:ctrlRange:max = 105.00007
            rel mjc:target = </Galaxea_A1Y/joints/joint5>
        }

        def MjcActuator "joint6"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -14
            uniform double mjc:forceRange:max = 14
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -165.00009
            uniform double mjc:ctrlRange:max = 165.00009
            rel mjc:target = </Galaxea_A1Y/joints/joint6>
        }
    }
}
