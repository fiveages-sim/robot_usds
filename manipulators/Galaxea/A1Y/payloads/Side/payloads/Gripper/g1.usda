#usda 1.0
(
    defaultPrim = "Galaxea_A1Y"
)

# Same prim path as g1_left.usda / g1_right.usda so Side switches stay on /Galaxea_A1Y/Galaxea_G1
def Xform "Galaxea_A1Y"
{
    def "Galaxea_G1" (
        prepend payload = @../../../../../G1/G1.usda@
        variants = {
            string Sensor = "d405"
            string Side = "default"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.058853, -5.699694156646729e-7, 0.21078501641750336)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "root_joint" (
            active = false
        )
        {
        }

        over "gripper_base"
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </Galaxea_A1Y/link6>
                rel physics:body1 = </Galaxea_A1Y/Galaxea_G1/gripper_base>
                point3f physics:localPos0 = (0.081650004, 0, 0)
                point3f physics:localPos1 = (-3.3228398e-9, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "finger1"
        {
        }

        over "finger2"
        {
        }

        over "joints"
        {
            over "gripper_joint"
            {
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
            }

            over "gripper_joint2"
            {
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
            }
        }
    }

    over "joints"
    {
        over "joint1"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint2"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint3"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint4"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint5"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        over "joint6"
        {
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }
}
