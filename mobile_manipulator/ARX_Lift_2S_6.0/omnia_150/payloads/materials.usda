    def Material "wheel_rubber"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/wheel_rubber/wheel_rubber.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/wheel_rubber/wheel_rubber.outputs:out>
