            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./omnia_150.usd"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "omnia_150"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "omnia_150"
{
    over "joints"
    {
        over "wheel_passive_0_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = inf
        }

        over "wheel_passive_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
