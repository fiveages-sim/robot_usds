#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (3.2917976709938777, 3.291797670993879, 3.2917977117656445)
                double3 target = (-3.978038476404322e-8, -3.978038209950796e-8, 7.956076819581881e-8)
