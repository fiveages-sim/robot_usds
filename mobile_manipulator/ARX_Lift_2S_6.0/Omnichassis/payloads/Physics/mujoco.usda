#usda 1.0
(
    defaultPrim = "Omnichassis"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

# Placeholder cleaned for composition. Omnichassis.usda does not yet
# register a "mujoco" Physics variant; keep this layer valid if added later.
def "Omnichassis"
{
    over "base_link" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    over "joints"
    {
        over "lift_joint" (
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
        }

        over "wheel1_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
        }

        over "wheel2_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
        }

        over "wheel3_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
        }
    }

    over "wheel_1"
    {
        float physics:mass = 0.01
    }

    over "wheel_2"
    {
        float physics:mass = 0.01
    }

    over "wheel_3"
    {
        float physics:mass = 0.01
    }
}
