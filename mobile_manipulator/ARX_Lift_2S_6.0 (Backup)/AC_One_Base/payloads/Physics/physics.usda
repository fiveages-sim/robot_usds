(
    defaultPrim = "AC_One_Base"
    doc = """Generated from Composed Stage of root layer /home/fiveages/distrobox/ubuntu24/FaSim-Isaac/robots/mobile_base/ARX_Lift_2S/AC_One_Base/AC_One_Base.usd


