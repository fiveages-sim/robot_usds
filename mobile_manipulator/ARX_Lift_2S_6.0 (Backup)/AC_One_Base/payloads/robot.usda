#usda 1.0
(
    defaultPrim = "AC_One_Base"
    doc = """Generated from Composed Stage of root layer /home/fiveages/distrobox/ubuntu24/FaSim-Isaac/robots/mobile_base/ARX_Lift_2S/AC_One_Base/AC_One_Base.usd
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "AC_One_Base" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = </AC_One_Base/root_joint>
    prepend rel isaac:physics:robotLinks = </AC_One_Base/base_link>

    over "base_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "root_joint" (
        prepend apiSchemas = ["IsaacJointAPI"]
    )
    {
    }
}

