                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom double inputs:timeStamp
                prepend double inputs:timeStamp.connect = </Galaxea_R1_Lite/Graph/ROS_JointStates/ReadSimTime.outputs:simulationTime>
