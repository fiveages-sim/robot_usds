                uniform token ui:nodegraph:node:expansionState = "open"
                uniform float2 ui:nodegraph:node:pos = (811.57446, 217.67787)
            }

            def OmniGraphNode "articulation_controller_01" (
                apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                custom double[] inputs:effortCommand
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                uint inputs:execIn.connect = </Galaxea_R1_Lite/Graph/ROS_Steering_Controller/script_node.outputs:execOut>
                custom int[] inputs:jointIndices
                custom token[] inputs:jointNames
                token[] inputs:jointNames.connect = </Galaxea_R1_Lite/Graph/ROS_Steering_Controller/script_node.outputs:Wheel_Joints>
                custom double[] inputs:positionCommand
                custom string inputs:robotPath
                custom rel inputs:targetPrim = </Galaxea_R1_Lite/base_link> (
                    customData = {
