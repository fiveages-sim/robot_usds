                token[] inputs:jointNames.connect = </Galaxea_R1_Lite/Graph/ROS_Steering_Controller/script_node.outputs:Steer_Joints>
                custom double[] inputs:positionCommand
                double[] inputs:positionCommand.connect = </Galaxea_R1_Lite/Graph/ROS_Steering_Controller/script_node.outputs:Steer_Position_Command>
