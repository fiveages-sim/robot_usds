#usda 1.0
(
    customLayerData = {
        dictionary omni_layer = {
            string authoring_layer = "./galaxea_a1y.usda"
        }
    }
    defaultPrim = "Galaxea_R1_Lite"
)

# Same prim path as none/a1x: /Galaxea_R1_Lite/torso_link3/right_base_link/Galaxea_Arm_Right
def Xform "Galaxea_R1_Lite"
{
    over "torso_link3"
    {
        over "right_base_link"
        {
            def "Galaxea_Arm_Right" (
                prepend payload = @../../../../../../manipulators/Galaxea/Galaxea_A1Y/Galaxea_A1Y.usda@
                variants = {
                    string ROS = "none"
                    string Side = "right"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                # Merge into chassis articulation; avoid PhysX looking at arm root_joint as artic root
                over "root_joint" (
                    active = false
                    delete apiSchemas = ["PhysicsArticulationRootAPI"]
                )
                {
                }

                over "base_link"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Galaxea_R1_Lite/torso_link3>
                        rel physics:body1 = </Galaxea_R1_Lite/torso_link3/right_base_link/Galaxea_Arm_Right/base_link>
                        point3f physics:localPos0 = (0, -0.335, 0.12306)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "right_joint1"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_joint2"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_joint3"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_joint4"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_joint5"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_joint6"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }
                }
            }
        }
    }
}
