#usda 1.0
(
    customLayerData = {
        dictionary omni_layer = {
            string authoring_layer = "./galaxea_a1x.usda"
        }
    }
    defaultPrim = "Galaxea_R1_Lite"
)

# Same prim path as none/a1y: /Galaxea_R1_Lite/torso_link3/left_base_link/Galaxea_Arm_Left
# Do NOT author Physics here — VariantSwitcher writes it on the session layer.
def Xform "Galaxea_R1_Lite"
{
    over "torso_link3"
    {
        over "left_base_link"
        {
            def "Galaxea_Arm_Left" (
                prepend payload = @../../../../../../manipulators/Galaxea/Galaxea_A1X/Galaxea_A1X.usda@
                variants = {
                    string ROS = "none"
                    string Side = "left"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "base_link"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Galaxea_R1_Lite/torso_link3>
                        rel physics:body1 = </Galaxea_R1_Lite/torso_link3/left_base_link/Galaxea_Arm_Left/base_link>
                        point3f physics:localPos0 = (0, 0.335, 0.12306)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "left_joint1"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint2"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint3"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint4"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint5"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint6"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }
                }
            }
        }
    }
}
