def Xform "Cobot_Magic_V2" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string Chassis = "Tracer_V2"
        string Arm_Left = "Piper"
        string Arm_Right = "Piper"
        string Robot = "none"
        string Sensor = "sensors"
    }
    prepend variantSets = ["Physics", "Chassis", "Arm_Left", "Arm_Right"]
    append variantSets = ["Robot", "Sensor"]
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
            append references = @./payloads/Physics/body_self_collision_mute_newton.usda@</Cobot_Magic_V2>
        ) {

        }
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
    variantSet "Chassis" = {
        "None" {

        }
        "Tracer_V1" (
            prepend payload = @./payloads/Chassis/tracer_v1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/Tracer>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/Tracer>
        }
        "Tracer_V2" (
            prepend payload = @./payloads/Chassis/tracer_v2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/Tracer>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/Tracer>
        }
    }
    variantSet "Arm_Left" = {
        "None" {

        }
        "Piper" (
            prepend payload = @./payloads/Arm_Left/piper.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
        }
        "Piper_H" (
            prepend payload = @./payloads/Arm_Left/piper_h.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
        }
        "Piper_X" (
            prepend payload = @./payloads/Arm_Left/piper_x.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
        }
        "Piper_L" (
            prepend payload = @./payloads/Arm_Left/piper_l.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/base_footprint/body_Link/left_base_link/Piper>
        }
    }
    variantSet "Arm_Right" = {
        "None" {

        }
        "Piper" (
            prepend payload = @./payloads/Arm_Right/piper.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/right_base_link/Piper>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/base_footprint/body_Link/right_base_link/Piper>
        }
        "Piper_H" (
            prepend payload = @./payloads/Arm_Right/piper_h.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/right_base_link/Piper>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/base_footprint/body_Link/right_base_link/Piper>
        }
        "Piper_X" (
            prepend payload = @./payloads/Arm_Right/piper_x.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/right_base_link/Piper>
            prepend rel isaac:physics:robotLinks = </Cobot_Magic_V2/base_footprint/body_Link/right_base_link/Piper>
        }
        "Piper_L" (
            prepend payload = @./payloads/Arm_Right/piper_l.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Cobot_Magic_V2/base_footprint/body_Link/right_base_link/Piper>
