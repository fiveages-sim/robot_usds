#usda 1.0
(
    defaultPrim = "Cobot_Magic_V2"
    metersPerUnit = 1
    startTimeCode = -1
    endTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Cobot_Magic_V2"
{
    over "Tracer" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "base_footprint"
    {
        over "body_Link"
        {
            over "left_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }
            }

            over "right_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }
            }
        }
    }
}
