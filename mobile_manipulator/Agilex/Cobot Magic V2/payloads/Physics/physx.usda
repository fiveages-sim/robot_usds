#usda 1.0
(
    defaultPrim = "Cobot_Magic_V2"
    metersPerUnit = 1
    startTimeCode = -1
    endTimeCode = 0
    subLayers = [
        @./physics.usda@,
        @./body_self_collision_mute.usda@
    ]
    upAxis = "Z"
)

over "Cobot_Magic_V2"
{
    over "Tracer" (
        variants = {
            string Physics = "physx"
        }
    )
    {
        # On for any arm/EE mix; NonDexHand (body_self_collision_mute.usda)
        # mutes body/chassis/arm. Piper EE dexhand_self_collision excludes
        # Revo1/Revo2 fingers from the nested arm group.
        bool physxArticulation:enabledSelfCollisions = 1
    }

    over "base_footprint"
    {
        over "body_Link"
        {
            over "left_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }
            }

            over "right_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "physx"
                    }
                )
                {
                }
            }
        }
    }
}
