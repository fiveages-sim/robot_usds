#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (2.952815195706574, -1.2851914152960873, 1.1314021098754543)
                double3 target = (-4.621459058246765, 2.928578306989559, -0.18543921796834528)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary metricsAssembler = {
            dictionary "/Cobot_Magic_V2/dabai" = {
            }
            dictionary "/Cobot_Magic_V2/mid360" = {
            }
            int version = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./Agilex_Aloha_V2.usd"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Cobot_Magic_V2"
    endTimeCode = 0
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

over "Cobot_Magic_V2"
{
    over "Tracer" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }

    over "base_footprint" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        # Upper box + camera stand only (~mesh mass). Keep mass; lower COM z
        # so arm reach does not pitch the platform (chassis ballast is on Tracer).
        point3f physics:centerOfMass = (0.02, 0, 0.10)
        float3 physics:diagonalInertia = (0.11673747, 0.06795954, 0.08867165)
        float physics:mass = 3.8046699
        quatf physics:principalAxes = (1, 0, 0, 0)

        over "body_Link"
        {
            over "left_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "physics"
                    }
                )
                {
                }
            }

            over "right_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "physics"
                    }
                )
                {
                }
            }
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI"]
)
{
}

