#usda 1.0
(
    defaultPrim = "Cobot_Magic_V2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Cobot_Magic_V2"
{
    over "base_footprint"
    {
        # NEWTON: self-col ON via Tracer art-root. Body/chassis mute via
        # Cobot_Magic_V2 Physics=mujoco append-ref body_self_collision_mute_newton
        # (no Piper paths). Arms: Piper arm_self_collision_mute_newton.
        uniform float mjc:gravcomp = 0

        over "body_Link"
        {
            over "left_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "mujoco"
                    }
                )
                {
                }
            }

            over "right_base_link"
            {
                over "Piper" (
                    variants = {
                        string Physics = "mujoco"
                    }
                )
                {
                }
            }
        }
    }

    over "Tracer" (
        variants = {
            string Physics = "mujoco"
        }
    )
    {
        bool newton:selfCollisionEnabled = 1
    }
}
