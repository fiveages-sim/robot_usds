#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.356713823171096, -1.364912956395908, 0.7834301684875337)
                double3 target = (-1.292766514041617, 1.6247877509392017, -0.19004519128799202)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary metricsAssembler = {
            dictionary "/Cobot_Magic_V1/base_footprint/body_link/camera_stand2/camera_link2/camera2/d435" = {
            }
            dictionary "/Cobot_Magic_V1/base_footprint/body_link/lidar_link/mid360" = {
            }
            int version = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./sensors.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Cobot_Magic_V1"
    endTimeCode = 0
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

def Xform "Cobot_Magic_V1"
{
    over "base_footprint"
    {
        over "body_link"
        {
            over "camera_stand2"
            {
                over "camera_link2"
                {
                    over "camera2"
                    {
                        # Optical Camera looks -Z; camera2 looks +Z → Camera Rx180.
                        # Sibling of d435 mesh — not under d435's compensate xform.
                        # D435 RGB 16:9 H69° V42°: aperture = 2 f tan(fov/2).
                        def Camera "head_camera"
                        {
                            float2 clippingRange = (0.01, 10000000)
                            float focalLength = 18.147562
                            float focusDistance = 400
                            float horizontalAperture = 24.95
                            token projection = "perspective"
                            float verticalAperture = 13.936
                            quatd xformOp:orient = (0, 1, 0, 0)
                            double3 xformOp:scale = (1, 1, 1)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                        }

                        def "d435" (
                            prepend payload = @../../../../../sensors/realsense/d435.usd@
                        )
                        {
                            double xformOp:rotateX = 90
                            double xformOp:rotateX:unitsResolve = 90
                            double xformOp:rotateZ = 90
                            float3 xformOp:scale = (1, 1, 1)
                            double3 xformOp:translate = (0, 0, 0)
                            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX:unitsResolve", "xformOp:rotateZ", "xformOp:rotateX", "xformOp:scale"]
                        }
                    }
                }
            }

            over "lidar_link"
            {
                def "mid360" (
                    prepend payload = @../../../../../sensors/mid360.usd@
                )
                {
                    quatf xformOp:orient = (1, 0, 0, 0)
                    double xformOp:rotateX:unitsResolve = 90
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                }
            }
        }
    }
}
