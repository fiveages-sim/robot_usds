    def Material "white_metal"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/white_metal/white_metal.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/white_metal/white_metal.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/white_metal/white_metal.outputs:out>
