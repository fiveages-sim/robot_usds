            displayGroup = "Outputs"
        )

        def Shader "white_metal" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @OmniPBR.mdl@
            token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            color3f inputs:diffuse_color_constant = (0.8, 0.8, 0.8) (
                customData = {
                    float3 default = (1, 1, 1)
                    dictionary range = {
                        float3 max = (1, 1, 1)
                        float3 min = (0, 0, 0)
                    }
                }
                displayGroup = "Albedo"
            )
            color3f inputs:emissive_color = (1, 1, 1) (
                customData = {
                    float3 default = (1, 1, 1)
                    dictionary range = {
                        float3 max = (1, 1, 1)
                        float3 min = (0, 0, 0)
                    }
                }
                displayGroup = "Emissive"
            )
            float inputs:emissive_intensity = 10000 (
                customData = {
                    double default = 10000
                    dictionary range = {
                        double max = 100000
                        double min = 0
                    }
                }
                displayGroup = "Emissive"
            )
            bool inputs:enable_emission = 0 (
                customData = {
                    bool default = 0
                }
                displayGroup = "Emissive"
            )
            bool inputs:enable_opacity = 0 (
                customData = {
                    bool default = 0
                }
                displayGroup = "Opacity"
            )
            bool inputs:enable_opacity_texture = 0 (
                customData = {
                    bool default = 0
                }
                displayGroup = "Opacity"
            )
            float inputs:metallic_constant = 0.77
            float inputs:opacity_constant = 1 (
                customData = {
                    double default = 1
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Opacity"
            )
            int inputs:opacity_mode = 1 (
