#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "white_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/white_metal>
            }

            over "screen" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/screen>
            }

            over "black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black>
            }

            over "orange" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/orange>
            }

            over "white_metal0" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/white_metal>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "white_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white_metal>
            )
            {
            }

            def Material "screen" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/screen>
            )
            {
            }

            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }

            def Material "orange" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/orange>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "white_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/white_metal>
            }

            over "screen" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/screen>
            }

            over "black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/black>
            }

            over "orange" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/orange>
            }

            over "white_metal0" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/white_metal>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "white_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white_metal>
            )
            {
            }

            def Material "screen" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/screen>
            )
            {
            }

            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }

            def Material "orange" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/orange>
            )
            {
            }
        }
    }

    def Xform "mesh_1_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/black_0>
        }

        def Scope "VisualMaterials"
        {
            def Material "black_0" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_0>
            )
            {
            }
        }
    }

    def Xform "mesh_2" (
        prepend references = @./geometries.usd@</Geometries/mesh_2>
    )
    {
        over "mesh_2" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh_2/VisualMaterials/black_0>
        }

        def Scope "VisualMaterials"
        {
            def Material "black_0" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_0>
            )
            {
            }
        }
    }

    def Xform "mesh_3" (
        prepend references = @./geometries.usd@</Geometries/mesh_3>
    )
    {
        over "mesh_3"
        {
            over "grey_plastic" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_3/VisualMaterials/grey_plastic>
            }

            over "plastic_black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_3/VisualMaterials/black>
            }

            over "white" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_3/VisualMaterials/white>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "grey_plastic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey_plastic>
            )
            {
            }

            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }

            def Material "white" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white>
            )
            {
            }
        }
    }

    def Xform "mesh_3_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_3>
    )
    {
        over "mesh_3" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "grey_plastic" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_3_1/VisualMaterials/grey_plastic>
            }

            over "plastic_black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_3_1/VisualMaterials/black>
            }

            over "white" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_3_1/VisualMaterials/white>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "grey_plastic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey_plastic>
            )
            {
            }

            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }

            def Material "white" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white>
            )
            {
            }
        }
    }
}

