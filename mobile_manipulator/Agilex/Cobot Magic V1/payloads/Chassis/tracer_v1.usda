#usda 1.0
(
    defaultPrim = "Cobot_Magic_V1"
)

def Xform "Cobot_Magic_V1"
{
    def "Agilex_Tracer" (
        prepend payload = @../../../../../mobile_base/Agilex/Tracer_V1/Tracer.usda@
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        variants = {
            string ROS = "enable"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "base_footprint"
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </Cobot_Magic_V1/base_footprint>
                rel physics:body1 = </Cobot_Magic_V1/Agilex_Tracer/base_footprint>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "joints"
        {
            over "left_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "fl_castor_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "fl_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "fr_castor_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "fr_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "rl_castor_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "rl_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "rr_castor_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "rr_wheel"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }

        over "Graph"
        {
            over "ROS_Odometry"
            {
                over "ComputeOdometry"
                {
                    custom rel inputs:chassisPrim = </Cobot_Magic_V1/base_footprint> (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                }
            }

            over "ROS_Differential_Controller"
            {
                over "ArticulationController"
                {
                    custom token[] inputs:jointNames = ["left_wheel", "right_wheel"]
                    custom rel inputs:targetPrim = </Cobot_Magic_V1> (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                }
            }
        }
    }
}
