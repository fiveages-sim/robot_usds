#usda 1.0
(
    doc = """Split Aloha NonDexHand mute — subLayer of payloads/Physics/physx.usda ONLY.

PhysX: CollisionGroup + filteredGroups self-filter. Always composed with
Physics=physx (any Arm_Left/Arm_Right / EE mix). Same convention as Luna/W2:
parent self-col ON; NonDexHand mutes body/chassis/arm; dexhand EE excludes
keep fingers ungrouped (finger self-col + FilteredPairs).

Nested Piper has its own CollisionGroups/NonDexHand. Parent and child groups
must filter each other or arm convex hulls vs box chatter (EE=Gripper/None).
Include whole lifting_link / Ranger_Mini / Piper subtrees so tcp/chassis
colliders are not left ungrouped.

Keep hand prim names in sync with Piper EE dexhand_self_collision.usda
(Revo1 / Revo2 under link6/tcp). Grippers are intentionally not excluded.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Split_Aloha"
{
    def Scope "CollisionGroups"
    {
        def PhysicsCollisionGroup "NonDexHand" (
            prepend apiSchemas = ["CollectionAPI:colliders"]
        )
        {
            uniform token collection:colliders:expansionRule = "expandPrims"
            prepend rel collection:colliders:includes = [
                </Split_Aloha/base>,
                </Split_Aloha/lifting_link>,
                </Split_Aloha/Ranger_Mini>,
                </Split_Aloha/lifting_link/left_base_link/Piper>,
                </Split_Aloha/lifting_link/right_base_link/Piper>,
            ]
            prepend rel collection:colliders:excludes = [
                </Split_Aloha/lifting_link/left_base_link/Piper/link6/tcp/Revo1>,
                </Split_Aloha/lifting_link/left_base_link/Piper/link6/tcp/Revo2>,
                </Split_Aloha/lifting_link/right_base_link/Piper/link6/tcp/Revo1>,
                </Split_Aloha/lifting_link/right_base_link/Piper/link6/tcp/Revo2>,
            ]
            prepend rel physics:filteredGroups = [
                </Split_Aloha/CollisionGroups/NonDexHand>,
                </Split_Aloha/lifting_link/left_base_link/Piper/CollisionGroups/NonDexHand>,
                </Split_Aloha/lifting_link/right_base_link/Piper/CollisionGroups/NonDexHand>,
            ]
        }
    }

    over "lifting_link"
    {
        over "left_base_link"
        {
            over "Piper"
            {
                over "CollisionGroups"
                {
                    over "NonDexHand"
                    {
                        prepend rel physics:filteredGroups = [
                            </Split_Aloha/CollisionGroups/NonDexHand>,
                        ]
                    }
                }
            }
        }

        over "right_base_link"
        {
            over "Piper"
            {
                over "CollisionGroups"
                {
                    over "NonDexHand"
                    {
                        prepend rel physics:filteredGroups = [
                            </Split_Aloha/CollisionGroups/NonDexHand>,
                        ]
                    }
                }
            }
        }
    }
}
