#usda 1.0
(
    doc = """Split Aloha Newton body/chassis mute.

WIRE: Split_Aloha Physics=mujoco → append references = @this@</Split_Aloha>
NOT a mujoco.usda subLayer (too weak). NEVER add Piper arm paths here —
that races Arm payloads. Arms: Piper arm_self_collision_mute_newton.
PhysX: CollisionGroup (unchanged). Art root: base.
Keep wheels enabled for ground contact. Hands not muted.
"""
    metersPerUnit = 1
    defaultPrim = "Split_Aloha"
    upAxis = "Z"
)

over "Split_Aloha"
{
    over "base"
    {
        over "collisions"
        {
            over "box_link" (
                instanceable = false
            )
            {
                over "mesh"
                {
                    bool physics:collisionEnabled = 0
                }
            }
        }
    }

    over "lifting_link"
    {
        over "collisions"
        {
            over "lift_link" (
                instanceable = false
            )
            {
                over "mesh_1"
                {
                    bool physics:collisionEnabled = 0
                }
            }
        }
    }

    over "Ranger_Mini"
    {
        over "base_link"
        {
            over "collisions"
            {
                over "mesh_0"
                {
                    over "box"
                    {
                        bool physics:collisionEnabled = 0
                    }
                }
            }
        }
    }
}
