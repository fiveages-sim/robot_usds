#usda 1.0
(
    defaultPrim = "Split_Aloha"
    metersPerUnit = 1
    startTimeCode = -1
    endTimeCode = 0
    subLayers = [
        @./physics.usda@,
        @./body_self_collision_mute.usda@
    ]
    upAxis = "Z"
)

def "Split_Aloha"
{
    over "base" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        # On for any arm/EE mix; NonDexHand (body_self_collision_mute.usda)
        # mutes body/chassis/arm. Piper EE dexhand_self_collision excludes
        # Revo1/Revo2 fingers from the nested arm group.
        bool physxArticulation:enabledSelfCollisions = 1
        # Merged Revo fingers use this parent solver (Piper root_joint inactive).
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
    }

    over "joints"
    {
        over "lifting_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 10
        }
    }

    over "Ranger_Mini" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "lifting_link"
    {
        over "left_base_link"
        {
            over "Piper" (
                variants = {
                    string Physics = "physx"
                }
            )
            {
            }
        }

        over "right_base_link"
        {
            over "Piper" (
                variants = {
                    string Physics = "physx"
                }
            )
            {
            }
        }
    }
}
