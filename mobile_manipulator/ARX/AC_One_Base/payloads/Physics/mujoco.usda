#usda 1.0
(
    defaultPrim = "AC_One_Base"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "AC_One_Base"
{
    # Mount-only: parent ARX_LIFT2S/base_link owns the articulation root.
    # Required when Physics=mujoco is set on this prim (layer wins over parent over).
    over "root_joint" (
        active = false
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
    )
    {
    }
}
