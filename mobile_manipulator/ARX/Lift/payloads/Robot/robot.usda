#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.148641161899407, 1.0174885049680849, 0.7722011892484977)
                double3 target = (-4.574589147009239, -4.004864799632941, -1.7799538860758455)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary metricsAssembler = {
            dictionary "/ARX_Lift/d405" = {
            }
            int version = 1
        }
        dictionary omni_layer = {
            string authoring_layer = "./Lift.usd"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "ARX_Lift"
    endTimeCode = 0
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

def Xform "ARX_Lift" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </ARX_Lift/joints/lift_joint>,
        </ARX_Lift/joints/head_joint1>,
        </ARX_Lift/joints/head_joint2>,
        </ARX_Lift/joints/wheel1_joint>,
        </ARX_Lift/joints/wheel2_joint>,
        </ARX_Lift/joints/wheel3_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </ARX_Lift/base_link>,
        </ARX_Lift/lift_link>,
        </ARX_Lift/head_link1>,
        </ARX_Lift/head_link2>,
        </ARX_Lift/wheel_1>,
        </ARX_Lift/wheel_2>,
        </ARX_Lift/wheel_3>,
    ]

    over "base_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "lift_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "joints"
    {
        over "lift_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "head_joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "head_joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "wheel1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "wheel2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "wheel3_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }
    }

    over "head_link1" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "head_link2" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "wheel_1" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "wheel_2" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "wheel_3" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }
}

