#usda 1.0
(
    defaultPrim = "ARX_Lift"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "PhysicsScene" (
    prepend apiSchemas = ["MjcSceneAPI"]
)
{
}

over "ARX_Lift"
{
    over "base_link" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
        uniform float mjc:gravcomp = 1
    }

    over "lift_link"
    {
        uniform float mjc:gravcomp = 1
    }

    over "head_link1"
    {
        uniform float mjc:gravcomp = 1
    }

    over "head_link2"
    {
        uniform float mjc:gravcomp = 1
    }

    over "joints"
    {
        over "lift_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = None
            float drive:linear:physics:maxForce = None
            float drive:linear:physics:stiffness = None
            float drive:linear:physics:targetPosition = None
            uniform token drive:linear:physics:type = None
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:armature = 1.0
            uniform double mjc:damping = 400
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -1000
            uniform double mjc:actuatorfrcrange:max = 1000
        }

        over "head_joint1" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "head_joint2" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetPosition = None
            uniform token drive:angular:physics:type = None
            uniform bool mjc:actuatorgravcomp = 1
            uniform double mjc:armature = 0.01
            uniform double mjc:damping = 0.1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "wheel1_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetVelocity = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "wheel2_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetVelocity = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }

        over "wheel3_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = None
            float drive:angular:physics:maxForce = None
            float drive:angular:physics:stiffness = None
            float drive:angular:physics:targetVelocity = None
            uniform token drive:angular:physics:type = None
            uniform double mjc:armature = 0.05
            uniform double mjc:damping = 1
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -100
            uniform double mjc:actuatorfrcrange:max = 100
        }
    }

    def Scope "actuators"
    {
        def MjcActuator "lift_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [8000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -8000, -3000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -1000
            uniform double mjc:forceRange:max = 1000
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = 0
            uniform double mjc:ctrlRange:max = 0.86
            rel mjc:target = </ARX_Lift/joints/lift_joint>
        }

        def MjcActuator "head_joint1"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -90
            uniform double mjc:ctrlRange:max = 90
            rel mjc:target = </ARX_Lift/joints/head_joint1>
        }

        def MjcActuator "head_joint2"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, -200, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:min = -45
            uniform double mjc:ctrlRange:max = 45
            rel mjc:target = </ARX_Lift/joints/head_joint2>
        }

        def MjcActuator "wheel1_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -20, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </ARX_Lift/joints/wheel1_joint>
        }

        def MjcActuator "wheel2_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -20, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </ARX_Lift/joints/wheel2_joint>
        }

        def MjcActuator "wheel3_joint"
        {
            uniform token mjc:gainType = "fixed"
            uniform token mjc:biasType = "affine"
            uniform double[] mjc:gainPrm = [20, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform double[] mjc:biasPrm = [0, 0, -20, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:min = -100
            uniform double mjc:forceRange:max = 100
            uniform token mjc:ctrlLimited = "false"
            rel mjc:target = </ARX_Lift/joints/wheel3_joint>
        }
    }

    over "wheel_1"
    {
        over "Angellun_OW"
        {
            over "root_joint" (
                active = false
                delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            )
            {
            }
        }
    }

    over "wheel_2"
    {
        over "Angellun_OW"
        {
            over "root_joint" (
                active = false
                delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            )
            {
            }
        }
    }

    over "wheel_3"
    {
        over "Angellun_OW"
        {
            over "root_joint" (
                active = false
                delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            )
            {
            }
        }
    }
}
