#usda 1.0
(
    defaultPrim = "ARX_Lift"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "ARX_Lift"
{
    over "base_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 64
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:stabilizationThreshold = 0.00001
    }

    over "joints"
    {
        over "lift_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 20000
            float drive:linear:physics:maxForce = 1000
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            float physxJoint:maxJointVelocity = 100
        }

        over "head_joint1" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 6000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 60000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 5729.5776
        }

        over "head_joint2" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 6000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 60000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            float physxJoint:maxJointVelocity = 5729.5776
        }

        over "wheel1_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "wheel2_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }

        over "wheel3_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "acceleration"
            float physxJoint:maxJointVelocity = inf
        }
    }

    over "wheel_1"
    {
        over "Angellun_OW"
        {
            over "root_joint" (
                active = false
                delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            )
            {
            }
        }
    }

    over "wheel_2"
    {
        over "Angellun_OW"
        {
            over "root_joint" (
                active = false
                delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            )
            {
            }
        }
    }

    over "wheel_3"
    {
        over "Angellun_OW"
        {
            over "root_joint" (
                active = false
                delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            )
            {
            }
        }
    }
}

over "PhysicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
}
