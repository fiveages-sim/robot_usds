#usda 1.0
(
    defaultPrim = "ARX_Lift"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ARX_Lift"
{
    over "lift_link"
    {
        def "Arm_Right" (
            prepend payload = @../../../../../manipulators/ARX/X5/X5.usda@
            variants = {
                string EE = "Gripper_2023"
                string ROS = "None"
                string Robot = "robot"
                string Sensor = "none"
                string Side = "right"
            }
        )
        {
            prepend rel isaac:physics:robotJoints = </ARX_Lift/lift_link/Arm_Right>
            prepend rel isaac:physics:robotLinks = </ARX_Lift/lift_link/Arm_Right>

            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.208, -0.25, 0.092)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "root_joint" (
                active = false
            )
            {
            }

            over "base_link"
            {
                def PhysicsFixedJoint "AssemblerFixedJoint"
                {
                    rel physics:body0 = </ARX_Lift/lift_link>
                    rel physics:body1 = </ARX_Lift/lift_link/Arm_Right/base_link>
                    point3f physics:localPos0 = (0.208, -0.25, 0.092)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }

            over "joints"
            {
                over "right_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_joint3"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_joint4"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_joint5"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "right_joint6"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
            }

            over "Gripper_2023"
            {
                over "joints"
                {
                    over "right_gripper_joint"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }

                    over "right_joint8"
                    {
                        float state:linear:physics:position = 0
                        float state:linear:physics:velocity = 0
                    }
                }
            }
        }
    }
}
