#usda 1.0
(
    defaultPrim = "root"
    doc = """sensors=orbbec_305_top — Orbbec 305 under flange camera_stand.

Composed path (flange.usda alone):
  /root/visual/flange_base/camera_stand/orbbec_305

Under suction flange_type1:
  /root/visual/suction_base/flange/visual/flange_base/camera_stand/orbbec_305

Camera: robots/sensors/orbbec_305.usd
TF vs camera_stand: translate=(-0.009, 0.0449, -0.01845), rotate=0.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def "root"
{
    over "visual"
    {
        over "flange_base"
        {
            over "camera_stand"
            {
                def "orbbec_305" (
                    prepend payload = @../../../../../../sensors/orbbec_305.usd@
                )
                {
                    double3 xformOp:translate = (-0.009, 0.0449, -0.01845)
                    double3 xformOp:rotateZYX = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]
                }
            }
        }
    }
}
