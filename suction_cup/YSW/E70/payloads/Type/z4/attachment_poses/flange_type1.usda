                point3f physics:localPos1 = (0.06198, -0.0734, 0.01934)
                quatf physics:localRot1 = (0.70710678, 0.70710678, 0, 0)
            }

            over "attach_tip_3"
            {
                point3f physics:localPos0 = (0.09798, -0.0734, 0.05534)
                quatf physics:localRot0 = (0.70710678, 0.70710678, 0, 0)
                point3f physics:localPos1 = (0.09798, -0.0734, 0.05534)
                quatf physics:localRot1 = (0.70710678, 0.70710678, 0, 0)
            }

