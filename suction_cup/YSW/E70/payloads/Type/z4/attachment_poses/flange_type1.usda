#usda 1.0
(
    defaultPrim = "ysw_e70"
    doc = """z4 SurfaceGripper D6 poses for flange=flange_type1.

Sets both localPos0/Rot0 (on gripper_base) and localPos1/Rot1 (on sg_d6_body1)
so the open-state constraint stays satisfied (zero residual force).
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "ysw_e70"
{
    over "gripper_base"
    {
        over "surface_gripper_joints"
        {
            over "attach_tip_1"
            {
                point3f physics:localPos0 = (0.06198, -0.0734, 0.05534)
                quatf physics:localRot0 = (0.70710678, 0.70710678, 0, 0)
                point3f physics:localPos1 = (0.06198, -0.0734, 0.05534)
                quatf physics:localRot1 = (0.70710678, 0.70710678, 0, 0)
            }

            over "attach_tip_2"
            {
                point3f physics:localPos0 = (0.06198, -0.0734, 0.01934)
