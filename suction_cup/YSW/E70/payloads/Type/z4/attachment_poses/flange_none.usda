#usda 1.0
(
    defaultPrim = "ysw_e70"
    doc = """z4 SurfaceGripper D6 poses for flange=none (also sets localPos1)."""
    metersPerUnit = 1
    upAxis = "Z"
)

over "ysw_e70"
{
    over "gripper_base"
    {
        over "surface_gripper_joints"
        {
            over "attach_tip_1"
            {
                point3f physics:localPos0 = (-0.018, 0.018, -0.0734)
                quatf physics:localRot0 = (0, 1, 0, 0)
                point3f physics:localPos1 = (-0.018, 0.018, -0.0734)
                quatf physics:localRot1 = (0, 1, 0, 0)
            }

            over "attach_tip_2"
            {
                point3f physics:localPos0 = (0.018, 0.018, -0.0734)
                quatf physics:localRot0 = (0, 1, 0, 0)
                point3f physics:localPos1 = (0.018, 0.018, -0.0734)
                quatf physics:localRot1 = (0, 1, 0, 0)
            }

            over "attach_tip_3"
            {
                point3f physics:localPos0 = (-0.018, -0.018, -0.0734)
                quatf physics:localRot0 = (0, 1, 0, 0)
                point3f physics:localPos1 = (-0.018, -0.018, -0.0734)
                quatf physics:localRot1 = (0, 1, 0, 0)
            }

            over "attach_tip_4"
            {
                point3f physics:localPos0 = (0.018, -0.018, -0.0734)
                quatf physics:localRot0 = (0, 1, 0, 0)
                point3f physics:localPos1 = (0.018, -0.018, -0.0734)
                quatf physics:localRot1 = (0, 1, 0, 0)
            }
        }
    }
}
