#usda 1.0
(
    defaultPrim = "ysw_e70"
    doc = """type=z4 entry payload — visual tips/pad + Surface Gripper.

subLayers keep composition reliable (single payload from e70 type=z4).
Future types should mirror: Type/<name>/payload.usda → visual + surface_gripper.
"""
    metersPerUnit = 1
    subLayers = [
        @./z4.usda@,
        @./surface_gripper.usda@,
    ]
    upAxis = "Z"
)

# Anchor so defaultPrim resolves in this root layer as well as subLayers.
over "ysw_e70"
{
}
