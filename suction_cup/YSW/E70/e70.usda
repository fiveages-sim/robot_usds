#usda 1.0
(
    customLayerData = {
        dictionary omni_layer = {
            string authoring_layer = "./e70.usda"
        }
    }
    defaultPrim = "ysw_e70"
    doc = """YSW E70 suction cup — Hook/RG75-style Physics.

Hierarchy (critical for Play TF):
  ysw_e70
    gripper_base     <- PhysicsRigidBodyAPI (Physics=physx)
      visual         <- flange EE-tcp xformOps live HERE (non-RB child)
        suction_base / tips...
      surface_gripper_joints/attach_tip_*  <- when type=z4
    sg_d6_body1      <- D6 body1 placeholder (type=z4)
    SurfaceGripper   <- IsaacSurfaceGripper (type=z4, on this root layer)

Defaults: type=none, flange=none (flange_type1 only when assembly selects it).
type=z4 adds tip visuals + official Surface Gripper (D6 poses assume flange=none).
SurfaceGripper path: <instance>/SurfaceGripper
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ysw_e70" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string type = "none"
        string flange = "none"
        string side = "default"
    }
    prepend variantSets = ["Physics", "type", "flange", "side"]
)
{
    variantSet "Physics" = {
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
    variantSet "type" = {
        "none" {

        }
        "z4" (
            prepend payload = @./payloads/Type/z4/payload.usda@
        ) {
            def IsaacSurfaceGripper "SurfaceGripper"
            {
                rel isaac:attachmentPoints = [
                    </ysw_e70/gripper_base/surface_gripper_joints/attach_tip_1>,
                    </ysw_e70/gripper_base/surface_gripper_joints/attach_tip_2>,
                    </ysw_e70/gripper_base/surface_gripper_joints/attach_tip_3>,
                    </ysw_e70/gripper_base/surface_gripper_joints/attach_tip_4>,
                ]
                float isaac:coaxialForceLimit = 500
                rel isaac:grippedObjects
                float isaac:maxGripDistance = 0.08
                float isaac:retryInterval = 3
                float isaac:shearForceLimit = 500
                uniform token isaac:status = "Open"
            }
        }
    }
    variantSet "flange" = {
        "none" {
            over "gripper_base"
            {
                over "visual"
                {
                    double3 xformOp:translate = (0, 0, 0)
                    double3 xformOp:rotateZYX = (180, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]
                }
            }
        }
        "flange_type1" (
            prepend payload = @./payloads/flange/flange_type1.usda@
        ) {
            over "gripper_base"
            {
                over "visual"
                {
                    double3 xformOp:translate = (0.07998, 0, 0.03734)
                    double3 xformOp:rotateZYX = (-90, -90, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]
                }
            }
        }
    }
    variantSet "side" = {
        "default" {

        }
        "left" (
            prepend payload = @./payloads/Side/left.usda@
        ) {

        }
        "right" (
            prepend payload = @./payloads/Side/right.usda@
        ) {

        }
    }
}
