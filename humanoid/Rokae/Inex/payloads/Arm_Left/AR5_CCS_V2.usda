#usda 1.0
(
    defaultPrim = "Inex"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Inex"
{
    over "body_link4"
    {
        def "Arm_Left" (
            prepend payload = @../../../../../manipulators/Rokae/AR5_CCS_V2/AR5_CCS_V2.usda@
            variants = {
                string Side = "left"
                string EE = "RG75"
            }
        )
        {
            quatd xformOp:orient = (0.5, -0.5, 0.5, 0.5)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0.0775, 0.1429)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "root_joint" (
                active = false
            )
            {
            }

            over "base_link"
            {
                def PhysicsFixedJoint "AssemblerFixedJoint"
                {
                    rel physics:body0 = </Inex/body_link4>
                    rel physics:body1 = </Inex/body_link4/Arm_Left/base_link>
                    point3f physics:localPos0 = (0, 0.0775, 0.1429)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (0.5, -0.5, 0.5, 0.5)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }

            over "joints"
            {
                over "left_joint1"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_joint2"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_joint3"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_joint4"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_joint5"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_joint6"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }

                over "left_joint7"
                {
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
            }

            over "link7"
            {
                over "tcp"
                {
                    over "RG75" (
                        variants = {
                            string side = "left"
                            string flange = "default"
                        }
                    )
                    {
                    }
                }
            }
        }
    }
}
