#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "Shell_White" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/Shell_White>
            }

            over "green_light" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/green_light>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "Shell_White" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Shell_White>
            )
            {
            }

            def Material "green_light" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/green_light>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
