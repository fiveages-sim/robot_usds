#usda 1.0
(
    defaultPrim = "G2"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "G2"
{
    over "body_link5"
    {
        over "arm_base"
        {
            def "Arm_Left" (
                prepend payload = @../../../../../manipulators/Tianji/M6_CCS/M6_CCS.usda@
                variants = {
                    string Side = "left"
                    string visual = "agibot_g2"
                }
            )
            {
                quatd xformOp:orient = (0.7071067811865476, -0.7071067811865475, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0.069, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "base_link"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </G2/body_link5/arm_base>
                        rel physics:body1 = </G2/body_link5/arm_base/Arm_Left/base_link>
                        point3f physics:localPos0 = (0, 0.069, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.70710677, -0.70710677, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "left_joint1"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint2"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint3"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint4"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint5"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint6"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint7"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }
                }
            }
        }
    }
}
