    over "base_link" (
        prepend apiSchemas = ["NewtonArticulationRootAPI"]
    )
    {
        bool newton:selfCollisionEnabled = 0
    }

    over "body_link1"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link2"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link3"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link4"
    {
        uniform float mjc:gravcomp = 1
    }

    over "body_link5"
    {
        uniform float mjc:gravcomp = 1

        over "arm_base"
        {
            over "Arm_Left" (
                variants = {
                    string Physics = "mujoco"
                }
            )
            {
            }

            over "Arm_Right" (
                variants = {
