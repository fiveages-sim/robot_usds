#usda 1.0
(
    defaultPrim = "G2"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "G2"
{
    over "base_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }

    over "joints"
    {
        over "body_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }

        over "body_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }

        over "body_joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }

        over "body_joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }

        over "body_joint5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }

        over "head_joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }

        over "head_joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }

        over "head_joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 3.4028235e38
        }
    }

    over "G2_Chassis" (
        variants = {
            string Physics = "physx"
        }
    )
    {
    }

    over "body_link5"
    {
        over "arm_base"
        {
            over "Arm_Left" (
                variants = {
                    string Physics = "physx"
                }
            )
            {
            }

            over "Arm_Right" (
                variants = {
                    string Physics = "physx"
                }
            )
            {
            }
        }
    }
}

