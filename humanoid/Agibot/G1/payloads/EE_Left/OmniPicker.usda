#usda 1.0
(
    defaultPrim = "Agibot_G1"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Agibot_G1"
{
    over "left_end_link"
    {
        over "tcp"
        {
            def "EE" (
                prepend payload = @../../../../../grippers/Agibot/OmniPicker/OmniPicker.usda@
                variants = {
                    string Side = "left"
                    string Sensor = "none"
                }
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0, 0.7071067811865475)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0.005199963)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Agibot_G1/left_end_link/tcp>
                        rel physics:body1 = </Agibot_G1/left_end_link/tcp/EE/gripper_base>
                        point3f physics:localPos0 = (0, 0, 0.005199963)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }

                    def "omni_picker_camera_stand" (
                        prepend payload = @../EE/omni_picker_camera_stand.usd@
                    )
                    {
                        quatf xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                        double xformOp:rotateX:unitsResolve = 90
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
                    }
                }

                over "joints"
                {
                    over "left_gripper_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_narrow2_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_narrow3_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_narrow_loop_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_wide1_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_wide2_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_wide3_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_wide_loop_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }
                }
            }
        }
    }
}
