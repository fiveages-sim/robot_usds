    def Scope "actuators"
    {
        def MjcActuator "body_joint1"
        {
            uniform double[] mjc:biasPrm = [0, -625, -5, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 30
            uniform double mjc:ctrlRange:min = -30
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 500
            uniform double mjc:forceRange:min = -500
            uniform double[] mjc:gainPrm = [625, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
