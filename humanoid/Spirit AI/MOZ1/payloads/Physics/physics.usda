#usda 1.0
(
    defaultPrim = "MOZ1"
    metersPerUnit = 1
    upAxis = "Z"
)

over "MOZ1"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        float3 physics:diagonalInertia = (0.0001, 0.0001, 0.0001)
    }

    over "leg01" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.00163202, -0.00617037, 0.06844628)
        float3 physics:diagonalInertia = (0.028071517, 0.028247291, 0.009104566)
        float physics:mass = 5.0191007
        quatf physics:principalAxes = (0.96280074, -0.044161357, -0.00006796469, -0.26657933)
    }

    over "joints"
    {
        def PhysicsRevoluteJoint "body_joint1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 625
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </MOZ1/base_link>
            custom rel physics:body1
            append rel physics:body1 = </MOZ1/leg01>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0
            point3f physics:localPos0 = (-0.1114, 0, 0.1875)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = -30
            float physics:upperLimit = 30
        }

