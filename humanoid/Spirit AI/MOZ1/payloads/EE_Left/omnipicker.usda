#usda 1.0
(
    defaultPrim = "MOZ1"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MOZ1"
{
    over "left07"
    {
        over "tcp"
        {
            def "OmniPicker" (
                prepend payload = @../../../../../grippers/Agibot/OmniPicker/OmniPicker.usda@
                variants = {
                    string Sensor = "none"
                    string Side = "left"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "gripper_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </MOZ1/left07>
                        rel physics:body1 = </MOZ1/left07/tcp/OmniPicker/gripper_base>
                        point3f physics:localPos0 = (-0.01, 0.001, -0.05)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0.00000063413623, -0.99999936586377, -0.00079632645824, -0.00079632645824)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }
            }
        }
    }
}
