def Xform "SteerChassis" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string Robot = "robot"
        string Sensor = "sensors"
    }
    prepend variantSets = "ROS"
    append variantSets = ["Physics", "Robot", "Sensor"]
)
{
    string isaac:description = "Steering Wheel Chassis for Galaxea R1 and R1 Pro"
    string isaac:namespace = ""
    token isaac:robotType = "Holonomic"

    over "base_link"
    {
    }

    over "steer_motor_link1"
    {
    }

    over "wheel_motor_link1"
    {
    }

    over "steer_motor_link2"
    {
    }

    over "wheel_motor_link2"
    {
    }

    over "steer_motor_link3"
    {
    }

    over "wheel_motor_link3"
    {
