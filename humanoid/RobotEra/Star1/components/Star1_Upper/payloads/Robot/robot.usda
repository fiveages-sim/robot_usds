#usda 1.0
(
    defaultPrim = "Star1_Upper"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Star1_Upper" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    token isaac:robotType = "Humanoid"
    prepend rel isaac:physics:robotJoints = [
        </Star1_Upper/joints/floating_base>,
        </Star1_Upper/joints/left_arm_base_joint>,
        </Star1_Upper/joints/left_arm_yaw_joint>,
        </Star1_Upper/joints/left_elbow_pitch_joint>,
        </Star1_Upper/joints/left_elbow_yaw_joint>,
        </Star1_Upper/joints/left_shoulder_pitch_joint>,
        </Star1_Upper/joints/left_shoulder_roll_joint>,
        </Star1_Upper/joints/left_wrist_pitch_joint>,
        </Star1_Upper/joints/left_wrist_roll_joint>,
        </Star1_Upper/joints/mic_joint>,
        </Star1_Upper/joints/neck_pitch_joint>,
        </Star1_Upper/joints/neck_yaw_joint>,
        </Star1_Upper/joints/realsense_joint>,
        </Star1_Upper/joints/right_arm_base_joint>,
        </Star1_Upper/joints/right_arm_yaw_joint>,
        </Star1_Upper/joints/right_elbow_pitch_joint>,
        </Star1_Upper/joints/right_elbow_yaw_joint>,
        </Star1_Upper/joints/right_shoulder_pitch_joint>,
        </Star1_Upper/joints/right_shoulder_roll_joint>,
        </Star1_Upper/joints/right_wrist_pitch_joint>,
        </Star1_Upper/joints/right_wrist_roll_joint>,
        </Star1_Upper/joints/root_joint>,
        </Star1_Upper/joints/torso_base_joint>,
        </Star1_Upper/joints/waist_pitch_joint>,
        </Star1_Upper/joints/waist_roll_joint>,
        </Star1_Upper/joints/waist_yaw_joint>
    ]
    prepend rel isaac:physics:robotLinks = [
        </Star1_Upper/base>,
        </Star1_Upper/base_link>,
        </Star1_Upper/left_arm_base_link>,
        </Star1_Upper/left_arm_yaw_link>,
        </Star1_Upper/left_elbow_pitch_link>,
        </Star1_Upper/left_elbow_yaw_link>,
        </Star1_Upper/left_shoulder_pitch_link>,
        </Star1_Upper/left_shoulder_roll_link>,
        </Star1_Upper/left_wrist_pitch_link>,
        </Star1_Upper/left_wrist_roll_link>,
        </Star1_Upper/mic_link>,
        </Star1_Upper/neck_base_link>,
        </Star1_Upper/neck_pitch_link>,
        </Star1_Upper/neck_yaw_link>,
        </Star1_Upper/realsense_link>,
        </Star1_Upper/right_arm_base_link>,
        </Star1_Upper/right_arm_yaw_link>,
        </Star1_Upper/right_elbow_pitch_link>,
        </Star1_Upper/right_elbow_yaw_link>,
        </Star1_Upper/right_shoulder_pitch_link>,
        </Star1_Upper/right_shoulder_roll_link>,
        </Star1_Upper/right_wrist_pitch_link>,
        </Star1_Upper/right_wrist_roll_link>,
        </Star1_Upper/torso_base_link>,
        </Star1_Upper/waist_base_link>,
        </Star1_Upper/waist_pitch_link>,
        </Star1_Upper/waist_roll_link>
    ]
}
