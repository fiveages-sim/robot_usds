#usda 1.0
(
    defaultPrim = "Star1_Lower"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Star1_Lower" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    token isaac:robotType = "Humanoid"
    prepend rel isaac:physics:robotJoints = [
        </Star1_Lower/joints/left_ankle_pitch_joint>,
        </Star1_Lower/joints/left_ankle_roll_joint>,
        </Star1_Lower/joints/left_hip_pitch_joint>,
        </Star1_Lower/joints/left_hip_roll_joint>,
        </Star1_Lower/joints/left_hip_yaw_joint>,
        </Star1_Lower/joints/left_knee_joint>,
        </Star1_Lower/joints/right_ankle_pitch_joint>,
        </Star1_Lower/joints/right_ankle_roll_joint>,
        </Star1_Lower/joints/right_hip_pitch_joint>,
        </Star1_Lower/joints/right_hip_roll_joint>,
        </Star1_Lower/joints/right_hip_yaw_joint>,
        </Star1_Lower/joints/right_knee_joint>,
        </Star1_Lower/joints/root_joint>
    ]
    prepend rel isaac:physics:robotLinks = [
        </Star1_Lower/base_link>,
        </Star1_Lower/left_ankle_pitch_link>,
        </Star1_Lower/left_ankle_roll_link>,
        </Star1_Lower/left_hip_pitch_link>,
        </Star1_Lower/left_hip_roll_link>,
        </Star1_Lower/left_hip_yaw_link>,
        </Star1_Lower/left_knee_link>,
        </Star1_Lower/right_ankle_pitch_link>,
        </Star1_Lower/right_ankle_roll_link>,
        </Star1_Lower/right_hip_pitch_link>,
        </Star1_Lower/right_hip_roll_link>,
        </Star1_Lower/right_hip_yaw_link>,
        </Star1_Lower/right_knee_link>
    ]
}
