#usda 1.0
(
    defaultPrim = "Star1"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Xhand1 on left_wrist_roll_link (URDF xyz=0 0 -0.040 rpy=pi 0 -pi/2; no flange)."
)

over "Star1"
{
    over "Star1_Upper"
    {
        over "left_wrist_roll_link"
        {
            def "Xhand1" (
                prepend payload = @../../../../../dexhands/RobotEra/Xhand1/Xhand1.usda@
                variants = {
                    string Physics = "physx"
                    string Flange = "none"
                    string Side = "left"
                    string Sensor = "none"
                    string Robot = "none"
                    string ROS = "none"
                }
            )
            {
                quatd xformOp:orient = (0, 0.7071067811865476, -0.7071067811865476, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, -0.040)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                    delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                )
                {
                }

                over "hand_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Star1/Star1_Upper/left_wrist_roll_link>
                        rel physics:body1 = </Star1/Star1_Upper/left_wrist_roll_link/Xhand1/hand_base>
                        bool physics:excludeFromArticulation = 0
                        point3f physics:localPos0 = (0, 0, -0.040)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (0, 0.7071067811865476, -0.7071067811865476, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }
            }
        }
    }
}
