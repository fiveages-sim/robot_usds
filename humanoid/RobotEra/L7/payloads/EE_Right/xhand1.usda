#usda 1.0
(
    defaultPrim = "L7"
    metersPerUnit = 1
    upAxis = "Z"
)
over "L7"
{
    over "L7_Upper"
    {
        over "right_wrist_roll_link"
        {
            def Xform "Xhand1" (
                prepend payload = @../../../../../dexhands/RobotEra/Xhand1/Xhand1.usda@
                variants = { string Physics = "physx"
                    string Side = "right"
                    string Flange = "none"
                    string Sensor = "none"
                    string Robot = "none"
                    string ROS = "none" }
            )
            {
                double3 xformOp:translate = (0, 0, -0.050999999046325684)
                quatd xformOp:orient = (5.338517603953564e-08, 0.7071080798594718, 0.7071054825112345, -5.338497994519471e-08)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                over "root_joint" ( active = false
                    delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"] ) { }
                over "hand_base"
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </L7/L7_Upper/right_wrist_roll_link>
                        rel physics:body1 = </L7/L7_Upper/right_wrist_roll_link/Xhand1/hand_base>
                        bool physics:excludeFromArticulation = 0
                        point3f physics:localPos0 = (0, 0, -0.050999999046325684)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (5.338517603953564e-08, 0.7071080798594718, 0.7071054825112345, -5.338497994519471e-08)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }
            }
        }
    }
}
