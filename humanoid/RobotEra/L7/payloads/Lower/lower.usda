#usda 1.0
(
    defaultPrim = "L7"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Attach both leg chains to the existing Upper base. The standalone Lower base is disabled here, avoiding a duplicate pelvis rigid body and articulation root."
)
over "L7"
{
    over "L7_Upper"
    {
        # Release the fixed-world joint only when the legs are composed.
        over "root_joint" (active = false) { }

        # Keep the original articulation settings on the floating pelvis.
        over "base" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 0
            int physxArticulation:solverPositionIterationCount = 64
            int physxArticulation:solverVelocityIterationCount = 4
        }
    }

    def Xform "L7_Lower" (
        prepend payload = @../../components/L7_Lower/L7_Lower.usda@
        variants = { string Physics = "physx" }
    )
    {
        over "base" (active = false) { }
        over "joints"
        {
            over "left_hip_roll_joint"
            {
                rel physics:body0 = </L7/L7_Upper/base>
            }
            over "right_hip_roll_joint"
            {
                rel physics:body0 = </L7/L7_Upper/base>
            }
        }
    }
}
