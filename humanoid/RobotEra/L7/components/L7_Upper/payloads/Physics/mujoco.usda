#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "robotera_l7"
{
    over "joints"
    {
        over "waist_yaw_joint" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

        over "waist_roll_joint" (
            delete apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
        }

