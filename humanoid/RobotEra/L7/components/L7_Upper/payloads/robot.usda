#usda 1.0
(
    defaultPrim = "robotera_l7"
    metersPerUnit = 1
    upAxis = "Z"
)

over "robotera_l7" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </robotera_l7/root_joint>,
        </robotera_l7/joints/waist_yaw_joint>,
        </robotera_l7/joints/waist_roll_joint>,
        </robotera_l7/joints/waist_pitch_joint>,
        </robotera_l7/joints/left_shoulder_pitch_joint>,
        </robotera_l7/joints/left_shoulder_roll_joint>,
        </robotera_l7/joints/left_arm_yaw_joint>,
        </robotera_l7/joints/left_elbow_pitch_joint>,
        </robotera_l7/joints/left_elbow_yaw_joint>,
        </robotera_l7/joints/left_wrist_pitch_joint>,
        </robotera_l7/joints/left_wrist_roll_joint>,
        </robotera_l7/joints/right_shoulder_pitch_joint>,
        </robotera_l7/joints/right_shoulder_roll_joint>,
        </robotera_l7/joints/right_arm_yaw_joint>,
        </robotera_l7/joints/right_elbow_pitch_joint>,
        </robotera_l7/joints/right_elbow_yaw_joint>,
        </robotera_l7/joints/right_wrist_pitch_joint>,
        </robotera_l7/joints/right_wrist_roll_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </robotera_l7/base>,
        </robotera_l7/waist_yaw_link>,
        </robotera_l7/waist_roll_link>,
        </robotera_l7/torso_link>,
        </robotera_l7/left_shoulder_pitch_link>,
        </robotera_l7/left_shoulder_roll_link>,
        </robotera_l7/left_arm_yaw_link>,
        </robotera_l7/left_elbow_pitch_link>,
        </robotera_l7/left_elbow_yaw_link>,
        </robotera_l7/left_wrist_pitch_link>,
        </robotera_l7/left_wrist_roll_link>,
        </robotera_l7/right_shoulder_pitch_link>,
        </robotera_l7/right_shoulder_roll_link>,
        </robotera_l7/right_arm_yaw_link>,
        </robotera_l7/right_elbow_pitch_link>,
        </robotera_l7/right_elbow_yaw_link>,
        </robotera_l7/right_wrist_pitch_link>,
        </robotera_l7/right_wrist_roll_link>,
        </robotera_l7/left_wrist_roll_link/left_hand_flange_link>,
        </robotera_l7/right_wrist_roll_link/right_hand_flange_link>,
    ]

    over "base" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "waist_yaw_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "joints"
    {
        over "waist_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "waist_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "waist_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "left_shoulder_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "left_shoulder_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "left_arm_yaw_joint" (
