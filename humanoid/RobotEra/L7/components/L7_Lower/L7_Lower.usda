#usda 1.0
(
    defaultPrim = "L7_Lower"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "L7_Lower" (
    prepend references = @./payloads/base.usda@
    variants = { string Physics = "physx" }
    prepend variantSets = ["Physics"]
)
{
    variantSet "Physics" = {
        "none" { }
        "physics" (prepend payload = @./payloads/Physics/physics.usda@) { }
        "physx" (prepend payload = @./payloads/Physics/physx.usda@) { }
    }
}
