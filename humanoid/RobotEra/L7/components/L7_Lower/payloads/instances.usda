        dictionary omni_layer = {
            string authoring_layer = "./robotera_l7.usd"
        }
        dictionary renderSettings = {
        }
    }
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh/VisualMaterials/black_matte>
        }

        def Scope "VisualMaterials"
        {
            def Material "black_matte" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_matte>
            )
            {
            }
        }
    }

