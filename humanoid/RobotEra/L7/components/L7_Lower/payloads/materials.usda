def Scope "Materials"
{
    def Material "black_matte"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/black_matte/black_matte.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/black_matte/black_matte.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/black_matte/black_matte.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "black_matte" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @./materials/pbr.mdl@
            token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0 (
                customData = {
                    double default = 0.5
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Opacity"
            )
            int inputs:alpha_mode = 0 (
                customData = {
                    int default = 0
                    dictionary range = {
                        int max = 2
                        int min = 0
                    }
                }
                displayGroup = "Opacity"
                renderType = "gltf_alpha_mode"
                sdrMetadata = {
                    string __SDR__enum_value = "opaque"
                    string options = "opaque:0|mask:1|blend:2"
                }
            )
            float inputs:base_alpha = 1 (
                customData = {
                    double default = 1
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Base Alpha"
            )
            color3f inputs:base_color_factor = (0.035, 0.04, 0.045) (
                customData = {
                    float3 default = (1, 1, 1)
                    dictionary range = {
                        float3 max = (1, 1, 1)
                        float3 min = (0, 0, 0)
                    }
                }
                displayGroup = "PBR Metallic Roughness"
            )
            float inputs:emissive_strength = 10000 (
                customData = {
                    double default = 1
                }
                displayGroup = "Emission"
            )
            float inputs:metallic_factor = 0.05 (
                customData = {
                    double default = 0
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Metallic Roughness"
            )
            float inputs:roughness_factor = 0.78 (
                customData = {
                    double default = 0
                    dictionary range = {
                        double max = 1
                        double min = 0
                    }
                }
                displayGroup = "Metallic Roughness"
            )
            token outputs:out
        }
    }

