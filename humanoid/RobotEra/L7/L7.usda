def Xform "L7" (
    prepend references = @./payloads/base.usda@
    variants = {
        string EE_Left = "none"
        string EE_Right = "none"
        string Lower = "none"
        string Physics = "physx"
        string ROS = "none"
        string Robot = "none"
        string Sensor = "none"
        string Upper = "upper"
    }
    prepend variantSets = ["Physics", "ROS", "Sensor", "Upper", "Lower", "EE_Left", "EE_Right", "Robot"]
)
{
    over "L7_Upper" (
        variants = {
            string Robot = "none"
        }
    )
    {
        over "root_joint"
        {
            bool[] isaac:actuator (
                displayName = "Actuator"
            )
            string isaac:NameOverride (
                displayName = "Joint Name Override"
            )
            token[] isaac:physics:DofOffsetOpOrder (
                displayName = "Dof Offset Op Order"
            )
            bool physxArticulation:articulationEnabled = 1
            token visibility = "inherited"
        }

        over "right_wrist_roll_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
            )
        }

        over "torso_link"
        {
            over "visuals"
            {
                over "torso_base_link"
                {
                }
            }
        }

        over "right_shoulder_pitch_link"
        {
            over "visuals"
            {
                over "shoulder_pitch_link"
                {
                }
            }
        }

        over "right_shoulder_roll_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
            )
        }

        over "right_arm_yaw_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
            )
        }

        over "right_elbow_yaw_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
            )
        }

        over "joints"
        {
            token visibility = "inherited"

            over "waist_roll_joint"
            {
                float drive:angular:physics:damping = 600
                float drive:angular:physics:stiffness = 6000
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }

            over "left_arm_yaw_joint"
            {
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }

            over "waist_pitch_joint"
            {
                float drive:angular:physics:damping = 600
                float drive:angular:physics:stiffness = 6000
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }

            over "left_shoulder_roll_joint"
            {
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }

            over "left_elbow_yaw_joint"
            {
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }

            over "left_shoulder_pitch_joint"
            {
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }

            over "waist_yaw_joint"
            {
                float drive:angular:physics:damping = 600
                float drive:angular:physics:stiffness = 6000
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }

            over "left_wrist_pitch_joint"
            {
                bool[] isaac:actuator (
                    displayName = "Actuator"
                )
                string isaac:NameOverride (
                    displayName = "Joint Name Override"
                )
                token[] isaac:physics:DofOffsetOpOrder (
                    displayName = "Dof Offset Op Order"
                )
            }
        }

        over "waist_roll_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
            )
        }
    }
    variantSet "Physics" = {
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
    variantSet "Upper" = {
        "upper" (
            prepend payload = @./payloads/Upper/upper.usda@
        ) {

        }
    }
    variantSet "Lower" = {
