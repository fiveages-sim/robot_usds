    def Xform "waist_roll_link" (
        prepend references = @./geometries.usd@</Geometries/waist_roll_link>
    )
    {
        over "waist_roll_link" (
            apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/waist_roll_link/VisualMaterials/black_shell>
            token physics:approximation = "convexHull"
        }

        def Scope "VisualMaterials"
        {
            def Material "black_shell" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_shell>
            )
            {
            }
        }
    }

