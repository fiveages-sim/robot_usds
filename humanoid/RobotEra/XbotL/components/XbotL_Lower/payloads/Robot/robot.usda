#usda 1.0
(
    defaultPrim = "XbotL_Lower"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "XbotL_Lower" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    token isaac:robotType = "Humanoid"
    prepend rel isaac:physics:robotJoints = [
        </XbotL_Lower/joints/left_ankle_pitch_joint>,
        </XbotL_Lower/joints/left_ankle_roll_joint>,
        </XbotL_Lower/joints/left_knee_joint>,
        </XbotL_Lower/joints/left_leg_pitch_joint>,
        </XbotL_Lower/joints/left_leg_roll_joint>,
        </XbotL_Lower/joints/left_leg_yaw_joint>,
        </XbotL_Lower/joints/right_ankle_pitch_joint>,
        </XbotL_Lower/joints/right_ankle_roll_joint>,
        </XbotL_Lower/joints/right_knee_joint>,
        </XbotL_Lower/joints/right_leg_pitch_joint>,
        </XbotL_Lower/joints/right_leg_roll_joint>,
        </XbotL_Lower/joints/right_leg_yaw_joint>,
        </XbotL_Lower/joints/root_joint>
    ]
    prepend rel isaac:physics:robotLinks = [
        </XbotL_Lower/left_ankle_pitch_link>,
        </XbotL_Lower/left_ankle_roll_link>,
        </XbotL_Lower/left_knee_link>,
        </XbotL_Lower/left_leg_pitch_link>,
        </XbotL_Lower/left_leg_roll_link>,
        </XbotL_Lower/left_leg_yaw_link>,
        </XbotL_Lower/right_ankle_pitch_link>,
        </XbotL_Lower/right_ankle_roll_link>,
        </XbotL_Lower/right_knee_link>,
        </XbotL_Lower/right_leg_pitch_link>,
        </XbotL_Lower/right_leg_roll_link>,
        </XbotL_Lower/right_leg_yaw_link>,
        </XbotL_Lower/waist_roll_link>
    ]
}
