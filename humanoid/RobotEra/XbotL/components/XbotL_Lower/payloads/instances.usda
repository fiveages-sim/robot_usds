    def Xform "leg_roll_link" (
        prepend references = @./geometries.usd@</Geometries/leg_roll_link>
    )
    {
        over "leg_roll_link" (
            apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/leg_roll_link/VisualMaterials/white_shell>
            token physics:approximation = "convexHull"
        }

        def Scope "VisualMaterials"
        {
            def Material "white_shell" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white_shell>
            )
            {
            }
        }
    }

