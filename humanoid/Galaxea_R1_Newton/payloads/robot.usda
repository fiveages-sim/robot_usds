#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.3509832577519139, 1.2867990653058576, 2.23572539152764)
                double3 target = (-0.2735193218382894, -0.337703514284345, 0.6112228507114386)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./Galaxea_R1.usd"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "Galaxea_R1"
    doc = """Generated from Composed Stage of root layer /home/biao/distrobox/ubuntu24/FaSim-Isaac/robots/humanoid/Galaxea_R1_Newton/Galaxea_R1/Galaxea_R1.usd
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Galaxea_R1" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </Galaxea_R1/joints/torso_joint1>,
        </Galaxea_R1/joints/torso_joint2>,
        </Galaxea_R1/joints/torso_joint3>,
        </Galaxea_R1/joints/torso_joint4>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Galaxea_R1/base_link>,
        </Galaxea_R1/torso_link1>,
        </Galaxea_R1/torso_link2>,
        </Galaxea_R1/torso_link3>,
        </Galaxea_R1/torso_link4>,
        </Galaxea_R1/base_link/visuals>,
        </Galaxea_R1/base_link/collisions>,
        </Galaxea_R1/torso_link4/zed_link>,
    ]

    over "base_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "visuals" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "torso_link1" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "joints"
    {
        over "torso_joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "torso_joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "torso_joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "torso_joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }
    }

    over "torso_link2" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "torso_link3" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "torso_link4" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "zed_link" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }
}

