#usda 1.0
(
    defaultPrim = "Skye"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Skye"
{
    def "Right_Arm" (
        prepend payload = @../../../../../manipulators/Tianji/M6_CCS/M6_CCS.usda@
        variants = {
            string Side = "right"
            string visual = "default"
        }
    )
    {
        # DualArmMount right: xyz (0, -0.056, 0.4335) rpy (+pi/2, 0, 0) on body_link3/arm_base
        quatd xformOp:orient = (0.7071067811865476, 0.7071067811865475, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.18048, -0.056, 0.7235)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "root_joint" (
            active = false
        )
        {
        }

        over "base_link"
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </Skye/body_link3/arm_base>
                rel physics:body1 = </Skye/Right_Arm/base_link>
                point3f physics:localPos0 = (0, -0.056, 0.4335)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0.70710677, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "joints"
        {
            over "right_joint1"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_joint2"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_joint3"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_joint4"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_joint5"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_joint6"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "right_joint7"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }

        over "link1"
        {
        }

        over "link2"
        {
        }

        over "link3"
        {
        }

        over "link4"
        {
        }

        over "link5"
        {
        }

        over "link6"
        {
        }

        over "link7"
        {
        }
    }
}
