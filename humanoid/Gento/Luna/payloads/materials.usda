    def Material "white"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/white/white.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/white/white.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/white/white.outputs:out>
