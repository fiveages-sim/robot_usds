#usda 1.0
(
    doc = """Luna NonDexHand mute — subLayer of payloads/Physics/physx.usda ONLY.

PhysX: CollisionGroup + filteredGroups self-filter. Always composed with
Physics=physx (any Arm_Left/Arm_Right mix). Same convention as W2:
parent self-col ON; NonDexHand mutes body/chassis/arm; dexhand EE excludes
keep fingers ungrouped (finger self-col + FilteredPairs).

M6S_Lite nested arm also authors CollisionGroups/NonDexHand on the same links.
A collider may belong to only ONE PhysX group — dual membership spams
  [omni.physx.plugin] Collisions are supported currently only in one collision group
especially for gripper colliders (Marvin_Gripper is not in the dexhand excludes).
Deactivate the nested arm groups so body/chassis/arm/gripper live only in this
parent group. Dexhand roots stay excluded (ungrouped finger self-col).

Keep hand prim names in sync with M6S_Lite_CCS EE dexhand_self_collision.usda.
Grippers are intentionally not excluded.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Luna"
{
    def Scope "CollisionGroups"
    {
        def PhysicsCollisionGroup "NonDexHand" (
            prepend apiSchemas = ["CollectionAPI:colliders"]
        )
        {
            uniform token collection:colliders:expansionRule = "expandPrims"
            prepend rel collection:colliders:includes = [
                </Luna/base_link>,
                </Luna/body_link1>,
                </Luna/body_link2>,
                </Luna/body_link3>,
                </Luna/body_link4>,
                </Luna/body_link5>,
                </Luna/body_link6>,
                </Luna/head_link1>,
                </Luna/head_link2>,
                </Luna/Linkhou_S2>,
                </Luna/Left_Arm>,
                </Luna/Right_Arm>,
            ]
            prepend rel collection:colliders:excludes = [
                </Luna/Left_Arm/link7/tcp/LinkerHand_o6>,
                </Luna/Left_Arm/link7/tcp/LinkerHand_o7>,
                </Luna/Left_Arm/link7/tcp/L6>,
                </Luna/Left_Arm/link7/tcp/Xhand1>,
                </Luna/Right_Arm/link7/tcp/LinkerHand_o6>,
                </Luna/Right_Arm/link7/tcp/LinkerHand_o7>,
                </Luna/Right_Arm/link7/tcp/L6>,
                </Luna/Right_Arm/link7/tcp/Xhand1>,
            ]
            prepend rel physics:filteredGroups = [
                </Luna/CollisionGroups/NonDexHand>,
            ]
        }
    }

    over "Left_Arm"
    {
        over "CollisionGroups"
        {
            over "NonDexHand" (
                active = false
            )
            {
            }
        }
    }

    over "Right_Arm"
    {
        over "CollisionGroups"
        {
            over "NonDexHand" (
                active = false
            )
            {
            }
        }
    }
}
