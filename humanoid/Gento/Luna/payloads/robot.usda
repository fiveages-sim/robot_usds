#usda 1.0
(
    defaultPrim = "Luna"
    doc = """Generated from Composed Stage of root layer /home/fiveages/libraries/FaSim-Isaac/robots/humanoid/Gento/Luna/Luna.usd
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Luna" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </Luna/joints/body_joint1>,
        </Luna/joints/body_joint2>,
        </Luna/joints/body_joint3>,
        </Luna/joints/body_joint4>,
        </Luna/joints/body_joint5>,
        </Luna/joints/body_joint6>,
        </Luna/joints/head_joint1>,
        </Luna/joints/head_joint2>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Luna/base_link>,
        </Luna/body_link1>,
        </Luna/body_link2>,
        </Luna/body_link3>,
        </Luna/body_link4>,
        </Luna/body_link5>,
        </Luna/body_link6>,
        </Luna/head_link1>,
