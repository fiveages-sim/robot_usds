#usda 1.0
(
    defaultPrim = "Realman_AIDAL"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Realman_AIDAL"
{
    over "platform_base_link"
    {
        over "left_base_link"
        {
            def "RM75_Left" (
                prepend payload = @../../../../../manipulators/Realman/RM75/RM75.usda@
                variants = {
                    string EE = "EG2_4C2"
                    string Robot = "robot"
                    string Sensor = "ee_aidal"
                    string Side = "left"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, -0.053503234)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "root_joint" (
                    active = false
                )
                {
                }

                over "base_link"
                {
                    over "visuals"
                    {
                        token visibility = "invisible"
                    }

                    over "collisions"
                    {
                        token visibility = "invisible"
                    }

                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Realman_AIDAL/platform_base_link/left_base_link>
                        rel physics:body1 = </Realman_AIDAL/platform_base_link/left_base_link/RM75_Left/base_link>
                        point3f physics:localPos0 = (0, 0, -0.053503234)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                over "joints"
                {
                    over "left_joint1"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint2"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint3"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint4"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint5"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint6"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_joint7"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }
                }
            }
        }
    }
}
