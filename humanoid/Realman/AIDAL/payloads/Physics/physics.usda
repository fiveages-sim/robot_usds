over "Realman_AIDAL" (
    delete apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.0002128, -0.027490001, 0.37118003)
        float3 physics:diagonalInertia = (0.69175, 0.6886754, 0.15287459)
        float physics:mass = 12.159
        quatf physics:principalAxes = (0.9999333, 0.011540785, 0.000011803436, 0.0004254643)
    }

