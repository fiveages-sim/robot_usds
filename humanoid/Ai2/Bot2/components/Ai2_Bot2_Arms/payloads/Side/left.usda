    uniform double mjc:armature = 0.01
    uniform bool mjc:actuatorgravcomp = 1
    uniform double mjc:damping = 0.1
    uniform token mjc:actuatorfrclimited = "auto"
    uniform double mjc:actuatorfrcrange:min = -60
    uniform double mjc:actuatorfrcrange:max = 60
    uniform token physics:axis = "Z"
    prepend rel physics:body0 = </Ai2_Bot2_Arms/base_link>
    prepend rel physics:body1 = </Ai2_Bot2_Arms/link1>
    float physics:breakForce = 3.4028235e38
    float physics:breakTorque = 3.4028235e38
    float physics:JointEquivalentInertia = 0.02647193
    point3f physics:localPos0 = (0, 0, 0.1785)
    point3f physics:localPos1 = (0, 0, 0)
    quatf physics:localRot0 = (1, 0, 0, 0)
    quatf physics:localRot1 = (1, 0, 0, 0)
    float physics:lowerLimit = -177.6169
    float physics:upperLimit = 177.6169
    float physxJoint:maxJointVelocity = 179.90874
    float state:angular:physics:position = 0
    float state:angular:physics:velocity = 0
}

