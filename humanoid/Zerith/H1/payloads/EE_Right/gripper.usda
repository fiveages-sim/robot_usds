#usda 1.0
(
    defaultPrim = "Zerith_H1"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Zerith_H1"
{
    over "right_wrist_pitch_link"
    {
        over "right_tcp"
        {
            def "Zerith_H1_Gripper" (
                prepend payload = @../../components/Zerith_H1_Gripper/Zerith_H1_Gripper.usda@
                variants = {
                    string Physics = "physx"
                    string Robot = "none"
                    string Sensor = "d405"
                    string Side = "right"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "joints"
                {
                    over "root_joint" (
                        active = false
                    )
                    {
                    }
                }

                over "gripper_base" (
                    delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                )
                {
                    def PhysicsFixedJoint "AssemblerFixedJoint"
                    {
                        rel physics:body0 = </Zerith_H1/right_wrist_pitch_link/right_tcp>
                        rel physics:body1 = </Zerith_H1/right_wrist_pitch_link/right_tcp/Zerith_H1_Gripper/gripper_base>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }
            }
        }
    }

    over "right_wrist_yaw_link"
    {
    }

    over "right_wrist_roll_link"
    {
    }

    over "right_elbow_link"
    {
    }

    over "right_shoulder_yaw_link"
    {
    }

    over "right_shoulder_roll_link"
    {
    }

    over "right_shoulder_pitch_link"
    {
    }

    over "body_yaw_link"
    {
    }

    over "body_pitch_link"
    {
    }

    over "body_link1"
    {
    }

    over "base_link"
    {
    }
}

