        </Zerith_H1/body_link1>,
        </Zerith_H1/body_pitch_link>,
        </Zerith_H1/body_yaw_link>,
        </Zerith_H1/neck_yaw_link>,
        </Zerith_H1/neck_pitch_link>,
        </Zerith_H1/neck_pitch_link/neck_camera_link>,
        </Zerith_H1/neck_pitch_link/neck_camera_link/head_camera>,
        </Zerith_H1/left_shoulder_pitch_link>,
