        </Zerith_H1/joints/left_joint5>,
        </Zerith_H1/joints/left_joint6>,
        </Zerith_H1/joints/left_joint7>,
        </Zerith_H1/joints/right_joint2>,
        </Zerith_H1/joints/right_joint3>,
        </Zerith_H1/joints/right_joint4>,
        </Zerith_H1/joints/right_joint5>,
        </Zerith_H1/joints/right_joint6>,
        </Zerith_H1/joints/right_joint7>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Zerith_H1/base_link>,
        </Zerith_H1/left_front_caster_link>,
        </Zerith_H1/left_front_wheel_link>,
