#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Zerith_H1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "Zerith_H1" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Zerith_H1/joints/root_joint>,
        </Zerith_H1/joints/left_front_caster_swivel_joint>,
        </Zerith_H1/joints/left_wheel_joint>,
