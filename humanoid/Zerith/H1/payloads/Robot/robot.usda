        </Zerith_H1/joints/left_front_wheel_joint>,
        </Zerith_H1/joints/left_rear_wheel_joint>,
        </Zerith_H1/joints/right_front_wheel_joint>,
        </Zerith_H1/joints/right_rear_wheel_joint>,
        </Zerith_H1/joints/body_joint2>,
