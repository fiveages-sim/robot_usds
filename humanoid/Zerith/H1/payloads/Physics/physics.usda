        def PhysicsRevoluteJoint "left_front_caster_swivel_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            custom rel physics:body0
            append rel physics:body0 = </Zerith_H1/base_link>
            custom rel physics:body1
            append rel physics:body1 = </Zerith_H1/left_front_caster_link>
