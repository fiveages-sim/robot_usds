#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Zerith_H1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Zerith_H1"
{
    over "joints"
    {
        over "left_front_caster_swivel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = inf
        }

        over "left_front_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = inf
        }

        over "left_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 1000000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 0
            uniform token drive:angular:physics:type = "acceleration"
            float newton:velocityLimit = 500000
            float physxJoint:maxJointVelocity = 500000
        }

        over "left_rear_caster_swivel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
