#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "dipan_link" (
        prepend references = @./geometries.usd@</Geometries/dipan_link>
    )
    {
        over "dipan_link" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/dipan_link/VisualMaterials/dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark>
            )
            {
            }
        }
    }

    def Xform "dipan_link_1" (
        prepend references = @./dipan_link_collision.usdc@</Geometries/dipan_link_collision>
    )
    {
        over "dipan_link_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysxCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
        )
        {
            token physics:approximation = "convexDecomposition"
            bool physics:collisionEnabled = 1
            float physxCollision:contactOffset = 0.002
            float physxCollision:restOffset = 0
            int physxConvexDecompositionCollision:maxConvexHulls = 2
            uniform token purpose = "guide"
        }
    }

