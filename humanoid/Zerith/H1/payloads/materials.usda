#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "dark"
    {
        token outputs:mdl:displacement.connect = </Materials/dark/dark.outputs:out>
        token outputs:mdl:surface.connect = </Materials/dark/dark.outputs:out>
        token outputs:mdl:volume.connect = </Materials/dark/dark.outputs:out>

        def Shader "dark"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.011764706, 0.011764706, 0.015686275)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "purple"
    {
        token outputs:mdl:displacement.connect = </Materials/purple/purple.outputs:out>
        token outputs:mdl:surface.connect = </Materials/purple/purple.outputs:out>
        token outputs:mdl:volume.connect = </Materials/purple/purple.outputs:out>

        def Shader "purple"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.2509804, 0.24705882, 0.8235294)
            color3f inputs:emissive_factor = (0.25015837, 0.24620144, 0.8227861)
            float inputs:emissive_strength = 5000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "silver"
    {
        token outputs:mdl:displacement.connect = </Materials/silver/silver.outputs:out>
        token outputs:mdl:surface.connect = </Materials/silver/silver.outputs:out>
        token outputs:mdl:volume.connect = </Materials/silver/silver.outputs:out>

        def Shader "silver"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.7764706, 0.7882353, 0.8)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "grey"
    {
        token outputs:mdl:displacement.connect = </Materials/grey/grey.outputs:out>
        token outputs:mdl:surface.connect = </Materials/grey/grey.outputs:out>
        token outputs:mdl:volume.connect = </Materials/grey/grey.outputs:out>

        def Shader "grey"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.05490196, 0.0627451, 0.09019608)
            float inputs:metallic_factor = 0.7123288
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "black"
    {
        token outputs:mdl:displacement.connect = </Materials/black/black.outputs:out>
        token outputs:mdl:surface.connect = </Materials/black/black.outputs:out>
        token outputs:mdl:volume.connect = </Materials/black/black.outputs:out>

        def Shader "black"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.011764706, 0.011764706, 0.011764706)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "black_2"
    {
        token outputs:mdl:displacement.connect = </Materials/black_2/black_2.outputs:out>
        token outputs:mdl:surface.connect = </Materials/black_2/black_2.outputs:out>
        token outputs:mdl:volume.connect = </Materials/black_2/black_2.outputs:out>

        def Shader "black_2"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0, 0, 0)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "black_face"
    {
        token outputs:mdl:displacement.connect = </Materials/black_face/black_face.outputs:out>
        token outputs:mdl:surface.connect = </Materials/black_face/black_face.outputs:out>
        token outputs:mdl:volume.connect = </Materials/black_face/black_face.outputs:out>

        def Shader "black_face"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.016, 0.018, 0.026)
            float inputs:clearcoat_factor = 1
            float inputs:clearcoat_roughness_factor = 0.04
            float inputs:ior = 1.52
            float inputs:metallic_factor = 0.12
            float inputs:roughness_factor = 0.05
            color3f inputs:specular_color_factor = (0.92, 0.95, 1)
            float inputs:specular_factor = 1
            token outputs:out
        }
    }
}
