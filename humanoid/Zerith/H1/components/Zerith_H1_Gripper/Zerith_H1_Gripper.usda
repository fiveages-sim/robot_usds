#usda 1.0
(
    defaultPrim = "Zerith_H1_Gripper"
    metersPerUnit = 1
    upAxis = "Z"

    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    startTimeCode = 0
)

def Xform "Zerith_H1_Gripper" (
    prepend references = @./payloads/base.usda@
    prepend variantSets = ["Physics", "Sensor", "Side"]
    append variantSets = ["Robot"]
)
{
    variantSet "Physics" = {
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {
        }
        "none" {
        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {
        }
        "d405" (
            prepend payload = @./payloads/Sensor/d405.usda@
        ) {
        }
    }
    variantSet "Side" = {
        "left" (
            prepend payload = @./payloads/Side/left.usda@
        ) {
        }
        "right" (
            prepend payload = @./payloads/Side/right.usda@
        ) {
        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {
        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {
        }
    }
}
