#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "motor"
    {
        token outputs:mdl:displacement.connect = </Materials/motor/motor.outputs:out>
        token outputs:mdl:surface.connect = </Materials/motor/motor.outputs:out>
        token outputs:mdl:volume.connect = </Materials/motor/motor.outputs:out>

        def Shader "motor"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.011764706, 0.011764706, 0.011764706)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.25
            token outputs:out
        }
    }

    def Material "black_rubber"
    {
        token outputs:mdl:displacement.connect = </Materials/black_rubber/black_rubber.outputs:out>
        token outputs:mdl:surface.connect = </Materials/black_rubber/black_rubber.outputs:out>
        token outputs:mdl:volume.connect = </Materials/black_rubber/black_rubber.outputs:out>

        def Shader "black_rubber"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.011764706, 0.011764706, 0.011764706)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "black_1"
    {
        token outputs:mdl:displacement.connect = </Materials/black_1/black_1.outputs:out>
        token outputs:mdl:surface.connect = </Materials/black_1/black_1.outputs:out>
        token outputs:mdl:volume.connect = </Materials/black_1/black_1.outputs:out>

        def Shader "black_1"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0, 0, 0)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "black"
    {
        token outputs:mdl:displacement.connect = </Materials/black/black.outputs:out>
        token outputs:mdl:surface.connect = </Materials/black/black.outputs:out>
        token outputs:mdl:volume.connect = </Materials/black/black.outputs:out>

        def Shader "black"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.003921569, 0.003921569, 0.003921569)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "silver"
    {
        token outputs:mdl:displacement.connect = </Materials/silver/silver.outputs:out>
        token outputs:mdl:surface.connect = </Materials/silver/silver.outputs:out>
        token outputs:mdl:volume.connect = </Materials/silver/silver.outputs:out>

        def Shader "silver"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.7764706, 0.7882353, 0.8)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }
}
