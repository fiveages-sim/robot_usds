    def Xform "right_wrist_yaw_link" (
        prepend references = @./geometries.usd@</Geometries/right_wrist_yaw_link>
    )
    {
        over "right_wrist_yaw_link" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/right_wrist_yaw_link/VisualMaterials/motor>
        }

        def Scope "VisualMaterials"
        {
            def Material "motor" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/motor>
            )
            {
            }
        }
    }

    def Xform "right_wrist_yaw_link_1" (
        prepend references = @./geometries.usd@</Geometries/right_wrist_yaw_link>
    )
    {
        over "right_wrist_yaw_link" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"
        }
    }

