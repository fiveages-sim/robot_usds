#usda 1.0
(
    defaultPrim = "Zerith_H1_Gripper"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Zerith_H1_Gripper"
{
    over "jaw_camera_link"
    {
        def "d405" (
            prepend payload = @../../../../../../../sensors/realsense/d405.usd@
        )
        {
            double xformOp:rotateX:unitsResolve = 90
            double xformOp:rotateY = -90
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale", "xformOp:rotateX:unitsResolve"]
        }
    }

    over "camera_support"
    {
    }

    over "gripper_base"
    {
    }
}

