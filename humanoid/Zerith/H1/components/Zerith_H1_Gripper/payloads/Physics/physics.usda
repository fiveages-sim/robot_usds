#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Zerith_H1_Gripper"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "Zerith_H1_Gripper"
{
    over "joints"
    {
        def PhysicsPrismaticJoint "gripper_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 120
            float newton:velocityLimit = 0.25
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Zerith_H1_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Zerith_H1_Gripper/jaw_left_finger_link>
            point3f physics:localPos0 = (0.056, -0.04, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.04
            custom float urdf:limit:effort = 120
        }

        def PhysicsPrismaticJoint "jaw_right_finger_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 120
            float newton:mimicCoef1 = -1
            rel newton:mimicJoint = </Zerith_H1_Gripper/joints/gripper_joint>
            float newton:velocityLimit = 0.25
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Zerith_H1_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Zerith_H1_Gripper/jaw_right_finger_link>
            point3f physics:localPos0 = (0.056, 0.04, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.04
            float physics:upperLimit = 0
            custom float urdf:limit:effort = 120
        }

        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </Zerith_H1_Gripper>
            custom rel physics:body1
            append rel physics:body1 = </Zerith_H1_Gripper/gripper_base>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "camera_support_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </Zerith_H1_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Zerith_H1_Gripper/camera_support>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "jaw_camera_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </Zerith_H1_Gripper/camera_support>
            custom rel physics:body1
            append rel physics:body1 = </Zerith_H1_Gripper/jaw_camera_link>
            point3f physics:localPos0 = (0.07675, 0, 0.05878)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.37993604, -0.5963613, 0.5963635, -0.37993744)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "eef_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </Zerith_H1_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Zerith_H1_Gripper/eef>
            point3f physics:localPos0 = (0.0975, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }

    over "jaw_camera_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
    )
    {
        double[] newton:inertia = [0.00001081, 0.0000108, 0.00001658, 0, 0, 0]
        point3f physics:centerOfMass = (0, 0.005, -0.01561719)
        float3 physics:diagonalInertia = (0.0000108, 0.00001081, 0.00001658)
        float physics:mass = 0.05789
