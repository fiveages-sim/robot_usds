    }

    over "camera_support" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
    )
    {
        double[] newton:inertia = [0.000001, 0.000001, 0.000001, 0, 0, 0]
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
        float physics:mass = 0.02
        quatf physics:principalAxes = (1, 0, 0, 0)
    }

    over "eef" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
    )
    {
        double[] newton:inertia = [0.000012345, 6.5495e-8, 0.00001232, -7.5727e-14, 2.3275e-11, -8.2193e-15]
