#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Zerith_H1_Gripper"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Zerith_H1_Gripper"
{
    over "joints"
    {
        over "gripper_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "jaw_right_finger_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "gripper_joint_actuator"
        {
            uniform double mjc:forceRange:max = 120
            uniform double mjc:forceRange:min = -120
            custom rel mjc:target
            append rel mjc:target = </Zerith_H1_Gripper/joints/gripper_joint>
        }

        def MjcActuator "jaw_right_finger_joint_actuator"
        {
            uniform double mjc:forceRange:max = 120
            uniform double mjc:forceRange:min = -120
            custom rel mjc:target
            append rel mjc:target = </Zerith_H1_Gripper/joints/jaw_right_finger_joint>
        }
    }
}

