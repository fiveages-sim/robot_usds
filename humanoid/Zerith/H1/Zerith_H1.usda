#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Zerith_H1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "Zerith_H1" (
    prepend references = @./payloads/base.usda@
    prepend variantSets = ["Physics", "ROS", "Sensor", "EE_Left", "EE_Right"]
    append variantSets = ["Robot"]
)
{
    variantSet "Physics" = {
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {
        }
        "none" {
        }
    }
    variantSet "ROS" = {
        "none" (
            prepend payload = @./payloads/ROS/none.usda@
        ) {
        }
        "enable" (
            prepend payload = @./payloads/ROS/enable.usda@
        ) {
        }
        "fiveages" (
            prepend payload = @./payloads/ROS/fiveages.usda@
        ) {
        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {
        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {
        }
    }
    # EE_Left / EE_Right names == robot_common_launch left_type / right_type
    # (gripper | revo1 | revo2 | none). robotJoints on the selection body
    # (same pattern as CR5 EE), not inside the EE payload def.
    variantSet "EE_Left" = {
        "none" (
            prepend payload = @./payloads/EE_Left/none.usda@
        ) {
        }
        "gripper" (
            prepend payload = @./payloads/EE_Left/gripper.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Zerith_H1/left_wrist_pitch_link/left_tcp/Zerith_H1_Gripper>
            prepend rel isaac:physics:robotLinks = </Zerith_H1/left_wrist_pitch_link/left_tcp/Zerith_H1_Gripper>
        }
        "revo1" (
            prepend payload = @./payloads/EE_Left/revo1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Zerith_H1/left_wrist_pitch_link/left_tcp/Revo1>
            prepend rel isaac:physics:robotLinks = </Zerith_H1/left_wrist_pitch_link/left_tcp/Revo1>
        }
        "revo2" (
            prepend payload = @./payloads/EE_Left/revo2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Zerith_H1/left_wrist_pitch_link/left_tcp/Revo2>
            prepend rel isaac:physics:robotLinks = </Zerith_H1/left_wrist_pitch_link/left_tcp/Revo2>
        }
    }
    variantSet "EE_Right" = {
        "none" (
            prepend payload = @./payloads/EE_Right/none.usda@
        ) {
        }
        "gripper" (
            prepend payload = @./payloads/EE_Right/gripper.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Zerith_H1/right_wrist_pitch_link/right_tcp/Zerith_H1_Gripper>
            prepend rel isaac:physics:robotLinks = </Zerith_H1/right_wrist_pitch_link/right_tcp/Zerith_H1_Gripper>
        }
        "revo1" (
            prepend payload = @./payloads/EE_Right/revo1.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Zerith_H1/right_wrist_pitch_link/right_tcp/Revo1>
            prepend rel isaac:physics:robotLinks = </Zerith_H1/right_wrist_pitch_link/right_tcp/Revo1>
        }
        "revo2" (
            prepend payload = @./payloads/EE_Right/revo2.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Zerith_H1/right_wrist_pitch_link/right_tcp/Revo2>
            prepend rel isaac:physics:robotLinks = </Zerith_H1/right_wrist_pitch_link/right_tcp/Revo2>
        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {
        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {
        }
    }
}
