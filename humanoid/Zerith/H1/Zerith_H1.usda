#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Zerith_H1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "Zerith_H1" (
    prepend references = @./payloads/base.usda@
    prepend variantSets = ["Physics", "ROS", "Sensor", "EE_Left", "EE_Right"]
    append variantSets = ["Robot"]
)
{
    variantSet "Physics" = {
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {
        }
        "none" {
        }
    }
    variantSet "ROS" = {
        "none" (
            prepend payload = @./payloads/ROS/none.usda@
        ) {
        }
        "enable" (
            prepend payload = @./payloads/ROS/enable.usda@
        ) {
        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {
        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {
        }
    }
    variantSet "EE_Left" = {
        "none" (
            prepend payload = @./payloads/EE_Left/none.usda@
        ) {
        }
        "gripper" (
            prepend payload = @./payloads/EE_Left/gripper.usda@
        ) {
        }
        "revo1" (
            prepend payload = @./payloads/EE_Left/revo1.usda@
        ) {
        }
        "revo2" (
            prepend payload = @./payloads/EE_Left/revo2.usda@
        ) {
        }
    }
    variantSet "EE_Right" = {
        "none" (
            prepend payload = @./payloads/EE_Right/none.usda@
        ) {
        }
        "gripper" (
            prepend payload = @./payloads/EE_Right/gripper.usda@
        ) {
        }
        "revo1" (
            prepend payload = @./payloads/EE_Right/revo1.usda@
        ) {
        }
        "revo2" (
            prepend payload = @./payloads/EE_Right/revo2.usda@
        ) {
        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {
        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {
        }
    }
}
