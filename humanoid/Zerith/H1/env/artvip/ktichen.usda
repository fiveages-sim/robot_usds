#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.2324510999466751, -5.049692259315336, 1.802444836819667)
                double3 target = (-5.060597437233495, 19.990151693605114, -4.956610195003352)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./ktichen.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 1000000
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def "kitchen" (
        prepend payload = @../../../../../../environment/ArtVIP-fasim/kitchen/kitchen.usda@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-1.8670123261901344, -4.0629315871640275, -0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "kitchen_all_light"
        {
            token visibility = "invisible"
        }

        over "oven"
        {
            over "oven_light"
            {
                token visibility = "invisible"
            }

            over "Heating_light"
            {
                token visibility
            }

            over "oven_E_door_73"
            {
                over "RevoluteJoint_oven_door"
                {
                    float drive:angular:physics:stiffness = 0.8
                }
            }
        }

        over "model_fridge"
        {
            over "fridge_light"
            {
                token visibility = "invisible"
            }

            over "fridge_E_Leftdoor_84"
            {
                over "RevoluteJoint_fridge_left"
                {
                    float drive:angular:physics:stiffness = 2
                }
            }

            over "fridge_E_Rightdoor_73"
            {
                over "RevoluteJoint_fridge_right"
                {
                    float drive:angular:physics:stiffness = 2
                }
            }
        }

        over "switch"
        {
            over "switch_E_button_09"
            {
                double3 xformOp:translate = (-0.0019290447235107422, 0.00412750244140625, 0.09463346004486084)
            }
        }

        over "Access_control"
        {
            over "Access_control_E_button_09"
            {
                double3 xformOp:translate = (-0.0019292831420898438, 0.00412750244140625, 0.09463346004486084)
            }
        }
    }

    def "Zerith_H1" (
        prepend payload = @../../Zerith_H1.usda@
        variants = {
            string EE_Left = "gripper"
            string EE_Right = "gripper"
            string Physics = "physx"
            string ROS = "enable"
            string Robot = "robot"
            string Sensor = "sensors"
        }
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0.15767963133353613)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Graph"
        {
            over "ROS_JointStates"
            {
                over "ArticulationController"
                {
                    custom int[] inputs:jointIndices
                    custom string inputs:robotPath
                    custom rel inputs:targetPrim (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                }

                over "ReadSimTime"
                {
                    custom uint64 inputs:referenceTimeDenominator
                    custom int64 inputs:referenceTimeNumerator
                }

                over "ros2_publish_clock"
                {
                    custom string inputs:nodeNamespace
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom string inputs:topicName
                }

                over "isaac_read_joint_state_node"
                {
                    custom rel inputs:prim (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                }

                over "SubscriberJointState"
                {
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                }

                over "PublisherJointState"
                {
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom rel inputs:targetPrim (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                }
            }

            over "ROS_Odometry"
            {
                over "OnPlaybackTick"
                {
                    custom double outputs:deltaSeconds
                    custom double outputs:frame
                    custom double outputs:time
                }

                over "Context"
                {
                    custom uchar inputs:domain_id
                    custom bool inputs:useDomainIDEnvVar
                }

                over "ReadSimTime"
                {
                    custom uint64 inputs:referenceTimeDenominator
                    custom int64 inputs:referenceTimeNumerator
                }

                over "TFOdom2Footprint"
                {
                    custom string inputs:nodeNamespace
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom string inputs:topicName
                }

                over "ComputeOdometry"
                {
                    custom rel inputs:chassisPrim (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                    custom vector3d outputs:angularAcceleration
                    custom vector3d outputs:globalLinearAcceleration
                    custom vector3d outputs:globalLinearVelocity
                    custom vector3d outputs:linearAcceleration
                }

                over "TFFootprint2Base"
                {
                    custom string inputs:nodeNamespace
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom quatd inputs:rotation
                    custom string inputs:topicName
                    custom vector3d inputs:translation
                }

                over "TFWorld2Odom"
                {
                    custom string inputs:nodeNamespace
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom quatd inputs:rotation
                    custom string inputs:topicName
                    custom vector3d inputs:translation
                }

                over "PublisherOdometry"
                {
                    custom string inputs:nodeNamespace
                    custom bool inputs:publishRawVelocities
                    custom string inputs:qosProfile
                    custom uint64 inputs:queueSize
                    custom vector3d inputs:robotFront
                }
            }
        }
    }
}

def "Render" (
    hide_in_stage_window = true
    no_delete = true
)
{
    def "OmniverseKit"
    {
        def "HydraTextures" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            def RenderProduct "omni_kit_widget_viewport_ViewportTexture_0" (
                prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxSettingsParticleFieldAPI_1", "OmniRtxPostColorGradingAPI_1", "OmniRtxPostChromaticAberrationAPI_1", "OmniRtxPostBloomPhysicalAPI_1", "OmniRtxPostMatteObjectAPI_1", "OmniRtxPostCompositingAPI_1", "OmniRtxPostDofAPI_1", "OmniRtxPostMotionBlurAPI_1", "OmniRtxPostTvNoiseAPI_1", "OmniRtxPostTonemapIrayReinhardAPI_1", "OmniRtxPostDebugSettingsAPI_1", "OmniRtxDebugSettingsAPI_1"]
                hide_in_stage_window = true
                no_delete = true
            )
            {
                rel camera = </OmniverseKit_Persp>
                token omni:rtx:ambientOcclusion:denoiserMode = "none"
                token omni:rtx:background:source:texture:textureMode = "repeatMirrored"
                token omni:rtx:background:source:type = "domeLight"
                bool omni:rtx:debug:view:pixelDebug:enableFixedTextPos = 1
                token omni:rtx:directLighting:sampledLighting:denoisingTechnique = "None"
                bool omni:rtx:dlss:frameGeneration = 0
                bool omni:rtx:indirectDiffuse:denoiser:enabled = 0
                bool omni:rtx:material:db:syncLoads = 1
                token omni:rtx:post:dlss:execMode = "performance"
                bool omni:rtx:post:registeredCompositing:invertColorCorrection = 1
                bool omni:rtx:post:registeredCompositing:invertToneMap = 1
                bool omni:rtx:pt:adaptiveSampling:filterError = 0
                uint omni:rtx:pt:adaptiveSampling:fixedSppIterations = 2
                uint omni:rtx:pt:maxSamplesPerLaunch = 2073600
                uint omni:rtx:pt:mgpu:maxPixelsPerRegionExponent = 12
                bool omni:rtx:reflections:denoiser:enabled = 0
                token omni:rtx:rendermode = "RealTimePathTracing"
                color3f omni:rtx:rt:ambientLight:color = (0.1, 0.1, 0.1)
                bool omni:rtx:rt:demoire = 0
                bool omni:rtx:rt:ecoMode:enabled
                bool omni:rtx:rt:lightcache:spatialCache:dontResolveConflicts = 1
                int omni:rtx:rt:sss:samples = 1
                uint omni:rtx:rtpt:maxVolumeBounces = 15
                float omni:rtx:rtpt:modulatingRoughnessThreshold = 0.08
                bool omni:rtx:scene:hydra:materialSyncLoads = 1
                bool omni:rtx:scene:hydra:mdlMaterialWarmup = 1
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1097, 637)
            }
        }
    }

    def RenderSettings "OmniverseGlobalRenderSettings" (
        prepend apiSchemas = ["OmniRtxSettingsGlobalRtAdvancedAPI_1", "OmniRtxSettingsGlobalPtAdvancedAPI_1"]
        no_delete = true
    )
    {
        rel products = </Render/OmniverseKit/HydraTextures/omni_kit_widget_viewport_ViewportTexture_0>
    }

    def "Vars" (
        hide_in_stage_window = true
        no_delete = true
    )
    {
        def RenderVar "LdrColor" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            uniform string sourceName = "LdrColor"
            uniform token sourceType = "raw"
        }
    }
}

over "OmniverseKit_Persp" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    customData = {
        dictionary omni = {
            dictionary kit = {
                bool hide_in_stage_window = 1
                bool no_delete = 1
            }
        }
    }
    hide_in_stage_window = true
    kind = "component"
    no_delete = true
)
{
    float2 clippingRange = (0.01, 10000000)
    float exposure:fStop = 5
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
    float focalLength = 18.147562
    float focusDistance = 400
    custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -26.688594380392615)
    float3 xformOp:rotateXYZ = (75.32971, -1.08934e-13, 14.107478)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (1.2324510999466751, -5.049692259315336, 1.802444836819667)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

