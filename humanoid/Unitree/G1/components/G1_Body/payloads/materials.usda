    }

    def Material "face"
    {
        token outputs:mdl:displacement.connect = </Materials/face/face.outputs:out>
        token outputs:mdl:surface.connect = </Materials/face/face.outputs:out>
        token outputs:mdl:volume.connect = </Materials/face/face.outputs:out>

        def Shader "face"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.0, 0.018083, 0.800016)
            color3f inputs:emissive_factor = (0.0, 0.388855, 1.0)
            float inputs:emissive_strength = 5000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.0
            token outputs:out
        }
    }

}
