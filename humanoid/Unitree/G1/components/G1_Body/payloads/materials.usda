#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "white"
    {
        token outputs:mdl:displacement.connect = </Materials/white/white.outputs:out>
        token outputs:mdl:surface.connect = </Materials/white/white.outputs:out>
        token outputs:mdl:volume.connect = </Materials/white/white.outputs:out>

        def Shader "white"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.69804, 0.69804, 0.69804)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "grey"
    {
        token outputs:mdl:displacement.connect = </Materials/grey/grey.outputs:out>
        token outputs:mdl:surface.connect = </Materials/grey/grey.outputs:out>
        token outputs:mdl:volume.connect = </Materials/grey/grey.outputs:out>

        def Shader "grey"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.50196, 0.50196, 0.50196)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "light_green"
    {
        token outputs:mdl:displacement.connect = </Materials/light_green/light_green.outputs:out>
        token outputs:mdl:surface.connect = </Materials/light_green/light_green.outputs:out>
        token outputs:mdl:volume.connect = </Materials/light_green/light_green.outputs:out>

        def Shader "light_green"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.0, 0.8, 0.01176)
            color3f inputs:emissive_factor = (0.0, 1.0, 0.006111)
            float inputs:emissive_strength = 5000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "dark"
    {
        token outputs:mdl:displacement.connect = </Materials/dark/dark.outputs:out>
        token outputs:mdl:surface.connect = </Materials/dark/dark.outputs:out>
        token outputs:mdl:volume.connect = </Materials/dark/dark.outputs:out>

        def Shader "dark"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.08, 0.08, 0.08)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }

    def Material "camera"
    {
        token outputs:mdl:displacement.connect = </Materials/camera/camera.outputs:out>
        token outputs:mdl:surface.connect = </Materials/camera/camera.outputs:out>
        token outputs:mdl:volume.connect = </Materials/camera/camera.outputs:out>

        def Shader "camera"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.0, 0.0, 0.0)
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.2
            token outputs:out
        }
    }

    def Material "lidar"
    {
        token outputs:mdl:displacement.connect = </Materials/lidar/lidar.outputs:out>
        token outputs:mdl:surface.connect = </Materials/lidar/lidar.outputs:out>
        token outputs:mdl:volume.connect = </Materials/lidar/lidar.outputs:out>

        def Shader "lidar"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.030560074, 0.030961279, 0.1930502)
            float inputs:metallic_factor = 1
            float inputs:roughness_factor = 0.03
            token outputs:out
