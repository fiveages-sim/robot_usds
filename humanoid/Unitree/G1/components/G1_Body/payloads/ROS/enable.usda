#usda 1.0
(
    defaultPrim = "G1_Body"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """G1_Body ROS=enable: publish head_camera rgb / depth / camera_info.

The Camera prim lives on Sensor=sensors (payloads/Sensor/sensors.usda, mounted on
torso_link/d435_link/head_camera). This layer only adds the OmniGraph publishers,
so switching ROS never changes geometry or physics.

Requires Sensor=sensors. With Sensor=none the cameraPrim target is unresolved and
the graph is a no-op — set ROS=none in that case.

Topics (relative, so they follow a robot namespace):
  /head_camera/{rgb,depth,camera_info}

Intrinsics come from the optical Camera (focalLength 18.147562,
horizontalAperture 24.95, verticalAperture 13.936). Render size 640x480; the
aperture is 16:9-ish so 1280x720 also works if you prefer native aspect.
"""
)

def Xform "G1_Body"
{
    def "Graph"
    {
        def OmniGraph "ROS_G1BodyCamera"
        {
            token evaluationMode = "Automatic"
            token evaluator:type = "execution"
            token fabricCacheBacking = "StageWithoutHistory"
            int2 fileFormatVersion = (1, 9)
            token pipelineStage = "pipelineStageSimulation"

            def OmniGraphNode "OnPlaybackTick"
            {
                token node:type = "omni.graph.action.OnPlaybackTick"
                int node:typeVersion = 2
                custom double outputs:deltaSeconds
                custom double outputs:frame
                custom uint outputs:tick (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom double outputs:time
            }

            def OmniGraphNode "RunOnce"
            {
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/OnPlaybackTick.outputs:tick>
                ]
                token node:type = "isaacsim.core.nodes.OgnIsaacRunOneSimulationFrame"
                int node:typeVersion = 1
                custom uint outputs:step (
                    customData = {
                        bool isExecution = 1
                    }
                )
            }

            def OmniGraphNode "Context"
            {
                custom uchar inputs:domain_id
                custom bool inputs:useDomainIDEnvVar
                token node:type = "isaacsim.ros2.bridge.ROS2Context"
                int node:typeVersion = 2
                custom uint64 outputs:context
            }

            def OmniGraphNode "RenderProduct"
            {
                custom rel inputs:cameraPrim = </G1_Body/torso_link/d435_link/head_camera> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom bool inputs:enabled
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/RunOnce.outputs:step>
                ]
                # ------------------------------------------------------------------
                # 【临时改动 2026-11-14】发布分辨率从 1280x720 改为 640x480
                #
                # 原因：训练数据（sdg 采集）用的是 640x480（4:3），而这里原本
                # 发布 1280x720（16:9）。Isaac 按分辨率比例推导有效垂直 aperture
                # （HFOV 固定、方形像素），导致两者的**垂直视野差 12.3°（29%）**：
                #     640x480  → HFOV 69.0° VFOV 54.5°   ← 训练数据
                #     1280x720 → HFOV 69.0° VFOV 42.3°   ← 话题发布的
                # 直接 resize 到 640x480 会把画面纵向压扁 29%，策略"看不懂"。
                # 实测：用数据集图 20 帧推进 18.2mm，用实时图只有 0.7mm。
                #
                # 改这里让话题发布与训练数据同分辨率 → 零转换、零视野损失。
                # 注意：sdg 采集**不受影响**（它直接读 Replicator，用
                # task.yaml 的 resolution，本来就是 640x480）。
                #
                # TODO 后续方案：要么把采集分辨率统一到 1280x720，要么把这个
                # 分辨率做成配置项（而不是写死在资产里）。
                # ------------------------------------------------------------------
                custom uint inputs:height = 480
                custom rel inputs:renderProductPrim (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom uint inputs:width = 640
                token node:type = "isaacsim.core.nodes.IsaacCreateRenderProduct"
                int node:typeVersion = 2
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom token outputs:renderProductPath
            }

            def OmniGraphNode "CameraInfoPublish"
            {
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/Context.outputs:context>
                ]
                custom bool inputs:enabled
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/RenderProduct.outputs:execOut>
                ]
                custom string inputs:frameId = "head_camera"
                custom string inputs:frameIdRight
                custom uint inputs:frameSkipCount
                custom string inputs:nodeNamespace = "head_camera"
                custom string inputs:qosProfile
                custom uint64 inputs:queueSize
                custom token inputs:renderProductPath
                prepend token inputs:renderProductPath.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/RenderProduct.outputs:renderProductPath>
                ]
                custom token inputs:renderProductPathRight
                custom bool inputs:resetSimulationTimeOnStop = 1
                custom string inputs:topicName = "camera_info"
                custom string inputs:topicNameRight
                custom bool inputs:useSystemTime
                token node:type = "isaacsim.ros2.bridge.ROS2CameraInfoHelper"
                int node:typeVersion = 1
            }

            def OmniGraphNode "RGBPublish"
            {
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/Context.outputs:context>
                ]
                custom bool inputs:enabled
                custom bool inputs:enableSemanticLabels
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/RenderProduct.outputs:execOut>
                ]
                custom string inputs:frameId = "head_camera"
                custom uint inputs:frameSkipCount
                custom string inputs:nodeNamespace = "head_camera"
                custom string inputs:qosProfile
                custom uint64 inputs:queueSize
                custom token inputs:renderProductPath
                prepend token inputs:renderProductPath.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/RenderProduct.outputs:renderProductPath>
                ]
                custom bool inputs:resetSimulationTimeOnStop = 1
                custom string inputs:semanticLabelsTopicName
                custom string inputs:srtxCompressionType
                custom float2 inputs:stereoOffset
                custom string inputs:topicName = "rgb"
                custom token inputs:type = "rgb" (
                    allowedTokens = ["rgb", "rgb_h264", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "rgb_hevc"]
                )
                custom bool inputs:useSystemTime
                token node:type = "isaacsim.ros2.bridge.ROS2CameraHelper"
                int node:typeVersion = 2
            }

            def OmniGraphNode "DepthPublish"
            {
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/Context.outputs:context>
                ]
                custom bool inputs:enabled
                custom bool inputs:enableSemanticLabels
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/RenderProduct.outputs:execOut>
                ]
                custom string inputs:frameId = "head_camera"
                custom uint inputs:frameSkipCount
                custom string inputs:nodeNamespace = "head_camera"
                custom string inputs:qosProfile
                custom uint64 inputs:queueSize
                custom token inputs:renderProductPath
                prepend token inputs:renderProductPath.connect = [
                    </G1_Body/Graph/ROS_G1BodyCamera/RenderProduct.outputs:renderProductPath>
                ]
                custom bool inputs:resetSimulationTimeOnStop = 1
                custom string inputs:semanticLabelsTopicName
                custom string inputs:srtxCompressionType
                custom float2 inputs:stereoOffset
                custom string inputs:topicName = "depth"
                custom token inputs:type = "depth" (
                    allowedTokens = ["rgb", "rgb_h264", "depth", "depth_pcl", "instance_segmentation", "semantic_segmentation", "bbox_2d_tight", "bbox_2d_loose", "bbox_3d", "rgb_hevc"]
                )
                custom bool inputs:useSystemTime
                token node:type = "isaacsim.ros2.bridge.ROS2CameraHelper"
                int node:typeVersion = 2
            }
        }
    }
}
