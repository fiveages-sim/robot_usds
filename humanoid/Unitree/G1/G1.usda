#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.1515935282325602, 0.8714519104513806, 0.839320399844628)
                double3 target = (0.10565924687988848, -0.15428384624671365, 0.058067579084619125)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./G1.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "G1"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "G1" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Arms = "arms"
        string BodyHead = "bodyhead"
        string EE_Left = "rubber_hand"
        string EE_Right = "rubber_hand"
        string Lower = "lower"
        string Physics = "physx"
        string ROS = "none"
        string Robot = "none"
        string Sensor = "none"
    }
    prepend variantSets = ["Physics", "ROS", "Sensor", "Lower", "BodyHead", "Arms", "EE_Left", "EE_Right"]
    append variantSets = "Robot"
)
{
    over "G1_Arms"
    {
        over "right_wrist_yaw_link"
        {
            over "right_tcp"
            {
                over "RubberHand" (
                    delete apiSchemas = ["PhysicsArticulationRootAPI"]
                )
                {
                    uniform bool newton:jointsAddMobility (
                        displayName = "Joints Add Mobility"
                    )
                }
            }
        }

        over "left_wrist_yaw_link"
        {
            over "left_tcp"
            {
                over "RubberHand" (
                    delete apiSchemas = ["PhysicsArticulationRootAPI"]
                )
                {
                    uniform bool newton:jointsAddMobility (
                        displayName = "Joints Add Mobility"
                    )
                }
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
    variantSet "ROS" = {
        "enable" (
            prepend payload = @./payloads/ROS/enable.usda@
        ) {

        }
        "none" (
            prepend payload = @./payloads/ROS/none.usda@
        ) {

        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {

        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {

        }
    }
    variantSet "Lower" = {
        "None" (
            prepend payload = @./payloads/Lower/none.usda@
        ) {

        }
        "lower" (
            prepend payload = @./payloads/Lower/lower.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </G1/G1_Lower>
            prepend rel isaac:physics:robotLinks = </G1/G1_Lower>

        }
    }
    variantSet "BodyHead" = {
        "None" (
            prepend payload = @./payloads/BodyHead/none.usda@
        ) {

        }
        "bodyhead" (
            prepend payload = @./payloads/BodyHead/bodyhead.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </G1/G1_Body>
            prepend rel isaac:physics:robotLinks = </G1/G1_Body>

        }
    }
    variantSet "Arms" = {
        "None" (
            prepend payload = @./payloads/Arms/none.usda@
        ) {

        }
        "arms" (
            prepend payload = @./payloads/Arms/arms.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </G1/G1_Arms>
            prepend rel isaac:physics:robotLinks = </G1/G1_Arms>

        }
    }
    variantSet "EE_Left" = {
        "dex1" (
            prepend payload = @./payloads/EE_Left/dex1.usda@
        ) {

        }
        "dex3" (
            prepend payload = @./payloads/EE_Left/dex3.usda@
        ) {

        }
        "none" (
            prepend payload = @./payloads/EE_Left/none.usda@
        ) {

        }
        "revo2" (
            prepend payload = @./payloads/EE_Left/revo2.usda@
        ) {

        }
        "rubber_hand" (
            prepend payload = @./payloads/EE_Left/rubber_hand.usda@
        ) {

        }
    }
    variantSet "EE_Right" = {
        "dex1" (
            prepend payload = @./payloads/EE_Right/dex1.usda@
        ) {

        }
        "dex3" (
            prepend payload = @./payloads/EE_Right/dex3.usda@
        ) {

        }
        "none" (
            prepend payload = @./payloads/EE_Right/none.usda@
        ) {

        }
        "revo2" (
            prepend payload = @./payloads/EE_Right/revo2.usda@
        ) {

        }
        "rubber_hand" (
            prepend payload = @./payloads/EE_Right/rubber_hand.usda@
        ) {

        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {

        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {

        }
    }
}

def "Render" (
    hide_in_stage_window = true
    no_delete = true
)
{
    def "OmniverseKit"
    {
        def "HydraTextures" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            def RenderProduct "omni_kit_widget_viewport_ViewportTexture_0" (
                prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxSettingsParticleFieldAPI_1", "OmniRtxPostColorGradingAPI_1", "OmniRtxPostChromaticAberrationAPI_1", "OmniRtxPostBloomPhysicalAPI_1", "OmniRtxPostMatteObjectAPI_1", "OmniRtxPostCompositingAPI_1", "OmniRtxPostDofAPI_1", "OmniRtxPostMotionBlurAPI_1", "OmniRtxPostTvNoiseAPI_1", "OmniRtxPostTonemapIrayReinhardAPI_1", "OmniRtxPostDebugSettingsAPI_1", "OmniRtxDebugSettingsAPI_1"]
                hide_in_stage_window = true
                no_delete = true
            )
            {
                rel camera = </OmniverseKit_Persp>
                token omni:rtx:ambientOcclusion:denoiserMode = "none"
                token omni:rtx:background:source:texture:textureMode = "repeatMirrored"
                token omni:rtx:background:source:type = "domeLight"
                bool omni:rtx:debug:view:pixelDebug:enableFixedTextPos = 1
                token omni:rtx:directLighting:sampledLighting:denoisingTechnique = "None"
                bool omni:rtx:dlss:frameGeneration = 0
                bool omni:rtx:indirectDiffuse:denoiser:enabled = 0
                bool omni:rtx:material:db:syncLoads = 1
                token omni:rtx:post:dlss:execMode = "performance"
                bool omni:rtx:post:registeredCompositing:invertColorCorrection = 1
                bool omni:rtx:post:registeredCompositing:invertToneMap = 1
                bool omni:rtx:pt:adaptiveSampling:filterError = 0
                uint omni:rtx:pt:adaptiveSampling:fixedSppIterations = 2
                uint omni:rtx:pt:maxSamplesPerLaunch = 2073600
                uint omni:rtx:pt:mgpu:maxPixelsPerRegionExponent = 12
                bool omni:rtx:reflections:denoiser:enabled = 0
                token omni:rtx:rendermode = "RealTimePathTracing"
                color3f omni:rtx:rt:ambientLight:color = (0.1, 0.1, 0.1)
                bool omni:rtx:rt:demoire = 0
                bool omni:rtx:rt:lightcache:spatialCache:dontResolveConflicts = 1
                int omni:rtx:rt:sss:samples = 1
                uint omni:rtx:rtpt:maxVolumeBounces = 15
                float omni:rtx:rtpt:modulatingRoughnessThreshold = 0.08
                bool omni:rtx:scene:hydra:materialSyncLoads = 1
                bool omni:rtx:scene:hydra:mdlMaterialWarmup = 1
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1614, 720)
            }
        }
    }

    def RenderSettings "OmniverseGlobalRenderSettings" (
        prepend apiSchemas = ["OmniRtxSettingsGlobalRtAdvancedAPI_1", "OmniRtxSettingsGlobalPtAdvancedAPI_1"]
        no_delete = true
    )
    {
        rel products = </Render/OmniverseKit/HydraTextures/omni_kit_widget_viewport_ViewportTexture_0>
    }

    def "Vars" (
        hide_in_stage_window = true
        no_delete = true
    )
    {
        def RenderVar "LdrColor" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            uniform string sourceName = "LdrColor"
            uniform token sourceType = "raw"
        }
    }
}

over "OmniverseKit_Persp" (
    prepend apiSchemas = ["OmniRtxCameraAutoExposureAPI_1", "OmniRtxCameraExposureAPI_1"]
    customData = {
        dictionary omni = {
            dictionary kit = {
                bool hide_in_stage_window = 1
                bool no_delete = 1
            }
        }
    }
    hide_in_stage_window = true
    kind = "component"
    no_delete = true
)
{
    float2 clippingRange = (0.01, 10000000)
    float exposure:fStop = 5
    float exposure:responsivity = 1.1026709
    float exposure:time = 0.02
    float focalLength = 18.147562
    float focusDistance = 400
    custom uniform vector3d omni:kit:centerOfInterest = (0, 0, -1.660261525610713)
    float3 xformOp:rotateXYZ = (61.92934, -1.2722219e-14, 134.44139)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (1.1515935282325602, 0.8714519104513806, 0.839320399844628)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

