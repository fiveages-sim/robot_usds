#usda 1.0
(
    defaultPrim = "G1"
    metersPerUnit = 1
    upAxis = "Z"
)

over "G1"
{
    def "G1_Body" (
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        prepend payload = @../../components/G1_Body/G1_Body.usda@
        variants = {
            string Physics = "physx"
            string ROS = "none"
            string Sensor = "none"
            string Robot = "none"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.0039635, 0, 0.044)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "torso_link" (
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        )
        {
            def PhysicsRevoluteJoint "waist_pitch_joint" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
            )
            {
                float physxJoint:maxJointVelocity = 500000
                rel physics:body0 = </G1/G1_Lower/waist_roll_link>
                rel physics:body1 = </G1/G1_Body/torso_link>
                uniform token physics:axis = "Y"
                bool physics:collisionEnabled = false
                bool physics:excludeFromArticulation = false
                bool physics:jointEnabled = true
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -29.793806076049805
                float physics:upperLimit = 29.793806076049805
                uniform token drive:angular:physics:type = "force"
                float drive:angular:physics:stiffness = 60000
                float drive:angular:physics:damping = 6000
                float drive:angular:physics:maxForce = 5000
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }
    }
}
