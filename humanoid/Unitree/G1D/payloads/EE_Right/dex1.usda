#usda 1.0
(
    defaultPrim = "G1D"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Dex1 right EE (G1D).

Match working Revo2 / CR5 AG2F90 / G1 Dex1 mount:
- root_joint active=false + delete ArtRoot schemas (active alone can leave a
  nested root that PhysX rejects → Mimic 'not part of an articulation' →
  tensors invalidate → arms scatter).
- AssemblerFixedJoint body0 = right_tcp (same as Revo2/G1); tcp already sits
  at 0.0415 on the wrist, Dex1 translate is 0 → localPos0 = 0.
"""
)

def "G1D"
{
    over "G1_Arms"
    {
        over "right_wrist_yaw_link"
        {
            over "right_tcp"
            {
            def "Dex1" (
                prepend payload = @../../../../../grippers/Unitree/Dex1/Dex1.usda@
                variants = {
                    string Physics = "physx"
                    string Robot = "none"
                    string Sensor = "camera"
                    string Side = "right"
                }
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.0, 0.0, 0.0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "Physics"
                {
                    over "root_joint" (
                        active = false
                        delete apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
                    )
                    {
                    }
                }

                over "Geometry"
                {
                    over "dex1_base_link"
                    {
                        def PhysicsFixedJoint "AssemblerFixedJoint"
                        {
                            rel physics:body0 = </G1D/G1_Arms/right_wrist_yaw_link/right_tcp>
                            rel physics:body1 = </G1D/G1_Arms/right_wrist_yaw_link/right_tcp/Dex1/Geometry/dex1_base_link>
                            bool physics:excludeFromArticulation = false
                            bool physics:jointEnabled = true
                            point3f physics:localPos0 = (0, 0, 0)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (1, 0, 0, 0)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                        }
                    }
                }
            }
            }
        }
    }
}
