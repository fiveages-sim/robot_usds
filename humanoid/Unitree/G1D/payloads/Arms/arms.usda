#usda 1.0
(
    defaultPrim = "G1D"
    metersPerUnit = 1
    upAxis = "Z"
)

over "G1D"
{
    # Dual-arm asset. Strip importer ArticulationRoot; arms_torso_link → G1_Body torso.
    def "G1_Arms" (
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        prepend payload = @../../../G1/components/G1_Arms/G1_Arms.usda@
        variants = {
            string ROS = "none"
            string Sensor = "none"
            string Robot = "none"
        }
    )
    {
        # Same rest pose as G1_Body so shoulders sit on the torso before physics runs.
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.053371430065905015, 0.000167718, 0.8351085659999999)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "arms_torso_link" (
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        )
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </G1D/G1_Body/torso_link>
                rel physics:body1 = </G1D/G1_Arms/arms_torso_link>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }
}
