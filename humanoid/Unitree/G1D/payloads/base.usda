#usda 1.0
(
    defaultPrim = "G1D"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Skeleton: /G1D/base_link = TF + Assembler hub. Physics=* adds RigidBody on base_link; ArtRoot on /G1D."
)

def Xform "G1D"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    # Floating-base Assembler hub. Physics=* adds RigidBody here; ArtRoot lives on /G1D.
    def Xform "base_link"
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Xform "visuals"
        {
        }

        def Xform "collisions"
        {
        }
    }

    def Scope "joints"
    {
    }
}
