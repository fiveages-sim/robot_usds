#usda 1.0
(
    defaultPrim = "G1D"
    metersPerUnit = 1
    upAxis = "Z"
)

over "G1D"
{
    def "G1D_Lift" (
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        prepend payload = @../../components/G1D_Lift/G1D_Lift.usda@
        variants = {
            string Physics = "physx"
            string ROS = "none"
            string Sensor = "none"
            string Robot = "none"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        # Component LZ_ot_Joint expected AGV_link inside Lift — use Assembler weld instead.
        over "joints"
        {
            over "LZ_ot_Joint" (
                active = false
            )
            {
            }
        }

        over "LZ_ot_Link" (
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        )
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </G1D/G1D_Chassis/AGV_link>
                rel physics:body1 = </G1D/G1D_Lift/LZ_ot_Link>
                point3f physics:localPos0 = (-0.000162639876214998, 0, 0.5275)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }
}
