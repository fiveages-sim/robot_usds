#usda 1.0
(
    defaultPrim = "G1D"
    metersPerUnit = 1
    upAxis = "Z"
)

over "G1D"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
    }

    over "G1D_Chassis" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }

    over "G1D_Lift" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }

    over "G1_Body" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }

    over "G1_Arms" (
        variants = {
            string Physics = "physics"
        }
    )
    {
    }
}
