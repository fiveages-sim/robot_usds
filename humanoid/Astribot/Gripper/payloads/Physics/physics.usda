#usda 1.0
(
    defaultPrim = "Astribot_Gripper"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Astribot_Gripper"
{
    over "gripper_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.0002861143, 0.000054614397, 0.03130708)
        float3 physics:diagonalInertia = (0.00007706413, 0.0000918575, 0.00011079536)
        float physics:mass = 0.18791515
        quatf physics:principalAxes = (0.9984325, -0.054688934, -0.0118891345, -0.000518271)
        rel physics:simulationOwner
    }

    over "gripper_L1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.023864087, 9.476878e-11, 0.022907544)
        float3 physics:diagonalInertia = (0.0000026587975, 0.000003738571, 0.000006289154)
        float physics:mass = 0.013277335
        quatf physics:principalAxes = (0.93358046, 0, -0.35836792, 0)
        rel physics:simulationOwner
    }

    over "joints"
    {
        def PhysicsRevoluteJoint "gripper_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 1
            float drive:angular:physics:maxForce = 10
            float drive:angular:physics:stiffness = 10
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Astribot_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Astribot_Gripper/gripper_L1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.00024833222
            point3f physics:localPos0 = (0.0145, 0, 0.0511)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 57.295776
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "gripper_joint_L11" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Astribot_Gripper/gripper_L1>
            custom rel physics:body1
            append rel physics:body1 = </Astribot_Gripper/gripper_L11>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.00037653488
            point3f physics:localPos0 = (0.04125, 0, 0.03637908)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -11.459155
            float physics:upperLimit = 68.75493
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "gripper_joint_L2" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Astribot_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Astribot_Gripper/gripper_L2>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.00015301285
            point3f physics:localPos0 = (0.0325, 0, 0.0511)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = -11.459155
            float physics:upperLimit = 68.75493
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "gripper_joint_R1" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Astribot_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Astribot_Gripper/gripper_R1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.0002508852
            point3f physics:localPos0 = (-0.0145, 0, 0.0511)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -11.459155
            float physics:upperLimit = 68.75493
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "gripper_joint_R11" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Astribot_Gripper/gripper_R1>
            custom rel physics:body1
            append rel physics:body1 = </Astribot_Gripper/gripper_R11>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.0003772252
            point3f physics:localPos0 = (-0.04125, 0, 0.03637908)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 1, 0, 0)
            quatf physics:localRot1 = (0, 1, 0, 0)
            float physics:lowerLimit = -11.459155
            float physics:upperLimit = 68.75493
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }

        def PhysicsRevoluteJoint "gripper_joint_R2" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </Astribot_Gripper/gripper_base>
            custom rel physics:body1
            append rel physics:body1 = </Astribot_Gripper/gripper_R2>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.00015378029
            point3f physics:localPos0 = (-0.0325, 0, 0.0511)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -11.459155
            float physics:upperLimit = 68.75493
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
    }

    over "gripper_L11" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.005802138, -0.00008251652, 0.030870039)
        float3 physics:diagonalInertia = (0.0000133554, 0.0000122075035, 0.0000035137214)
        float physics:mass = 0.048314776
        quatf physics:principalAxes = (0.9992638, -0.0033312591, -0.03814872, -0.0023514656)
        rel physics:simulationOwner
    }

    over "gripper_L2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.014084759, 1.3810393e-10, 0.013636045)
        float3 physics:diagonalInertia = (0.0000015284783, 0.000009275804, 0.000009980987)
        float physics:mass = 0.022578854
        quatf physics:principalAxes = (0.9584329, 0, -0.28531837, 0)
        rel physics:simulationOwner
    }

    over "gripper_R1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.023864087, -9.476857e-11, 0.022907544)
        float3 physics:diagonalInertia = (0.0000026587975, 0.000003738571, 0.000006289154)
        float physics:mass = 0.013277335
        quatf physics:principalAxes = (0.93358046, 0, 0.35836792, 0)
        rel physics:simulationOwner
    }

    over "gripper_R11" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.0058021382, 0.00008251653, 0.030870039)
        float3 physics:diagonalInertia = (0.0000133554, 0.0000122075035, 0.0000035137211)
        float physics:mass = 0.048314776
        quatf physics:principalAxes = (0.9992638, 0.0033312596, 0.03814872, -0.002351466)
        rel physics:simulationOwner
    }

    over "gripper_R2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.014084759, -1.3809695e-10, 0.013636045)
        float3 physics:diagonalInertia = (0.0000015284783, 0.000009275804, 0.000009980987)
        float physics:mass = 0.022578854
        quatf physics:principalAxes = (0.9584329, 0, 0.28531837, 0)
        rel physics:simulationOwner
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </Astribot_Gripper/gripper_base>
    }
}

