#usda 1.0
(
    defaultPrim = "Astribot_Gripper"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Astribot_Gripper" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </Astribot_Gripper/root_joint>,
        </Astribot_Gripper/joints/gripper_joint>,
        </Astribot_Gripper/joints/gripper_joint_L11>,
        </Astribot_Gripper/joints/gripper_joint_L2>,
        </Astribot_Gripper/joints/gripper_joint_R1>,
        </Astribot_Gripper/joints/gripper_joint_R11>,
        </Astribot_Gripper/joints/gripper_joint_R2>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Astribot_Gripper/gripper_base>,
        </Astribot_Gripper/gripper_L1>,
        </Astribot_Gripper/gripper_L11>,
        </Astribot_Gripper/gripper_L2>,
        </Astribot_Gripper/gripper_R1>,
        </Astribot_Gripper/gripper_R11>,
        </Astribot_Gripper/gripper_R2>,
        </Astribot_Gripper/gripper_base/gripper_center>,
        </Astribot_Gripper/gripper_base/collisions>,
        </Astribot_Gripper/gripper_L1/collisions>,
        </Astribot_Gripper/gripper_L2/collisions>,
        </Astribot_Gripper/gripper_R1/collisions>,
        </Astribot_Gripper/gripper_R2/collisions>,
    ]

    over "gripper_base" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "gripper_center" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "gripper_L1" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "joints"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "gripper_joint_L11" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "gripper_joint_L2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "gripper_joint_R1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "gripper_joint_R11" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "gripper_joint_R2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }
    }

    over "gripper_L11" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "gripper_L2" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "gripper_R1" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "gripper_R11" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "gripper_R2" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["IsaacJointAPI"]
    )
    {
    }
}

