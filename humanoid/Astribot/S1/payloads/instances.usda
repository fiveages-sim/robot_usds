    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "grey" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/grey>
            }

            over "white" (
