                {
                    custom rel inputs:targetPrim = </Galaxea_R1>
                }

                over "articulation_controller"
                {
                    custom rel inputs:targetPrim = </Galaxea_R1>
                }
            }

            over "ROS_Odometry"
            {
                over "ComputeTFRobot"
                {
                    uniform float2 ui:nodegraph:node:pos = (-615.3267, -771.27155)
                }

                over "ComputeOdometry" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform float2 ui:nodegraph:node:pos = (-626.68146, -483.94876)
                }

