over "SteerChassis" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </SteerChassis/joints/steer_joint1>,
        </SteerChassis/joints/wheel_joint1>,
        </SteerChassis/joints/steer_joint2>,
        </SteerChassis/joints/wheel_joint2>,
        </SteerChassis/joints/steer_joint3>,
        </SteerChassis/joints/wheel_joint3>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </SteerChassis/base_link>,
        </SteerChassis/steer_motor_link1>,
        </SteerChassis/wheel_motor_link1>,
        </SteerChassis/steer_motor_link2>,
        </SteerChassis/wheel_motor_link2>,
