#usda 1.0
(
    defaultPrim = "Galaxea_R1_Lite"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Galaxea_R1_Lite" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </Galaxea_R1_Lite/joints/steer_joint1>,
        </Galaxea_R1_Lite/joints/wheel_joint1>,
        </Galaxea_R1_Lite/joints/steer_joint2>,
        </Galaxea_R1_Lite/joints/wheel_joint2>,
        </Galaxea_R1_Lite/joints/steer_joint3>,
        </Galaxea_R1_Lite/joints/wheel_joint3>,
        </Galaxea_R1_Lite/joints/torso_joint1>,
        </Galaxea_R1_Lite/joints/torso_joint2>,
        </Galaxea_R1_Lite/joints/torso_joint3>,
    ]
