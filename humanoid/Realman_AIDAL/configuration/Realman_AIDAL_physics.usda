#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (1.5293392526607625, 1.4322330492314055, 2.06946130350413)
                double3 target = (-0.14767195935807065, -0.2447781627874268, 0.3924501315125868)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./Realman_AIDAL_physics.usd"
            dictionary locked = {
            }
            dictionary muteness = {
            }
