over "colliders"
{
    over "base_footprint"
    {
        over "mesh_0"
        {
            over "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
            }
        }
    }

    over "caster_wheel_1_link"
    {
        over "mesh_0"
        {
