                                float focalLength = 18.147562
                                float focusDistance = 400
                                quatd xformOp:orient = (1, 0, 0, 0)
                                double3 xformOp:scale = (1, 1, 1)
                                double3 xformOp:translate = (0, 0, 0)
                                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                            }
                        }
                    }
                }
            }
        }
    }
    variantSet "Physics" = {
        "None" (
            prepend references = @./configuration/Realman_AIDAL_base.usd@
        ) {
            over "joints" (
                active = false
            )
            {
            }

        }
        "PhysX" (
            prepend payload = @./configuration/Realman_AIDAL_physics.usd@
        ) {

        }
    }
    variantSet "Sensor" = {
        "None" {

        }
        "Sensors" (
            prepend payload = @./configuration/Realman_AIDAL_sensor.usd@
        ) {

        }
    }
    variantSet "Robot" = {
        "None" {

        }
        "Robot" (
            prepend payload = @./configuration/Realman_AIDAL_robot.usd@
        ) {

        }
    }
    variantSet "Base" = {
        "None" {

        }
        "Woosh_AGV" (
            delete payload = @./configuration/Realman_AIDAL_Base_Woosh_AGV.usd@
            prepend payload = @./configuration/Realman_AIDAL_Base_Woosh_AGV.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Realman_AIDAL/Woosh_AGV>
            prepend rel isaac:physics:robotLinks = </Realman_AIDAL/Woosh_AGV>

        }
    }
    variantSet "Arm_Left" = {
        "None" {

        }
        "RM75_aidal_left" (
            delete payload = @./configuration/Realman_AIDAL_Arm_Left_RM75_aidal_left.usd@
            prepend payload = @./configuration/Realman_AIDAL_Arm_Left_RM75_aidal_left.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Realman_AIDAL/RM75_aidal_left>
            prepend rel isaac:physics:robotLinks = </Realman_AIDAL/RM75_aidal_left>

        }
    }
    variantSet "Arm_Right" = {
        "None" {

        }
        "RM75_aidal_right" (
            delete payload = @./configuration/Realman_AIDAL_Arm_Right_RM75_aidal_right.usd@
            prepend payload = @./configuration/Realman_AIDAL_Arm_Right_RM75_aidal_right.usda@
        ) {
            prepend rel isaac:physics:robotJoints = </Realman_AIDAL/RM75_aidal_right>
            prepend rel isaac:physics:robotLinks = </Realman_AIDAL/RM75_aidal_right>

        }
    }
