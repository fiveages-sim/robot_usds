            displayName = "Namespace"
        )
        rel isaac:physics:robotJoints (
            displayName = "Robot Joints"
        )
        rel isaac:physics:robotLinks (
            displayName = "Robot Links"
        )
        token isaac:robotType (
            displayName = "Robot Type"
        )
        string isaac:source (
            displayName = "Source"
        )
        string isaac:version (
            displayName = "Version"
        )

        over "Graphs"
        {
            over "differential_controller"
            {
                over "ArrayNames"
                {
                    custom token inputs:input0 = "left_wheel_joint" (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    token attrValue = "left_wheel_joint"
                                    string resolvedType = "token"
                                }
                            }
                        }
                    )
                    custom token inputs:input1 = "right_wheel_joint"
                }

                over "ArticulationController" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    custom rel inputs:targetPrim = </Realman_AIDAL>
                    uniform float2 ui:nodegraph:node:pos = (277.19022, 30.087286)
                }

                over "DifferentialController"
                {
                    uniform float2 ui:nodegraph:node:pos = (-18.201815, 384.9002)
                }

                over "ros2_subscribe_twist"
                {
                    uniform float2 ui:nodegraph:node:pos = (-702.64526, 471.70535)
                }
            }

            over "ROS_Odometry" (
                active = true
            )
            {
                over "ComputeOdometry" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    custom rel inputs:chassisPrim = </Realman_AIDAL/Woosh_AGV/base_footprint>
                    uniform float2 ui:nodegraph:node:pos = (-578.25, -229.92847)
                }
            }
        }

        over "base_footprint"
        {
        }

        over "caster_1_link"
