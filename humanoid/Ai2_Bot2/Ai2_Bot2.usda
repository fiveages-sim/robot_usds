                        }
                    )
                }

                over "ArticulationController"
                {
                    custom rel inputs:targetPrim = </Ai2_Bot2>
                }
            }

            over "ROS_Odometry"
            {
                over "ComputeOdometry" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    custom rel inputs:chassisPrim = </Ai2_Bot2/Ai2_Bot2_Chassis/base_footprint>
                    uniform float2 ui:nodegraph:node:pos = (-580.28516, 291.875)
                }
            }

            over "ROS_Camera"
            {
                over "DepthPclPublish"
                {
                    custom token inputs:viewport
                }

                over "DepthPublish"
                {
                    custom token inputs:viewport
                }

                over "RGBPublish"
                {
                    custom token inputs:viewport
                }
            }
        }

        over "base_footprint"
