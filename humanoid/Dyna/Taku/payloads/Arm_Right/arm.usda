#usda 1.0
(
    defaultPrim = "Taku"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Taku"
{
    def "Arm_Right" (
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        prepend payload = @../../components/Taku_Arm/Taku_Arm.usda@
        variants = {
            string EE = "Dynaclaw"
            string Sensor = "sensors"
            string Side = "right"
        }
    )
    {
        quatd xformOp:orient = (6.123233995736766e-17, 0, 0, 1)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.205555, -0.105199, 1.0977169999999998)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "base_link" (
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        )
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </Taku/Taku_Body/torso_body_link>
                rel physics:body1 = </Taku/Arm_Right/base_link>
                point3f physics:localPos0 = (0, -0.105, 0.243)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (6.123234e-17, 0, 0, 1)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }
}

