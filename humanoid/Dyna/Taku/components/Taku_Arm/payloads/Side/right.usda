#usda 1.0
(
    defaultPrim = "Taku_Arm"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Taku_Arm" (
    variants = {
        string EE = "Dynaclaw"
    }
    prepend variantSets = "EE"
)
{
    custom rel isaac:physics:robotJoints
    prepend rel isaac:physics:robotJoints = [
        </Taku_Arm/joints/right_shoulder_pitch_joint>,
        </Taku_Arm/joints/right_shoulder_roll_joint>,
        </Taku_Arm/joints/right_shoulder_yaw_joint>,
        </Taku_Arm/joints/right_elbow_joint>,
        </Taku_Arm/joints/right_wrist_yaw_joint>,
        </Taku_Arm/joints/right_wrist_pitch_joint>,
        </Taku_Arm/joints/right_wrist_roll_joint>,
    ]

    def "joints"
    {
        over "shoulder_pitch_joint" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_shoulder_pitch_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 40
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "Y"
            rel physics:body0 = </Taku_Arm/base_link>
            rel physics:body1 = </Taku_Arm/shoulder_pitch_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -150
            float physics:upperLimit = 90
            custom float physxJoint:maxJointVelocity = 959.9716
            custom float state:angular:physics:position = 0
            custom float state:angular:physics:velocity = 0
        }

        def MjcActuator "right_shoulder_pitch_joint_actuator"
        {
            custom double mjc:forceRange:max = 40
            custom double mjc:forceRange:min = -40
            custom rel mjc:target = </Taku_Arm/joints/right_shoulder_pitch_joint>
        }

        over "shoulder_roll_joint" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_shoulder_roll_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 40
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "X"
            rel physics:body0 = </Taku_Arm/shoulder_pitch_link>
            rel physics:body1 = </Taku_Arm/shoulder_roll_link>
            point3f physics:localPos0 = (0, 0.085, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0.70710677, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -95
            float physics:upperLimit = 0
            custom float physxJoint:maxJointVelocity = 959.9716
            custom float state:angular:physics:position = 0
            custom float state:angular:physics:velocity = 0
        }

        def MjcActuator "right_shoulder_roll_joint_actuator"
        {
            custom double mjc:forceRange:max = 40
            custom double mjc:forceRange:min = -40
            custom rel mjc:target = </Taku_Arm/joints/right_shoulder_roll_joint>
        }

        over "shoulder_yaw_joint" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_shoulder_yaw_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 27
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "Z"
            rel physics:body0 = </Taku_Arm/shoulder_roll_link>
            rel physics:body1 = </Taku_Arm/shoulder_yaw_link>
            point3f physics:localPos0 = (0, 0, -0.125)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0, 0, 0.70710677)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -180
            float physics:upperLimit = 180
            custom float physxJoint:maxJointVelocity = 311.99994
            custom float state:angular:physics:position = 0
            custom float state:angular:physics:velocity = 0
        }

        def MjcActuator "right_shoulder_yaw_joint_actuator"
        {
            custom double mjc:forceRange:max = 27
            custom double mjc:forceRange:min = -27
            custom rel mjc:target = </Taku_Arm/joints/right_shoulder_yaw_joint>
        }

        over "elbow_joint" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_elbow_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 27
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "Y"
            rel physics:body0 = </Taku_Arm/shoulder_yaw_link>
            rel physics:body1 = </Taku_Arm/elbow_link>
            point3f physics:localPos0 = (0.015, -0, -0.125)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -100
            float physics:upperLimit = 20
            custom float physxJoint:maxJointVelocity = 311.99994
            custom float state:angular:physics:position = 0
            custom float state:angular:physics:velocity = 0
        }

        def MjcActuator "right_elbow_joint_actuator"
        {
            custom double mjc:forceRange:max = 27
            custom double mjc:forceRange:min = -27
            custom rel mjc:target = </Taku_Arm/joints/right_elbow_joint>
        }

        over "wrist_yaw_joint" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_wrist_yaw_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 7
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "Z"
            rel physics:body0 = </Taku_Arm/elbow_link>
            rel physics:body1 = </Taku_Arm/wrist_yaw_link>
            point3f physics:localPos0 = (-0.01, 8.6566e-35, -0.1025)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -90
            float physics:upperLimit = 90
            custom float physxJoint:maxJointVelocity = 1199.9998
            custom float state:angular:physics:position = 0
            custom float state:angular:physics:velocity = 0
        }

        def MjcActuator "right_wrist_yaw_joint_actuator"
        {
            custom double mjc:forceRange:max = 7
            custom double mjc:forceRange:min = -7
            custom rel mjc:target = </Taku_Arm/joints/right_wrist_yaw_joint>
        }

        over "wrist_pitch_joint" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_wrist_pitch_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 7
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "Y"
            rel physics:body0 = </Taku_Arm/wrist_yaw_link>
            rel physics:body1 = </Taku_Arm/wrist_pitch_link>
            point3f physics:localPos0 = (0, -2.0858687e-35, -0.1525)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -60
            float physics:upperLimit = 60
            custom float physxJoint:maxJointVelocity = 1199.9998
            custom float state:angular:physics:position = 0
            custom float state:angular:physics:velocity = 0
        }

        def MjcActuator "right_wrist_pitch_joint_actuator"
        {
            custom double mjc:forceRange:max = 7
            custom double mjc:forceRange:min = -7
            custom rel mjc:target = </Taku_Arm/joints/right_wrist_pitch_joint>
        }

        over "wrist_roll_joint" (
            active = false
        )
        {
        }

        def PhysicsRevoluteJoint "right_wrist_roll_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 7
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "X"
            rel physics:body0 = </Taku_Arm/wrist_pitch_link>
            rel physics:body1 = </Taku_Arm/wrist_roll_link>
            point3f physics:localPos0 = (0.0285, -2.1300613e-35, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -90
            float physics:upperLimit = 90
            custom float physxJoint:maxJointVelocity = 1199.9998
            custom float state:angular:physics:position = 0
            custom float state:angular:physics:velocity = 0
        }

        def MjcActuator "right_wrist_roll_joint_actuator"
        {
            custom double mjc:forceRange:max = 7
            custom double mjc:forceRange:min = -7
            custom rel mjc:target = </Taku_Arm/joints/right_wrist_roll_joint>
        }
    }
    variantSet "EE" = {
        "Dynaclaw" (
            prepend payload = @./payloads/EE/dynaclaw_right.usda@
        ) {

        }
    }

    over "wrist_roll_link"
    {
        over "gripper_camera"
        {
            over "gripper_camera" (
                active = false
            )
            {
            }

            def Camera "right_hand_camera"
            {
                float2 clippingRange = (0.01, 10000000)
                float focalLength = 18.147562
                float focusDistance = 400
                token projection = "perspective"
                quatd xformOp:orient = (0, 1, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}
