#usda 1.0
(
    defaultPrim = "Taku_Arm"
    doc = """Gripper wrist camera: Sensing SHW5G (Marvin Pro wiring: Isaac Rx+90; optical Camera Rx180 for site +Z → look -Z). Optical Camera prim is renamed per Side: left_hand_camera / right_hand_camera (FiveAges W2 / Xhand / L6); Side=default keeps Camera gripper_camera."""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Taku_Arm"
{
    over "wrist_roll_link"
    {
        over "gripper_camera"
        {
            def "SHW5G" (
                prepend payload = @../../../../../../../sensors/sensing/SHW5G.usd@
            )
            {
                double xformOp:rotateX = 90
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateX", "xformOp:orient", "xformOp:scale"]
            }

            def Camera "gripper_camera"
            {
                float2 clippingRange = (0.01, 10000000)
                float focalLength = 18.147562
                float focusDistance = 400
                token projection = "perspective"
                quatd xformOp:orient = (0, 1, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}
