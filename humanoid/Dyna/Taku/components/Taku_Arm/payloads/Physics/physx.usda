#usda 1.0
(
    defaultPrim = "Taku_Arm"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Taku_Arm"
{
    over "base_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:stabilizationThreshold = 0.00001
    }

    over "joints"
    {
        over "shoulder_pitch_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 40
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 959.9716
        }

        over "shoulder_roll_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 40
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 959.9716
        }

        over "shoulder_yaw_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 27
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 311.99994
        }

        over "elbow_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 27
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 311.99994
        }

        over "wrist_yaw_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 7
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 1199.9998
        }

        over "wrist_pitch_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 7
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 1199.9998
        }

        over "wrist_roll_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 10
            float drive:angular:physics:maxForce = 7
            float drive:angular:physics:stiffness = 200
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 1199.9998
        }

        # Physics=physx: deactivate Side/default MjcActuators (live only under Physics=mujoco).
        over "left_shoulder_pitch_joint_actuator" (
            active = false
        )
        {
        }

        over "left_shoulder_roll_joint_actuator" (
            active = false
        )
        {
        }

        over "left_shoulder_yaw_joint_actuator" (
            active = false
        )
        {
        }

        over "left_elbow_joint_actuator" (
            active = false
        )
        {
        }

        over "left_wrist_yaw_joint_actuator" (
            active = false
        )
        {
        }

        over "left_wrist_pitch_joint_actuator" (
            active = false
        )
        {
        }

        over "left_wrist_roll_joint_actuator" (
            active = false
        )
        {
        }

        over "right_shoulder_pitch_joint_actuator" (
            active = false
        )
        {
        }

        over "right_shoulder_roll_joint_actuator" (
            active = false
        )
        {
        }

        over "right_shoulder_yaw_joint_actuator" (
            active = false
        )
        {
        }

        over "right_elbow_joint_actuator" (
            active = false
        )
        {
        }

        over "right_wrist_yaw_joint_actuator" (
            active = false
        )
        {
        }

        over "right_wrist_pitch_joint_actuator" (
            active = false
        )
        {
        }

        over "right_wrist_roll_joint_actuator" (
            active = false
        )
        {
        }
    }

    over "wrist_roll_link"
    {
        over "Taku_Dynaclaw" (
            variants = {
                string Physics = "physx"
            }
        )
        {
        }
    }
}

