#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "shoulder_pitch_link" (
        prepend references = @./geometries.usd@</Geometries/shoulder_pitch_link>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "default" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/default>
            )
            {
            }
        }

        over "mesh"
        {
            over "default" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/shoulder_pitch_link/VisualMaterials/default>
            }
        }
    }

    def Xform "shoulder_pitch_link_col" (
        prepend references = @./geometries.usd@</Geometries/shoulder_pitch_link>
    )
    {
        over "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "default" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/shoulder_pitch_link_col/VisualMaterials/default>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "default" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/default>
            )
            {
            }
        }
    }

