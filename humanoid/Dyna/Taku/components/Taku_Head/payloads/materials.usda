#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "urdf_7"
    {
        token outputs:mdl:displacement.connect = </Materials/urdf_7/urdf_7.outputs:out>
        token outputs:mdl:surface.connect = </Materials/urdf_7/urdf_7.outputs:out>
        token outputs:mdl:volume.connect = </Materials/urdf_7/urdf_7.outputs:out>

        def Shader "urdf_7"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.9647059, 0.6, 0.16470589)
            float inputs:emissive_strength = 10000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.6
            token outputs:out
        }
    }

    def Material "photo_black"
    {
        token outputs:mdl:displacement.connect = </Materials/photo_black/photo_black.outputs:out>
        token outputs:mdl:surface.connect = </Materials/photo_black/photo_black.outputs:out>
        token outputs:mdl:volume.connect = </Materials/photo_black/photo_black.outputs:out>

        def Shader "photo_black"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.015686275, 0.015686275, 0.015686275)
            float inputs:emissive_strength = 10000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.6
            token outputs:out
        }
    }

    def Material "urdf_8"
    {
        token outputs:mdl:displacement.connect = </Materials/urdf_8/urdf_8.outputs:out>
        token outputs:mdl:surface.connect = </Materials/urdf_8/urdf_8.outputs:out>
        token outputs:mdl:volume.connect = </Materials/urdf_8/urdf_8.outputs:out>

        def Shader "urdf_8"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.7372549, 0.7882353, 0.8784314)
            float inputs:emissive_strength = 10000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.6
            token outputs:out
        }
    }

    def Material "camera"
    {
        token outputs:mdl:displacement.connect = </Materials/camera/camera.outputs:out>
        token outputs:mdl:surface.connect = </Materials/camera/camera.outputs:out>
        token outputs:mdl:volume.connect = </Materials/camera/camera.outputs:out>

        def Shader "camera"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0, 0, 0)
            float inputs:emissive_strength = 10000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.1
            token outputs:out
        }
    }

    def Material "default"
    {
        token outputs:mdl:displacement.connect = </Materials/default/default.outputs:out>
        token outputs:mdl:surface.connect = </Materials/default/default.outputs:out>
        token outputs:mdl:volume.connect = </Materials/default/default.outputs:out>

        def Shader "default"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.8, 0.8, 0.8)
            float inputs:emissive_strength = 10000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.5
            token outputs:out
        }
    }
}

