        {
            def Xform "head_pitch_link" (
                instanceable = true
                prepend references = @./instances.usda@</Instances/head_pitch_link_col>
            )
            {
                uniform token purpose = "guide"
                quatd xformOp:orient = (1, 0, 0, 0)
