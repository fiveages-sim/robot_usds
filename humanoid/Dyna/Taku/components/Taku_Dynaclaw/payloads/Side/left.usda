#usda 1.0
(
    defaultPrim = "Taku_Dynaclaw"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Taku_Dynaclaw"
{
    custom rel isaac:physics:robotJoints
    prepend rel isaac:physics:robotJoints = [
        </Taku_Dynaclaw/joints/left_gripper_joint>,
        </Taku_Dynaclaw/joints/left_gripper_mimic_joint>,
    ]

    def "joints"
    {
        over "gripper_joint" (
            active = false
        )
        {
        }

        def PhysicsPrismaticJoint "left_gripper_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:linear:physics:damping = 40
            float drive:linear:physics:maxForce = 100
            float drive:linear:physics:stiffness = 1000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            uniform token physics:axis = "Y"
            rel physics:body0 = </Taku_Dynaclaw/base_link>
            rel physics:body1 = </Taku_Dynaclaw/gripperb_link>
            point3f physics:localPos0 = (-0.028088, 0.023048, -0.166971)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.0345
            custom float physxJoint:maxJointVelocity = 0.25
            custom float state:linear:physics:position = 0
            custom float state:linear:physics:velocity = 0
        }

        def MjcActuator "left_gripper_joint_actuator"
        {
            custom double mjc:forceRange:max = 100
            custom double mjc:forceRange:min = -100
            custom rel mjc:target = </Taku_Dynaclaw/joints/left_gripper_joint>
        }

        over "gripper_mimic_joint" (
            active = false
        )
        {
        }

        def PhysicsPrismaticJoint "left_gripper_mimic_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysxJointAPI", "MjcJointAPI", "IsaacJointAPI"]
        )
        {
            float drive:linear:physics:damping = 0
            float drive:linear:physics:maxForce = 100
            float drive:linear:physics:stiffness = 0
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
            custom float newton:mimicCoef0 = 0
            custom float newton:mimicCoef1 = -1
            custom rel newton:mimicJoint = </Taku_Dynaclaw/joints/left_gripper_joint>
            uniform token physics:axis = "Y"
            rel physics:body0 = </Taku_Dynaclaw/base_link>
            rel physics:body1 = </Taku_Dynaclaw/grippera_link>
            point3f physics:localPos0 = (-0.028953, -0.023048, -0.166971)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.0345
            float physics:upperLimit = 0
            custom float physxJoint:maxJointVelocity = 0.25
            custom float state:linear:physics:position = 0
            custom float state:linear:physics:velocity = 0
        }

        def MjcActuator "left_gripper_mimic_joint_actuator"
        {
            custom double mjc:forceRange:max = 100
            custom double mjc:forceRange:min = -100
            custom rel mjc:target = </Taku_Dynaclaw/joints/left_gripper_mimic_joint>
        }
    }
}

