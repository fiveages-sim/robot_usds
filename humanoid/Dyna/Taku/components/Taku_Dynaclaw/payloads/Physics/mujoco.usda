#usda 1.0
(
    defaultPrim = "Taku_Dynaclaw"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Taku_Dynaclaw"
{
    over "joints"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
        }

        def MjcActuator "gripper_joint_actuator"
        {
            custom double mjc:forceRange:max = 100
            custom double mjc:forceRange:min = -100
            custom rel mjc:target = </Taku_Dynaclaw/joints/gripper_joint>
        }

        over "gripper_mimic_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            custom double mjc:armature = 0.01
            custom double mjc:damping = 0.1
        }

        def MjcActuator "gripper_mimic_joint_actuator"
        {
            custom double mjc:forceRange:max = 100
            custom double mjc:forceRange:min = -100
            custom rel mjc:target = </Taku_Dynaclaw/joints/gripper_mimic_joint>
        }
    }
}

