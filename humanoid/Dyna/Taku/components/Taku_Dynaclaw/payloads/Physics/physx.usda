#usda 1.0
(
    defaultPrim = "Taku_Dynaclaw"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Taku_Dynaclaw"
{
    over "base_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
        float physxArticulation:stabilizationThreshold = 0.00001
    }

    over "joints"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 6000
            float drive:linear:physics:maxForce = 30
            float drive:linear:physics:stiffness = 60000
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 1
        }

        over "gripper_mimic_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 0
            float drive:linear:physics:maxForce = 30
            float drive:linear:physics:stiffness = 0
            float drive:linear:physics:targetPosition = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 1
        }

        # Physics=physx: deactivate Side/default MjcActuators (live only under Physics=mujoco).
        over "gripper_joint_actuator" (
            active = false
        )
        {
        }

        over "gripper_mimic_joint_actuator" (
            active = false
        )
        {
        }

        over "left_gripper_joint_actuator" (
            active = false
        )
        {
        }

        over "left_gripper_mimic_joint_actuator" (
            active = false
        )
        {
        }

        over "right_gripper_joint_actuator" (
            active = false
        )
        {
        }

        over "right_gripper_mimic_joint_actuator" (
            active = false
        )
        {
        }

    }
}

