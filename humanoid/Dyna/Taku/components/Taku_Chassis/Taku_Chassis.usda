#usda 1.0
(
    defaultPrim = "Taku_Chassis"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Taku_Chassis" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Graph = "none"
        string Physics = "physx"
        string Robot = "robot"
        string ROS = "none"
        string Sensor = "none"
    }
    prepend variantSets = ["Physics", "Graph", "ROS", "Robot", "Sensor"]
)
{
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
    variantSet "Graph" = {
        "none" {

        }
        "enable" (
            prepend payload = @./payloads/Graph/enable.usda@
        ) {

        }
    }
    variantSet "ROS" = {
        "none" {

        }
        "enable" (
            prepend payload = @./payloads/ROS/enable.usda@
        ) {

        }
        "full" (
            prepend payload = @./payloads/ROS/full.usda@
        ) {

        }
    }
    variantSet "Robot" = {
        "none" (
            prepend payload = @./payloads/Robot/none.usda@
        ) {

        }
        "robot" (
            prepend payload = @./payloads/Robot/robot.usda@
        ) {

        }
    }
    variantSet "Sensor" = {
        "none" (
            prepend payload = @./payloads/Sensor/none.usda@
        ) {

        }
        "sensors" (
            prepend payload = @./payloads/Sensor/sensors.usda@
        ) {

        }
    }
}
