#usda 1.0
(
    defaultPrim = "Taku_Chassis"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Taku_Chassis"
{
    over "base_link" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        float physxArticulation:sleepThreshold = 0.00005
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 4
        float physxArticulation:stabilizationThreshold = 0.00001
    }

    over "joints"
    {
        over "agv_right_front_steering_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 200
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 800
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 180
        }

        over "agv_right_front_rotate_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "acceleration"
            custom float physxJoint:maxJointVelocity = inf
        }

        over "agv_right_back_steering_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 200
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 800
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 180
        }

        over "agv_right_back_rotate_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "acceleration"
            custom float physxJoint:maxJointVelocity = inf
        }

        over "agv_left_front_steering_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 200
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 800
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 180
        }

        over "agv_left_front_rotate_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "acceleration"
            custom float physxJoint:maxJointVelocity = inf
        }

        over "agv_left_back_steering_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 200
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 800
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            custom float physxJoint:maxJointVelocity = 180
        }

        over "agv_left_back_rotate_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:maxForce = 3.4028235e38
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "acceleration"
            custom float physxJoint:maxJointVelocity = inf
        }
    }
}

