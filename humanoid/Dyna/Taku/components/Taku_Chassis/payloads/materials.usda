#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "photo_gray_001"
    {
        token outputs:mdl:displacement.connect = </Materials/photo_gray_001/photo_gray_001.outputs:out>
        token outputs:mdl:surface.connect = </Materials/photo_gray_001/photo_gray_001.outputs:out>
        token outputs:mdl:volume.connect = </Materials/photo_gray_001/photo_gray_001.outputs:out>

        def Shader "photo_gray_001"
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @../Textures/pbr.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "gltf_material"
            float inputs:alpha_cutoff = 0
            int inputs:alpha_mode = 0
            float inputs:base_alpha = 1
            color3f inputs:base_color_factor = (0.6509804, 0.6509804, 0.6509804)
            float inputs:emissive_strength = 10000
            float inputs:metallic_factor = 0
            float inputs:roughness_factor = 0.6
            token outputs:out
        }
    }

