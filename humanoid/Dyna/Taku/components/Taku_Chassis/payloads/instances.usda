#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "agv_base" (
        prepend references = @./geometries.usd@</Geometries/agv_base>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "photo_gray_001" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray_001>
            )
            {
            }

            def Material "red" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/red>
            )
            {
            }

            def Material "default" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/default>
            )
            {
            }

            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }

            def Material "color_666666" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/color_666666>
            )
            {
            }

            def Material "photo_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_black>
            )
            {
            }

            def Material "light_green" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/light_green>
            )
            {
            }

            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }
        }

        over "mesh"
        {
            over "photo_gray_001" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/photo_gray_001>
            }

            over "red" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/red>
            }

            over "default" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/default>
            }

            over "silver" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/silver>
            }

            over "color_666666" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/color_666666>
            }

            over "photo_black" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/photo_black>
            }

            over "light_green" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/light_green>
            }

            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base/VisualMaterials/photo_gray>
            }
        }
    }

    def Xform "agv_base_col" (
        prepend references = @./geometries.usd@</Geometries/agv_base>
    )
    {
        over "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "photo_gray_001" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/photo_gray_001>
            }

            over "red" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/red>
            }

            over "default" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/default>
            }

            over "silver" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/silver>
            }

            over "color_666666" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/color_666666>
            }

            over "photo_black" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/photo_black>
            }

            over "light_green" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/light_green>
            }

            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/agv_base_col/VisualMaterials/photo_gray>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "photo_gray_001" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray_001>
            )
            {
            }

            def Material "red" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/red>
            )
            {
            }

            def Material "default" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/default>
            )
            {
            }

            def Material "silver" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver>
            )
            {
            }

            def Material "color_666666" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/color_666666>
            )
            {
            }

            def Material "photo_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_black>
            )
            {
            }

            def Material "light_green" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/light_green>
            )
            {
            }

            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }
        }
    }

    def Xform "wheel_steering" (
        prepend references = @./geometries.usd@</Geometries/wheel_steering>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }
        }

        over "mesh"
        {
            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/wheel_steering/VisualMaterials/photo_gray>
            }
        }
    }

    def Xform "wheel_steering_col" (
        prepend references = @./geometries.usd@</Geometries/wheel_steering>
    )
    {
        over "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/wheel_steering_col/VisualMaterials/photo_gray>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }
        }
    }

    def Xform "wheel_rotate" (
        prepend references = @./geometries.usd@</Geometries/wheel_rotate>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "photo_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_black>
            )
            {
            }

            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }
        }

        over "mesh"
        {
            over "photo_black" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/wheel_rotate/VisualMaterials/photo_black>
            }

            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/wheel_rotate/VisualMaterials/photo_gray>
            }
        }
    }

    def Xform "wheel_rotate_col" (
        prepend references = @./geometries.usd@</Geometries/wheel_rotate>
    )
    {
        def PhysicsMaterial "TireMaterial" (
            prepend apiSchemas = ["PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.2
            float physics:restitution = 0
            float physics:staticFriction = 1.5
            uniform token physxMaterial:frictionCombineMode = "multiply"
            uniform token physxMaterial:restitutionCombineMode = "min"
        }

        over "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            float physxCollision:contactOffset = 0.02
            float physxCollision:restOffset = 0.0
            rel material:binding:physics = </Instances/wheel_rotate_col/TireMaterial>
            uniform token purpose = "guide"

            over "photo_black" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/wheel_rotate_col/VisualMaterials/photo_black>
            }

            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/wheel_rotate_col/VisualMaterials/photo_gray>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "photo_black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_black>
            )
            {
            }

            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }
        }
    }
}

