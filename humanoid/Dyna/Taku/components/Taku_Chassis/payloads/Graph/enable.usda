#usda 1.0
(
    defaultPrim = "Taku_Chassis"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Taku_Chassis"
{
    def "Graphs"
    {
        def OmniGraph "steering_wheel_controller"
        {
            token evaluationMode = "Automatic"
            token evaluator:type = "execution"
            token fabricCacheBacking = "StageWithoutHistory"
            int2 fileFormatVersion = (1, 9)
            token pipelineStage = "pipelineStageSimulation"
            token ui:displayName = "steering_wheel_controller"

            def OmniGraphNode "OnPlaybackTick"
            {
                token node:type = "omni.graph.action.OnPlaybackTick"
                int node:typeVersion = 2
                custom double outputs:deltaSeconds
                custom double outputs:frame
                custom uint outputs:tick (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom double outputs:time
            }

            def OmniGraphNode "ReadSimTime"
            {
                custom uint64 inputs:referenceTimeDenominator
                custom int64 inputs:referenceTimeNumerator
                custom bool inputs:resetOnStop = 0
                token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
                int node:typeVersion = 1
                custom double outputs:simulationTime
            }

            def OmniGraphNode "Context"
            {
                custom uchar inputs:domain_id
                custom bool inputs:useDomainIDEnvVar
                token node:type = "isaacsim.ros2.bridge.ROS2Context"
                int node:typeVersion = 2
                custom uint64 outputs:context
            }

            def OmniGraphNode "ros2_subscribe_twist"
            {
                custom uint64 inputs:context
                prepend uint64 inputs:context.connect = </Taku_Chassis/Graphs/steering_wheel_controller/Context.outputs:context>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </Taku_Chassis/Graphs/steering_wheel_controller/OnPlaybackTick.outputs:tick>
                custom string inputs:nodeNamespace = ""
                custom string inputs:qosProfile
                custom uint64 inputs:queueSize
                custom string inputs:topicName = "/cmd_vel"
                token node:type = "isaacsim.ros2.bridge.ROS2SubscribeTwist"
                int node:typeVersion = 1
                custom vector3d outputs:angularVelocity
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom vector3d outputs:linearVelocity
            }

            def OmniGraphNode "cmd_msg_counter"
            {
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </Taku_Chassis/Graphs/steering_wheel_controller/ros2_subscribe_twist.outputs:execOut>
                custom uint inputs:reset (
                    customData = {
                        bool isExecution = 1
                    }
                )
                token node:type = "omni.graph.action.Counter"
                int node:typeVersion = 2
                custom int outputs:count
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom int state:count
            }

            def OmniGraphNode "scale_to_from_stage_units"
            {
                custom token inputs:conversion = "Convert to meters" (
                    allowedTokens = ["Convert to stage units", "Convert to meters"]
                )
                custom token inputs:value
                prepend token inputs:value.connect = </Taku_Chassis/Graphs/steering_wheel_controller/ros2_subscribe_twist.outputs:linearVelocity>
                token node:type = "isaacsim.core.nodes.OgnIsaacScaleToFromStageUnit"
                int node:typeVersion = 1
                custom token outputs:result
            }

            def OmniGraphNode "break_angular"
            {
                custom token inputs:tuple
                prepend token inputs:tuple.connect = </Taku_Chassis/Graphs/steering_wheel_controller/ros2_subscribe_twist.outputs:angularVelocity>
                token node:type = "omni.graph.nodes.BreakVector3"
                int node:typeVersion = 1
                custom token outputs:x
                custom token outputs:y
                custom token outputs:z
            }

            def OmniGraphNode "break_linear"
            {
                custom token inputs:tuple
                prepend token inputs:tuple.connect = </Taku_Chassis/Graphs/steering_wheel_controller/scale_to_from_stage_units.outputs:result>
                token node:type = "omni.graph.nodes.BreakVector3"
                int node:typeVersion = 1
                custom token outputs:x
                custom token outputs:y
                custom token outputs:z
            }

            def OmniGraphNode "script_node"
            {
                custom double inputs:angularGain = 1
                custom double inputs:deltaSeconds
                prepend double inputs:deltaSeconds.connect = </Taku_Chassis/Graphs/steering_wheel_controller/OnPlaybackTick.outputs:deltaSeconds>
                custom double inputs:Desired_Angular_Velocity
                prepend double inputs:Desired_Angular_Velocity.connect = </Taku_Chassis/Graphs/steering_wheel_controller/break_angular.outputs:z>
                custom double inputs:Desired_Linear_Velocity_X
                prepend double inputs:Desired_Linear_Velocity_X.connect = </Taku_Chassis/Graphs/steering_wheel_controller/break_linear.outputs:x>
                custom double inputs:Desired_Linear_Velocity_Y
                prepend double inputs:Desired_Linear_Velocity_Y.connect = </Taku_Chassis/Graphs/steering_wheel_controller/break_linear.outputs:y>
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </Taku_Chassis/Graphs/steering_wheel_controller/OnPlaybackTick.outputs:tick>
                custom double inputs:flipVelocityScale = 0.15
                custom double inputs:linearGain = 16
                custom int inputs:msgCount
                prepend int inputs:msgCount.connect = </Taku_Chassis/Graphs/steering_wheel_controller/cmd_msg_counter.outputs:count>
                custom string inputs:script = '''import numpy as np

# Taku 4-module swerve. Wheel radius ~0.0625 m. Positions from chassis.urdf steering origins.
_WHEEL_RADIUS = 0.0625
_DEFAULT_LINEAR_GAIN = 1.0 / _WHEEL_RADIUS
_DEFAULT_ANGULAR_GAIN = 1.0
_DEFAULT_FLIP_VELOCITY_SCALE = 0.15
_SPEED_EPS = 1e-6
# Cmd deadband: hold steer, zero wheel speed (do NOT snap steer to 0 — that causes chatter).
_CMD_LIN_DEADBAND = 0.02
_CMD_ANG_DEADBAND = 0.05
# WBC BASE_LOCK often stops publishing without sending a zero Twist; latch would keep driving.
_CMD_TIMEOUT_S = 0.25
_STEER_SLEW_RAD_S = np.deg2rad(60.0)
_ALIGN_FULL_RAD = np.deg2rad(8.0)
_ALIGN_ZERO_RAD = np.deg2rad(35.0)
# Require flip solution to be clearly better before switching (stops boundary dither).
_FLIP_HYST_RAD = np.deg2rad(20.0)

_prev_pos_cmd = np.zeros(4)
_prev_vel_unscaled = np.zeros(4)
_steer_actual = np.zeros(4)
_has_prev_steer = False
_last_msg_count = -1
_last_msg_time = 0.0
_held_vx = 0.0
_held_vy = 0.0
_held_omega = 0.0


def _wrap_to_pi(angle):
    return (angle + np.pi) % (2 * np.pi) - np.pi


def _angle_diff(target, reference):
    return _wrap_to_pi(target - reference)


def _pick_steer_and_wheel_speed(raw_angle, speed, ref_angle):
    a = _wrap_to_pi(raw_angle)
    va = speed
    b = _wrap_to_pi(raw_angle + np.pi)
    vb = -speed
    da = abs(_angle_diff(a, ref_angle))
    db = abs(_angle_diff(b, ref_angle))
    # Prefer non-flipped unless flip is better by hysteresis margin.
    if db < da - _FLIP_HYST_RAD:
        return b, vb
    return a, va


def _align_scale(err):
    a = abs(err)
    if a <= _ALIGN_FULL_RAD:
        return 1.0
    if a >= _ALIGN_ZERO_RAD:
        return 0.0
    return (_ALIGN_ZERO_RAD - a) / (_ALIGN_ZERO_RAD - _ALIGN_FULL_RAD)


def setup(db):
    global _prev_pos_cmd, _prev_vel_unscaled, _steer_actual, _has_prev_steer
    global _last_msg_count, _last_msg_time, _held_vx, _held_vy, _held_omega
    _prev_pos_cmd = np.zeros(4)
    _prev_vel_unscaled = np.zeros(4)
    _steer_actual = np.zeros(4)
    _has_prev_steer = False
    _last_msg_count = -1
    _last_msg_time = 0.0
    _held_vx = 0.0
    _held_vy = 0.0
    _held_omega = 0.0


def cleanup(db):
    global _has_prev_steer, _prev_vel_unscaled, _steer_actual
    global _last_msg_count, _held_vx, _held_vy, _held_omega
    _has_prev_steer = False
    _prev_vel_unscaled = np.zeros(4)
    _steer_actual = np.zeros(4)
    _last_msg_count = -1
    _held_vx = 0.0
    _held_vy = 0.0
    _held_omega = 0.0


def compute(db):
    global _prev_pos_cmd, _prev_vel_unscaled, _steer_actual, _has_prev_steer
    global _last_msg_count, _last_msg_time, _held_vx, _held_vy, _held_omega

    linear_gain = float(getattr(db.inputs, "linearGain", _DEFAULT_LINEAR_GAIN))
    angular_gain = float(getattr(db.inputs, "angularGain", _DEFAULT_ANGULAR_GAIN))
    flip_vel_scale = float(getattr(db.inputs, "flipVelocityScale", _DEFAULT_FLIP_VELOCITY_SCALE))
    flip_vel_scale = max(0.0, min(1.0, flip_vel_scale))
    dt = float(getattr(db.inputs, "deltaSeconds", 0.0) or 0.0)
    if dt <= 1e-6 or dt > 0.1:
        dt = 1.0 / 60.0
    sim_t = float(getattr(db.inputs, "simTime", 0.0) or 0.0)
    msg_count = int(getattr(db.inputs, "msgCount", 0) or 0)

    vx_in = float(db.inputs.Desired_Linear_Velocity_X)
    vy_in = float(db.inputs.Desired_Linear_Velocity_Y)
    omega_in = float(db.inputs.Desired_Angular_Velocity)

    # Refresh held twist only when SubscribeTwist reports a new message (Counter ticks).
    if msg_count != _last_msg_count:
        _last_msg_count = msg_count
        _last_msg_time = sim_t
        _held_vx = vx_in
        _held_vy = vy_in
        _held_omega = omega_in

    if _last_msg_count < 0 or (sim_t - _last_msg_time) > _CMD_TIMEOUT_S:
        vx = 0.0
        vy = 0.0
        omega_cmd = 0.0
    else:
        vx = _held_vx
        vy = _held_vy
        omega_cmd = _held_omega

    # Deadband after timeout/hold — keep modules pointed, stop rolling.
    if np.linalg.norm([vx, vy]) < _CMD_LIN_DEADBAND and abs(omega_cmd) < _CMD_ANG_DEADBAND:
        vx = 0.0
        vy = 0.0
        omega_cmd = 0.0

    omega = omega_cmd * angular_gain
    pos_cmd = np.zeros(4)
    vel_cmd = np.zeros(4)

    # Order: fl, rl, rr, fr (matches jointNames below)
    wheel_positions = np.array([
        [0.2745, 0.2045],
        [-0.2745, 0.2045],
        [-0.2745, -0.2045],
        [0.2745, -0.2045],
    ])

    stopped = abs(vx) < _SPEED_EPS and abs(vy) < _SPEED_EPS and abs(omega_cmd) < _SPEED_EPS

    for i in range(4):
        x_i, y_i = wheel_positions[i]
        vx_total = vx - omega * y_i
        vy_total = vy + omega * x_i
        angle = np.arctan2(vy_total, vx_total)
        speed = np.linalg.norm([vx_total, vy_total])

        if stopped or speed < _SPEED_EPS:
            # Hold module angle; never snap to 0 on stop (avoids steer whip / wheel chatter).
            pos_cmd[i] = _steer_actual[i] if _has_prev_steer else 0.0
            vel_cmd[i] = 0.0
        else:
            ref = _steer_actual[i] if _has_prev_steer else 0.0
            pos_cmd[i], vel_cmd[i] = _pick_steer_and_wheel_speed(angle, speed, ref)
            if _has_prev_steer:
                pv = _prev_vel_unscaled[i]
                nv = vel_cmd[i]
                if (
                    abs(pv) > _SPEED_EPS
                    and abs(nv) > _SPEED_EPS
                    and pv * nv < 0
                    and flip_vel_scale < 1.0
                ):
                    vel_cmd[i] *= flip_vel_scale

    ik_vel = vel_cmd.copy()
    max_step = _STEER_SLEW_RAD_S * dt
    aligns = np.ones(4)
    for i in range(4):
        err = _angle_diff(pos_cmd[i], _steer_actual[i])
        _steer_actual[i] = _wrap_to_pi(
            _steer_actual[i] + np.clip(err, -max_step, max_step)
        )
        # Gate wheel speed by remaining steer error (no drive while misaligned).
        aligns[i] = _align_scale(_angle_diff(pos_cmd[i], _steer_actual[i]))
    if stopped:
        vel_cmd[:] = 0.0
    else:
        vel_cmd *= float(np.min(aligns))
        vel_cmd[:] *= linear_gain

    _prev_vel_unscaled = ik_vel
    _prev_pos_cmd = pos_cmd.copy()
    _has_prev_steer = True

    db.outputs.Steer_Position_Command = _steer_actual
    db.outputs.Wheel_Velocity_Command = vel_cmd
    return True
'''
                custom double inputs:simTime
                prepend double inputs:simTime.connect = </Taku_Chassis/Graphs/steering_wheel_controller/ReadSimTime.outputs:simulationTime>
                custom bool inputs:usePath = 0
                token node:type = "omni.graph.scriptnode.ScriptNode"
                int node:typeVersion = 2
                custom uint outputs:execOut (
                    customData = {
                        bool isExecution = 1
                    }
                )
                custom double[] outputs:Steer_Position_Command
                custom double[] outputs:Wheel_Velocity_Command
                custom bool state:omni_initialized
            }

            def OmniGraphNode "steer_articulation_controller"
            {
                custom double[] inputs:effortCommand
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </Taku_Chassis/Graphs/steering_wheel_controller/OnPlaybackTick.outputs:tick>
                custom int[] inputs:jointIndices
                custom token[] inputs:jointNames = ["agv_left_front_steering_joint", "agv_left_back_steering_joint", "agv_right_back_steering_joint", "agv_right_front_steering_joint"]
                custom double[] inputs:positionCommand
                prepend double[] inputs:positionCommand.connect = </Taku_Chassis/Graphs/steering_wheel_controller/script_node.outputs:Steer_Position_Command>
                custom string inputs:robotPath
                custom rel inputs:targetPrim = </Taku_Chassis/base_link> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom double[] inputs:velocityCommand
                token node:type = "isaacsim.core.nodes.IsaacArticulationController"
                int node:typeVersion = 1
            }

            def OmniGraphNode "drive_articulation_controller"
            {
                custom double[] inputs:effortCommand
                custom uint inputs:execIn (
                    customData = {
                        bool isExecution = 1
                    }
                )
                prepend uint inputs:execIn.connect = </Taku_Chassis/Graphs/steering_wheel_controller/OnPlaybackTick.outputs:tick>
                custom int[] inputs:jointIndices
                custom token[] inputs:jointNames = ["agv_left_front_rotate_joint", "agv_left_back_rotate_joint", "agv_right_back_rotate_joint", "agv_right_front_rotate_joint"]
                custom double[] inputs:positionCommand
                custom string inputs:robotPath
                custom rel inputs:targetPrim = </Taku_Chassis/base_link> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
                                string relType = "target"
                            }
                        }
                    }
                )
                custom double[] inputs:velocityCommand
                prepend double[] inputs:velocityCommand.connect = </Taku_Chassis/Graphs/steering_wheel_controller/script_node.outputs:Wheel_Velocity_Command>
                token node:type = "isaacsim.core.nodes.IsaacArticulationController"
                int node:typeVersion = 1
            }
        }
    }
}

