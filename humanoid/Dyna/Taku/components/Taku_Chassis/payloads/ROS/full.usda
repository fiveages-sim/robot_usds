            def OmniGraphNode "RenderProduct"
            {
                custom rel inputs:cameraPrim = </Taku_Chassis/base_link/lidar_front_left/RTX_Lidar> (
                    customData = {
                        dictionary omni = {
                            dictionary graph = {
