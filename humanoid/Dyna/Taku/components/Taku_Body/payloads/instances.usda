#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "folding_lower_joint_link" (
        prepend references = @./geometries.usd@</Geometries/folding_lower_joint_link>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }

            def Material "default" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/default>
            )
            {
            }
        }

        over "mesh"
        {
            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/folding_lower_joint_link/VisualMaterials/photo_gray>
            }

            over "default" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/folding_lower_joint_link/VisualMaterials/default>
            }
        }
    }

    def Xform "folding_lower_joint_link_col" (
        prepend references = @./geometries.usd@</Geometries/folding_lower_joint_link>
    )
    {
        over "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "photo_gray" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/folding_lower_joint_link_col/VisualMaterials/photo_gray>
            }

            over "default" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Instances/folding_lower_joint_link_col/VisualMaterials/default>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "photo_gray" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/photo_gray>
            )
            {
            }

            def Material "default" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/default>
            )
            {
            }
        }
    }

