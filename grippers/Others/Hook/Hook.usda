#usda 1.0
(
    defaultPrim = "Hook"
    doc = """Hook — hook EE (领世夹爪二) with virtual ROS DOFs.

Geometry: payloads/hook.usdc. No real finger mechanism.
Virtual dummy_finger(+2) + prismatic joints exist only so W2 ROS
ArticulationController accepts left_/right_gripper_joint names
(same convention as RG75 Side). Hook mesh stays on gripper_base.

Mount: Marvin_M6_CCS EE=Hook under link7/tcp.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Hook" (
    variants = {
        string Physics = "physx"
        string side = "default"
    }
    prepend variantSets = ["Physics", "side"]
)
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    variantSet "Physics" = {
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
    }

    variantSet "side" = {
        "default" {
        }
        "left" (
            prepend payload = @./payloads/Side/left.usda@
        ) {
        }
        "right" (
            prepend payload = @./payloads/Side/right.usda@
        ) {
        }
    }

    def Xform "gripper_base" (
        prepend payload = @./payloads/hook.usdc@
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "领世夹爪二_2"
        {
            over "Mesh_953_002" (
                delete apiSchemas = [
                    "PhysicsCollisionAPI",
                    "PhysxCollisionAPI",
                    "PhysicsMeshCollisionAPI",
                    "PhysxConvexDecompositionCollisionAPI",
                    "PhysxConvexHullCollisionAPI"
                ]
            )
            {
                bool physics:collisionEnabled = 0
            }
        }

        over "collision"
        {
            token visibility = "invisible"
        }
    }

    # Invisible ROS placeholder links (no collision). Driven by virtual joints.
    def Xform "dummy_finger"
    {
        token visibility = "invisible"
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.01, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "dummy_finger2"
    {
        token visibility = "invisible"
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.01, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Scope "joints"
    {
    }
}
