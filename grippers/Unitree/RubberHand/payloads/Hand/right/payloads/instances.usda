#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "hand" (
        prepend references = @./geometries.usd@</Geometries/hand>
    )
    {
        over "hand" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/hand/VisualMaterials/dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dark>
            )
            {
            }
        }
    }
}

