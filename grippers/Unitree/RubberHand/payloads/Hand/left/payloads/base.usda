        string name = "RubberHand"
    }
    kind = "component"
)
{
    float3[] extentsHint = [(0, -0.047906, -0.043029), (0.131828, 0.018651, 0.06345), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (3.4028235e38, 3.4028235e38, 3.4028235e38), (-3.4028235e38, -3.4028235e38, -3.4028235e38), (0.010000002, -0.045, -0.05), (0.13, 0.0050000004, 0.05)]

    def Scope "Materials"
    {
    }

    def Scope "Geometry"
    {
        def Xform "hand_base"
        {
            def Xform "hand" (
                instanceable = true
                prepend references = @./instances.usda@</Instances/hand>
            )
            {
                quatd xformOp:orient = (1, 0, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Cube "box" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
                uniform token purpose = "guide"
                double size = 1
                quatf xformOp:orient = (1, 0, 0, 0)
                float3 xformOp:scale = (0.12, 0.05, 0.1)
                double3 xformOp:translate = (0.07, -0.02, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }

    def Scope "Physics"
    {
    }

    def Scope "VisualMaterials"
    {
