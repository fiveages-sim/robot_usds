#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Dex1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Dex1"
{
    over "Physics"
    {
        over "gripper_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "gripper_joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "gripper_joint_actuator"
        {
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            custom rel mjc:target
            append rel mjc:target = </Dex1/Physics/gripper_joint>
        }

        def MjcActuator "gripper_joint1_actuator"
        {
            uniform double mjc:forceRange:max = 20
            uniform double mjc:forceRange:min = -20
            custom rel mjc:target
            append rel mjc:target = </Dex1/Physics/gripper_joint1>
        }
    }
}

