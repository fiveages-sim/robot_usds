#usda 1.0
(
    defaultPrim = "Dex1"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [ @./physics.usda@ ]
)

over "Dex1"
{
    over "Physics"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:damping = 1000
            float drive:linear:physics:stiffness = 10000
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "force"
        }

        over "gripper_joint1" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:transY"]
        )
        {
            float physxMimicJoint:transY:dampingRatio = 0
            float physxMimicJoint:transY:gearing = 1
            float physxMimicJoint:transY:naturalFrequency = 0
            float physxMimicJoint:transY:offset = 0
            rel physxMimicJoint:transY:referenceJoint = </Dex1/Physics/gripper_joint>
        }
    }
}
