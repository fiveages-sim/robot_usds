#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "Dex1"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "Dex1" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Dex1/Physics/root_joint>,
        </Dex1/Physics/gripper_joint>,
        </Dex1/Physics/gripper_joint1>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Dex1/Geometry/dex1_base_link>,
        </Dex1/Geometry/dex1_base_link/dex1_finger_link_1>,
        </Dex1/Geometry/dex1_base_link/dex1_finger_link_2>,
    ]
    token isaac:robotType = "Manipulator"

    over "Geometry"
    {
        over "dex1_base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "dex1_finger_link_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "dex1_finger_link_2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

