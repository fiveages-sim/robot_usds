#usda 1.0
(
    defaultPrim = "Dex1"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Unitree Dex1 parallel jaw. Sensor=none|camera."
)

def Xform "Dex1" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
        string Robot = "none"
        string Sensor = "none"
        string Side = "default"
        string ROS = "none"
    }
    prepend variantSets = ["Physics", "Sensor", "Side", "ROS"]
    append variantSets = ["Robot"]
)
{
    variantSet "Physics" = {
        "mujoco" ( prepend payload = @./payloads/Physics/mujoco.usda@ ) {}
        "none" {}
        "physics" ( prepend payload = @./payloads/Physics/physics.usda@ ) {}
        "physx" ( prepend payload = @./payloads/Physics/physx.usda@ ) {}
    }
    variantSet "Sensor" = {
        "none" ( prepend payload = @./payloads/Sensor/none.usda@ ) {}
        "camera" ( prepend payload = @./payloads/Sensor/camera.usda@ ) {}
    }
    variantSet "Side" = {
        "default" ( prepend payload = @./payloads/Side/default.usda@ ) {}
        "left" ( prepend payload = @./payloads/Side/left.usda@ ) {}
        "right" ( prepend payload = @./payloads/Side/right.usda@ ) {}
    }
    # ROS=enable publishes the wrist camera (rgb / depth / camera_info).
    # Requires Sensor=camera (the Camera prim lives there). Side=left|right
    # remaps nodeNamespace + cameraPrim via payloads/Side/*.usda overlays.
    variantSet "ROS" = {
        "none" ( prepend payload = @./payloads/ROS/none.usda@ ) {}
        "enable" ( prepend payload = @./payloads/ROS/enable.usda@ ) {}
    }
    variantSet "Robot" = {
        "none" {}
    }
}
