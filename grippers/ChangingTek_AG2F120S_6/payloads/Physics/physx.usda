#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (5, 0, 0)
                double radius = 5
            }
            dictionary Perspective = {
                double3 position = (0.17729754858695682, 0.3710137244174917, 0.3875802616125334)
                double3 target = (-0.0401955025636109, -0.11565616360828163, 0.0029176338671074165)
            }
            dictionary Right = {
                double3 position = (0, -5, 0)
                double radius = 5
            }
            dictionary Top = {
                double3 position = (0, 0, 5)
                double radius = 5
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./ChangingTek_AG2F120S.usd"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "ChangingTek_AG2F120S"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "ChangingTek_AG2F120S"
{
    over "joints"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxDrivePerformanceEnvelopeAPI:angular"]
        )
        {
            float physxDrivePerformanceEnvelope:angular:maxActuatorVelocity = inf
            float physxJoint:maxJointVelocity = 57295.777
        }

        over "left_support_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </ChangingTek_AG2F120S/joints/gripper_joint>
        }

        over "left_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </ChangingTek_AG2F120S/joints/gripper_joint>
        }

        over "right_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = 1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </ChangingTek_AG2F120S/joints/gripper_joint>
        }

        over "right_support_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = 1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </ChangingTek_AG2F120S/joints/right_1_joint>
        }

        over "right_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = 1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </ChangingTek_AG2F120S/joints/left_2_joint>
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}

