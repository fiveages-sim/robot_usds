    defaultPrim = "ChangingTek_AG2F120S"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ChangingTek_AG2F120S" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
