#usda 1.0
(
    defaultPrim = "AG2F120S"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "AG2F120S"
{
    over "joints"
    {
        # Rated open/close is fast; keep a generous PhysX velocity cap.
        over "gripper_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 240
        }

        # Align with AG2F90 / Side left|right: hard PhysX mimic
        # (naturalFrequency=0, dampingRatio=0). Soft NF=25/DR=0.005 lets
        # followers lag under gravity and the finger linkage falls apart.
        # gearing=-1 matches URDF multiplier=1 under PhysX's sign convention
        # (same as AG2F90; Newton uses mimicCoef1=+1).
        over "left_support_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </AG2F120S/joints/gripper_joint>
        }

        over "left_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </AG2F120S/joints/gripper_joint>
        }

        over "right_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </AG2F120S/joints/gripper_joint>
        }

        over "right_support_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </AG2F120S/joints/gripper_joint>
        }

        over "right_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
        )
        {
            float physxMimicJoint:rotZ:dampingRatio = 0
            float physxMimicJoint:rotZ:gearing = -1
            float physxMimicJoint:rotZ:naturalFrequency = 0
            float physxMimicJoint:rotZ:offset = 0
            rel physxMimicJoint:rotZ:referenceJoint = </AG2F120S/joints/gripper_joint>
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
    }
}
