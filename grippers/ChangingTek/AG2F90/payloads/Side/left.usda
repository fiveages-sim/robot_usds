#usda 1.0
(
    defaultPrim = "AG2F90"
    metersPerUnit = 1
    upAxis = "Z"
)

def "AG2F90"
{
    over "joints"
    {
over "gripper_joint" (
    active = false
)
{
}

        def PhysicsRevoluteJoint "left_gripper_joint" (
            prepend apiSchemas = ["MjcJointAPI", "PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float drive:angular:physics:damping = 1
            float drive:angular:physics:maxForce = 10
            float drive:angular:physics:stiffness = 10
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform double mjc:armature = 0.001
            uniform double mjc:damping = 0.01
            uniform token mjc:actuatorfrclimited = "auto"
            uniform double mjc:actuatorfrcrange:min = -5
            uniform double mjc:actuatorfrcrange:max = 5
            uniform token physics:axis = "X"
            prepend rel physics:body0 = </AG2F90/gripper_base>
            prepend rel physics:body1 = </AG2F90/left_1_link>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.00065483624
            point3f physics:localPos0 = (0, -0.030141, 0.090147)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, 0.70710677, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 57.295776
            # 100 mm/s rated over 90 mm stroke -> 63.662 deg/s
            float physxJoint:maxJointVelocity = 63.662
            float state:angular:physics:position = 0
            float state:angular:physics:velocity = 0
        }
over "left_in_Joint" (
    active = false
)
{
}

