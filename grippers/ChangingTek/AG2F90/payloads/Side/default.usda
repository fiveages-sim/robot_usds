#usda 1.0
(
    defaultPrim = "AG2F90"
    metersPerUnit = 1
    upAxis = "Z"
)

def "AG2F90"
{
    # Sensor=G305: optical Camera → hand_camera
    over "gripper_base"
    {
        over "flange"
        {
            over "g305_mount" (
                variants = {
                    string camera = "default"
                }
            )
            {
            }
        }
    }
}
