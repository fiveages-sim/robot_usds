#usda 1.0
(
    defaultPrim = "ERG32"
    doc = """Generated from Composed Stage of root layer /home/fiveages/Documents/FaSim-Isaac/robots/grippers/Jodell/ERG32/ERG32.usd
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "ERG32" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </ERG32/root_joint>,
        </ERG32/joints/rotate_joint>,
        </ERG32/joints/gripper_joint>,
        </ERG32/joints/right_finger_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </ERG32/gripper_base>,
        </ERG32/rotate_link>,
        </ERG32/left_finger>,
        </ERG32/right_finger>,
        </ERG32/gripper_base/eef>,
        </ERG32/rotate_link/collisions>,
        </ERG32/left_finger/left_finger_tip>,
        </ERG32/left_finger/collisions>,
        </ERG32/right_finger/right_finger_tip>,
        </ERG32/right_finger/collisions>,
    ]

    over "gripper_base" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "eef" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "rotate_link" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "joints"
    {
        over "rotate_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "gripper_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "right_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }
    }

    over "left_finger" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "left_finger_tip" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "right_finger" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "right_finger_tip" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["IsaacJointAPI"]
    )
    {
    }
}

