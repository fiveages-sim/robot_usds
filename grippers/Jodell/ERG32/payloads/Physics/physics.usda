over "ERG32"
{
    over "gripper_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.00006799377, -0.00041797172, 0.07243398)
        float3 physics:diagonalInertia = (0.0023778107, 0.002095335, 0.0011936539)
        float physics:mass = 2.9571335
