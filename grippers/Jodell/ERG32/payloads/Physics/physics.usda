        float physics:mass = 0.08652144
        quatf physics:principalAxes = (1, 0.0000022425918, 0.0000017780397, 0.000019662533)
    }

    over "joints"
    {
        def PhysicsRevoluteJoint "rotate_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 625
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "acceleration"
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </ERG32/gripper_base>
            custom rel physics:body1
            prepend rel physics:body1 = </ERG32/rotate_link>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.0037188157
            point3f physics:localPos0 = (0, 0.006, 0.1542)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -180
            float physics:upperLimit = 180
        }

        def PhysicsPrismaticJoint "gripper_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 0
            float drive:linear:physics:maxForce = 100
            float drive:linear:physics:stiffness = 625
            float drive:linear:physics:targetPosition = 0
            uniform token drive:linear:physics:type = "acceleration"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </ERG32/rotate_link>
            custom rel physics:body1
            prepend rel physics:body1 = </ERG32/left_finger>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.00000471742
            point3f physics:localPos0 = (0.0085, 0.0005, 0.0158)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = 0
            float physics:upperLimit = 0.016
        }

        def PhysicsPrismaticJoint "right_finger_joint" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </ERG32/rotate_link>
            custom rel physics:body1
            prepend rel physics:body1 = </ERG32/right_finger>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.000004717419
            point3f physics:localPos0 = (-0.0085, -0.0005, 0.0158)
            point3f physics:localPos1 = (0, 0, 0)
