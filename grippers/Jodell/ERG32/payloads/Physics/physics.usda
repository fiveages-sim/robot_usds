            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.0192
            float physics:upperLimit = 0.0032000002
        }
    }

    over "left_finger" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.00019188754, -0.008, -0.007321426)
        float3 physics:diagonalInertia = (7.8495924e-7, 2.318724e-7, 7.108682e-7)
        float physics:mass = 0.013849229
