def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "grey" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/grey>
            }

            over "black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black>
            }

            over "white" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/white>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey>
            )
            {
            }

            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }

            def Material "white" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white>
            )
            {
            }
        }
    }

    def Xform "mesh_1" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh" (
            apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            uniform token purpose = "guide"

            over "grey" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/grey>
            }

            over "black" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/black>
            }

            over "white" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh_1/VisualMaterials/white>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/grey>
            )
            {
            }

            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }

            def Material "white" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white>
            )
            {
            }
        }
    }

    def Xform "mesh_1_1" (
        prepend references = @./geometries.usd@</Geometries/mesh_1>
    )
    {
        over "mesh_1" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh_1_1/VisualMaterials/black>
        }

        def Scope "VisualMaterials"
        {
            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }
        }
    }

    def Xform "mesh_2" (
        prepend references = @./geometries.usd@</Geometries/mesh_2>
    )
    {
        over "mesh_2" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/mesh_2/VisualMaterials/black>
        }

        def Scope "VisualMaterials"
        {
            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
