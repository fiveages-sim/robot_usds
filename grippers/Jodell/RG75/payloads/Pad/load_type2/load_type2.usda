#usda 1.0
(
    defaultPrim = "RG75"
    doc = """Pad=load_type2 — Track C: dual tip USDC with author-made cube colliders.

File semantics (do not mount by filename alone):
  pad.usdc       = canonical tip (old shared mesh / right finger)
  pad_right.usdc = X-mirror of pad.usdc (old left finger with scale=-1)

Mount (fixed in gripper frame; no Side sticky — unlike heavy_carry):
  left_finger  → pad_right.usdc + rotateZYX=(-90,0,0)
  right_finger → pad.usdc       + rotateZYX=(-90,180,0)
  scale=(1,1,1) both

Side only renames joints; tip L/R stay fixed so scanner on gripper_base
keeps the same relative pose on both robot arms.

Visual mesh: no collision. Cubes only.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def "RG75"
{
    over "Looks"
    {
        def Material "PadMaterials" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1
        }
    }

    over "left_finger"
    {
        rel physics:simulationOwner

        over "visuals"
        {
            over "finger_support"
            {
                token visibility = "inherited"
            }
        }

        over "left_finger_pad"
        {
            def "pad" (
                prepend payload = @./pad_right.usdc@
            )
            {
                token visibility = "inherited"
                double3 xformOp:translate = (0, 0, 0)
                double3 xformOp:rotateZYX = (-90, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

                over "pad"
                {
                    over "pad" (
                        delete apiSchemas = [
                            "PhysicsCollisionAPI",
                            "PhysxCollisionAPI",
                            "PhysicsMeshCollisionAPI",
                            "PhysxConvexDecompositionCollisionAPI",
                            "PhysxConvexHullCollisionAPI"
                        ]
                    )
                    {
                        bool physics:collisionEnabled = 0
                    }
                }

                over "collision"
                {
                    token visibility = "invisible"

                    over "Cube"
                    {
                        rel physics:simulationOwner
                        prepend rel material:binding:physics = </RG75/Looks/PadMaterials>
                    }

                    over "Cube_01"
                    {
                        rel physics:simulationOwner
                        prepend rel material:binding:physics = </RG75/Looks/PadMaterials>
                    }

                    over "Cube_02"
                    {
                        rel physics:simulationOwner
                        prepend rel material:binding:physics = </RG75/Looks/PadMaterials>
                    }
                }
            }
        }
    }

    over "right_finger"
    {
        rel physics:simulationOwner

        over "visuals"
        {
            over "finger_support"
            {
                token visibility = "inherited"
            }
        }

        over "right_finger_pad"
        {
            def "pad" (
                prepend payload = @./pad.usdc@
            )
            {
                token visibility = "inherited"
                double3 xformOp:translate = (0, 0, 0)
                double3 xformOp:rotateZYX = (-90, 180, 0)
                double3 xformOp:scale = (1, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

                over "pad"
                {
                    over "pad" (
                        delete apiSchemas = [
                            "PhysicsCollisionAPI",
                            "PhysxCollisionAPI",
                            "PhysicsMeshCollisionAPI",
                            "PhysxConvexDecompositionCollisionAPI",
                            "PhysxConvexHullCollisionAPI"
                        ]
                    )
                    {
                        bool physics:collisionEnabled = 0
                    }
                }

                over "collision"
                {
                    token visibility = "invisible"

                    over "Cube"
                    {
                        rel physics:simulationOwner
                        prepend rel material:binding:physics = </RG75/Looks/PadMaterials>
                    }

                    over "Cube_01"
                    {
                        rel physics:simulationOwner
                        prepend rel material:binding:physics = </RG75/Looks/PadMaterials>
                    }

                    over "Cube_02"
                    {
                        rel physics:simulationOwner
                        prepend rel material:binding:physics = </RG75/Looks/PadMaterials>
                    }
                }
            }
        }
    }

    over "gripper_base"
    {
        rel physics:simulationOwner
    }
}
