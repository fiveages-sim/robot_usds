#usda 1.0
(
    defaultPrim = "root"
    doc = """PTC tip package for right_finger.

Soft tip uses Mesh_0_003_R (X-reflected bake) so xformOp:scale stays (1,1,1)
for Newton/MJWarp. Orient/translate match the original Asset Transformer pad.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "root"
{
    def Xform "shouzhi0305_001" (
        instanceable = true
        prepend references = @./instances.usda@</Instances/Mesh_0>
    )
    {
        quatd xformOp:orient = (0, 0.7071068283, 0, 0.7071067341)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "shouzhi0304_000R" (
        instanceable = true
        prepend references = @./instances.usda@</Instances/Mesh_0_003_R>
    )
    {
        quatd xformOp:orient = (0.5, -0.5, -0.5, 0.5)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.0295, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
