#usda 1.0
(
    defaultPrim = "RG75"
    doc = """Pad=flat_type1 — Track B thin USDC mount.

  pad.usdc = flat tip (collision on /root/visual/Mesh_0, convexDecomposition).
  Mount under left_finger_pad / right_finger_pad (base TF),
  L rotateZYX=(-90,0,0); R rotateZYX=(90,0,-180).
  scale (1,1,1). finger_support: inherited.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def "RG75"
{
    over "left_finger"
    {
        rel physics:simulationOwner

        over "visuals"
        {
            over "finger_support"
            {
                token visibility = "inherited"
            }
        }

        over "left_finger_pad"
        {
            def "pad" (
                prepend payload = @./pad.usdc@
            )
            {
                token visibility = "inherited"
                double3 xformOp:translate = (0, 0, 0)
                double3 xformOp:rotateZYX = (-90, 0, 0)
                double3 xformOp:scale = (1, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

                over "visual"
                {
                    over "Mesh_0"
                    {
                        rel physics:simulationOwner
                    }
                }
            }
        }
    }

    over "right_finger"
    {
        rel physics:simulationOwner

        over "visuals"
        {
            over "finger_support"
            {
                token visibility = "inherited"
            }
        }

        over "right_finger_pad"
        {
            def "pad" (
                prepend payload = @./pad.usdc@
            )
            {
                token visibility = "inherited"
                double3 xformOp:translate = (0, 0, 0)
                double3 xformOp:rotateZYX = (90, 0, -180)
                double3 xformOp:scale = (1, 1, 1)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

                over "visual"
                {
                    over "Mesh_0"
                    {
                        rel physics:simulationOwner
                    }
                }
            }
        }
    }

    over "gripper_base"
    {
        rel physics:simulationOwner
    }
}
