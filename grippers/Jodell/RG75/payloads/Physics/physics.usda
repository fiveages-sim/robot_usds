over "RG75"
{
    over "gripper_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (2.5446623e-8, -0.00007069806, 0.06869433)
        float3 physics:diagonalInertia = (0.005113887, 0.0044492097, 0.003081717)
        float physics:mass = 4.079849
