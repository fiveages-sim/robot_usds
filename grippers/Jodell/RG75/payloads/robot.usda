#usda 1.0
(
    defaultPrim = "RG75"
    doc = """Generated from Composed Stage of root layer /home/fiveages/Documents/FaSim-Isaac/robots/grippers/Jodell/RG75/RG75.usd
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "RG75" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description
    string isaac:namespace
    prepend rel isaac:physics:robotJoints = [
        </RG75/root_joint>,
        </RG75/joints/gripper_joint>,
        </RG75/joints/right_finger_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </RG75/gripper_base>,
        </RG75/left_finger>,
        </RG75/right_finger>,
        </RG75/left_finger/left_finger_pad>,
        </RG75/left_finger/collisions>,
        </RG75/right_finger/right_finger_pad>,
        </RG75/right_finger/collisions>,
    ]

    over "gripper_base" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride
    }

    over "left_finger" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "left_finger_pad" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "joints"
    {
        over "gripper_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }

        over "right_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
            string isaac:nameOverride
            float[] isaac:physics:AccelerationLimit
            int isaac:physics:index
            float[] isaac:physics:JerkLimit
            int isaac:physics:Rot_X:DofOffset
            int isaac:physics:Rot_Y:DofOffset
            int isaac:physics:Rot_Z:DofOffset
            int isaac:physics:Tr_X:DofOffset
            int isaac:physics:Tr_Y:DofOffset
            int isaac:physics:Tr_Z:DofOffset
        }
    }

    over "right_finger" (
        prepend apiSchemas = ["IsaacLinkAPI"]
    )
    {
        string isaac:nameOverride

        over "right_finger_pad" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }

        over "collisions" (
            prepend apiSchemas = ["IsaacSiteAPI"]
        )
        {
        }
    }

    over "root_joint" (
        prepend apiSchemas = ["IsaacJointAPI"]
    )
    {
    }
}

