#usda 1.0
(
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robotiq_2F_85"
{
    over "bracket"
    {
        over "lower"
        {
            over "lower_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/lower>
            }

        }
        over "upper"
        {
            over "upper_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/upper>
            }

        }
        over "clamp_fasteners"
        {
            over "clamp_fasteners_124_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_133_140_153>
            }

            over "clamp_fasteners_125_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_133_140_153>
            }

            over "clamp_fasteners_126_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_133_140_153>
            }

            over "clamp_fasteners_127_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_133_140_153>
            }

        }
        over "side_fasteners"
        {
            over "side_fasteners_128_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_096_087_078>
            }

            over "side_fasteners_129_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_096_087_078>
            }

        }
        over "camera_fasteners"
        {
            over "camera_fasteners_130_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_133_140_153>
            }

            over "camera_fasteners_131_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Robotiq_2F_85/Looks/fastener_133_140_153>
            }

        }
    }

    over "coupling"
    {
        over "body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Robotiq_2F_85/Looks/coupling_body>
        }

        over "collar" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Robotiq_2F_85/Looks/coupling_collar>
        }

        over "cable" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Robotiq_2F_85/Looks/coupling_cable>
        }

        over "collar_edge" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Robotiq_2F_85/Looks/coupling_collar_edge>
        }

        over "cable_dark" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Robotiq_2F_85/Looks/coupling_cable_dark>
        }

        over "connector_red" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Robotiq_2F_85/Looks/coupling_connector_red>
        }

        over "connector_green" (
