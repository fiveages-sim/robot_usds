#usda 1.0
(
    defaultPrim = "Robotiq_2F_85"
    doc = """Sensor=acepro2. Integrated RoboAPI Ace Pro 2 kit: wrist-camera bracket + fasteners, official coupling (adapter ring + gripper communication cable), and robots/sensors/action_camera/Insta360/AcePro2 hung identity on the library gripper face.

Shifts the gripper out by (0, 0, 0.00745) along tool Z. That translate is authored on the Sensor variant in Robotiq_2F_85.usda so the viewport updates when the variant changes; the matching AssemblerFixedJoint localPos0 keeps Play from snapping. Bracket, coupling, and wrist_camera are translated (0, 0, -0.0032) so they stay on the previous flange position. Bare Sensor=none stays on the flange face. Same offset on Action 6.

Meshes and colors come from the official developers.pokebot.com assembly GLB. Official UR wrist and official gripper body/fingers are omitted so they do not duplicate the Isaac UR5e wrist or the library Robotiq 2F-85. Camera Lens / Frame variants live on wrist_camera, not on this Sensor option name.

When composed under an arm EE payload, that file must not pin translate or AssemblerFixedJoint localPos0, or this offset is hidden. UR5e and CR5 robotiq85 payloads leave Z free. Scenes only select Sensor=acepro2; they do not restate the offset.
"""
    metersPerUnit = 1
    subLayers = [
        @./bindings_acepro2.usda@,
        @./materials_acepro2.usda@
    ]
    upAxis = "Z"
)

def Xform "Robotiq_2F_85"
{
    def Xform "bracket" (
        prepend references = @./geometries_acepro2.usdc@</Geometries>
    )
    {
        double3 xformOp:translate = (0, 0, -0.0032)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "coupling" (
        prepend references = @./geometries_coupling.usdc@</Geometries>
    )
    {
        double3 xformOp:translate = (0, 0, -0.0032)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "wrist_camera" (
        prepend payload = @../../../../../sensors/action_camera/Insta360/AcePro2/AcePro2.usda@
    )
    {
        # Default Lens=ultrawide, Frame=utility (RoboAPI recommended).
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, -0.0032)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
