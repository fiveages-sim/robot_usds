#usda 1.0
(
    defaultPrim = "Scoop_type1"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Scoop_type1"
{
    over "gripper_base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.4
        float3 physics:diagonalInertia = (0.0012, 0.0014, 0.0022)
    }

    def PhysicsFixedJoint "root_joint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </Scoop_type1/gripper_base>
    }
}
