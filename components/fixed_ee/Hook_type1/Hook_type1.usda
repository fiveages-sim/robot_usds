#usda 1.0
(
    defaultPrim = "Hook_type1"
    doc = """Hook_type1 — fixed jointless hook EE.

Geometry: payloads/hook.usdc. Single rigid body on gripper_base.
No finger DOFs / virtual ROS joints.

Mount: Marvin_M6_CCS EE=hook_type1 under link7/tcp.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Hook_type1" (
    variants = {
        string Physics = "physx"
        string side = "default"
    }
    prepend variantSets = ["Physics", "side"]
)
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    variantSet "Physics" = {
        "none" (
            prepend payload = @./payloads/Physics/none.usda@
        ) {
        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {
        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {
        }
    }

    variantSet "side" = {
        "default" {
        }
        "left" (
            prepend payload = @./payloads/Side/left.usda@
        ) {
        }
        "right" (
            prepend payload = @./payloads/Side/right.usda@
        ) {
        }
    }

    def Xform "gripper_base" (
        prepend payload = @./payloads/hook.usdc@
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "领世夹爪二_2"
        {
            over "Mesh_953_002" (
                delete apiSchemas = [
                    "PhysicsCollisionAPI",
                    "PhysxCollisionAPI",
                    "PhysicsMeshCollisionAPI",
                    "PhysxConvexDecompositionCollisionAPI",
                    "PhysxConvexHullCollisionAPI"
                ]
            )
            {
                bool physics:collisionEnabled = 0
            }
        }

        over "collision"
        {
            token visibility = "invisible"
        }
    }
}
