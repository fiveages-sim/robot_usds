    def Material "wheel_grey1"
    {
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:displacement.connect = </Materials/wheel_grey1/wheel_grey1.outputs:out>
        prepend token outputs:mdl:surface.connect = </Materials/wheel_grey1/wheel_grey1.outputs:out>
        prepend token outputs:mdl:volume.connect = </Materials/wheel_grey1/wheel_grey1.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
