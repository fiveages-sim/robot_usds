def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "wheel_grey1" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/wheel_grey1>
            }

            over "wheel_grey_2" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/wheel_grey_2>
            }

            over "silver_003" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/silver_003>
            }

            over "black_003" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_003>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "wheel_grey1" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/wheel_grey1>
            )
            {
            }

            def Material "wheel_grey_2" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/wheel_grey_2>
            )
            {
            }

            def Material "silver_003" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/silver_003>
            )
            {
            }

            def Material "black_003" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_003>
            )
            {
            }
        }
    }
}

