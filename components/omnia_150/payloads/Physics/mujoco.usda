#usda 1.0
(
    defaultPrim = "omnia_150"
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

def "omnia_150"
{
    over "joints"
    {
        over "wheel_passive_0_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_1_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_2_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_3_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_4_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_5_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_6_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_7_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }

        over "wheel_passive_8_joint" (
            prepend apiSchemas = ["MjcJointAPI"]
            delete apiSchemas = ["PhysicsJointStateAPI:angular"]
        )
        {
            uniform double mjc:armature = 0.02
            uniform double mjc:damping = 8.0
        }
    }

    # Merge into parent articulation when mounted on ARX_LIFT2S (Wheel payload).
    over "root_joint" (
        active = false
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
    )
    {
    }
}
