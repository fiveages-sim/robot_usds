def Scope "Instances"
{
    def Xform "mesh" (
        prepend references = @./geometries.usd@</Geometries/mesh>
    )
    {
        over "mesh"
        {
            over "wheel_rubber" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/wheel_rubber>
            }

            over "white_metal" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/white_metal>
            }

            over "black_plastic" (
                apiSchemas = ["MaterialBindingAPI"]
            )
            {
                custom rel material:binding
                prepend rel material:binding = </Instances/mesh/VisualMaterials/black_plastic>
            }
        }

        def Scope "VisualMaterials"
        {
            def Material "wheel_rubber" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/wheel_rubber>
            )
            {
            }

            def Material "white_metal" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/white_metal>
            )
            {
            }

            def Material "black_plastic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black_plastic>
            )
            {
            }
        }
    }
}

