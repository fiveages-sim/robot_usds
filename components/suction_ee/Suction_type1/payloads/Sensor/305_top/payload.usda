#usda 1.0
(
    defaultPrim = "Suction_type1"
    doc = """Sensors=orbbec_305_top — camera+stand under gripper_base.

Source: Fuyao Glass feeding gripper/305.usdc (camera including bracket).
TF relative to gripper_base currently identity — adjust later if needed.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def "Suction_type1"
{
    over "gripper_base"
    {
        def "stand" (
            prepend payload = @./305.usdc@
        )
        {
            double3 xformOp:translate = (0, 0, 0)
            double3 xformOp:rotateZYX = (0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]
        }
    }
}
